@Component
script PlayerHit extends Component

    -- QA finding (2026-08-19, real playtest): a fresh level-1 character walking into a field's
    -- spawn portal dropped from 60 -> 12 HP within ~3 seconds and died with 0 kills - multiple
    -- FieldWaveSpawner-spawned monsters share the exact same fixed spawn X (no position jitter -
    -- see FieldWaveSpawner.TrySpawn), so 2-3 of them can end up stacked on the same point and each
    -- swings independently on its own timer. The original "no extra i-frame gate - each monster's
    -- own timer already spaces its hits" reasoning only holds for a single attacker; it breaks down
    -- completely once more than one monster is in contact range at once, which a wave spawner will
    -- routinely produce as waves escalate. A short shared i-frame after any hit caps burst damage
    -- from simultaneous attackers to roughly one hit's worth, independent of how many monsters are
    -- touching the player - the standard fix for this class of problem in action games.
    property number IFrameSeconds = 0.5
    @HideFromInspector property number LastHitElapsed = -999

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- DefaultPlayer already ships a native HitComponent (confirmed via a runtime
        -- [LWA-3048] DuplicateComponent warning when this script previously tried to add a second
        -- one via extends HitComponent + AddComponent) - configure the existing instance instead of
        -- creating our own. It had no CollisionGroup/box set up since nothing in the project ever
        -- used player-side HitEvent before this.
        local hit = self.Entity.HitComponent
        if isvalid(hit) then
            hit.BoxSize = Vector2(0.67, 1.42)
            hit.ColliderOffset = Vector2(-0.005, 0.71)
            -- This project's CollisionGroupSet has no "Player" group (confirmed at runtime -
            -- CollisionGroups only has Portal/TriggerBox/Monster/HitBox/Climbable/Default/
            -- Interaction). Monster HitComponents already claim the "Monster" group (see
            -- Snail.model), so "Default" is the only unclaimed group left to tag the player with -
            -- MonsterAttack.mlua targets the same group.
            hit.CollisionGroup = CollisionGroups.Default
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- Applies monster contact damage to the real PlayerComponent.Hp, reduced by the "단단함"
        -- trait's DamageReductionPercent (PlayerStatsComponent) - this is the "몬스터 공격
        -- 파이프라인" that trait's description note said would apply the survival stat once it
        -- existed (see CharacterInfoUIController.TraitDesc). Triggers HIT/DEAD the same way the
        -- rest of combat feedback (damage skin, hit effect) already expects. No extra i-frame gate
        -- here - each monster's own MonsterAttack timer interval already spaces out its hits.
        local player = self.Entity.PlayerComponent
        if not isvalid(player) then return end
        -- QA finding (2026-08-25, real playtest re-verification): a character left standing in the
        -- field after death (RunEnded=true, but PlayerControllerComponent.Enable=false only blocks
        -- INPUT - the entity is still a valid HitComponent target and monsters keep swinging) kept
        -- taking hits indefinitely, observed dropping to Hp=-8/60 several seconds after the run had
        -- already ended. math.max(0, ...) below floors each individual write, so this must have come
        -- from processing hits the run no longer needs at all - once a run has ended there is nothing
        -- meaningful left to compute (no further death transition, no HIT-state feedback anyone will
        -- see). Short-circuit here so a dead run stops mutating Hp/state entirely instead of relying
        -- on downstream clamps.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if isvalid(statsComp) and statsComp.RunEnded then return end
        -- i-frame gate: ignore a hit that lands within IFrameSeconds of the last one, so several
        -- monsters stacked on the same spot (see the comment on IFrameSeconds above) can't all land
        -- in the same instant. A single attacker's own AttackInterval is always well above
        -- IFrameSeconds, so this never affects normal one-on-one combat pacing.
        local now = _UtilLogic.ElapsedSeconds
        if now - self.LastHitElapsed < self.IFrameSeconds then
            return
        end
        self.LastHitElapsed = now

        -- 2026-09-08 QA 발견 - LUK 2차 스탯(EvasionPercent, RecalculateDerived에서 effLuk*0.002로
        -- 계산됨)이 계산만 되고 실제로는 어디서도 참조되지 않는 "inert" 상태였다(코드 주석에
        -- "inert until a monster-attacks-player pipeline exists"라고 명시돼 있었음 - 이 메서드가
        -- 바로 그 파이프라인). 회피 성공 시 완전 무효(피해 0, 채널 취소·방어막 소모 등 아무 처리도
        -- 없이 즉시 리턴) - LUK 투자가 처음으로 실전에서 의미를 갖게 된다.
        if isvalid(statsComp) and statsComp.EvasionPercent > 0 and _UtilLogic:RandomDouble() < statsComp.EvasionPercent then
            log("PlayerHit: 회피 성공 (EvasionPercent=" .. string.format("%.3f", statsComp.EvasionPercent) .. ")")
            -- 2026-09-12 시스템 업그레이드 - 회피 성공이 지금까지 로그 한 줄 말고는 플레이어에게
            -- 아무 시각적 피드백이 없었다("맞았는데 데미지가 0인지 회피한 건지" 구분 불가). 명중
            -- 실패(PlayerAttack.IsAttackTarget)와 동일한 MISS 텍스트를 자기 머리 위에 띄운다.
            _CombatFeelLogic:ShowMissText(self.Entity, player.UserId)
            return
        end

        -- Interrupts an in-progress battlefield-return channel (Field/BattlefieldReturnLogic) -
        -- taking a hit cancels the "return scroll" so it can't be used to panic-escape a losing
        -- fight risk-free.
        _BattlefieldReturnLogic:CancelChannel("피격")
        local reduction = isvalid(statsComp) and statsComp.DamageReductionPercent or 0
        local dmg = math.floor(event.TotalDamage * (1 - reduction))

        -- 2026-09-08 QA 발견 - 도굴꾼(hb)의 "보스에게 받는 피해 2배" 페널티가 어디에도 구현돼
        -- 있지 않아, 짝을 이루는 보너스(보스 처치 보상 3배, Monster.GrantXpToAttacker)만 사실상
        -- 무비용으로 적용되고 있었다 - 공격자가 보스일 때만 여기서 2배로 적용해 짝을 맞춘다.
        if isvalid(statsComp) and (statsComp.Trait == "도굴꾼" or statsComp.Trait2 == "도굴꾼") and isvalid(event.AttackerEntity) then
            local atkMonster = event.AttackerEntity:GetComponent("script.Monster")
            if isvalid(atkMonster) and atkMonster.IsBoss then
                dmg = dmg * 2
                log("PlayerHit: 도굴꾼 - 보스 피해 2배")
            end
        end

        -- 2026-09-08 QA - 유리몸 링크("안전 확보": 파티 입장 후 첫 피격 무효) 신규 연결. 전장
        -- 진입마다 1회만 소모(CharacterRosterLogic.RequestEnterBattlefield가 리셋).
        if isvalid(statsComp) and statsComp.LinkFirstHitImmuneAvailable and not statsComp.FirstHitImmuneUsedThisVisit then
            statsComp.FirstHitImmuneUsedThisVisit = true
            log("PlayerHit: 유리몸 링크 - 첫 피격 무효")
            return
        end

        -- 2026-09-08 QA - 영혼 포획자 링크("포획 지원": 낮은 확률로 처치 시 파티에게 짧은 무적
        -- 프레임) 신규 연결. Monster.GrantXpToAttacker가 확률을 굴려 만료 시각을 세팅하면, 그
        -- 시간대 동안의 모든 피격을 여기서 전액 무효화.
        if isvalid(statsComp) and _UtilLogic.ElapsedSeconds < statsComp.LinkCaptureInvulnUntilElapsed then
            log("PlayerHit: 영혼 포획자 링크 - 포획 지원 무적 중, 피해 무효")
            return
        end

        -- 2026-09-10 QA - 부활자 링크("재림의 축복": 위기 시 낮은 확률로 짧은 무적) 신규 연결.
        -- PlayerStatsComponent.CombatTick이 위기 감지+확률 굴림을 담당, 여기선 시각 비교만.
        if isvalid(statsComp) and _UtilLogic.ElapsedSeconds < statsComp.LinkLowHpInvulnUntilElapsed then
            log("PlayerHit: 부활자 링크 - 재림의 축복 무적 중, 피해 무효")
            return
        end

        -- 2026-09-10 QA - 환영 교체 링크("잔상 지원": 대시 시 짧은 무적시간) 신규 연결.
        -- PlayerSkillComponent.DoDash가 세팅, 여기선 시각 비교만.
        if isvalid(statsComp) and _UtilLogic.ElapsedSeconds < statsComp.LinkDashInvulnUntilElapsed then
            log("PlayerHit: 환영 교체 링크 - 잔상 지원 무적 중, 피해 무효")
            return
        end

        -- 2026-09-08 QA - 신중함 링크("신중한 조언": 런당 1회 파티 첫 피격 피해 20% 경감) 신규 연결.
        -- 유리몸 링크(전액 무효)와 달리 부분 경감이라 return하지 않고 dmg만 줄여서 계속 진행.
        -- "런당" 1회라 전장 재진입으로는 재사용 불가(FirstHitReductionUsedThisRun은 캐릭터 로드시만 리셋).
        if isvalid(statsComp) and not statsComp.FirstHitReductionUsedThisRun then
            local reductionPct = _TraitEffectEngine:GetLinkFirstHitReduction(statsComp.LinkTrait1)
            if reductionPct == 0 and statsComp.LinkTrait2 ~= "" then reductionPct = _TraitEffectEngine:GetLinkFirstHitReduction(statsComp.LinkTrait2) end
            if reductionPct > 0 then
                statsComp.FirstHitReductionUsedThisRun = true
                dmg = math.floor(dmg * (1 - reductionPct))
                log("PlayerHit: 신중함 링크 - 첫 피격 경감 " .. reductionPct .. ", dmg=" .. dmg)
            end
        end

        -- M2 Phase B 2단계(2026-09-06) - 운명의 동전(coinFlipDefense): 50% 무효/50% 2배, 이후의
        -- 방어막·반사 계산 전부가 이 굴림 이후의 dmg를 기준으로 삼는다.
        -- M2 Phase B(2026-09-08) - Trait2(3차 전직 추가 특성)도 트리거형 효과를 발동할 수 있게
        -- 확장(Trait 우선, 없으면 Trait2 - CombatTick과 동일 원칙, 이하 이 메서드의 나머지 게터도 동일).
        local ownCoinFlip = isvalid(statsComp) and (_TraitEffectEngine:HasCoinFlipDefense(statsComp.Trait) or (statsComp.Trait2 ~= "" and _TraitEffectEngine:HasCoinFlipDefense(statsComp.Trait2)))
        if ownCoinFlip then
            if _UtilLogic:RandomDouble() < 0.5 then
                dmg = 0
                log("PlayerHit: 운명의 동전 - 피해 무효")
            else
                dmg = dmg * 2
                log("PlayerHit: 운명의 동전 - 피해 2배")
            end
        end

        -- 2026-09-10 QA - 운명의 동전 링크("동전의 양면": 파티가 받는 피해 낮은 확률로 무효/2배)
        -- 신규 연결. 본인판이 이미 발동했으면 중복 적용하지 않는다(ownCoinFlip 가드).
        if not ownCoinFlip and isvalid(statsComp) then
            local coinChance = _TraitEffectEngine:GetLinkCoinFlipChance(statsComp.LinkTrait1)
            if coinChance == 0 and statsComp.LinkTrait2 ~= "" then coinChance = _TraitEffectEngine:GetLinkCoinFlipChance(statsComp.LinkTrait2) end
            if coinChance > 0 and _UtilLogic:RandomDouble() < coinChance then
                if _UtilLogic:RandomDouble() < 0.5 then
                    dmg = 0
                    log("PlayerHit: 운명의 동전 링크 - 동전의 양면, 피해 무효")
                else
                    dmg = dmg * 2
                    log("PlayerHit: 운명의 동전 링크 - 동전의 양면, 피해 2배")
                end
            end
        end

        -- 방어막(마나실드/수호자/유리몸/약골) - Hp보다 먼저 소모된다.
        if isvalid(statsComp) and statsComp.ShieldAmount > 0 and dmg > 0 then
            if statsComp.ShieldAmount >= dmg then
                statsComp.ShieldAmount = statsComp.ShieldAmount - dmg
                log("PlayerHit: shield absorbed " .. dmg .. ", remaining=" .. statsComp.ShieldAmount)
                dmg = 0
            else
                dmg = dmg - statsComp.ShieldAmount
                log("PlayerHit: shield absorbed " .. statsComp.ShieldAmount .. ", overflow=" .. dmg)
                statsComp.ShieldAmount = 0
            end
        end

        player.Hp = math.max(0, player.Hp - dmg)

        -- 2026-09-10 QA - KnockbackResistance(STR 파생 2차 스탯)가 지금까지 계산만 되고 실제로
        -- 소비되는 곳이 전혀 없던 "죽은 스탯"이었음을 발견(이 세션 초반의 LUK/EvasionPercent와
        -- 동일 유형의 근본적 QA 발견 - PlayerAttack.mlua 상단 주석에 "applied on the player's own
        -- incoming-hit path once that exists"라고 명시돼 있던 대로, 몬스터가 플레이어를 실제로
        -- 밀쳐내는 넉백 자체가 이 프로젝트에 없어서 저항할 대상 자체가 없었다). 몬스터 접촉 피해가
        -- 실제로 적용된 바로 이 지점에 넉백 임펄스를 신규 추가 - 외골수/무게추 등 kb 채널 특성이
        -- 이제 실제 효과를 갖는다.
        if dmg > 0 and isvalid(event.AttackerEntity) then
            local body = self.Entity.RigidbodyComponent
            local attackerTransform = event.AttackerEntity.TransformComponent
            local selfTransform = self.Entity.TransformComponent
            if isvalid(body) and isvalid(attackerTransform) and isvalid(selfTransform) then
                local dir = (selfTransform.WorldPosition.x >= attackerTransform.WorldPosition.x) and 1 or -1
                local resistance = isvalid(statsComp) and statsComp.KnockbackResistance or 0
                local force = 2.5 * (1 - resistance)
                if force > 0 then
                    body:AddForce(Vector2(dir * force, 0.5))
                    log("PlayerHit: 넉백 적용 force=" .. string.format("%.2f", force) .. " resistance=" .. resistance)
                end
            end
        end

        if isvalid(statsComp) then
            -- 거울 갑옷(mirrorDamage) - 실제로 자신이 받은 최종 피해(dmg)의 비율만큼 공격자에게 반사.
            -- 2026-09-08 QA - 거울 갑옷 링크("반사의 축복": 파티가 받는 근접 피해 일부 반사)도 동일
            -- 소비처에서 합산(본인+링크 두 채널 모두 활성이어도 자연스럽게 더해짐).
            local mirrorPct = _TraitEffectEngine:GetMirrorDamagePct(statsComp.Trait)
            if mirrorPct == 0 and statsComp.Trait2 ~= "" then mirrorPct = _TraitEffectEngine:GetMirrorDamagePct(statsComp.Trait2) end
            mirrorPct = mirrorPct + statsComp.LinkMirrorDamagePct
            if mirrorPct > 0 and dmg > 0 and isvalid(event.AttackerEntity) then
                local atkMonster = event.AttackerEntity:GetComponent("script.Monster")
                if isvalid(atkMonster) then
                    atkMonster:TakeReflectedDamage(math.floor(dmg * mirrorPct))
                    log("PlayerHit: 거울 갑옷 반사 " .. math.floor(dmg * mirrorPct))
                end
            end
            -- 약골/유리몸(shieldOnHit) - 피격 시 확률로 다음 피해를 막을 방어막 생성.
            local shieldOnHit = _TraitEffectEngine:GetShieldOnHit(statsComp.Trait)
            if shieldOnHit == nil and statsComp.Trait2 ~= "" then shieldOnHit = _TraitEffectEngine:GetShieldOnHit(statsComp.Trait2) end
            if shieldOnHit ~= nil and _UtilLogic:RandomDouble() < (shieldOnHit.chance or 0) then
                statsComp.ShieldAmount = math.floor(player.MaxHp * (shieldOnHit.pct or 0))
                log("PlayerHit: shieldOnHit granted amount=" .. statsComp.ShieldAmount)
            end
            -- 적응력/굶주린 살점(hitStackAtk) - 피격마다 공격력 소폭 누적(런 종료까지 유지).
            local hitStack = _TraitEffectEngine:GetHitStackAtk(statsComp.Trait)
            if hitStack == nil and statsComp.Trait2 ~= "" then hitStack = _TraitEffectEngine:GetHitStackAtk(statsComp.Trait2) end
            if hitStack ~= nil then
                statsComp.HitStackAtkPercent = math.min(hitStack.cap or 1.0, statsComp.HitStackAtkPercent + (hitStack.perHit or 0))
                statsComp:RecomputeDynamicAttackDamage()
            end
            -- 2026-09-10 QA - 겁쟁이(bad)의 basicDesc "피격 직후 다음 공격+20%" 본인판이
            -- basicEffect에 없어 페널티(dr=-0.05)만 적용되던 무비용 페널티 버그 신규 수정.
            local onHitBuffOwn = _TraitEffectEngine:GetOwnOnHitBuff(statsComp.Trait)
            if onHitBuffOwn == nil and statsComp.Trait2 ~= "" then onHitBuffOwn = _TraitEffectEngine:GetOwnOnHitBuff(statsComp.Trait2) end
            if onHitBuffOwn ~= nil then
                statsComp.OwnOnHitBuffAtkPercent = onHitBuffOwn.atk or 0.20
                statsComp.OwnOnHitBuffExpireElapsed = _UtilLogic.ElapsedSeconds + (onHitBuffOwn.duration or 3)
                statsComp:RecomputeDynamicAttackDamage()
                log("PlayerHit: 겁쟁이 - 피격 직후 다음 공격 버프 발동")
            end
            -- 2026-09-08 QA - 굶주린 살점 링크("고통 공유": 피격 시 낮은 확률로 짧은 공격력 버프).
            -- 본인판(hitStackAtk, 확정 누적)과 달리 확률 게이트 + 짧은 지속시간 버프라 별도 채널.
            local onHitBuff = _TraitEffectEngine:GetLinkOnHitBuff(statsComp.LinkTrait1)
            if onHitBuff == nil and statsComp.LinkTrait2 ~= "" then onHitBuff = _TraitEffectEngine:GetLinkOnHitBuff(statsComp.LinkTrait2) end
            if onHitBuff ~= nil and _UtilLogic:RandomDouble() < (onHitBuff.chance or 0) then
                statsComp.LinkOnHitBuffAtkPercent = onHitBuff.atk or 0.08
                statsComp.LinkOnHitBuffExpireElapsed = _UtilLogic.ElapsedSeconds + (onHitBuff.duration or 3)
                statsComp:RecomputeDynamicAttackDamage()
                log("PlayerHit: 굶주린 살점 링크 - 고통 공유 발동 atk%=" .. statsComp.LinkOnHitBuffAtkPercent)
            end
        end

        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("HIT") end
        if player.Hp <= 0 then
            -- M2 Phase B(2026-09-06) - 부활자(basicEffect.reviveOnce, 런당 1회) - 치명적 피해를
            -- Hp 1로 버틴다. 죽음 처리(ProcessDead/TriggerRunEnd) 자체를 건너뛴다.
            if isvalid(statsComp) and not statsComp.ReviveUsedThisRun and (_TraitEffectEngine:HasReviveOnce(statsComp.Trait) or (statsComp.Trait2 ~= "" and _TraitEffectEngine:HasReviveOnce(statsComp.Trait2))) then
                statsComp.ReviveUsedThisRun = true
                player.Hp = 1
                log("PlayerHit: 부활자 revive triggered, Hp=1")
                return
            end
            -- 2026-09-08 QA - 순교자 링크("최후의 인연": 런당 1회 사망 시 HP10% 재기) 신규 연결.
            -- 부활자와 동일한 ReviveUsedThisRun을 공유(런당 부활은 출처 무관 총 1회로 제한).
            if isvalid(statsComp) and not statsComp.ReviveUsedThisRun and statsComp.LinkReviveHpPercent > 0 then
                statsComp.ReviveUsedThisRun = true
                player.Hp = math.max(1, math.floor(player.MaxHp * statsComp.LinkReviveHpPercent))
                log("PlayerHit: 순교자 링크 - 최후의 인연 발동, Hp=" .. player.Hp)
                return
            end
            -- 2026-09-10 QA - 시간을 거스르는 자 링크("인연의 메아리": 런당 1회 사망 직전 0.5초
            -- 무적) 신규 연결. 본인판(3초 전 스냅샷 복구)은 여전히 미구현이지만, 링크는 "사망을
            -- 막는다"는 결과만 필요해 부활자/순교자와 동일한 ReviveUsedThisRun 예산을 공유하는
            -- "Hp=1로 버팀" 근사로 구현(런당 부활은 출처 무관 총 1회 제한, 기존 원칙 그대로).
            if isvalid(statsComp) and not statsComp.ReviveUsedThisRun and
               (_TraitEffectEngine:HasLinkDeathPrevent(statsComp.LinkTrait1) or (statsComp.LinkTrait2 ~= "" and _TraitEffectEngine:HasLinkDeathPrevent(statsComp.LinkTrait2))) then
                statsComp.ReviveUsedThisRun = true
                player.Hp = 1
                log("PlayerHit: 시간을 거스르는 자 링크 - 인연의 메아리 발동, Hp=1")
                return
            end
            player:ProcessDead()
            if isvalid(statsComp) then
                statsComp:TriggerRunEnd()
            end
        end
    end

end
