@Logic
script CombatFeelLogic extends Logic

    -- 전투 피드백 연출 모음(2026-09-12, 유저 요청 "시스템 업그레이드, 다른 RPG 모티브 가능") -
    -- Diablo/Path of Exile/Hades류 액션 RPG가 공통으로 쓰는 두 가지 "타격감" 관행을 이 프로젝트의
    -- 전투 파이프라인에 새로 연결한다:
    --   1) 크리티컬 히트 시 짧은 히트스탑+카메라 셰이크 (지금까지 이 프로젝트 어디에도 없던
    --      네이티브 API - _UtilLogic:SetClientTimeScale/CameraComponent:ShakeCamera 둘 다 msw-
    --      combat-system §4 Game Feel에 정의돼 있지만 실제로 쓰인 곳이 없었다).
    --   2) 회피(EvasionPercent)/명중 실패(Accuracy vs Evasion) 시 "MISS" 텍스트 - 네이티브
    --      DamageSkinService:PlayTextDamage가 바로 이 용도(§11-3c)로 존재하는데도 두 판정
    --      지점(PlayerHit의 회피 분기, PlayerAttack.IsAttackTarget의 명중 실패 분기) 모두 그냥
    --      조용히 리턴만 하고 있어 플레이어가 "빗나간 건지 아무 일도 안 일어난 건지" 구분할 수
    --      없었다.
    -- 서버(PlayerAttack/PlayerHit)가 targetUserId를 지정해 호출하는 순수 Client RPC 전용 로직 -
    -- 기존 CharacterRosterLogic.GrantPotionDrop과 동일한 "서버는 판정만, 연출 지시는 클라에
    -- 위임" 패턴을 그대로 재사용(신규 아키텍처 도입 없음).

    property number CritTimeScale = 0.05
    property number CritTimeScaleDuration = 0.06
    property number CritShakeIntensity = 0.35
    property number CritShakeDuration = 0.15
    -- 2026-09-15 버그 수정(유저 리포트 "스킬 사용시 경직 상태 유지가 너무 오래 지속하여 몬스터가
    -- 다가와도 도망칠 수 없음", 치명적으로 리포트됨) - OnAttack은 AttackFast가 한 번에 맞힌 대상마다
    -- 한 번씩 호출된다(공식 문서 §2 "OnAttack(defender)") - 즉 여러 마리를 동시에/연달아 때리는
    -- 스킬(광역 근접, 다단히트, 돌진)에서 크리티컬이 여러 번 겹쳐 뜨면 PlayCritImpact도 그만큼
    -- 반복 호출된다. 이 메서드는 SetClientTimeScale(0.05)로 "OnUpdate에 전달되는 deltaTime 자체를
    -- 줄인다"(공식 문서) - 즉 카메라 셰이크(PlayKillImpact, 아래)처럼 화면만 흔들리는 연출이 아니라
    -- 공격자 자신의 로컬 이동 처리 속도를 실제로 20배 늦춘다. 쿨다운 게이트가 없어서 여러 마리를
    -- 같은 스윙/연속 히트로 크리티컬 낼 때마다 계속 재발동되며, 매 히트마다 반복되는 0.06초 슬로우가
    -- 사실상 끊이지 않고 이어져 "몬스터는 정상 속도로 다가오는데 나는 슬로우 상태에 갇힌" 체감을
    -- 만든다 - 처치 셰이크 중복 버그(PlayKillImpact, 아래)와 동일한 "짧은 시간 내 중복 트리거"
    -- 문제라 같은 쿨다운 게이트 패턴을 재사용.
    property number CritImpactCooldownSeconds = 0.15
    @HideFromInspector property number LastCritImpactTime = -999
    property string MissSkinRuid = "02c22d93421b4038b3c413b3e40b57ec"
    -- 2026-09-12 추가 업그레이드 - 처치 임팩트(킬 피드백, RoR2/Hades류 관행). 크리 임팩트보다
    -- 약한 셰이크(처치는 크리보다 훨씬 자주 일어나므로 화면이 계속 흔들리면 오히려 방해가 된다),
    -- 보스 처치는 살짝 더 크게.
    property number KillShakeIntensity = 0.25
    property number KillShakeDuration = 0.12
    property number BossKillShakeIntensity = 0.9
    property number BossKillShakeDuration = 0.4
    -- 2026-09-15 버그 수정(유저 리포트 "몬스터 처치 시 캐릭터가 잠시 움직이지 않는 것처럼 보임") -
    -- PlayerAttack의 한 번의 AttackFast 스윙이 겹쳐 있는 몬스터 여러 마리를 동시에 처치할 수 있다
    -- (실측: maker_execute_script로 폭 4칸 박스 공격 1회에 몬스터 6마리 동시 처치 확인). 처치마다
    -- Monster.HandleHitEvent -> PlayKillImpact가 개별 호출되면서 같은 프레임에 ShakeCamera가
    -- 여러 번 겹쳐 걸린다 - 매번 새 셰이크가 재시작되며 화면이 계속 흔들리는 상태가 이어져, 실제로는
    -- 캐릭터가 정상 이동 중이어도 카메라가 한자리에서 떠는 것처럼 보여 "움직이지 않는 것" 같은
    -- 착시를 만든다. 크리티컬 히트스탑(위 CritTimeScale)과 동일한 부류의 "짧은 시간 내 중복 트리거"
    -- 문제라, 같은 해결 패턴(쿨다운 게이트)을 재사용 - 이 짧은 윈도우 안의 후속 처치는 셰이크를
    -- 생략(파티클/XP 등 나머지 처치 피드백은 그대로 유지, 카메라 연출만 1회로 묶는다).
    property number KillShakeCooldownSeconds = 0.15
    @HideFromInspector property number LastKillShakeTime = -999
    -- 2026-09-12 추가 업그레이드 - 피격 플래시(Zelda/Hollow Knight류 관행). 지속시간을 i-frame
    -- (PlayerHit.IFrameSeconds=0.5)보다 훨씬 짧게 잡아 같은 피격 안에서 여러 색이 겹치지 않게 한다.
    property number HitFlashDuration = 0.12
    -- 2026-09-12 추가 업그레이드(인벤토리/장비 쪽) - 물약 회복 숫자. msw-combat-system §11-3b가
    -- 정확히 이 용도로 문서화해둔 네이티브 Heal 데미지스킨인데도 `RequestUsePotion`이 회복만 하고
    -- 화면엔 log() 말고 아무 표시가 없었다.
    property string HealSkinRuid = "d58b67cf0f3a4eaf9fe1ad87c0ffac8a"

    @ExecSpace("Client")
    method void PlayCritImpact()
        -- 크리티컬 히트 발생 시 아주 짧은(0.06초) 히트스탑 + 카메라 셰이크로 타격감을 강조한다.
        -- SetClientTimeScale은 "방(room) 이동 시 자동으로 1로 리셋"이 엔진 기본 동작이라 타이머
        -- 콜백이 못 돌아도(맵 전환 등) 값이 영구히 낮게 고정될 위험은 없다 - 그래도 정상 흐름에서는
        -- 타이머로 명시 복원한다.
        -- 위 CritImpactCooldownSeconds 주석 참고 - 여러 대상을 동시/연속으로 크리티컬 낼 때 매번
        -- 재발동하지 않도록 쿨다운 게이트.
        if _UtilLogic.ElapsedSeconds - self.LastCritImpactTime < self.CritImpactCooldownSeconds then
            return
        end
        self.LastCritImpactTime = _UtilLogic.ElapsedSeconds
        log("CombatFeel: 크리티컬 임팩트 발동 (timeScale=" .. self.CritTimeScale .. ")")
        _UtilLogic:SetClientTimeScale(self.CritTimeScale)
        -- 2026-09-15 버그 수정(유저 리포트 "크리 시 게임이 멈춘 것처럼 보임") - TimerService는
        -- "클라이언트 환경 스크립트에서 실행되면 TimeScale의 영향을 받는다"(공식 문서, Adjusting the
        -- TimeScale of the Client) - 이 복원 타이머 자체가 지금 막 걸어놓은 0.05배속 위에서 돌고
        -- 있었다. 그래서 의도한 0.06초가 아니라 실제로는 0.06 / 0.05 = 1.2초(20배)나 걸려 "짧은
        -- 히트스탑"이 아니라 눈에 띄는 정지처럼 느껴졌던 것 - 실측(로그 타임스탬프)으로 재현 확인.
        -- 고정: 타이머에 넘기는 지연시간 자체를 CritTimeScale만큼 미리 줄여서 보정한다 - 스케일된
        -- 시간 X초가 실제로는 X/CritTimeScale초 걸리므로, 원하는 실제 시간(CritTimeScaleDuration)이
        -- 되려면 X = CritTimeScaleDuration * CritTimeScale을 넘겨야 한다(공식 문서의 "timescale 2일
        -- 때 wait(10)이 실제 5초 걸림" 예제와 동일한 비례 관계).
        _TimerService:SetTimerOnce(function()
            _UtilLogic:SetClientTimeScale(1.0)
            log("CombatFeel: 타임스케일 복원")
        end, self.CritTimeScaleDuration * self.CritTimeScale)
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then
            cam:ShakeCamera(self.CritShakeIntensity, self.CritShakeDuration)
        end
    end

    @ExecSpace("Client")
    method void ShowMissText(Entity target)
        -- 회피 성공(PlayerHit) 또는 명중 실패(PlayerAttack.IsAttackTarget) 시 대상 머리 위에
        -- "MISS" 텍스트를 띄운다. 네이티브 DamageSkinTextType.Miss 프리셋 재사용(신규 스킨 불필요).
        if not isvalid(target) then return end
        log("CombatFeel: MISS 텍스트 표시")
        _DamageSkinService:PlayTextDamage(target, self.MissSkinRuid, DamageSkinTextType.Miss, DamageSkinTweenType.Default)
    end

    @ExecSpace("Client")
    method void FlashPlayerHit(Entity target)
        -- 몬스터 접촉 피해를 실제로 받았을 때(방어막 등으로 완전 흡수되지 않은 경우만) 아바타를
        -- 짧게 붉게 물들여 "맞았다"는 즉각적인 시각 피드백을 준다(Zelda/Hollow Knight류 액션 게임
        -- 관행). SpriteRendererComponent.Color는 아바타 엔티티에서 무시되므로(msw-avatar 문서 -
        -- 아바타 렌더러가 스프라이트 렌더러 출력을 덮어씀) 반드시 AvatarRendererComponent:SetColor를
        -- 써야 한다.
        if not isvalid(target) then return end
        local renderer = target.AvatarRendererComponent
        if not isvalid(renderer) then return end
        log("CombatFeel: 피격 플래시")
        renderer:SetColor(1.0, 0.3, 0.3, 1.0)
        _TimerService:SetTimerOnce(function()
            if isvalid(renderer) then
                renderer:SetColor(1.0, 1.0, 1.0, 1.0)
            end
        end, self.HitFlashDuration)
    end

    @ExecSpace("Client")
    method void PlayKillImpact(boolean isBossKill)
        -- 몬스터 처치 순간 처치자 클라이언트에게만 짧은 카메라 셰이크를 준다(처치 파티클 자체는
        -- Monster.HandleHitEvent가 ServerOnly에서 직접 _ParticleService로 재생 - 모든 클라이언트에
        -- 보여야 하는 월드 이펙트라 굳이 개별 RPC 불필요, 여기서는 "손맛" 담당인 카메라 셰이크만).
        if _UtilLogic.ElapsedSeconds - self.LastKillShakeTime < self.KillShakeCooldownSeconds then
            return
        end
        self.LastKillShakeTime = _UtilLogic.ElapsedSeconds
        local intensity = isBossKill and self.BossKillShakeIntensity or self.KillShakeIntensity
        local duration = isBossKill and self.BossKillShakeDuration or self.KillShakeDuration
        log("CombatFeel: 처치 임팩트 발동 (boss=" .. tostring(isBossKill) .. ")")
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then
            cam:ShakeCamera(intensity, duration)
        end
    end

    @ExecSpace("Client")
    method void PlayHealNumber(Entity target, integer amount)
        -- 물약 사용(PlayerStatsComponent.RequestUsePotion) 시 회복량을 초록 숫자로 띄운다 - msw-
        -- combat-system §11-3b 권장 패턴 그대로(네이티브 Heal 데미지스킨 RUID, 신규 스킨 불필요).
        if not isvalid(target) or amount <= 0 then return end
        log("CombatFeel: 회복 숫자 표시 amount=" .. amount)
        _DamageSkinService:Play(target, self.HealSkinRuid, 0, { amount }, DamageSkinTweenType.Default, false, Vector2(0, 0.5), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
    end

end
