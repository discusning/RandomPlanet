    @ExecSpace("Server")
    method void RequestUsePotion(string potionId)
        -- 물약 사용 (M2 Phase A, 2026-09-06 - 전체 기획서 §3-3 / 2026-09-15 HP+MP 확장). 인벤토리
        -- 자체는 ClientOnly라 아이템 소모는 EquipmentLogic.UsePotionAtIndex가 이미 처리했고(클릭/
        -- 단축키 시점에 버서크 특성도 한 번 걸러짐), 여기서는 실제 HP/MP 회복(서버 권한 필요)만
        -- 담당 - 이중 방어로 버서크를 한 번 더 검사(클라이언트 우회로 이 RPC만 직접 호출해도 회복은
        -- 막힘, 다만 이미 소모된 물약 자체는 이 프로젝트의 다른 인벤토리 조작(장비/주문서)과 동일하게
        -- 클라이언트 신뢰 기반이라 되돌리지 않음 - 솔로 PvE라 악용 실익이 없다고 판단).
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if self.Trait == "버서크" or self.Trait2 == "버서크" or _TraitEffectEngine:IsPotionBlocked(self.Trait) or (self.Trait2 ~= "" and _TraitEffectEngine:IsPotionBlocked(self.Trait2)) then
            log("PlayerStats: RequestUsePotion rejected - " .. self.Trait .. "/" .. self.Trait2 .. " 특성")
            return
        end
        -- 2026-09-15 - restorePercent를 EquipmentLogic의 물약 템플릿에서 직접 읽도록 변경(이전엔
        -- 여기 0.3이 하드코딩돼 있어 EquipmentLogic.GetPotionTemplate의 값과 별개로 관리되던 중복
        -- 이었음). potionId로 HP/MP 어느 쪽인지 분기.
        local tpl = _EquipmentLogic:GetPotionTemplate(potionId)
        if tpl == nil then return end
        local player = self.Entity.PlayerComponent
        if not isvalid(player) then return end
        -- M2 Phase B - 먹보를 포함한 potionMult 계열 전부 TraitCatalog/TraitEffectEngine 경유(먹보의
        -- 예전 하드코딩 x1.5는 여기서 제거 - basicEffect={potionMult=0.5}로 동일 수치 이전, 중복 적용 방지).
        -- M2 Phase C(2026-09-06) - Trait2(3차 전직 추가 특성)와 링크 패시브(LinkPotionMultBonus)의
        -- potionMult도 함께 합산(기존엔 self.Trait만 읽어 Trait2/링크 쪽 회복 보너스가 누락돼 있었음).
        local trait2Mult = (self.Trait2 ~= "") and _TraitEffectEngine:GetPotionEffectMult(self.Trait2) or 0
        local restorePercent = tpl.restorePercent * (1 + _TraitEffectEngine:GetPotionEffectMult(self.Trait) + trait2Mult + self.LinkPotionMultBonus)

        if tpl.restoreType == "hp" then
            if player.MaxHp <= 0 then return end
            local healAmount = math.floor(player.MaxHp * restorePercent)
            local before = player.Hp
            player.Hp = math.min(player.MaxHp, player.Hp + healAmount)
            local actualHealed = player.Hp - before
            log("PlayerStats: RequestUsePotion(hp) healed " .. actualHealed .. " -> Hp=" .. player.Hp .. "/" .. player.MaxHp)
            -- 2026-09-12 시스템 업그레이드(인벤토리/장비) - 지금까지 물약 회복이 log()에만 찍히고
            -- 화면엔 HP 바가 조용히 늘어나는 것 말고 아무 숫자 표시가 없었다.
            _CombatFeelLogic:PlayHealNumber(self.Entity, actualHealed, player.UserId)
        elseif tpl.restoreType == "mp" then
            if self.MaxMp <= 0 then return end
            local restoreAmount = math.floor(self.MaxMp * restorePercent)
            local before = self.CurrentMp
            self.CurrentMp = math.min(self.MaxMp, self.CurrentMp + restoreAmount)
            local actualRestored = self.CurrentMp - before
            log("PlayerStats: RequestUsePotion(mp) restored " .. actualRestored .. " -> Mp=" .. self.CurrentMp .. "/" .. self.MaxMp)
            _CombatFeelLogic:PlayHealNumber(self.Entity, actualRestored, player.UserId)
        end
    end

    @ExecSpace("Server")
    method void UpdateSquadLinks(table links)
        -- M2 Phase C(2026-09-06) - CharacterRosterLogic:PushSquadLinksToServer()가 공격대 편성 확정
        -- 직후 및 캐릭터 진입/교체 직후 호출. links = 최대 2개의 { trait, level } (로스터가 ClientOnly라
        -- 서버는 이 호출 없이는 누가 링크인지 전혀 알 수 없다). 15레벨 미만은 서버에서도 한 번 더
        -- 방어적으로 걸러낸다(클라이언트가 이미 걸러 보내지만 이중 방어 - 이 프로젝트의 다른 서버
        -- RPC들과 동일한 신뢰 경계 정책, RequestUsePotion 참고). 동일 특성 중복 링크는 부록 D 규칙대로
        -- 1개만 인정.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        self.LinkTrait1 = ""
        self.LinkLevel1 = 0
        self.LinkTrait2 = ""
        self.LinkLevel2 = 0
        if links ~= nil then
            for _, link in ipairs(links) do
                if link.level >= 15 and link.trait ~= "" then
                    if self.LinkTrait1 == "" then
                        self.LinkTrait1 = link.trait
                        self.LinkLevel1 = link.level
                    elseif self.LinkTrait2 == "" and link.trait ~= self.LinkTrait1 then
                        self.LinkTrait2 = link.trait
                        self.LinkLevel2 = link.level
                    end
                end
            end
        end
        log("PlayerStats: UpdateSquadLinks link1=" .. self.LinkTrait1 .. "(Lv." .. self.LinkLevel1 .. ") link2=" .. self.LinkTrait2 .. "(Lv." .. self.LinkLevel2 .. ")")
        self:RecalculateDerived(true)

        -- 마나실드 링크(shieldGrantPct) - "판 시작 시 1회성 소형 방어막". 스쿼드가 재편성돼 이 메서드가
        -- 다시 불려도 런당 1회만 지급(LinkShieldGrantUsedThisRun 가드).
        if not self.LinkShieldGrantUsedThisRun then
            local grantPct = _TraitEffectEngine:GetLinkShieldGrant(self.LinkTrait1)
            if grantPct == 0 and self.LinkTrait2 ~= "" then grantPct = _TraitEffectEngine:GetLinkShieldGrant(self.LinkTrait2) end
            if grantPct > 0 then
                local player = self.Entity.PlayerComponent
                if isvalid(player) and player.MaxHp > 0 then
                    self.LinkShieldGrantUsedThisRun = true
                    self.ShieldAmount = math.floor(player.MaxHp * grantPct)
                    log("PlayerStats: 마나실드 링크 - 방어막 나눔 발동 amount=" .. self.ShieldAmount)
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void ShiftTimers(number stopStartElapsed, number duration)
        -- 2026-09-22 타임 스톱(TimeStopLogic.Thaw) - 절대 시각(ElapsedSeconds)에 묶인 버프/무적 종료
        -- 시각을 멈춘 시간만큼 뒤로 밀어, 정지 중에 만료되지 않고 정지 직전 남은 시간 그대로 이어지게
        -- 한다. 정지 시작 시점에 아직 유효했던(시각 > stopStartElapsed) 값만 민다 - 이미 만료됐거나
        -- 비활성(0)인 값은 그대로 둬야 다시 살아나지 않는다. 런 시작 시각은 항상 밀어 생존 시간에
        -- 정지 시간이 포함되지 않게 한다.
        if duration <= 0 then return end
        self.RunStartElapsed = self.RunStartElapsed + duration
        local function shift(current)
            if current > stopStartElapsed then
                return current + duration
            end
            return current
        end
        self.BurstExpireElapsed = shift(self.BurstExpireElapsed)
        self.LinkMasterBuffExpireElapsed = shift(self.LinkMasterBuffExpireElapsed)
        self.OwnOnHitBuffExpireElapsed = shift(self.OwnOnHitBuffExpireElapsed)
        self.LinkOnHitBuffExpireElapsed = shift(self.LinkOnHitBuffExpireElapsed)
        self.LinkPeriodicBuffExpireElapsed = shift(self.LinkPeriodicBuffExpireElapsed)
        self.LinkCaptureInvulnUntilElapsed = shift(self.LinkCaptureInvulnUntilElapsed)
        self.LinkLowHpInvulnUntilElapsed = shift(self.LinkLowHpInvulnUntilElapsed)
        self.LinkLowHpInvulnCooldownUntilElapsed = shift(self.LinkLowHpInvulnCooldownUntilElapsed)
        self.LinkDashInvulnUntilElapsed = shift(self.LinkDashInvulnUntilElapsed)
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Fires once RunEnded finishes syncing to this client - only ever true for the local player's
        -- own entity (nobody else's PlayerStatsComponent is relevant to this client's UI). RunEnded is
        -- written server-side LAST (after EndedLevel/EndedKillCount/EndedSurvivalSeconds - see
        -- TriggerRunEnd), but each @Sync property replicates independently and arrival order on the
        -- client is not guaranteed to match write order - reading the Ended* fields in this same tick
        -- caught them still at their pre-sync defaults (0/0/0.0) in testing, the same class of
        -- same-tick @Sync visibility artifact already documented elsewhere in this project (see
        -- Archive/As-built.md 11차 세션 Gotchas). A short deferred read gives the sibling syncs time to
        -- land first.
        if name == "RunEnded" and value == true then
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) then return end
                _EndingUIController:ShowEnding(self.EndedLevel, self.EndedKillCount, self.EndedSurvivalSeconds, self.EndedWaveReached, self.EndedFieldCleared)
                _BestRecordLogic:RequestSubmitRun(self.EndedLevel, self.EndedKillCount, self.EndedSurvivalSeconds)
            end, 0.1)
        elseif name == "AbilityChoicePending" and value == true then
            -- 같은 이유(위 RunEnded 주석 참고)로 형제 @Sync 필드(PendingTraitPreview)가 아직
            -- 도착 전일 수 있어 한 틱 늦춰 읽는다.
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) then return end
                _AbilityChoiceUIController:ShowChoice(self.Trait, self.PendingTraitPreview, self.Trait2)
            end, 0.1)
        elseif name == "TimeStopped" then
            -- 2026-09-22 타임 스톱 - 서버가 이능/스킬 선택 중 게임 시간을 멈추거나 푼 것을 로컬 입력
            -- 잠금/해제로 반영(본인 캐릭터만).
            if isvalid(_UserService.LocalPlayer) and self.Entity == _UserService.LocalPlayer then
                _TimeStopLogic:OnTimeStopChanged(value == true)
            end
        elseif name == "Level" then
            -- M2 Phase C(2026-09-06) - 버그 수정: 로스터의 캐릭터별 level 필드가 생성 시점(1) 이후
            -- 전혀 갱신되지 않아(As-built 기존 기록 - 재입장/스왑 시 레벨업분 소실), 링크 캐릭터의
            -- "15레벨 이상" 조건이 실질적으로 영원히 충족 불가능했다. 레벨업마다 로스터에 즉시
            -- 반영해 이 조건이 실제로 동작하게 한다.
            _CharacterRosterLogic:UpdateActiveLevel(value)
        elseif name == "Str" or name == "Dex" or name == "Intel" or name == "Luk" then
            -- 2026-09-24 유저 QA "추가 스탯 찍을 때 어떤 스탯이 올랐는지 안 보임" - 레벨업 자동
            -- +1x4(LevelProgressionLogic.GrantXp), 이능 "추가 스탯"(AbilityChoiceLogic.ApplyBonusStats),
            -- 고급 스탯 구슬(AbilityChoiceLogic.GrantPremiumStatBonus) 모두 이 4개 필드를 직접
            -- 바꾸는 공통 경로라 여기 한 곳에서만 감지하면 모든 소스를 자동으로 커버한다. Str/Dex/
            -- Intel/Luk은 각각 독립된 @Sync라 같은 프레임에 4개가 동시에 바뀌어도 OnSyncProperty는
            -- 4번 따로 불린다 - 위 RunEnded/AbilityChoicePending과 동일한 "같은 틱 @Sync 지연" 대응
            -- 패턴으로, 마지막 도착 후 0.15초 debounce로 묶어서 한 번만 알림을 띄운다.
            if self._T.statGainTimerId then
                _TimerService:ClearTimer(self._T.statGainTimerId)
            end
            self._T.statGainTimerId = _TimerService:SetTimerOnce(self.ShowStatGainDelta, 0.15)
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowStatGainDelta()
        -- 위 OnSyncProperty debounce 타이머의 콜백 - Str/Dex/Intel/Luk 각각을 마지막으로 알림을
        -- 띄운 값(lastNotified*)과 비교해 오른 스탯만 "STR +1" 형태로 모아 PlayerHUDController에
        -- 전달한다. 다른 플레이어의 PlayerStatsComponent도 @Sync를 받으므로(본인 소유가 아닌 엔티티도
        -- 이 콜백을 탈 수 있음) 로컬 플레이어 소유 엔티티가 아니면 무시한다. 캐시가 비어있는 최초
        -- 도착(캐릭터 진입 시 초기값 세팅)은 델타 계산 없이 baseline만 저장 - 진입하자마자 "+1"이
        -- 뜨는 오탐을 막는다. 스탯 재분배(ApplyStatRedistribute)처럼 오르는 스탯과 내려가는 스탯이
        -- 섞여도 오른 스탯만 그대로 표시 - 사용자에게 유의미한 정보라 굳이 필터링하지 않는다.
        if not isvalid(self.Entity) then return end
        if not isvalid(_UserService.LocalPlayer) or self.Entity ~= _UserService.LocalPlayer then return end
        local parts = {}
        local lastStr = self._T.lastNotifiedStr
        if lastStr ~= nil and self.Str > lastStr then
            table.insert(parts, "STR +" .. tostring(self.Str - lastStr))
        end
        self._T.lastNotifiedStr = self.Str
        local lastDex = self._T.lastNotifiedDex
        if lastDex ~= nil and self.Dex > lastDex then
            table.insert(parts, "DEX +" .. tostring(self.Dex - lastDex))
        end
        self._T.lastNotifiedDex = self.Dex
        local lastIntel = self._T.lastNotifiedIntel
        if lastIntel ~= nil and self.Intel > lastIntel then
            table.insert(parts, "INT +" .. tostring(self.Intel - lastIntel))
        end
        self._T.lastNotifiedIntel = self.Intel
        local lastLuk = self._T.lastNotifiedLuk
        if lastLuk ~= nil and self.Luk > lastLuk then
            table.insert(parts, "LUK +" .. tostring(self.Luk - lastLuk))
        end
        self._T.lastNotifiedLuk = self.Luk
        if #parts == 0 then return end
        log("PlayerStats: ShowStatGainDelta -> " .. table.concat(parts, " · "))
        _PlayerHUDController:ShowStatGainNotification(table.concat(parts, " · "))
    end

    method integer ComputeXpToNextLevel(integer level)
        -- M2 Phase I(2026-09-08) - MVP 선형 램프를 전체 기획서 §8-3의 1~21레벨 경험치 테이블로 교체.
        -- §8-3 원안은 "구 타깃 플레이타임(10~20분) 기준"이라고 명시돼 있고, 부록 '플레이타임 재조정'
        -- 항목이 신규 타깃(1시간)에 맞춘 전면 재산정을 요구한다. 실제 라이브 플레이테스트로 정확한
        -- 배율을 확정할 방법이 이번 세션엔 없어서(1시간짜리 실측 런은 비현실적), 원안 표의 1~14
        -- "완만한 증가"/15~21 "레벨당 1.6~1.9배 급증" 곡선 형태는 그대로 유지한 채 총량만 ×4(구
        -- 타깃 10~20분의 중간값 15분 -> 신규 타깃 60분과 동일 비율)로 스케일링했다 - 이 배율 자체는
        -- **미검증**이며, 실제 플레이 템포를 보고 사용자가 재조정할 것을 권장(원안 §8 서두 "베이스라인
        -- - 플레이테스트 후 조정"과 동일한 성격의 근사치).
        -- 2026-09-15 버그 수정(유저 리포트 "몬스터를 꽤 잡았는데도 레벨업이 안 됨") - 실측(실제
        -- 활성 캐릭터로 라이브 확인): 레벨1 캐릭터의 XpToNextLevel이 4000으로 계산됨을 확인. 원본
        -- Docs/.../data/exp_table.json을 대조한 결과 원안 자체가 level 1의 expToNext를 1000으로
        -- 잡아놓았는데(×4 스케일링 후 4000), 이는 바로 다음 레벨(180, ×4=720)보다 약 5.5배나 높아
        -- "완만한 증가" 곡선 형태(2->3->4->5가 180->300->460->680로 매끄럽게 증가)와 명백히 어긋나는
        -- 이상치였다. 몬스터 처치당 기본 XpReward=20 기준, 전장1 웨이브 1~5를 전부 클리어해도
        -- (BaseKillTarget 6+8+10+12+14=50마리 + 미니보스) 약 1000~1250 XP 정도만 나와, 4000이 필요한
        -- 1레벨->2레벨 승급 자체가 정상적인 단일 플레이 세션으로는 사실상 도달 불가능했다(실측으로도
        -- 정확히 이 값을 재현 확인). 1차 수정으로 "완만한 증가" 곡선을 2번 레벨(720)보다 낮게
        -- 유지하도록 동일한 배수 패턴(약 1.5~1.7배씩 증가)을 역산해 480으로 조정 - 몬스터 24마리
        -- 처치(웨이브 1~2 이내)면 첫 레벨업이 가능해짐을 실측 확인.
        -- 2026-09-15 2차 조정(유저 요청 "경험치 수치 좀 더 완만하게") - 1차 수정 이후에도 2번 이후
        -- 레벨(720/1200/1840...)이 전장 한 판(~1000~1250 XP)만으로는 2~3레벨을 넘기기 빠듯해 여전히
        -- 더딘 편이었다. 원안 전체(1~14레벨, "완만한 증가" 구간)에 적용했던 ×4 스케일링을 ×2로
        -- 낮춰 전 구간을 절반으로 줄인다(15~21레벨 "급증" 구간은 계정 영구 강화로 해금하는 의도된
        -- 엔드게임 게이트라 이번 조정 범위에서 제외 - ComputeUnlockedMaxLevel 주석 참고). 1번 레벨은
        -- 기존과 동일하게 2번 레벨(이번엔 360)보다 낮게 유지하는 원칙으로 240 재조정. 결과: 전장
        -- 한 판이면 2~3레벨, 두세 판이면 4~5레벨까지 자연스럽게 도달 가능해져 "완만한 증가"라는
        -- 원안 의도에 실제 플레이 템포가 더 가까워진다.
        local xpTable = {
            [1] = 240, [2] = 360, [3] = 600, [4] = 920, [5] = 1360,
            [6] = 1900, [7] = 2560, [8] = 3360, [9] = 4300, [10] = 5400,
            [11] = 6700, [12] = 8200, [13] = 10000, [14] = 12200, [15] = 41600,
            [16] = 72000, [17] = 124000, [18] = 220000, [19] = 396000, [20] = 752000,
        }
        return xpTable[level] or xpTable[20]
    end

    method integer ComputeUnlockedMaxLevel(integer upgradeLevel)
        -- M2 Phase I - §8-3 "16~21레벨: 해금 조건 필요"는 원안 부록 '미결 항목'에 "각 레벨별 조건
        -- 별도 설계 예정"으로 남아있던 항목이라, 이번 세션에서 자체 설계로 확정한다: 새 시스템을
        -- 만드는 대신 이미 있는 계정 영구 강화 트랙(AccountCurrencyLogic, 0~10레벨)에 자연스럽게
        -- 연결 - 강화 5~10레벨이 순서대로 16~21레벨 해금을 담당(강화 10 = 만렙 21 해금). 강화
        -- 0~4레벨 구간은 기본 캡 15(§8-3의 "완만한 증가" 구간이 끝나는 지점)로 고정.
        return math.min(21, 15 + math.max(0, upgradeLevel - 4))
    end

    @ExecSpace("ServerOnly")
    method void RecalculateDerived(boolean resetHp)
        -- Pushes the current base stats into the real combat-facing components/properties, following
        -- Docs/랜덤 플래닛 전체 기획서.md §8-1's official per-point coefficients. Called on every stat
        -- change (initial apply, level-up) so nothing else needs to poll for changes.
        -- 2026-09-15 - resetHp 파라미터 신규 추가(RefreshEquipmentStats 도입 계기). 기존 호출부(진입/
        -- 레벨업/공격대 확정 등, 모두 true로 전달)는 MaxHp 재계산과 함께 항상 풀피 회복까지 했는데,
        -- 이제 장비 착용/해제만으로도 이 메서드가 불리게 되면서 "장비만 바꿔도 공짜로 풀피 회복"되는
        -- 부작용이 생긴다 - resetHp=false로 그 회복 스텝만 건너뛴다(MaxHp 자체는 항상 갱신, 어차피
        -- 현재 공식상 레벨에만 의존해 장비 변경으로는 바뀌지 않는다).
        local player = self.Entity.PlayerComponent
        if isvalid(player) then
            local maxHp = 50 + self.Level * 10
            player.MaxHp = maxHp
            if resetHp then
                player.Hp = maxHp
            end
        end

        -- 균형(1차 특성) - 4스탯 전부 +1, self.Str 등 원본은 건드리지 않고(장비 보너스 표기 로직과
        -- 충돌 방지) 아래 파생 공식에만 로컬 변수로 흘려보낸다 - 공격력/크리/명중/공속/이동속도까지
        -- 전부 자연히 함께 오르는 실제 "시너지"(단일 수치가 아니라 캐릭터 전체 파생 스탯에 전파).
        local traitStatBonus = (self.Trait == "균형" or self.Trait2 == "균형") and 1 or 0
        local effStr = self.Str + traitStatBonus
        local effDex = self.Dex + traitStatBonus
        local effInt = self.Intel + traitStatBonus
        local effLuk = self.Luk + traitStatBonus

        -- 스피드스터(speedster) - 2026-09-08 QA 스윕에서 게터/소비처 없이 데이터만 있던 갭으로 발견.
        -- "힘/지능 계수 -70%, 대신 이동속도 계수 2.5배 + 이동속도 초과분 10%p당 공격력·스킬데미지+6%
        -- (상한+90%)" - 원안 수치 그대로, 다만 "이동속도 초과분"의 기준선(무엇 대비 초과인가)이 원안에
        -- 명시돼 있지 않아 "이 트레잇이 없었다면의 DEX 공식값" 대비 초과율로 근사했다(아래 이동속도
        -- 블록 참고) - 자체 해석, 미검증 근사치.
        local isSpeedster = (self.Trait == "스피드스터" or self.Trait2 == "스피드스터")
        if isSpeedster then
            effStr = effStr * 0.3
            effInt = effInt * 0.3
        end

        -- INT primary: 최대 MP +3/pt (real resource). Skill damage bonus is inert until Phase 3.
        self.MaxMp = 20 + effInt * 3
        self.CurrentMp = self.MaxMp
        self.SkillDamageBonus = effInt * 0.015
        -- INT secondary: 스킬 쿨다운 감소 - inert until Phase 3 (no skill system yet).
        self.SkillCooldownReduction = math.min(0.5, effInt * 0.01)
        -- STR secondary: 넉백 저항 - inert until a monster-attacks-player pipeline exists.
        self.KnockbackResistance = math.min(0.8, effStr * 0.02)
        -- LUK secondary: 회피 +0.2%/pt - inert until a monster-attacks-player pipeline exists.
        self.EvasionPercent = effLuk * 0.002

        -- 단단함(1차 특성) - 방어력 소폭 증가. 데미지 경감은 `PlayerHit.HandleHitEvent`가 실제로
        -- 소비하고, CP 산식(CharacterInfoUIController)에도 배율로 함께 반영된다.
        self.DamageReductionPercent = (self.Trait == "단단함" or self.Trait2 == "단단함") and 0.12 or 0
        -- 버서크 보너스는 여기서 0으로 리셋 - 버서크가 아니면 BerserkTick 타이머가 애초에 돌지
        -- 않으므로(UpdateBerserkZoneState) 특성을 바꾼(캐릭터 교체) 경우에도 이전 보정이 남지 않는다.
        self.BerserkDamageBonusPercent = 0
        -- M2 Phase B 범용 채널도 매번 리셋 후 아래 엔진 호출이 다시 채운다(특성 변경 시 이전 값이
        -- 남지 않도록 - 위 버서크 리셋과 동일한 이유).
        self.MpCostMultiplier = 0
        self.DropRateMultiplier = 0
        self.ExpMultiplier = 0
        self.GateTicketChanceBonus = 0

        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(attack) then
            -- STR primary: 물리 공격력. 기획서 원안은 +2/pt이지만, STR이 캡 없는 선형 증가인 반면
            -- DEX(공격속도, 상한+100%)/LUK(크리확률, 상한60%)는 %기반+상한이 있어 몰빵 시 순수 DPS가
            -- 2.8~3배까지 벌어짐(실측 2026-08-06) - 사용자 결정에 따라 +1.5/pt로 소폭 완화.
            attack.AttackDamage = 10 + effStr * 1.5
            self.BaseAttackDamage = attack.AttackDamage
            -- LUK primary: 크리 확률 +0.3%/pt (상한 60%), 크리 데미지 +0.5%/pt.
            attack.CriticalChance = math.min(0.6, 0.05 + effLuk * 0.003)
            attack.CritDamageMultiplier = math.min(3.0, 1.5 + effLuk * 0.005)
            -- DEX primary: 공격 속도 +0.5%/pt (상한 +100%) -> cooldown shrinks proportionally.
            local attackSpeedBonus = math.min(1.0, effDex * 0.005)
            attack.AttackCooldownSeconds = 0.6 / (1 + attackSpeedBonus)
            -- DEX primary: 명중 +1/pt.
            attack.Accuracy = 90 + effDex * 1
        end

        -- DEX secondary: 이동 속도 (no official per-point number in the design doc - tuned value).
        -- Base lowered 3.0->1.5 (2026-08-16, user request: engine default is 1.0 and 3.0 felt too
        -- fast in actual play - skill VFX visibly couldn't keep up with the character at that speed).
        local move = self.Entity.MovementComponent
        if isvalid(move) then
            local dexMoveCoef = isSpeedster and (0.08 * 2.5) or 0.08
            move.InputSpeed = 1.5 + effDex * dexMoveCoef
            -- 스피드스터 - "이동속도 초과분 10%p당 공격력·스킬데미지+6%(상한+90%)". 기준선(1x 계수였을
            -- 때의 속도) 대비 실제 속도의 초과율(%)을 10 단위로 내림해 6%씩 부여. effDex가 클수록(더
            -- 많이 투자할수록) 초과율도 커지는 구조라 "이동속도로 완전히 갈아탄 빌드"를 보상한다.
            if isSpeedster then
                local baselineSpeed = math.max(0.01, 1.5 + effDex * 0.08)
                local excessPercent = ((move.InputSpeed / baselineSpeed) - 1) * 100
                self.SpeedsterAtkBonus = math.min(0.90, math.floor(excessPercent / 10) * 0.06)
                self.SkillDamageBonus = self.SkillDamageBonus + self.SpeedsterAtkBonus
            else
                self.SpeedsterAtkBonus = 0
            end
            -- 날렵함(1차 특성) - 이동 속도 직접 가산. 순수 유틸 스탯이라 CP에는 반영하지 않음(다른
            -- 게임의 "전투력"도 보통 이동속도는 제외 - §"현재 전투력 공식" 참고).
            if self.Trait == "날렵함" or self.Trait2 == "날렵함" then
                move.InputSpeed = move.InputSpeed + 0.6
            end
        end

        -- M2 Phase B - 신규 109종 특성의 플랫/퍼센트 계열 효과 적용(legacy 특성은 위에서 이미
        -- 처리됐으므로 엔진이 조용히 no-op). 반드시 STR/DEX/INT/LUK 파생 계산이 끝난 뒤에 호출해야
        -- 곱연산 순서가 맞는다(예: atk% 특성이 STR 기반 공격력 위에 곱해짐).
        _TraitEffectEngine:ApplyToStats(self, self.Trait, effStr, effDex, effInt, effLuk)
        -- 3차 전직 추가 특성(Trait2) - 있으면 같은 스탯 채널 위에 한 번 더 곱연산으로 적용된다(두
        -- 특성의 효과가 함께 누적).
        if self.Trait2 ~= "" then
            _TraitEffectEngine:ApplyToStats(self, self.Trait2, effStr, effDex, effInt, effLuk)
        end

        -- M2 Phase C(2026-09-06) - 링크 캐릭터(LinkTrait1/2, UpdateSquadLinks가 채움) 링크 패시브 적용.
        -- 본인 특성(Trait/Trait2) 기준 효율 보정계수(링크 마스터/박애주의자/친화력/외골수/고독)를 먼저
        -- 구해 두 링크 슬롯 모두에 동일하게 곱한다(부록 D-6: 이 계수는 "내가 받는 링크 효과" 전체에
        -- 적용되지 링크 캐릭터별로 다르지 않음).
        self.LinkPotionMultBonus = 0
        self.LinkLifestealBonus = 0
        self.LinkOnKillCurrencyChance = 0
        self.LinkClearCurrencyBonus = 0
        self.LinkGateDropBonus = 0
        self.LinkSkillCooldownRouletteChance = 0
        self.LinkTownRegenBonus = 0
        self.LinkExecuteCritThreshold = 0
        self.LinkFirstHitImmuneAvailable = false
        self.LinkReviveHpPercent = 0
        self.LinkMirrorDamagePct = 0
        -- M2 Phase C(2026-09-08) - 고독을 링크 슬롯에 편성하면(본인 특성이 아니라 "다른 슬롯"으로)
        -- 반대편 슬롯의 링크 효율을 +15%(부록 D-6 "다른 슬롯 링크효율+15%") 올린다 - 그래서 두 슬롯의
        -- 효율이 서로 다를 수 있어 슬롯별로 따로 계산한다(예전엔 linkEfficiency 하나를 공유).
        local baseLinkEfficiency = _TraitEffectEngine:GetLinkEfficiencyMultiplier(self.Trait, self.Trait2)
        local linkEfficiency1 = _TraitEffectEngine:GetLinkEfficiencyMultiplierForSlot(self.Trait, self.Trait2, self.LinkTrait2)
        local linkEfficiency2 = _TraitEffectEngine:GetLinkEfficiencyMultiplierForSlot(self.Trait, self.Trait2, self.LinkTrait1)
        if self.LinkTrait1 ~= "" then
            _TraitEffectEngine:ApplyLinkToStats(self, self.LinkTrait1, linkEfficiency1)
            self.LinkPotionMultBonus = self.LinkPotionMultBonus + _TraitEffectEngine:GetLinkPotionMult(self.LinkTrait1) * linkEfficiency1
            self.LinkLifestealBonus = self.LinkLifestealBonus + _TraitEffectEngine:GetLinkLifestealBonus(self.LinkTrait1) * linkEfficiency1
            self.LinkOnKillCurrencyChance = self.LinkOnKillCurrencyChance + _TraitEffectEngine:GetLinkOnKillCurrencyChance(self.LinkTrait1) * linkEfficiency1
            self.LinkClearCurrencyBonus = self.LinkClearCurrencyBonus + _TraitEffectEngine:GetLinkClearCurrencyBonus(self.LinkTrait1) * linkEfficiency1
            self.LinkGateDropBonus = self.LinkGateDropBonus + _TraitEffectEngine:GetLinkGateDropBonus(self.LinkTrait1) * linkEfficiency1
            self.LinkSkillCooldownRouletteChance = self.LinkSkillCooldownRouletteChance + _TraitEffectEngine:GetLinkOnSkillCooldownRoulette(self.LinkTrait1) * linkEfficiency1
            self.LinkTownRegenBonus = self.LinkTownRegenBonus + _TraitEffectEngine:GetLinkTownRegenBonus(self.LinkTrait1) * linkEfficiency1
            self.LinkExecuteCritThreshold = self.LinkExecuteCritThreshold + _TraitEffectEngine:GetLinkExecuteCritThreshold(self.LinkTrait1) * linkEfficiency1
            if linkEfficiency1 > 0 and _TraitEffectEngine:HasLinkFirstHitImmune(self.LinkTrait1) then
                self.LinkFirstHitImmuneAvailable = true
            end
            self.LinkReviveHpPercent = self.LinkReviveHpPercent + _TraitEffectEngine:GetLinkReviveHpPercent(self.LinkTrait1) * linkEfficiency1
            self.LinkMirrorDamagePct = self.LinkMirrorDamagePct + _TraitEffectEngine:GetLinkMirrorDamagePct(self.LinkTrait1) * linkEfficiency1
        end
        if self.LinkTrait2 ~= "" then
            _TraitEffectEngine:ApplyLinkToStats(self, self.LinkTrait2, linkEfficiency2)
            self.LinkPotionMultBonus = self.LinkPotionMultBonus + _TraitEffectEngine:GetLinkPotionMult(self.LinkTrait2) * linkEfficiency2
            self.LinkLifestealBonus = self.LinkLifestealBonus + _TraitEffectEngine:GetLinkLifestealBonus(self.LinkTrait2) * linkEfficiency2
            self.LinkOnKillCurrencyChance = self.LinkOnKillCurrencyChance + _TraitEffectEngine:GetLinkOnKillCurrencyChance(self.LinkTrait2) * linkEfficiency2
            self.LinkClearCurrencyBonus = self.LinkClearCurrencyBonus + _TraitEffectEngine:GetLinkClearCurrencyBonus(self.LinkTrait2) * linkEfficiency2
            self.LinkGateDropBonus = self.LinkGateDropBonus + _TraitEffectEngine:GetLinkGateDropBonus(self.LinkTrait2) * linkEfficiency2
            self.LinkSkillCooldownRouletteChance = self.LinkSkillCooldownRouletteChance + _TraitEffectEngine:GetLinkOnSkillCooldownRoulette(self.LinkTrait2) * linkEfficiency2
            self.LinkTownRegenBonus = self.LinkTownRegenBonus + _TraitEffectEngine:GetLinkTownRegenBonus(self.LinkTrait2) * linkEfficiency2
            self.LinkExecuteCritThreshold = self.LinkExecuteCritThreshold + _TraitEffectEngine:GetLinkExecuteCritThreshold(self.LinkTrait2) * linkEfficiency2
            if linkEfficiency2 > 0 and _TraitEffectEngine:HasLinkFirstHitImmune(self.LinkTrait2) then
                self.LinkFirstHitImmuneAvailable = true
            end
            self.LinkReviveHpPercent = self.LinkReviveHpPercent + _TraitEffectEngine:GetLinkReviveHpPercent(self.LinkTrait2) * linkEfficiency2
            self.LinkMirrorDamagePct = self.LinkMirrorDamagePct + _TraitEffectEngine:GetLinkMirrorDamagePct(self.LinkTrait2) * linkEfficiency2
        end
        self.LinkOnKillCurrencyChance = math.max(0, math.min(1.0, self.LinkOnKillCurrencyChance))
        -- 박애주의자를 링크 슬롯에 편성 + 두 슬롯 모두 활성이면(부록 D-6 "링크 2슬롯 모두 활성 시
        -- 전스탯+6%") 별도 플랫 보너스 - 고독처럼 자신이 링크를 아예 못 받는 상태(baseLinkEfficiency
        -- 0)면 이 보너스도 함께 막는다(같은 "링크를 받지 못함" 규칙 적용).
        if baseLinkEfficiency > 0 and self.LinkTrait1 ~= "" and self.LinkTrait2 ~= "" and (self.LinkTrait1 == "박애주의자" or self.LinkTrait2 == "박애주의자") then
            _TraitEffectEngine:ApplyModifiersToStats(self, { atk = 0.06, cc = 0.02, acc = 3, msm = 0.06 }, 1.0)
            log("PlayerStats: 박애주의자 교차-슬롯 보너스(전스탯+6%) 적용")
        end
        -- 2026-09-08 QA - 버서크 링크("고립의 힘": 링크 1슬롯만 활성 시 전스탯+12%) 신규 연결.
        -- 박애주의자(2슬롯 모두 활성)와 반대 조건 - 링크 슬롯이 정확히 1개만 채워져 있고 그게
        -- 버서크일 때만 적용(비율은 고독의 "전스탯+30%" 배분과 동일 비율로 근사).
        if baseLinkEfficiency > 0 and ((self.LinkTrait1 == "버서크" and self.LinkTrait2 == "") or (self.LinkTrait2 == "버서크" and self.LinkTrait1 == "")) then
            _TraitEffectEngine:ApplyModifiersToStats(self, { atk = 0.12, cc = 0.02, acc = 4, msm = 0.06 }, 1.0)
            log("PlayerStats: 버서크 링크(1슬롯 단독) 보너스(전스탯+12%) 적용")
        end

        -- M2 Phase B 2단계 - 순교자(lowHpCritMult)의 저체력 크리데미지 가산이 매 CombatTick마다 이
        -- 베이스라인 위에 얹힌다(ApplyToStats 이후 시점의 크리데미지를 기준으로 삼아야 저격수/행운아
        -- 등 다른 크리데미지 특성과 정확히 합산됨). 동적 공격력 보너스(버서크/스택/저체력/럭키데이)도
        -- 여기서 한 번 재적용해 레벨업으로 BaseAttackDamage가 바뀌어도 누적 스택이 유지되도록 한다.
        if isvalid(attack) then
            self.BaseCritDamageMultiplier = attack.CritDamageMultiplier
        end
        self:RecomputeDynamicAttackDamage()

        local attackDamage = isvalid(attack) and attack.AttackDamage or -1
        local critChance = isvalid(attack) and attack.CriticalChance or -1
        local critMult = isvalid(attack) and attack.CritDamageMultiplier or -1
        local cooldown = isvalid(attack) and attack.AttackCooldownSeconds or -1
        local accuracy = isvalid(attack) and attack.Accuracy or -1
        local inputSpeed = isvalid(move) and move.InputSpeed or -1
        local maxHp = isvalid(player) and player.MaxHp or -1
        log("PlayerStats: RecalculateDerived maxHp=" .. maxHp .. " maxMp=" .. self.MaxMp .. " attackDamage=" .. attackDamage .. " critChance=" .. critChance .. " critMult=" .. critMult .. " cooldown=" .. cooldown .. " accuracy=" .. accuracy .. " inputSpeed=" .. inputSpeed)
    end

    @ExecSpace("ServerOnly")
    method void RefreshEquipmentStats(integer str, integer dex, integer intel, integer luk)
        -- 2026-09-15 유저 리포트 "장비 착용해도 전투력 반영 안 됨" / "STR 늘어도 데미지 그대로" 수정.
        -- 원인: 장비 착용/해제는 지금까지 AvatarLookLogic.ApplyEquipmentToPlayer를 통해 아바타
        -- 코스튬(겉모습)만 갱신했을 뿐, 이 컴포넌트의 서버 권위 전투 스탯(Str/Dex/Intel/Luk, 여기서
        -- 파생되는 AttackDamage/Accuracy 등)은 캐릭터 진입 시점(ApplyStats)에 딱 한 번만 계산되고
        -- 그 뒤로는 전혀 재계산되지 않았다. 인벤토리(로스터)가 전부 ClientOnly라 서버는 장비 보너스를
        -- 직접 알 수 없으므로, 클라이언트가 장비 변경 직후 EquipmentLogic:GetEffectiveStat로 재계산한
        -- 유효 스탯(기본값+장비 보너스)을 여기로 보낸다. ApplyStats와 달리 레벨/경험치/킬수/트레잇 등
        -- 진행 중인 런 상태는 전혀 건드리지 않고, RecalculateDerived(false)로 MaxHp 재계산은 하되
        -- 풀피 회복(resetHp)은 건너뛴다 - 장비를 바꿀 때마다 공짜로 회복되는 부작용을 막기 위함.
        self.Str = str
        self.Dex = dex
        self.Intel = intel
        self.Luk = luk
        self:RecalculateDerived(false)
        log("PlayerStats: RefreshEquipmentStats str=" .. str .. " dex=" .. dex .. " intel=" .. intel .. " luk=" .. luk)
    end

    @ExecSpace("ServerOnly")
    method void OnMapEnter(Entity mapEntity)
        -- 맵 이동마다(마을<->전투 지형) 버서크 자해 DoT·마을 자동 회복을 켜고 끄기 위한 판정 갱신.
        self:UpdateZoneState()
    end

    @ExecSpace("ServerOnly")
    method void OnMapLeave(Entity mapEntity)
        -- 다음 맵의 OnMapEnter가 다시 판정하므로, 여기서는 일단 두 타이머를 모두 멈춰 전 맵의
        -- 효과가 새 맵으로 새는 것을 막는다(전투 지형->전투 지형 이동이어도 OnMapEnter가 바로
        -- 재시작함).
        self:StopBerserkTimer()
        self:StopTownRegenTimer()
        self:StopCombatTimer()
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:StopBerserkTimer()
        self:StopTownRegenTimer()
        self:StopCombatTimer()
    end

    @ExecSpace("ServerOnly")
    method void UpdateZoneState()
        -- 마을(Lobby)·캐릭터 선택(choice_map)은 비전투 지형이라 버서크 자해 DoT를 끄고 대신 자동
        -- 체력/마나 회복을 켠다. 화이트리스트가 아닌 "안전지대 목록에 없으면 전투 지형"으로 판정 -
        -- 새 맵이 추가돼도 코드 수정 없이 자동으로 전투 지형 취급된다.
        local map = self.Entity.CurrentMap
        local mapName = isvalid(map) and map.Name or ""
        local inSafeZone = (mapName == "Lobby") or (mapName == "choice_map")

        if (self.Trait == "버서크" or self.Trait2 == "버서크") and not inSafeZone then
            self:StartBerserkTimer()
        else
            self:StopBerserkTimer()
            -- 안전지대에서는 반응형 공격력 보정을 즉시 되돌려 항상 기본 공격력으로 되돌아오게
            -- 한다(전투 지형에서 빠져나온 순간 직전 체력 비율 기준 보너스만 남아있는 것을 방지).
            self.BerserkDamageBonusPercent = 0
            self:RecomputeDynamicAttackDamage()
        end

        if inSafeZone then
            self:StartTownRegenTimer()
            self:StopCombatTimer()
            -- 안전지대 진입 시 방어막·저체력 보너스도 함께 정리(전투 지형 밖에서 남아있으면 다음
            -- 전장 재입장 때 혼란스러운 잔여 상태가 될 수 있음).
            self.ShieldAmount = 0
            self.LowHpBonusAtkPercent = 0
            self:RecomputeDynamicAttackDamage()
        else
            self:StopTownRegenTimer()
            self:StartCombatTimer()
        end
        log("PlayerStats: UpdateZoneState map=" .. mapName .. " safe=" .. tostring(inSafeZone) .. " trait=" .. self.Trait .. " berserkTimerActive=" .. tostring(self.BerserkTimerId ~= 0) .. " regenTimerActive=" .. tostring(self.TownRegenTimerId ~= 0) .. " combatTimerActive=" .. tostring(self.CombatTimerId ~= 0))
    end

    method void StartBerserkTimer()
        -- 이미 돌고 있으면 중복 시작하지 않는다(맵 재판정이 여러 경로에서 호출될 수 있음).
        if self.BerserkTimerId ~= 0 then return end
        self.BerserkTimerId = _TimerService:SetTimerRepeat(self.BerserkTick, 1.0)
    end

    method void StopBerserkTimer()
        if self.BerserkTimerId ~= 0 then
            _TimerService:ClearTimer(self.BerserkTimerId)
            self.BerserkTimerId = 0
        end
    end

    method void StartTownRegenTimer()
        -- 이미 돌고 있으면 중복 시작하지 않는다(맵 재판정이 여러 경로에서 호출될 수 있음).
        if self.TownRegenTimerId ~= 0 then return end
        self.TownRegenTimerId = _TimerService:SetTimerRepeat(self.TownRegenTick, 1.0)
    end

    method void StopTownRegenTimer()
        if self.TownRegenTimerId ~= 0 then
            _TimerService:ClearTimer(self.TownRegenTimerId)
            self.TownRegenTimerId = 0
        end
    end

    method void StartCombatTimer()
        -- 버서크 전용 타이머와 별개로, 특성과 무관하게 전투 지형에서 항상 도는 1Hz 틱 - 여러 다른
        -- 특성(재생력/투지/순교자/시한폭탄/마나실드/수호자/유리몸)이 여기 얹혀서 각자 자기 basicEffect
        -- 필드가 있을 때만 반응한다(없으면 CombatTick 내부에서 조용히 스킵).
        if self.CombatTimerId ~= 0 then return end
        self.CombatTimerId = _TimerService:SetTimerRepeat(self.CombatTick, 1.0)
    end

    method void StopCombatTimer()
        if self.CombatTimerId ~= 0 then
            _TimerService:ClearTimer(self.CombatTimerId)
            self.CombatTimerId = 0
        end
    end

    @ExecSpace("ServerOnly")
    method void RegisterBurstKill(table spec)
        -- 2026-09-15 코드 구조화 - 본체는 Combat/PlayerCombatTickLogic.mlua로 이동, 여기엔 위임
        -- 래퍼만 남긴다(기존 TraitEffectEngine과 동일한 패턴). 외부 호출부(statsComp:RegisterBurstKill(spec)
        -- 등)는 전혀 안 바뀐다.
        _PlayerCombatTickLogic:RegisterBurstKill(self, spec)
    end

    @ExecSpace("ServerOnly")
    method void RecomputeDynamicAttackDamage()
        -- 2026-09-15 코드 구조화 - 위임 래퍼, 본체는 PlayerCombatTickLogic.mlua.
        _PlayerCombatTickLogic:RecomputeDynamicAttackDamage(self)
    end

    @ExecSpace("ServerOnly")
    method void CombatTick()
        -- 2026-09-15 코드 구조화 - 위임 래퍼, 본체는 PlayerCombatTickLogic.mlua. StartCombatTimer가
        -- self.CombatTick을 타이머 콜백으로 넘기므로 이름/시그니처는 그대로 유지해야 한다.
        _PlayerCombatTickLogic:CombatTick(self)
    end

    @ExecSpace("ServerOnly")
    method void BerserkTick()
        -- 2026-09-15 코드 구조화 - 위임 래퍼, 본체는 PlayerCombatTickLogic.mlua. StartBerserkTimer가
        -- self.BerserkTick을 타이머 콜백으로 넘기므로 이름/시그니처는 그대로 유지해야 한다.
        _PlayerCombatTickLogic:BerserkTick(self)
    end

    @ExecSpace("ServerOnly")
    method void TownRegenTick()
        -- 2026-09-15 코드 구조화 - 위임 래퍼, 본체는 PlayerCombatTickLogic.mlua. StartTownRegenTimer가
        -- self.TownRegenTick을 타이머 콜백으로 넘기므로 이름/시그니처는 그대로 유지해야 한다.
        _PlayerCombatTickLogic:TownRegenTick(self)
    end

end
