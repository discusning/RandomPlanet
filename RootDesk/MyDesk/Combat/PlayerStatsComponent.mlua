    @ExecSpace("Server")
    method void RequestRerollAbilityPreview()
        -- 2026-09-15 코드 구조화 - RPC 진입점의 senderUserId 검증은 이 메서드 스코프를 벗어나
        -- 전달되지 않으므로 여기서 처리하고, 통과 후 나머지 로직만 AbilityChoiceLogic으로 위임한다.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        _AbilityChoiceLogic:RequestRerollAbilityPreview(self)
    end

