        -- 여기서 처리하고, 통과 후 나머지 로직만 AbilityChoiceLogic으로 위임한다.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        _AbilityChoiceLogic:RequestResolveAbilityChoice(self, choice)
    end

