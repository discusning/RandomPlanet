@Component
script PlayerStatsComponent extends Component
    -- Implements Docs/랜덤 플래닛 전체 기획서.md §2-2 + §8-1's official STR/DEX/INT/LUK effect table.
    -- MaxHp is deliberately NOT derived from any of the 4 stats here - the design doc only ever
    -- grants HP via traits (강건함/약골/etc., Phase 3+) or level, never a base stat.
    -- INT's primary effects (스킬 데미지, 스킬 쿨다운 감소) and STR's secondary (넉백 저항) and LUK's
    -- secondary (회피) are computed and stored below but have no consumer yet - no skill system
    -- (Phase 3) and no monster-attacks-player pipeline exist in this project yet. MaxMp is the one
    -- INT effect that's concretely real today (a resource number + HUD bar), even with nothing
    -- spending it yet, per the GDD's own HUD spec ("HP/MP 바, 경험치·레벨...").

    @Sync property integer Str = 1
    @Sync property integer Dex = 1
    @Sync property integer Intel = 1
    @Sync property integer Luk = 1
    @Sync property integer Level = 1
    @Sync property integer CurrentXp = 0
    @Sync property integer XpToNextLevel = 100
    -- M2 Phase I(2026-09-08) - 계정 영구 강화 레벨에 따라 이번 런에서 도달 가능한 최대 레벨(15~21).
    -- ApplyStats에서 계정 강화 레벨로부터 계산해 채워진다(ComputeUnlockedMaxLevel).
    @Sync property integer UnlockedMaxLevel = 15
    @Sync property integer MaxMp = 0
    @Sync property integer CurrentMp = 0
    -- Inert until Phase 3+ wires them into a real consumer (see comment above).
    @Sync property number SkillDamageBonus = 0
    @Sync property number SkillCooldownReduction = 0
    @Sync property number EvasionPercent = 0
    @Sync property number KnockbackResistance = 0

    -- Run lifecycle (Phase 4 permadeath) - RunStartElapsed anchors "survival time" to the last time
    -- this character became the controlled character (ApplyStats), not its original creation date -
    -- a roguelite "how long did THIS life last" reading rather than calendar time. KillCount is
    -- incremented by Monster.GrantXpToAttacker alongside XP. RunEnded is the client-facing trigger
    -- flag (watched via OnSyncProperty) - the Ended* fields are frozen copies taken at death so the
    -- ENDING screen shows a stable snapshot even though Level/KillCount keep existing afterward.
    @HideFromInspector property number RunStartElapsed = 0
    @Sync property integer KillCount = 0
    @Sync property boolean RunEnded = false
    @Sync property integer EndedLevel = 0
    @Sync property integer EndedKillCount = 0
    @Sync property number EndedSurvivalSeconds = 0
    -- 시장 비교 검토(2026-08-25, Dead Cells/RoR2 런 종료 리포트 참고) - "어디까지 갔는지"를 더
    -- 구체적으로 보여주기 위한 2개 필드. 별도 추적 인프라 없이, 사망은 항상 전장 안에서만 일어나므로
    -- (PlayerHit이 몬스터 접촉 피격에서만 트리거) 사망 시점에 현재 맵의 FieldWaveSpawner를 그대로
    -- 읽기만 하면 된다.
    @Sync property integer EndedWaveReached = 0
    @Sync property boolean EndedFieldCleared = false

    -- 전직 퀘스트 보스 게이트 (M2 Phase D, 2026-09-06, 전체 기획서 §2-5 "전직 퀘스트 보스 클리어") -
    -- 레벨 요건(5/13/18)을 채워도 곧바로 스킬 티어를 지급하지 않고, 그 필드의 미니보스(FieldMiniBoss,
    -- 이미 검증된 인프라 재사용 - 전용 "전직 퀘스트" 맵/보스를 새로 만들지 않음)를 처치해야 실제
    -- 지급된다. Monster.GrantXpToAttacker가 IsBoss=true 처치를 감지해 RecordBossKillForPromotion을
    -- 호출한다.
    @Sync property boolean PromotionPending2 = false
    @Sync property boolean PromotionPending3 = false
    @Sync property boolean PromotionPending4 = false
    @HideFromInspector property number PromotionMilestoneElapsed = 0
    -- 계정 귀속 영구 저장 + 전역 리더보드 연동은 Phase H 몫 - 지금은 세션 내 최근 값만 보관.
    @Sync property number LastPromotionClearSeconds = 0

    -- 특성(115종, TraitCatalog/TraitRollLogic) - 전투력(CP, CharacterInfoUIController) 산식에도 반영.
    @Sync property string Trait = ""
    -- 3차 전직(13레벨) 추가 특성 (M2 Phase B, 2026-09-06 - 전체 기획서 §2-5 "3차 전직 시 추가로 1회
    -- 더 추첨"). 별도 선택 UI 없이 자동 지급(전체 기획서 원문 그대로 "추첨"이지 "선택"이 아님 - 이능
    -- 3택1 팝업과는 다른 시스템). GrantSkillTierIfMilestone(tier==3)에서 1회만 굴린다. **범위 제한**:
    -- TraitEffectEngine의 17개 스탯 채널(ApplyToStats)과 5개 legacy 특성 체크(버서크/균형/절약가/
    -- 단단함/날렵함)에는 반영되지만, 2단계 트리거 메커니즘(방어막/반사/즉사/스택 등)과 링크 패시브,
    -- 캐릭터 정보 UI 표시·CP 산식에는 아직 반영되지 않음(정직하게 기록, 후속 패스 과제) - 호출부가
    -- 20곳 이상으로 많아 이번 패스에서 전부 확장하면 리스크가 크다고 판단해 스탯 채널만 우선 연결.
    @Sync property string Trait2 = ""
    -- 단단함 전용 - "받는 피해 감소"는 `PlayerHit.HandleHitEvent`(몬스터->플레이어 공격 파이프라인,
    -- Phase 3.5에 신설)가 실제로 소비한다. CP 산식에도 배율로 함께 반영된다.
    @Sync property number DamageReductionPercent = 0
    -- 버서크 전용 - 체력 비율에 반비례해 실시간으로 갱신되는 공격력 보너스(BerserkTick). CP에 그대로
    -- 반영되므로 체력이 낮을수록 전투력 수치도 함께 오른다("살수록 약해지고 다치수록 강해진다").
    @Sync property number BerserkDamageBonusPercent = 0
    @HideFromInspector property number BaseAttackDamage = 0
    -- 버서크 공격력 보너스 계수 - 실제로 몬스터에게 맞아 깎인 체력 비율에 곱해진다(BerserkTick 참고).
    @HideFromInspector property number BerserkBonusCoef = 0.6
    @HideFromInspector property integer BerserkTimerId = 0
    -- 마을(안전지대) 자동 체력/마나 회복 - 특성과 무관하게 전원 적용. 1초마다 최대치의 이 비율만큼
    -- 회복(유저 요청: "Hp도 마을에서는 자동으로 회복되게 해줘" -> "MP도 마을에서는 자동으로
    -- 회복되게 해줘"). 같은 타이머(TownRegenTick)가 Hp/Mp 둘 다 처리 - 둘 다 마을 진입 조건이
    -- 동일해 별도 타이머를 둘 이유가 없다.
    @HideFromInspector property number TownRegenPercent = 0.08
    @HideFromInspector property number TownMpRegenPercent = 0.1
    @HideFromInspector property integer TownRegenTimerId = 0

    -- 이능(Ability) 3택1 팝업 (Phase 3, 2026-08-24) - GDD §3 core loop "레벨업 시 3택1 이능 팝업
    -- (스탯 재분배 / 추가 스탯 / 특성 변경)". 기존 레벨업 자동 +1×4 스탯 증가는 그대로 유지하고, 그
    -- 위에 매 레벨업마다 추가 보너스를 주는 팝업을 얹는 설계 - 순수 상승분이라 기존 밸런스를
    -- 깎지 않는다. PendingAbilityChoices는 큐(레벨업이 몰릴 때 팝업을 한 번에 하나씩만 띄우기 위함).
    @Sync @HideFromInspector property boolean AbilityChoicePending = false
    @Sync @HideFromInspector property integer PendingAbilityChoices = 0
    -- 2026-09-22 타임 스톱(Combat/TimeStopLogic.mlua) - 서버가 이능/스킬 선택 중 게임 시간을 멈추는 동안
    -- true. 클라이언트는 이 값의 변화(OnSyncProperty)를 받아 로컬 입력을 잠그고/푼다.
    @Sync @HideFromInspector property boolean TimeStopped = false
    -- "특성 변경" 선택 시 실제로 적용될 특성 - 팝업이 뜨는 시점에 미리 굴려서 클라이언트가 몇으로
    --바뀌는지 보고 고를 수 있게 한다(블라인드 선택 방지).
    @Sync @HideFromInspector property string PendingTraitPreview = ""
    @HideFromInspector property integer BonusStatPoints = 3

    -- M2 Phase B(2026-09-06) - 범용 특성 엔진(TraitEffectEngine)이 매 RecalculateDerived마다 채우는
    -- 3개 채널. legacy 특성(버서크/절약가/균형/단단함/날렵함)은 이 필드들을 쓰지 않고 기존 전용
    -- 코드를 그대로 유지한다 - 신규 109종 중 exp/drop/mpCost 계열 효과가 있는 특성만 값이 채워진다.
    @Sync property number MpCostMultiplier = 0
    @Sync property number DropRateMultiplier = 0
    @Sync property number ExpMultiplier = 0
    -- 2026-09-08 QA - 빈손 링크("통행증": 게이트 입장권 획득 확률 증가)가 그동안 linkEffect 필드
    -- 자체가 없어 "선행 필요"로 미구현이었던 것을 신규 연결 - FieldWaveSpawner.RollGateTicketDrop이
    -- 판정 시 이 값을 더해서 읽는다.
    @Sync property number GateTicketChanceBonus = 0
    -- 2026-09-08 QA 발견 - RestGaugeLogic.TryConsumeForEntry("휴식 게이지 40 이상 소모 시 보상 2배")가
    -- 이미 오래전부터 게이지 차감+신호(rewardBonus)까지 반환하고 있었으나, 주석에 "토벌전장 보상
    -- 시스템(Phase 4) 자체가 없어서" 실제 지급은 미뤄져 있었다 - 그 보상 시스템(XP/드랍/런종료 재화)이
    -- 이미 오래전에 다 구축된 상태라 신규 연결. `CharacterRosterLogic.RequestEnterBattlefield`가 이
    -- 값을 진입 시점에 세팅, `Monster.GrantXpToAttacker`/`TryDropPotion`/`GrantRunEndCurrency`가 함께
    -- 소비한다. 게이트 모드는 별도의 3배/2배 배율 체계라 이 보너스와 중첩되지 않게
    -- `GateTicketLogic.RequestEnterGate`에서 명시적으로 꺼둔다.
    @Sync property boolean RestBonusActive = false
    -- 부활자(Hidden-good, basicEffect.reviveOnce) - 런당 1회 소모. PlayerHit.HandleHitEvent가 치명적
    -- 피해 직전에 확인한다.
    @Sync @HideFromInspector property boolean ReviveUsedThisRun = false

    -- M2 Phase B 2단계(2026-09-06 후속 패스) - 새 서브시스템 없이 표현 가능한 확률/주기/누적 트리거들.
    -- 방어막(마나실드/수호자/유리몸/약골) - PlayerHit이 Hp를 깎기 전에 먼저 이 값을 소모한다.
    @Sync property number ShieldAmount = 0
    @HideFromInspector property integer ShieldTickElapsed = 0
    @HideFromInspector property integer CombatTimerId = 0
    -- 누적형 공격력 보너스 3종(적응력/굶주린 살점/시한폭탄) + 저체력 조건부(투지) + 럭키데이(1회
    -- 고정치) - 전부 BaseAttackDamage 위에 함께 곱해진다(RecomputeDynamicAttackDamage 참고). 버서크와
    -- 원리상 동일한 "Base 위에 매번 곱연산" 패턴을 그대로 재사용해 여러 타이머가 서로 덮어쓰지 않는다.
    @HideFromInspector property number HitStackAtkPercent = 0
    @HideFromInspector property number KillStackAtkPercent = 0
    @HideFromInspector property number TimeStackAtkPercent = 0
    @HideFromInspector property number LowHpBonusAtkPercent = 0
    @HideFromInspector property number LuckyDayAtkPercent = 0
    -- 럭키 세븐(periodicRandomBuff) 전용 - CombatTick이 interval초마다 리롤한다.
    @HideFromInspector property number RandomBuffAtkPercent = 0
    @HideFromInspector property number RandomBuffTickElapsed = 0
    -- 자석술사(burstKill) 전용 - 단시간 다중 처치 추적 + 발동 중인 버프의 만료 시각.
    -- 스피드스터(speedster) 전용 - 이동속도 초과분 기반 공격력·스킬데미지 보너스(RecalculateDerived가 갱신).
    @HideFromInspector property number SpeedsterAtkBonus = 0
    @HideFromInspector property number BurstAtkPercent = 0
    @HideFromInspector property number BurstExpireElapsed = 0
    -- 2026-09-08 QA 발견 - 링크 마스터(hg)의 basicDesc("이능 획득 시 3초간 전 스탯 대폭 상승")가
    -- 이 프로젝트 어디에도 구현돼 있지 않았다(TraitEffectEngine의 "링크 마스터" 하드코딩 1.2배는
    -- "받는 링크 효과 전체 보정" 용도로, 이 basicDesc와는 이름만 같을 뿐 무관한 별개 효과 - 그대로
    -- 유지). "전 스탯"은 다른 임시버프와 동일하게 공격력 채널로 근사(자체 근사치, 미검증).
    @HideFromInspector property number LinkMasterBuffAtkPercent = 0
    @HideFromInspector property number LinkMasterBuffExpireElapsed = 0
    @HideFromInspector property number BurstKillWindowStart = 0
    @HideFromInspector property integer BurstKillCountInWindow = 0

    -- M2 Phase C(2026-09-06) - 링크 캐릭터 실효과 연결. 공격대 편성(CharacterRosterLogic.squadLinks)에서
    -- 확정된 최대 2명의 링크 캐릭터 정보를 클라이언트가 UpdateSquadLinks로 밀어넣는다 - 로스터 자체가
    -- ClientOnly라 서버는 이 필드들 없이는 누가 링크인지 알 방법이 없다. 15레벨 미만이면 클라이언트가
    -- 애초에 채워 보내지 않지만(UpdateSquadLinks도 방어적으로 재검증), 여기 두 슬롯 자체가 비어있으면
    -- 그냥 링크 없음.
    @HideFromInspector property string LinkTrait1 = ""
    @HideFromInspector property integer LinkLevel1 = 0
    @HideFromInspector property string LinkTrait2 = ""
    @HideFromInspector property integer LinkLevel2 = 0
    -- 링크 패시브 중 potionMult/lifestealPct 계열은 ApplyModifiersToStats의 범용 채널에 없는(RequestUsePotion/
    -- PlayerAttack이 각각 별도 공식으로 소비하는) 값이라 RecalculateDerived가 매번 이 두 필드에 집계해둔다.
    @Sync property number LinkPotionMultBonus = 0
    @Sync property number LinkLifestealBonus = 0
    -- 2026-09-08 QA - 도박꾼 링크("재화 폭죽": 처치 시 낮은 확률 재화 즉시 획득) 전용.
    @Sync property number LinkOnKillCurrencyChance = 0
    -- 2026-09-08 QA - 불운 링크("후원": 파티 클리어 시 영구재화+20%) 전용.
    @Sync property number LinkClearCurrencyBonus = 0
    -- 2026-09-08 QA - 거리의 방랑자 링크("탐험 지원": 몬스터 게이트에서 스탯 구슬 획득량 대폭 증가)
    -- 전용. Monster.GrantXpToAttacker가 IsGateMode일 때만 이 값을 exp 보너스로 반영한다.
    @Sync property number LinkGateDropBonus = 0
    -- 2026-09-08 QA - 회전룰렛 링크("돌아가는 운명") 전용. PlayerSkillComponent.UseSkillSlot이
    -- 본인 특성 롤과 합산해서 읽는다.
    @Sync property number LinkSkillCooldownRouletteChance = 0
    -- 2026-09-08 QA - 금욕 링크("재생 지원": 비전투 시 파티 회복 속도 증가) 전용. TownRegenTick이
    -- TownRegenPercent(전원 공통 기본값)에 이 값을 더해서 읽는다.
    @Sync property number LinkTownRegenBonus = 0
    -- 2026-09-08 QA - 동전 던지기 사형집행인 링크("확정타") 전용. PlayerAttack.CalcCritical이
    -- 대상 Monster.Hp 비율과 비교해서 읽는다.
    @Sync property number LinkExecuteCritThreshold = 0
    -- 2026-09-08 QA - 유리몸 링크("안전 확보": 파티 입장 후 첫 피격 무효) 전용. 전장 입장마다
    -- CharacterRosterLogic.RequestEnterBattlefield가 소모 플래그를 리셋한다(런당이 아니라 판마다).
    @Sync property boolean LinkFirstHitImmuneAvailable = false
    @HideFromInspector property boolean FirstHitImmuneUsedThisVisit = false
    -- 2026-09-08 QA - 순교자 링크("최후의 인연": 런당 1회 사망 시 HP10% 재기) 전용. 부활자
    -- (본인, Hp=1 고정)와 회복량이 달라 별도 채널이지만 ReviveUsedThisRun 플래그는 공유한다.
    @Sync property number LinkReviveHpPercent = 0
    -- 2026-09-08 QA - 거울 갑옷 링크("반사의 축복": 파티가 받는 근접 피해 일부 반사) 전용. 본인
    -- 특성의 mirrorDamage(100% 반사)와 독립된 채널이라 둘 다 활성이면 PlayerHit에서 합산.
    @Sync property number LinkMirrorDamagePct = 0
    -- 2026-09-08 QA - 굶주린 살점 링크("고통 공유": 피격 시 낮은 확률로 짧은 공격력 버프) 전용.
    -- 본인 특성(HitStackAtkPercent, 확정 누적)과 독립된 채널.
    @HideFromInspector property number LinkOnHitBuffAtkPercent = 0
    -- 2026-09-10 QA - 겁쟁이(bad)의 basicDesc "피격 직후 다음 공격+20%" 본인판 전용. 굶주린 살점
    -- 링크(확률형)와 달리 "직후"라 매 피격마다 확정 발동하는 독립 채널.
    @HideFromInspector property number OwnOnHitBuffAtkPercent = 0
    @HideFromInspector property number OwnOnHitBuffExpireElapsed = 0
    -- 2026-09-10 QA - 옹졸함(bad)의 basicDesc "무피격 시간 비례 데미지 증가" 본인판 전용.
    @HideFromInspector property number UnhitScaleAtkPercent = 0
    @HideFromInspector property number LinkOnHitBuffExpireElapsed = 0
    -- 2026-09-08 QA - 신중함 링크("신중한 조언": 런당 1회 파티 첫 피격 피해 20% 경감) 전용.
    -- 유리몸 링크(firstHitImmune)와 달리 "런당" 1회라 ReviveUsedThisRun과 동일하게 캐릭터
    -- 로드 시에만 리셋(전장 재진입으로는 재사용 불가).
    @Sync @HideFromInspector property boolean FirstHitReductionUsedThisRun = false
    -- 2026-09-08 QA - 유리대포 링크("수호 기도": 25초마다 파티 치명타 무효, 방어막으로 근사) 전용.
    -- ShieldAmount 자체는 마나실드/수호자/유리몸과 동일하게 공유하되 틱 카운터만 별도.
    @HideFromInspector property number LinkShieldTickElapsed = 0
    -- 2026-09-08 QA - 영혼 포획자 링크("포획 지원": 낮은 확률로 처치 시 짧은 무적) 전용. 이
    -- 시각 이전(ElapsedSeconds 미만)이면 무적 - Monster.GrantXpToAttacker가 굴리고 세팅.
    @HideFromInspector property number LinkCaptureInvulnUntilElapsed = 0
    -- 2026-09-10 QA - 부활자 링크("재림의 축복": 위기 시 낮은 확률로 짧은 무적) 전용. 쿨다운
    -- 필드는 threshold 이하로 유지되는 동안 매 CombatTick마다 재굴림되는 것을 방지.
    @HideFromInspector property number LinkLowHpInvulnUntilElapsed = 0
    @HideFromInspector property number LinkLowHpInvulnCooldownUntilElapsed = 0
    -- 2026-09-10 QA - 마나실드 링크("방어막 나눔": 판 시작 시 1회성 소형 방어막) 전용. 스쿼드
    -- 재편성으로 UpdateSquadLinks가 여러 번 불려도 런당 1회만 지급되도록 하는 가드.
    @HideFromInspector property boolean LinkShieldGrantUsedThisRun = false
    -- 2026-09-10 QA - 환영 교체 링크("잔상 지원": 대시/회피 시 짧은 무적시간) 전용.
    -- PlayerSkillComponent.DoDash가 세팅, PlayerHit이 소비.
    @HideFromInspector property number LinkDashInvulnUntilElapsed = 0
    -- 2026-09-08 QA - 럭키 세븐/복불복 상자 링크(주기적 소형 랜덤 버프) 전용. 본인 특성의
    -- RandomBuffAtkPercent와 독립된 채널(둘 다 활성이어도 합산되도록).
    @HideFromInspector property number LinkPeriodicBuffAtkPercent = 0
    @HideFromInspector property number LinkPeriodicBuffExpireElapsed = 0
    @HideFromInspector property number LinkPeriodicBuffTickElapsed = 0
    -- 순교자(lowHpCritMult)가 크리 데미지 배율에 얹는 보너스의 베이스라인 - RecalculateDerived가 매번
    -- (ApplyToStats 이후) 갱신해서 CombatTick의 매 틱 조건부 가산이 드리프트하지 않게 한다.
    @HideFromInspector property number BaseCritDamageMultiplier = 0
    -- 마지막으로 "웨이브당 첫 타격 확정 크리"(집중)를 소비한 웨이브 번호 - PlayerAttack.CalcCritical
    -- 참고. 여기 두는 이유: 캐릭터 교체(ApplyStats) 시 함께 리셋되어야 하는 런-스코프 상태이기 때문.
    @HideFromInspector property integer LastCritWaveNumber = -1
    -- 신중함(firstHitBonus) 전용 - 웨이브당 첫 타격에만 데미지 보너스(집중의 LastCritWaveNumber와
    -- 동일 패턴, 대상은 크리 확정이 아니라 데미지%).
    @HideFromInspector property integer LastFirstHitWaveNumber = -1

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Seeds sane combat defaults before the real roster stats arrive via ApplyStats
        -- (RequestEnterGame / SwapActiveCharacter), so the player never starts at 0 damage.
        self:RecalculateDerived(true)
    end

    @ExecSpace("ServerOnly")
    method void ApplyStats(table stats)
        -- stats = { str, dex, intel, luk, level, trait } - effective (base + equipment bonus) values
        -- computed client-side by EquipmentLogic:GetEffectiveStat, crossed over the
        -- RequestEnterGame / SwapActiveCharacter RPC boundary alongside look/equipment. `trait`
        -- piggybacks on this same table (CharacterCardController/LobbyStageController pass
        -- data.trait) rather than adding a new RPC parameter.
        self.Str = stats.str
        self.Dex = stats.dex
        self.Intel = stats.intel
        self.Luk = stats.luk
        self.Level = stats.level
        self.UnlockedMaxLevel = self:ComputeUnlockedMaxLevel(stats.upgradeLevel or 0)
        self.Trait = stats.trait or ""
        -- 3차 전직 추가 특성(Trait2)은 로스터에 영구 저장되지 않는다(레벨 자체가 이미 그런 기존
        -- 한계 - Phase 2.5 세션 기록 참고, 재입장/스왑 시 소실). 매 진입마다 새로 시작하므로 이전
        -- 캐릭터의 값이 새지 않도록 명시적으로 초기화.
        self.Trait2 = ""
        self.CurrentXp = 0
        self.XpToNextLevel = self:ComputeXpToNextLevel(self.Level)
        -- Fresh run bookkeeping - without this reset, a character that swaps in after a previous
        -- life's death would carry RunEnded=true and the ENDING screen would pop immediately.
        self.RunStartElapsed = _UtilLogic.ElapsedSeconds
        self.KillCount = 0
        self.RunEnded = false
        self.EndedWaveReached = 0
        self.EndedFieldCleared = false
        self.ReviveUsedThisRun = false
        self.FirstHitReductionUsedThisRun = false
        self.LinkShieldGrantUsedThisRun = false
        self.LinkDashInvulnUntilElapsed = 0
        self.RestBonusActive = false
        -- M2 Phase B 2단계 - 캐릭터 교체마다 런-스코프 누적 상태를 전부 초기화(이전 캐릭터의 스택이
        -- 새 캐릭터로 새는 것을 방지 - 위 BerserkDamageBonusPercent 리셋과 동일한 이유).
        self.ShieldAmount = 0
        self.ShieldTickElapsed = 0
        self.LinkShieldTickElapsed = 0
        self.HitStackAtkPercent = 0
        self.KillStackAtkPercent = 0
        self.TimeStackAtkPercent = 0
        self.LowHpBonusAtkPercent = 0
        self.RandomBuffAtkPercent = 0
        self.RandomBuffTickElapsed = 0
        self.SpeedsterAtkBonus = 0
        self.BurstAtkPercent = 0
        self.BurstExpireElapsed = 0
        self.LinkMasterBuffAtkPercent = 0
        self.LinkMasterBuffExpireElapsed = 0
        self.LinkPeriodicBuffAtkPercent = 0
        self.LinkPeriodicBuffExpireElapsed = 0
        self.LinkPeriodicBuffTickElapsed = 0
        self.LinkOnHitBuffAtkPercent = 0
        self.LinkOnHitBuffExpireElapsed = 0
        self.OwnOnHitBuffAtkPercent = 0
        self.OwnOnHitBuffExpireElapsed = 0
        self.UnhitScaleAtkPercent = 0
        self.LinkCaptureInvulnUntilElapsed = 0
        self.LinkLowHpInvulnUntilElapsed = 0
        self.LinkLowHpInvulnCooldownUntilElapsed = 0
        self.BurstKillWindowStart = 0
        self.BurstKillCountInWindow = 0
        self.LastCritWaveNumber = -1
        self.LastFirstHitWaveNumber = -1
        -- M2 Phase C - 캐릭터 교체마다 이전 캐릭터의 링크 정보가 새지 않도록 초기화. 실제 값은 이
        -- 직후 클라이언트의 PushSquadLinksToServer() 후속 호출(UpdateSquadLinks)이 다시 채운다.
        self.LinkTrait1 = ""
        self.LinkLevel1 = 0
        self.LinkTrait2 = ""
        self.LinkLevel2 = 0
        -- 룰렛(statReshuffle) - 입장 시 스탯 총량을 ±range 범위로 재조정 후 4종에 재분배.
        local reshuffle = _TraitEffectEngine:GetStatReshuffle(self.Trait)
        if reshuffle ~= nil then
            local total = self.Str + self.Dex + self.Intel + self.Luk
            local variance = reshuffle.range or 0
            local factor = 1 + (_UtilLogic:RandomDouble() * 2 - 1) * variance
            local newTotal = math.max(4, math.floor(total * factor))
            local vals = { 1, 1, 1, 1 }
            for i = 1, (newTotal - 4) do
                local idx = _UtilLogic:RandomIntegerRange(1, 4)
                vals[idx] = vals[idx] + 1
            end
            self.Str, self.Dex, self.Intel, self.Luk = vals[1], vals[2], vals[3], vals[4]
            log("PlayerStats: 룰렛 statReshuffle total " .. total .. " -> " .. newTotal)
        end
        -- 럭키/언럭키 데이(luckyDayRoll) - 판마다 1회 굴려 런 내내 유지되는 고정 공격력 보너스/페널티.
        self.LuckyDayAtkPercent = 0
        local luckyRoll = _TraitEffectEngine:GetLuckyDayRoll(self.Trait)
        if luckyRoll ~= nil then
            local isGood = _UtilLogic:RandomDouble() < 0.5
            self.LuckyDayAtkPercent = isGood and (luckyRoll.good or 0) or (luckyRoll.bad or 0)
            log("PlayerStats: 럭키/언럭키 데이 -> " .. (isGood and "GOOD" or "BAD") .. " atk%=" .. self.LuckyDayAtkPercent)
        end
        self:RecalculateDerived(true)
        self:UpdateZoneState()
        log("PlayerStats: ApplyStats str=" .. self.Str .. " dex=" .. self.Dex .. " intel=" .. self.Intel .. " luk=" .. self.Luk .. " level=" .. self.Level .. " trait=" .. self.Trait)
    end

