@Component
script PlayerStatsComponent extends Component
    -- Implements Docs/랜덤 플래닛 전체 기획서.md §2-2 + §8-1's official STR/DEX/INT/LUK effect table.
    -- MaxHp is deliberately NOT derived from any of the 4 stats here - the design doc only ever
    -- grants HP via traits (강건함/약골/etc., Phase 3+) or level, never a base stat.
    -- INT's primary effects (스킬 데미지, 스킬 쿨다운 감소) and STR's secondary (넉백 저항) and LUK's
    -- secondary (회피) are computed and stored below but have no consumer yet - no skill system
    -- (Phase 3) and no monster-attacks-player pipeline exist in this project yet. MaxMp is the one
    -- INT effect that's concretely real today (a resource number + HUD bar), even with nothing
    -- spending it yet, per the GDD's own HUD spec ("HP/MP 바, 경험치·레벨...").

    @Sync property integer Str = 1
    @Sync property integer Dex = 1
    @Sync property integer Intel = 1
    @Sync property integer Luk = 1
    @Sync property integer Level = 1
    @Sync property integer CurrentXp = 0
    @Sync property integer XpToNextLevel = 100
    -- M2 Phase I(2026-09-08) - 계정 영구 강화 레벨에 따라 이번 런에서 도달 가능한 최대 레벨(15~21).
    -- ApplyStats에서 계정 강화 레벨로부터 계산해 채워진다(ComputeUnlockedMaxLevel).
    @Sync property integer UnlockedMaxLevel = 15
    @Sync property integer MaxMp = 0
    @Sync property integer CurrentMp = 0
    -- Inert until Phase 3+ wires them into a real consumer (see comment above).
    @Sync property number SkillDamageBonus = 0
    @Sync property number SkillCooldownReduction = 0
    @Sync property number EvasionPercent = 0
    @Sync property number KnockbackResistance = 0

    -- Run lifecycle (Phase 4 permadeath) - RunStartElapsed anchors "survival time" to the last time
    -- this character became the controlled character (ApplyStats), not its original creation date -
    -- a roguelite "how long did THIS life last" reading rather than calendar time. KillCount is
    -- incremented by Monster.GrantXpToAttacker alongside XP. RunEnded is the client-facing trigger
    -- flag (watched via OnSyncProperty) - the Ended* fields are frozen copies taken at death so the
    -- ENDING screen shows a stable snapshot even though Level/KillCount keep existing afterward.
    @HideFromInspector property number RunStartElapsed = 0
    @Sync property integer KillCount = 0
    @Sync property boolean RunEnded = false
    @Sync property integer EndedLevel = 0
    @Sync property integer EndedKillCount = 0
    @Sync property number EndedSurvivalSeconds = 0
    -- 시장 비교 검토(2026-08-25, Dead Cells/RoR2 런 종료 리포트 참고) - "어디까지 갔는지"를 더
    -- 구체적으로 보여주기 위한 2개 필드. 별도 추적 인프라 없이, 사망은 항상 전장 안에서만 일어나므로
    -- (PlayerHit이 몬스터 접촉 피격에서만 트리거) 사망 시점에 현재 맵의 FieldWaveSpawner를 그대로
    -- 읽기만 하면 된다.
    @Sync property integer EndedWaveReached = 0
    @Sync property boolean EndedFieldCleared = false

    -- 전직 퀘스트 보스 게이트 (M2 Phase D, 2026-09-06, 전체 기획서 §2-5 "전직 퀘스트 보스 클리어") -
    -- 레벨 요건(5/13/18)을 채워도 곧바로 스킬 티어를 지급하지 않고, 그 필드의 미니보스(FieldMiniBoss,
    -- 이미 검증된 인프라 재사용 - 전용 "전직 퀘스트" 맵/보스를 새로 만들지 않음)를 처치해야 실제
    -- 지급된다. Monster.GrantXpToAttacker가 IsBoss=true 처치를 감지해 RecordBossKillForPromotion을
    -- 호출한다.
    @Sync property boolean PromotionPending2 = false
    @Sync property boolean PromotionPending3 = false
    @Sync property boolean PromotionPending4 = false
    @HideFromInspector property number PromotionMilestoneElapsed = 0
    -- 계정 귀속 영구 저장 + 전역 리더보드 연동은 Phase H 몫 - 지금은 세션 내 최근 값만 보관.
    @Sync property number LastPromotionClearSeconds = 0

    -- 1차 특성(MVP 6종, CharacterSelectStageController.InitRandomPools의 traitPool과 매칭) - 2026-08-16
    -- 유저 요청으로 순수 표시문구에서 실제 효과로 승격, 전투력(CP, CharacterInfoUIController) 산식에도
    -- 반영. 상인(아이템 드랍률)은 이 프로젝트에 루팅 시스템 자체가 없어 여전히 미구현 - 정직하게 비워둠.
    @Sync property string Trait = ""
    -- 3차 전직(13레벨) 추가 특성 (M2 Phase B, 2026-09-06 - 전체 기획서 §2-5 "3차 전직 시 추가로 1회
    -- 더 추첨"). 별도 선택 UI 없이 자동 지급(전체 기획서 원문 그대로 "추첨"이지 "선택"이 아님 - 이능
    -- 3택1 팝업과는 다른 시스템). GrantSkillTierIfMilestone(tier==3)에서 1회만 굴린다. **범위 제한**:
    -- TraitEffectEngine의 17개 스탯 채널(ApplyToStats)과 5개 legacy 특성 체크(버서크/균형/절약가/
    -- 단단함/날렵함)에는 반영되지만, 2단계 트리거 메커니즘(방어막/반사/즉사/스택 등)과 링크 패시브,
    -- 캐릭터 정보 UI 표시·CP 산식에는 아직 반영되지 않음(정직하게 기록, 후속 패스 과제) - 호출부가
    -- 20곳 이상으로 많아 이번 패스에서 전부 확장하면 리스크가 크다고 판단해 스탯 채널만 우선 연결.
    @Sync property string Trait2 = ""
    -- 단단함 전용 - 실제 "받는 피해 감소" 자체는 몬스터->플레이어 공격 파이프라인이 없어 아직
    -- 관측 불가하지만, CP 산식에는 배율로 실제 반영된다(생존형 특성도 전투력에 기여하라는 요청).
    @Sync property number DamageReductionPercent = 0
    -- 버서크 전용 - 체력 비율에 반비례해 실시간으로 갱신되는 공격력 보너스(BerserkTick). CP에 그대로
    -- 반영되므로 체력이 낮을수록 전투력 수치도 함께 오른다("살수록 약해지고 다치수록 강해진다").
    @Sync property number BerserkDamageBonusPercent = 0
    @HideFromInspector property number BaseAttackDamage = 0
    -- 버서크 공격력 보너스 계수 - 실제로 몬스터에게 맞아 깎인 체력 비율에 곱해진다(BerserkTick 참고).
    @HideFromInspector property number BerserkBonusCoef = 0.6
    @HideFromInspector property integer BerserkTimerId = 0
    -- 마을(안전지대) 자동 체력/마나 회복 - 특성과 무관하게 전원 적용. 1초마다 최대치의 이 비율만큼
    -- 회복(유저 요청: "Hp도 마을에서는 자동으로 회복되게 해줘" -> "MP도 마을에서는 자동으로
    -- 회복되게 해줘"). 같은 타이머(TownRegenTick)가 Hp/Mp 둘 다 처리 - 둘 다 마을 진입 조건이
    -- 동일해 별도 타이머를 둘 이유가 없다.
    @HideFromInspector property number TownRegenPercent = 0.08
    @HideFromInspector property number TownMpRegenPercent = 0.1
    @HideFromInspector property integer TownRegenTimerId = 0

    -- 이능(Ability) 3택1 팝업 (Phase 3, 2026-08-24) - GDD §3 core loop "레벨업 시 3택1 이능 팝업
    -- (스탯 재분배 / 추가 스탯 / 특성 변경)". 기존 레벨업 자동 +1×4 스탯 증가는 그대로 유지하고, 그
    -- 위에 매 레벨업마다 추가 보너스를 주는 팝업을 얹는 설계 - 순수 상승분이라 기존 밸런스를
    -- 깎지 않는다. PendingAbilityChoices는 큐(레벨업이 몰릴 때 팝업을 한 번에 하나씩만 띄우기 위함).
    @Sync @HideFromInspector property boolean AbilityChoicePending = false
    @Sync @HideFromInspector property integer PendingAbilityChoices = 0
    -- "특성 변경" 선택 시 실제로 적용될 특성 - 팝업이 뜨는 시점에 미리 굴려서 클라이언트가 몇으로
    --바뀌는지 보고 고를 수 있게 한다(블라인드 선택 방지).
    @Sync @HideFromInspector property string PendingTraitPreview = ""
    @HideFromInspector property integer BonusStatPoints = 3

    -- M2 Phase B(2026-09-06) - 범용 특성 엔진(TraitEffectEngine)이 매 RecalculateDerived마다 채우는
    -- 3개 채널. legacy 특성(버서크/절약가/균형/단단함/날렵함)은 이 필드들을 쓰지 않고 기존 전용
    -- 코드를 그대로 유지한다 - 신규 109종 중 exp/drop/mpCost 계열 효과가 있는 특성만 값이 채워진다.
    @Sync property number MpCostMultiplier = 0
    @Sync property number DropRateMultiplier = 0
    @Sync property number ExpMultiplier = 0
    -- 부활자(Hidden-good, basicEffect.reviveOnce) - 런당 1회 소모. PlayerHit.HandleHitEvent가 치명적
    -- 피해 직전에 확인한다.
    @Sync @HideFromInspector property boolean ReviveUsedThisRun = false

    -- M2 Phase B 2단계(2026-09-06 후속 패스) - 새 서브시스템 없이 표현 가능한 확률/주기/누적 트리거들.
    -- 방어막(마나실드/수호자/유리몸/약골) - PlayerHit이 Hp를 깎기 전에 먼저 이 값을 소모한다.
    @Sync property number ShieldAmount = 0
    @HideFromInspector property integer ShieldTickElapsed = 0
    @HideFromInspector property integer CombatTimerId = 0
    -- 누적형 공격력 보너스 3종(적응력/굶주린 살점/시한폭탄) + 저체력 조건부(투지) + 럭키데이(1회
    -- 고정치) - 전부 BaseAttackDamage 위에 함께 곱해진다(RecomputeDynamicAttackDamage 참고). 버서크와
    -- 원리상 동일한 "Base 위에 매번 곱연산" 패턴을 그대로 재사용해 여러 타이머가 서로 덮어쓰지 않는다.
    @HideFromInspector property number HitStackAtkPercent = 0
    @HideFromInspector property number KillStackAtkPercent = 0
    @HideFromInspector property number TimeStackAtkPercent = 0
    @HideFromInspector property number LowHpBonusAtkPercent = 0
    @HideFromInspector property number LuckyDayAtkPercent = 0

    -- M2 Phase C(2026-09-06) - 링크 캐릭터 실효과 연결. 공격대 편성(CharacterRosterLogic.squadLinks)에서
    -- 확정된 최대 2명의 링크 캐릭터 정보를 클라이언트가 UpdateSquadLinks로 밀어넣는다 - 로스터 자체가
    -- ClientOnly라 서버는 이 필드들 없이는 누가 링크인지 알 방법이 없다. 15레벨 미만이면 클라이언트가
    -- 애초에 채워 보내지 않지만(UpdateSquadLinks도 방어적으로 재검증), 여기 두 슬롯 자체가 비어있으면
    -- 그냥 링크 없음.
    @HideFromInspector property string LinkTrait1 = ""
    @HideFromInspector property integer LinkLevel1 = 0
    @HideFromInspector property string LinkTrait2 = ""
    @HideFromInspector property integer LinkLevel2 = 0
    -- 링크 패시브 중 potionMult/lifestealPct 계열은 ApplyModifiersToStats의 범용 채널에 없는(RequestUsePotion/
    -- PlayerAttack이 각각 별도 공식으로 소비하는) 값이라 RecalculateDerived가 매번 이 두 필드에 집계해둔다.
    @Sync property number LinkPotionMultBonus = 0
    @Sync property number LinkLifestealBonus = 0
    -- 순교자(lowHpCritMult)가 크리 데미지 배율에 얹는 보너스의 베이스라인 - RecalculateDerived가 매번
    -- (ApplyToStats 이후) 갱신해서 CombatTick의 매 틱 조건부 가산이 드리프트하지 않게 한다.
    @HideFromInspector property number BaseCritDamageMultiplier = 0
    -- 마지막으로 "웨이브당 첫 타격 확정 크리"(집중)를 소비한 웨이브 번호 - PlayerAttack.CalcCritical
    -- 참고. 여기 두는 이유: 캐릭터 교체(ApplyStats) 시 함께 리셋되어야 하는 런-스코프 상태이기 때문.
    @HideFromInspector property integer LastCritWaveNumber = -1

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Seeds sane combat defaults before the real roster stats arrive via ApplyStats
        -- (RequestEnterGame / SwapActiveCharacter), so the player never starts at 0 damage.
        self:RecalculateDerived()
    end

    @ExecSpace("ServerOnly")
    method void ApplyStats(table stats)
        -- stats = { str, dex, intel, luk, level, trait } - effective (base + equipment bonus) values
        -- computed client-side by EquipmentLogic:GetEffectiveStat, crossed over the
        -- RequestEnterGame / SwapActiveCharacter RPC boundary alongside look/equipment. `trait`
        -- piggybacks on this same table (CharacterCardController/LobbyStageController pass
        -- data.trait) rather than adding a new RPC parameter.
        self.Str = stats.str
        self.Dex = stats.dex
        self.Intel = stats.intel
        self.Luk = stats.luk
        self.Level = stats.level
        self.UnlockedMaxLevel = self:ComputeUnlockedMaxLevel(stats.upgradeLevel or 0)
        self.Trait = stats.trait or ""
        -- 3차 전직 추가 특성(Trait2)은 로스터에 영구 저장되지 않는다(레벨 자체가 이미 그런 기존
        -- 한계 - Phase 2.5 세션 기록 참고, 재입장/스왑 시 소실). 매 진입마다 새로 시작하므로 이전
        -- 캐릭터의 값이 새지 않도록 명시적으로 초기화.
        self.Trait2 = ""
        self.CurrentXp = 0
        self.XpToNextLevel = self:ComputeXpToNextLevel(self.Level)
        -- Fresh run bookkeeping - without this reset, a character that swaps in after a previous
        -- life's death would carry RunEnded=true and the ENDING screen would pop immediately.
        self.RunStartElapsed = _UtilLogic.ElapsedSeconds
        self.KillCount = 0
        self.RunEnded = false
        self.EndedWaveReached = 0
        self.EndedFieldCleared = false
        self.ReviveUsedThisRun = false
        -- M2 Phase B 2단계 - 캐릭터 교체마다 런-스코프 누적 상태를 전부 초기화(이전 캐릭터의 스택이
        -- 새 캐릭터로 새는 것을 방지 - 위 BerserkDamageBonusPercent 리셋과 동일한 이유).
        self.ShieldAmount = 0
        self.ShieldTickElapsed = 0
        self.HitStackAtkPercent = 0
        self.KillStackAtkPercent = 0
        self.TimeStackAtkPercent = 0
        self.LowHpBonusAtkPercent = 0
        self.LastCritWaveNumber = -1
        -- M2 Phase C - 캐릭터 교체마다 이전 캐릭터의 링크 정보가 새지 않도록 초기화. 실제 값은 이
        -- 직후 클라이언트의 PushSquadLinksToServer() 후속 호출(UpdateSquadLinks)이 다시 채운다.
        self.LinkTrait1 = ""
        self.LinkLevel1 = 0
        self.LinkTrait2 = ""
        self.LinkLevel2 = 0
        -- 룰렛(statReshuffle) - 입장 시 스탯 총량을 ±range 범위로 재조정 후 4종에 재분배.
        local reshuffle = _TraitEffectEngine:GetStatReshuffle(self.Trait)
        if reshuffle ~= nil then
            local total = self.Str + self.Dex + self.Intel + self.Luk
            local variance = reshuffle.range or 0
            local factor = 1 + (_UtilLogic:RandomDouble() * 2 - 1) * variance
            local newTotal = math.max(4, math.floor(total * factor))
            local vals = { 1, 1, 1, 1 }
            for i = 1, (newTotal - 4) do
                local idx = _UtilLogic:RandomIntegerRange(1, 4)
                vals[idx] = vals[idx] + 1
            end
            self.Str, self.Dex, self.Intel, self.Luk = vals[1], vals[2], vals[3], vals[4]
            log("PlayerStats: 룰렛 statReshuffle total " .. total .. " -> " .. newTotal)
        end
        -- 럭키/언럭키 데이(luckyDayRoll) - 판마다 1회 굴려 런 내내 유지되는 고정 공격력 보너스/페널티.
        self.LuckyDayAtkPercent = 0
        local luckyRoll = _TraitEffectEngine:GetLuckyDayRoll(self.Trait)
        if luckyRoll ~= nil then
            local isGood = _UtilLogic:RandomDouble() < 0.5
            self.LuckyDayAtkPercent = isGood and (luckyRoll.good or 0) or (luckyRoll.bad or 0)
            log("PlayerStats: 럭키/언럭키 데이 -> " .. (isGood and "GOOD" or "BAD") .. " atk%=" .. self.LuckyDayAtkPercent)
        end
        self:RecalculateDerived()
        self:UpdateZoneState()
        log("PlayerStats: ApplyStats str=" .. self.Str .. " dex=" .. self.Dex .. " intel=" .. self.Intel .. " luk=" .. self.Luk .. " level=" .. self.Level .. " trait=" .. self.Trait)
    end

    @ExecSpace("ServerOnly")
    method void GrantXp(integer amount)
        -- Adds kill XP and auto-levels in a loop (no player choice yet - Phase 3 replaces this with
        -- a 3-way level-up pick). Each level bumps all four stats by 1 and fully heals/restores MP.
        --
        -- 유저 리포트(2026-08-19) "버서커 특성이 아닌데 몬스터 처치 시 흡혈 효과가 있다" - 실제
        -- 원인은 RecalculateDerived()가 while 루프 밖에서 무조건 호출되고 있었던 것. 그 안의
        -- `player.Hp = maxHp`는 "레벨업 시 완전 회복"이라는 의도된 설계지만, 레벨업이 실제로
        -- 일어나지 않은 평범한 킬(XP만 쌓이고 다음 레벨 문턱을 못 넘은 경우)에도 매번 호출돼
        -- 특성/조건과 무관하게 모든 몬스터 처치가 사실상 즉시 풀피 회복으로 보였다. 실제로 레벨업이
        -- 일어난 킬에서만 호출하도록 수정 - "레벨업 시 완전 회복"은 그대로 유지, "모든 킬마다 회복"만
        -- 제거.
        --
        -- M2 Phase B(2026-09-06) - 상인은 이제 실제 드랍 시스템(물약, Monster.TryDropPotion)이 생겨
        -- 원래 의도(아이템 드랍률)로 복원됐다(DropRateMultiplier 경유) - 여기의 처치경험치+20% 임시
        -- 대체 효과는 제거. 대신 범용 특성 엔진의 ExpMultiplier(TraitEffectEngine, 견습/근면/불운/
        -- 시간여행자 등 exp 계열 특성)를 전 특성 공통으로 적용한다.
        -- M2 Phase I(2026-09-08) - 만렙(계정 강화 레벨에 따라 15~21, UnlockedMaxLevel)에 도달했으면
        -- XP 자체를 더 쌓지 않는다(누적돼도 의미 없는 값이 계속 불어나는 것을 방지).
        if self.Level >= self.UnlockedMaxLevel then
            return
        end
        amount = math.floor(amount * (1 + self.ExpMultiplier))
        self.CurrentXp = self.CurrentXp + amount
        local leveledUp = false
        local levelsGained = 0
        while self.CurrentXp >= self.XpToNextLevel and self.Level < self.UnlockedMaxLevel do
            self.CurrentXp = self.CurrentXp - self.XpToNextLevel
            self.Level = self.Level + 1
            self.Str = self.Str + 1
            self.Dex = self.Dex + 1
            self.Intel = self.Intel + 1
            self.Luk = self.Luk + 1
            self.XpToNextLevel = self:ComputeXpToNextLevel(self.Level)
            log("PlayerStats: level up -> " .. self.Level)
            self:GrantSkillTierIfMilestone(self.Level)
            leveledUp = true
            levelsGained = levelsGained + 1
        end
        if leveledUp then
            self:RecalculateDerived()
            -- 이능 팝업 - 레벨업당 1회, 큐에 쌓아뒀다가 한 번에 하나씩만 띄운다(MaybeOpenNextAbilityChoice).
            self.PendingAbilityChoices = self.PendingAbilityChoices + levelsGained
            self:MaybeOpenNextAbilityChoice()
        end
    end

    @ExecSpace("ServerOnly")
    method void GrantAbilityRerollTicket()
        -- 몬스터 게이트 클리어 보상 "이능 재선택권" (전체 기획서 §5-2) - FieldWaveSpawner.
        -- GrantGateClearRewards에서 호출. 레벨업 이능 팝업과 동일한 큐에 1회 추가한다.
        self.PendingAbilityChoices = self.PendingAbilityChoices + 1
        self:MaybeOpenNextAbilityChoice()
        log("PlayerStats: GrantAbilityRerollTicket pending=" .. self.PendingAbilityChoices)
    end

    @ExecSpace("ServerOnly")
    method void GrantPremiumStatBonus()
        -- 몬스터 게이트 클리어 보상 "고급 스탯 구슬" (전체 기획서 §5-2 "스탯 구슬 획득량 토벌 전장
        -- 대비 대폭 상승") - 레벨업 자동 증가(+1x4)보다 큰 고정 보너스를 4종 전부에 즉시 부여.
        self.Str = self.Str + 3
        self.Dex = self.Dex + 3
        self.Intel = self.Intel + 3
        self.Luk = self.Luk + 3
        self:RecalculateDerived()
        log("PlayerStats: GrantPremiumStatBonus -> str=" .. self.Str .. " dex=" .. self.Dex .. " intel=" .. self.Intel .. " luk=" .. self.Luk)
    end

    @ExecSpace("ServerOnly")
    method void MaybeOpenNextAbilityChoice()
        -- 이미 팝업이 떠 있으면 스킵(한 번에 하나만) - RequestResolveAbilityChoice가 처리 후 다시 호출.
        if self.AbilityChoicePending then return end
        if self.PendingAbilityChoices <= 0 then return end
        -- 직전 RequestResolveAbilityChoice 호출과 같은 프레임에 AbilityChoicePending을
        -- false->true로 다시 뒤집으면 클라이언트에서 두 값이 하나의 @Sync 틱으로 합쳐질 위험이 있다
        -- (이 프로젝트에 이미 여러 세션에 걸쳐 기록된 "같은 틱 @Sync 지연-가시성" 패턴 - 11차/17차
        -- 세션 Gotchas 참고). 한 틱 늦춰서 별도 sync로 보낸다.
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) then return end
            if self.AbilityChoicePending or self.PendingAbilityChoices <= 0 then return end
            self.PendingTraitPreview = self:RollDifferentTrait()
            self.AbilityChoicePending = true
            log("PlayerStats: MaybeOpenNextAbilityChoice pending=" .. self.PendingAbilityChoices .. " traitPreview=" .. self.PendingTraitPreview)
        end, 0.1)
    end

    method string RollDifferentTrait()
        -- M2 Phase B(2026-09-06) - 축소 6종 풀 대신 TraitRollLogic(전체 115종, 5풀 가중치+천장)로
        -- 이관. 현재 특성과 다른 것이 나올 때까지 재추첨하는 정책은 유지(RollDifferentTrait 내부에서
        -- 처리).
        return _TraitRollLogic:RollDifferentTrait(self.Trait)
    end

    @ExecSpace("Server")
    method void RequestResolveAbilityChoice(string choice)
        -- 클라이언트(AbilityChoiceUIController)의 선택 버튼 클릭 → 서버 RPC. senderUserId로 자기
        -- 자신의 엔티티에 대해서만 호출됐는지 검증(다른 플레이어 엔티티를 조작 못 하도록).
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if not self.AbilityChoicePending then
            return
        end
        if choice == "redistribute" then
            self:ApplyStatRedistribute()
        elseif choice == "bonus" then
            self:ApplyBonusStats()
        elseif choice == "trait" then
            self:ApplyTraitChange()
        else
            log_warning("PlayerStats: RequestResolveAbilityChoice unknown choice=" .. tostring(choice))
            return
        end
        self.PendingAbilityChoices = math.max(0, self.PendingAbilityChoices - 1)
        self.AbilityChoicePending = false
        self:RecalculateDerived()
        log("PlayerStats: RequestResolveAbilityChoice choice=" .. choice .. " -> str=" .. self.Str .. " dex=" .. self.Dex .. " intel=" .. self.Intel .. " luk=" .. self.Luk .. " trait=" .. self.Trait .. " remainingPending=" .. self.PendingAbilityChoices)
        self:MaybeOpenNextAbilityChoice()
    end

    @ExecSpace("ServerOnly")
    method void ApplyStatRedistribute()
        -- "스탯 재분배" - 보유 스탯 총량은 유지한 채 4종에 무작위로 재분배(기획서 §2-5 원문 그대로).
        -- 순수 변주용 선택지 - 순증가는 없지만 극단적인 몰빵 조합이 나올 수도 있는 도박성 옵션.
        local total = self.Str + self.Dex + self.Intel + self.Luk
        local vals = { 1, 1, 1, 1 }
        local remaining = total - 4
        for i = 1, remaining do
            local idx = _UtilLogic:RandomIntegerRange(1, 4)
            vals[idx] = vals[idx] + 1
        end
        self.Str = vals[1]
        self.Dex = vals[2]
        self.Intel = vals[3]
        self.Luk = vals[4]
    end

    @ExecSpace("ServerOnly")
    method void ApplyBonusStats()
        -- "추가 스탯" - BonusStatPoints(3)를 4종 스탯에 1점씩 무작위로 배분(안전한 순증가 옵션).
        for i = 1, self.BonusStatPoints do
            local pick = _UtilLogic:RandomIntegerRange(1, 4)
            if pick == 1 then self.Str = self.Str + 1
            elseif pick == 2 then self.Dex = self.Dex + 1
            elseif pick == 3 then self.Intel = self.Intel + 1
            else self.Luk = self.Luk + 1
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyTraitChange()
        -- "특성 변경" - 팝업이 뜰 때 이미 굴려둔 PendingTraitPreview를 그대로 적용(블라인드 아님,
        -- 유저가 미리 보고 고른 값과 실제 적용값이 항상 일치해야 하므로 여기서 다시 굴리지 않는다).
        if self.PendingTraitPreview ~= "" then
            self.Trait = self.PendingTraitPreview
        end
    end

    method boolean HasTrait(string name)
        -- Trait/Trait2(3차 전직 추가 특성) 어느 쪽이든 일치하면 true - 봉인된 자/외길/봉인구 같은
        -- 전직 상호작용 특성이 Trait2로 나왔을 경우까지 함께 커버한다.
        return self.Trait == name or self.Trait2 == name
    end

    @ExecSpace("ServerOnly")
    method void GrantSkillTierIfMilestone(integer level)
        -- 전직 레벨(기획서 §2-5: 5/13/18) 도달 판정. 2차=5, 3차=13, 4차=18. M2 Phase D(2026-09-06) -
        -- 레벨 요건을 채워도 곧바로 지급하지 않고 PromotionPending*를 세운 뒤 전직 퀘스트 보스(필드
        -- 미니보스) 처치를 기다린다(RecordBossKillForPromotion이 실제 지급을 수행).
        local tier = 0
        if level == 5 then tier = 2
        elseif level == 13 then tier = 3
        elseif level == 18 then tier = 4
        end
        if tier == 0 then return end

        -- 특성-전직 상호작용 (전체 기획서 §2-3 Hidden-bad 3종).
        if self:HasTrait("봉인된 자") then
            -- "전직을 1차까지만 가능" - 2차 이상 전부 영구 차단(대가로 시작 스탯 대폭 보너스는
            -- basicEffect의 exp 보정과 별개로 TraitCatalog 데이터에 있어야 하며, 없다면 후속 보완 필요).
            log("PlayerStats: 봉인된 자 - 전직 1차까지만 가능, tier=" .. tier .. " 요건 무시")
            return
        end
        if tier == 4 and self:HasTrait("봉인구") then
            -- "4차 전직 불가(3차까지)".
            log("PlayerStats: 봉인구 - 4차 전직 불가, tier4 요건 무시")
            return
        end

        if tier == 2 then self.PromotionPending2 = true
        elseif tier == 3 then self.PromotionPending3 = true
        else self.PromotionPending4 = true
        end
        self.PromotionMilestoneElapsed = _UtilLogic.ElapsedSeconds
        log("PlayerStats: 전직 조건(레벨" .. level .. ") 충족, tier=" .. tier .. " - 전직 퀘스트 보스(필드 미니보스) 처치 대기")
    end

    @ExecSpace("ServerOnly")
    method void RecordBossKillForPromotion()
        -- Monster.GrantXpToAttacker가 IsBoss=true 처치를 감지하면 호출. 대기 중인 전직 중 가장 낮은
        -- 티어 하나를 해결(레벨업이 몰려 여러 티어가 동시에 대기 중이어도 한 번의 보스 처치는 1개만
        -- 해소 - 실제로 그럴 일은 드물지만, 다음 미니보스로 이어서 해결하면 된다).
        local tier = 0
        if self.PromotionPending2 then tier = 2
        elseif self.PromotionPending3 then tier = 3
        elseif self.PromotionPending4 then tier = 4
        end
        if tier == 0 then return end

        if tier == 2 then self.PromotionPending2 = false
        elseif tier == 3 then self.PromotionPending3 = false
        else self.PromotionPending4 = false
        end

        self.LastPromotionClearSeconds = _UtilLogic.ElapsedSeconds - self.PromotionMilestoneElapsed
        log("PlayerStats: 전직 퀘스트 보스 처치 확인 tier=" .. tier .. " 클리어타임=" .. self.LastPromotionClearSeconds .. "초")

        -- M2 Phase H(2026-09-08) - 4차(최종) 전직만 전역 리더보드 대상(전체 기획서 §9 "전직 퀘스트
        -- 보스 클리어 타임" - 헤드라인 지표로 최종 전직 하나만 다룬다, 2/3차는 개인 로그로만 남김).
        if tier == 4 and isvalid(self.Entity.PlayerComponent) then
            local profileCode = self.Entity.PlayerComponent.ProfileCode
            local nickname = self.Entity.PlayerComponent.Nickname
            _LeaderboardLogic:SubmitPromotionClearSeconds(profileCode, nickname, self.LastPromotionClearSeconds)
        end

        -- 외길(Hidden-bad) - "스킬 슬롯 2개로 제한(1차분만 유지)/이후 전직에서 스킬 획득이 중단" -
        -- 보스는 정상적으로 처치하되(레벨/특성 진행은 막지 않음) 스킬 지급만 스킵.
        if self:HasTrait("외길") then
            log("PlayerStats: 외길 - 스킬 슬롯 2개 제한, tier=" .. tier .. " 스킬 지급 스킵")
        else
            local skillComp = self.Entity:GetComponent("script.PlayerSkillComponent")
            if isvalid(skillComp) then
                skillComp:GrantTierSkills(tier)
            end
        end

        -- M2 Phase B(2026-09-06) - 3차 전직(13레벨) 추가 특성 1회 재추첨(전체 기획서 §2-5, Trait2
        -- 선언부 주석 참고). 부패한 계약서(forceHiddenRerollAt13) 보유 시 Hidden 풀에서만 나온다.
        if tier == 3 and self.Trait2 == "" then
            if _TraitEffectEngine:HasForceHiddenRerollAt13(self.Trait) then
                self.Trait2 = _TraitRollLogic:RollHiddenPool()
            else
                self.Trait2 = _TraitRollLogic:RollDifferentTrait(self.Trait)
            end
            log("PlayerStats: 3차 전직 추가 특성 획득 -> " .. self.Trait2)
            self:RecalculateDerived()
        end
    end

    @ExecSpace("ServerOnly")
    method void AddKill()
        -- Called from Monster.GrantXpToAttacker alongside the XP grant - same trigger point, one
        -- extra counter.
        self.KillCount = self.KillCount + 1
    end

    @ExecSpace("ServerOnly")
    method void TriggerRunEnd()
        -- Called from PlayerHit.HandleHitEvent when Hp reaches 0 (Phase 4 permadeath). Freezes a
        -- stat snapshot into the Ended* fields and locks input - does NOT touch the character roster
        -- (that's ClientOnly, owned by CharacterRosterLogic) and does NOT call PlayerComponent:Respawn()
        -- - actual deletion + return-to-select only happens when the player clicks "재시작" on the
        -- ENDING screen (see Field/EndingUIController.mlua), which is a client-initiated flow and so
        -- needs no server->specific-client targeting.
        if self.RunEnded then return end
        self.EndedLevel = self.Level
        self.EndedKillCount = self.KillCount
        self.EndedSurvivalSeconds = _UtilLogic.ElapsedSeconds - self.RunStartElapsed
        -- 사망은 항상 전장(토벌전장) 안에서만 일어나므로(PlayerHit이 몬스터 접촉 피격에서만
        -- 트리거) 현재 맵의 FieldWaveSpawner를 그대로 읽는다 - 별도 추적 필드 불필요.
        local map = self.Entity.CurrentMap
        if isvalid(map) then
            local spawner = map:GetComponent("script.FieldWaveSpawner")
            if isvalid(spawner) then
                self.EndedWaveReached = spawner.WaveNumber
                self.EndedFieldCleared = spawner.FieldCleared
            end
        end
        local controller = self.Entity.PlayerControllerComponent
        if isvalid(controller) then
            controller.Enable = false
        end
        self.RunEnded = true
        self:GrantRunEndCurrency()
        log("PlayerStats: TriggerRunEnd level=" .. self.EndedLevel .. " kills=" .. self.EndedKillCount .. " survivalSeconds=" .. string.format("%.1f", self.EndedSurvivalSeconds))
    end

    @ExecSpace("ServerOnly")
    method void GrantRunEndCurrency()
        -- M2 Phase G(2026-09-06) - 전체 기획서 §6-1/§6-2 "클리어 정산 -> 계정 메타 강화". 도달
        -- 레벨/처치수/생존시간 기반으로 영구 재화(정수)를 계산해 AccountCurrencyLogic에 적립한다.
        -- 빈곤의 서약(평소 획득 0)/한탕주의(평소 획득 0, 클리어 시 5배 일확천금)는 기존 특성-전직
        -- 상호작용(봉인된 자/외길/봉인구)과 동일하게 트레잇 이름으로 직접 분기 - 이 둘은 "0으로
        -- 억제"라는 규칙이라 가산형 basicEffect 채널로 표현하기 애매하기 때문. 시간여행자만
        -- clearCurrencyBonus(가산형 채널)로 범용 엔진을 거친다.
        local player = self.Entity.PlayerComponent
        if not isvalid(player) then return end
        local baseCurrency = self.EndedLevel * 5 + self.EndedKillCount * 2 + math.floor(self.EndedSurvivalSeconds / 10)
        local granted = 0
        if self:HasTrait("빈곤의 서약") then
            granted = 0
        elseif self:HasTrait("한탕주의") then
            granted = self.EndedFieldCleared and (baseCurrency * 5) or 0
        else
            local bonus = _TraitEffectEngine:GetClearCurrencyBonus(self.Trait)
            if self.Trait2 ~= "" then
                bonus = bonus + _TraitEffectEngine:GetClearCurrencyBonus(self.Trait2)
            end
            granted = math.floor(baseCurrency * (1 + bonus))
        end
        if granted > 0 then
            _AccountCurrencyLogic:GrantCurrency(player.ProfileCode, granted, player.UserId)
        end
        log("PlayerStats: GrantRunEndCurrency base=" .. baseCurrency .. " granted=" .. granted .. " trait=" .. self.Trait)
    end

    @ExecSpace("Server")
    method void RequestUsePotion()
        -- 물약 사용 (M2 Phase A, 2026-09-06 - 전체 기획서 §3-3). 인벤토리 자체는 ClientOnly라
        -- 아이템 소모는 InventoryUIController.UsePotion이 이미 처리했고(클릭 시점에 버서크 특성도
        -- 한 번 걸러짐), 여기서는 실제 HP 회복(서버 권한 필요)만 담당 - 이중 방어로 버서크를 한 번
        -- 더 검사(클라이언트 우회로 이 RPC만 직접 호출해도 회복은 막힘, 다만 이미 소모된 물약
        -- 자체는 이 프로젝트의 다른 인벤토리 조작(장비/주문서)과 동일하게 클라이언트 신뢰 기반이라
        -- 되돌리지 않음 - 솔로 PvE라 악용 실익이 없다고 판단).
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if self.Trait == "버서크" or self.Trait2 == "버서크" or _TraitEffectEngine:IsPotionBlocked(self.Trait) or (self.Trait2 ~= "" and _TraitEffectEngine:IsPotionBlocked(self.Trait2)) then
            log("PlayerStats: RequestUsePotion rejected - " .. self.Trait .. "/" .. self.Trait2 .. " 특성")
            return
        end
        local player = self.Entity.PlayerComponent
        if not isvalid(player) or player.MaxHp <= 0 then return end
        -- M2 Phase B - 먹보를 포함한 potionMult 계열 전부 TraitCatalog/TraitEffectEngine 경유(먹보의
        -- 예전 하드코딩 x1.5는 여기서 제거 - basicEffect={potionMult=0.5}로 동일 수치 이전, 중복 적용 방지).
        -- M2 Phase C(2026-09-06) - Trait2(3차 전직 추가 특성)와 링크 패시브(LinkPotionMultBonus)의
        -- potionMult도 함께 합산(기존엔 self.Trait만 읽어 Trait2/링크 쪽 회복 보너스가 누락돼 있었음).
        local trait2Mult = (self.Trait2 ~= "") and _TraitEffectEngine:GetPotionEffectMult(self.Trait2) or 0
        local healPercent = 0.3 * (1 + _TraitEffectEngine:GetPotionEffectMult(self.Trait) + trait2Mult + self.LinkPotionMultBonus)
        local healAmount = math.floor(player.MaxHp * healPercent)
        local before = player.Hp
        player.Hp = math.min(player.MaxHp, player.Hp + healAmount)
        log("PlayerStats: RequestUsePotion healed " .. (player.Hp - before) .. " -> Hp=" .. player.Hp .. "/" .. player.MaxHp)
    end

    @ExecSpace("Server")
    method void UpdateSquadLinks(table links)
        -- M2 Phase C(2026-09-06) - CharacterRosterLogic:PushSquadLinksToServer()가 공격대 편성 확정
        -- 직후 및 캐릭터 진입/교체 직후 호출. links = 최대 2개의 { trait, level } (로스터가 ClientOnly라
        -- 서버는 이 호출 없이는 누가 링크인지 전혀 알 수 없다). 15레벨 미만은 서버에서도 한 번 더
        -- 방어적으로 걸러낸다(클라이언트가 이미 걸러 보내지만 이중 방어 - 이 프로젝트의 다른 서버
        -- RPC들과 동일한 신뢰 경계 정책, RequestUsePotion 참고). 동일 특성 중복 링크는 부록 D 규칙대로
        -- 1개만 인정.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        self.LinkTrait1 = ""
        self.LinkLevel1 = 0
        self.LinkTrait2 = ""
        self.LinkLevel2 = 0
        if links ~= nil then
            for _, link in ipairs(links) do
                if link.level >= 15 and link.trait ~= "" then
                    if self.LinkTrait1 == "" then
                        self.LinkTrait1 = link.trait
                        self.LinkLevel1 = link.level
                    elseif self.LinkTrait2 == "" and link.trait ~= self.LinkTrait1 then
                        self.LinkTrait2 = link.trait
                        self.LinkLevel2 = link.level
                    end
                end
            end
        end
        log("PlayerStats: UpdateSquadLinks link1=" .. self.LinkTrait1 .. "(Lv." .. self.LinkLevel1 .. ") link2=" .. self.LinkTrait2 .. "(Lv." .. self.LinkLevel2 .. ")")
        self:RecalculateDerived()
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Fires once RunEnded finishes syncing to this client - only ever true for the local player's
        -- own entity (nobody else's PlayerStatsComponent is relevant to this client's UI). RunEnded is
        -- written server-side LAST (after EndedLevel/EndedKillCount/EndedSurvivalSeconds - see
        -- TriggerRunEnd), but each @Sync property replicates independently and arrival order on the
        -- client is not guaranteed to match write order - reading the Ended* fields in this same tick
        -- caught them still at their pre-sync defaults (0/0/0.0) in testing, the same class of
        -- same-tick @Sync visibility artifact already documented elsewhere in this project (see
        -- Archive/As-built.md 11차 세션 Gotchas). A short deferred read gives the sibling syncs time to
        -- land first.
        if name == "RunEnded" and value == true then
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) then return end
                _EndingUIController:ShowEnding(self.EndedLevel, self.EndedKillCount, self.EndedSurvivalSeconds, self.EndedWaveReached, self.EndedFieldCleared)
                _BestRecordLogic:RequestSubmitRun(self.EndedLevel, self.EndedKillCount, self.EndedSurvivalSeconds)
            end, 0.1)
        elseif name == "AbilityChoicePending" and value == true then
            -- 같은 이유(위 RunEnded 주석 참고)로 형제 @Sync 필드(PendingTraitPreview)가 아직
            -- 도착 전일 수 있어 한 틱 늦춰 읽는다.
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) then return end
                _AbilityChoiceUIController:ShowChoice(self.Trait, self.PendingTraitPreview)
            end, 0.1)
        elseif name == "Level" then
            -- M2 Phase C(2026-09-06) - 버그 수정: 로스터의 캐릭터별 level 필드가 생성 시점(1) 이후
            -- 전혀 갱신되지 않아(As-built 기존 기록 - 재입장/스왑 시 레벨업분 소실), 링크 캐릭터의
            -- "15레벨 이상" 조건이 실질적으로 영원히 충족 불가능했다. 레벨업마다 로스터에 즉시
            -- 반영해 이 조건이 실제로 동작하게 한다.
            _CharacterRosterLogic:UpdateActiveLevel(value)
        end
    end

    method integer ComputeXpToNextLevel(integer level)
        -- M2 Phase I(2026-09-08) - MVP 선형 램프를 전체 기획서 §8-3의 1~21레벨 경험치 테이블로 교체.
        -- §8-3 원안은 "구 타깃 플레이타임(10~20분) 기준"이라고 명시돼 있고, 부록 '플레이타임 재조정'
        -- 항목이 신규 타깃(1시간)에 맞춘 전면 재산정을 요구한다. 실제 라이브 플레이테스트로 정확한
        -- 배율을 확정할 방법이 이번 세션엔 없어서(1시간짜리 실측 런은 비현실적), 원안 표의 1~14
        -- "완만한 증가"/15~21 "레벨당 1.6~1.9배 급증" 곡선 형태는 그대로 유지한 채 총량만 ×4(구
        -- 타깃 10~20분의 중간값 15분 -> 신규 타깃 60분과 동일 비율)로 스케일링했다 - 이 배율 자체는
        -- **미검증**이며, 실제 플레이 템포를 보고 사용자가 재조정할 것을 권장(원안 §8 서두 "베이스라인
        -- - 플레이테스트 후 조정"과 동일한 성격의 근사치).
        local xpTable = {
            [1] = 4000, [2] = 720, [3] = 1200, [4] = 1840, [5] = 2720,
            [6] = 3800, [7] = 5120, [8] = 6720, [9] = 8600, [10] = 10800,
            [11] = 13400, [12] = 16400, [13] = 20000, [14] = 24400, [15] = 41600,
            [16] = 72000, [17] = 124000, [18] = 220000, [19] = 396000, [20] = 752000,
        }
        return xpTable[level] or xpTable[20]
    end

    method integer ComputeUnlockedMaxLevel(integer upgradeLevel)
        -- M2 Phase I - §8-3 "16~21레벨: 해금 조건 필요"는 원안 부록 '미결 항목'에 "각 레벨별 조건
        -- 별도 설계 예정"으로 남아있던 항목이라, 이번 세션에서 자체 설계로 확정한다: 새 시스템을
        -- 만드는 대신 이미 있는 계정 영구 강화 트랙(AccountCurrencyLogic, 0~10레벨)에 자연스럽게
        -- 연결 - 강화 5~10레벨이 순서대로 16~21레벨 해금을 담당(강화 10 = 만렙 21 해금). 강화
        -- 0~4레벨 구간은 기본 캡 15(§8-3의 "완만한 증가" 구간이 끝나는 지점)로 고정.
        return math.min(21, 15 + math.max(0, upgradeLevel - 4))
    end

    @ExecSpace("ServerOnly")
    method void RecalculateDerived()
        -- Pushes the current base stats into the real combat-facing components/properties, following
        -- Docs/랜덤 플래닛 전체 기획서.md §8-1's official per-point coefficients. Called on every stat
        -- change (initial apply, level-up) so nothing else needs to poll for changes.
        local player = self.Entity.PlayerComponent
        if isvalid(player) then
            local maxHp = 50 + self.Level * 10
            player.MaxHp = maxHp
            player.Hp = maxHp
        end

        -- 균형(1차 특성) - 4스탯 전부 +1, self.Str 등 원본은 건드리지 않고(장비 보너스 표기 로직과
        -- 충돌 방지) 아래 파생 공식에만 로컬 변수로 흘려보낸다 - 공격력/크리/명중/공속/이동속도까지
        -- 전부 자연히 함께 오르는 실제 "시너지"(단일 수치가 아니라 캐릭터 전체 파생 스탯에 전파).
        local traitStatBonus = (self.Trait == "균형" or self.Trait2 == "균형") and 1 or 0
        local effStr = self.Str + traitStatBonus
        local effDex = self.Dex + traitStatBonus
        local effInt = self.Intel + traitStatBonus
        local effLuk = self.Luk + traitStatBonus

        -- INT primary: 최대 MP +3/pt (real resource). Skill damage bonus is inert until Phase 3.
        self.MaxMp = 20 + effInt * 3
        self.CurrentMp = self.MaxMp
        self.SkillDamageBonus = effInt * 0.015
        -- INT secondary: 스킬 쿨다운 감소 - inert until Phase 3 (no skill system yet).
        self.SkillCooldownReduction = math.min(0.5, effInt * 0.01)
        -- STR secondary: 넉백 저항 - inert until a monster-attacks-player pipeline exists.
        self.KnockbackResistance = math.min(0.8, effStr * 0.02)
        -- LUK secondary: 회피 +0.2%/pt - inert until a monster-attacks-player pipeline exists.
        self.EvasionPercent = effLuk * 0.002

        -- 단단함(1차 특성) - 방어력 소폭 증가. 실제 피격 파이프라인이 없어 아직 데미지 경감 자체는
        -- 관측 불가하지만, CP 산식(CharacterInfoUIController)에는 배율로 실제 반영된다.
        self.DamageReductionPercent = (self.Trait == "단단함" or self.Trait2 == "단단함") and 0.12 or 0
        -- 버서크 보너스는 여기서 0으로 리셋 - 버서크가 아니면 BerserkTick 타이머가 애초에 돌지
        -- 않으므로(UpdateBerserkZoneState) 특성을 바꾼(캐릭터 교체) 경우에도 이전 보정이 남지 않는다.
        self.BerserkDamageBonusPercent = 0
        -- M2 Phase B 범용 채널도 매번 리셋 후 아래 엔진 호출이 다시 채운다(특성 변경 시 이전 값이
        -- 남지 않도록 - 위 버서크 리셋과 동일한 이유).
        self.MpCostMultiplier = 0
        self.DropRateMultiplier = 0
        self.ExpMultiplier = 0

        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(attack) then
            -- STR primary: 물리 공격력. 기획서 원안은 +2/pt이지만, STR이 캡 없는 선형 증가인 반면
            -- DEX(공격속도, 상한+100%)/LUK(크리확률, 상한60%)는 %기반+상한이 있어 몰빵 시 순수 DPS가
            -- 2.8~3배까지 벌어짐(실측 2026-08-06) - 사용자 결정에 따라 +1.5/pt로 소폭 완화.
            attack.AttackDamage = 10 + effStr * 1.5
            self.BaseAttackDamage = attack.AttackDamage
            -- LUK primary: 크리 확률 +0.3%/pt (상한 60%), 크리 데미지 +0.5%/pt.
            attack.CriticalChance = math.min(0.6, 0.05 + effLuk * 0.003)
            attack.CritDamageMultiplier = math.min(3.0, 1.5 + effLuk * 0.005)
            -- DEX primary: 공격 속도 +0.5%/pt (상한 +100%) -> cooldown shrinks proportionally.
            local attackSpeedBonus = math.min(1.0, effDex * 0.005)
            attack.AttackCooldownSeconds = 0.6 / (1 + attackSpeedBonus)
            -- DEX primary: 명중 +1/pt.
            attack.Accuracy = 90 + effDex * 1
        end

        -- DEX secondary: 이동 속도 (no official per-point number in the design doc - tuned value).
        -- Base lowered 3.0->1.5 (2026-08-16, user request: engine default is 1.0 and 3.0 felt too
        -- fast in actual play - skill VFX visibly couldn't keep up with the character at that speed).
        local move = self.Entity.MovementComponent
        if isvalid(move) then
            move.InputSpeed = 1.5 + effDex * 0.08
            -- 날렵함(1차 특성) - 이동 속도 직접 가산. 순수 유틸 스탯이라 CP에는 반영하지 않음(다른
            -- 게임의 "전투력"도 보통 이동속도는 제외 - §"현재 전투력 공식" 참고).
            if self.Trait == "날렵함" or self.Trait2 == "날렵함" then
                move.InputSpeed = move.InputSpeed + 0.6
            end
        end

        -- M2 Phase B - 신규 109종 특성의 플랫/퍼센트 계열 효과 적용(legacy 특성은 위에서 이미
        -- 처리됐으므로 엔진이 조용히 no-op). 반드시 STR/DEX/INT/LUK 파생 계산이 끝난 뒤에 호출해야
        -- 곱연산 순서가 맞는다(예: atk% 특성이 STR 기반 공격력 위에 곱해짐).
        _TraitEffectEngine:ApplyToStats(self, self.Trait, effStr, effDex, effInt, effLuk)
        -- 3차 전직 추가 특성(Trait2) - 있으면 같은 스탯 채널 위에 한 번 더 곱연산으로 적용된다(두
        -- 특성의 효과가 함께 누적).
        if self.Trait2 ~= "" then
            _TraitEffectEngine:ApplyToStats(self, self.Trait2, effStr, effDex, effInt, effLuk)
        end

        -- M2 Phase C(2026-09-06) - 링크 캐릭터(LinkTrait1/2, UpdateSquadLinks가 채움) 링크 패시브 적용.
        -- 본인 특성(Trait/Trait2) 기준 효율 보정계수(링크 마스터/박애주의자/친화력/외골수/고독)를 먼저
        -- 구해 두 링크 슬롯 모두에 동일하게 곱한다(부록 D-6: 이 계수는 "내가 받는 링크 효과" 전체에
        -- 적용되지 링크 캐릭터별로 다르지 않음).
        self.LinkPotionMultBonus = 0
        self.LinkLifestealBonus = 0
        local linkEfficiency = _TraitEffectEngine:GetLinkEfficiencyMultiplier(self.Trait, self.Trait2)
        if self.LinkTrait1 ~= "" then
            _TraitEffectEngine:ApplyLinkToStats(self, self.LinkTrait1, linkEfficiency)
            self.LinkPotionMultBonus = self.LinkPotionMultBonus + _TraitEffectEngine:GetLinkPotionMult(self.LinkTrait1) * linkEfficiency
            self.LinkLifestealBonus = self.LinkLifestealBonus + _TraitEffectEngine:GetLinkLifestealBonus(self.LinkTrait1) * linkEfficiency
        end
        if self.LinkTrait2 ~= "" then
            _TraitEffectEngine:ApplyLinkToStats(self, self.LinkTrait2, linkEfficiency)
            self.LinkPotionMultBonus = self.LinkPotionMultBonus + _TraitEffectEngine:GetLinkPotionMult(self.LinkTrait2) * linkEfficiency
            self.LinkLifestealBonus = self.LinkLifestealBonus + _TraitEffectEngine:GetLinkLifestealBonus(self.LinkTrait2) * linkEfficiency
        end

        -- M2 Phase B 2단계 - 순교자(lowHpCritMult)의 저체력 크리데미지 가산이 매 CombatTick마다 이
        -- 베이스라인 위에 얹힌다(ApplyToStats 이후 시점의 크리데미지를 기준으로 삼아야 저격수/행운아
        -- 등 다른 크리데미지 특성과 정확히 합산됨). 동적 공격력 보너스(버서크/스택/저체력/럭키데이)도
        -- 여기서 한 번 재적용해 레벨업으로 BaseAttackDamage가 바뀌어도 누적 스택이 유지되도록 한다.
        if isvalid(attack) then
            self.BaseCritDamageMultiplier = attack.CritDamageMultiplier
        end
        self:RecomputeDynamicAttackDamage()

        local attackDamage = isvalid(attack) and attack.AttackDamage or -1
        local critChance = isvalid(attack) and attack.CriticalChance or -1
        local critMult = isvalid(attack) and attack.CritDamageMultiplier or -1
        local cooldown = isvalid(attack) and attack.AttackCooldownSeconds or -1
        local accuracy = isvalid(attack) and attack.Accuracy or -1
        local inputSpeed = isvalid(move) and move.InputSpeed or -1
        local maxHp = isvalid(player) and player.MaxHp or -1
        log("PlayerStats: RecalculateDerived maxHp=" .. maxHp .. " maxMp=" .. self.MaxMp .. " attackDamage=" .. attackDamage .. " critChance=" .. critChance .. " critMult=" .. critMult .. " cooldown=" .. cooldown .. " accuracy=" .. accuracy .. " inputSpeed=" .. inputSpeed)
    end

    @ExecSpace("ServerOnly")
    method void OnMapEnter(Entity mapEntity)
        -- 맵 이동마다(마을<->전투 지형) 버서크 자해 DoT·마을 자동 회복을 켜고 끄기 위한 판정 갱신.
        self:UpdateZoneState()
    end

    @ExecSpace("ServerOnly")
    method void OnMapLeave(Entity mapEntity)
        -- 다음 맵의 OnMapEnter가 다시 판정하므로, 여기서는 일단 두 타이머를 모두 멈춰 전 맵의
        -- 효과가 새 맵으로 새는 것을 막는다(전투 지형->전투 지형 이동이어도 OnMapEnter가 바로
        -- 재시작함).
        self:StopBerserkTimer()
        self:StopTownRegenTimer()
        self:StopCombatTimer()
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:StopBerserkTimer()
        self:StopTownRegenTimer()
        self:StopCombatTimer()
    end

    @ExecSpace("ServerOnly")
    method void UpdateZoneState()
        -- 마을(Lobby)·캐릭터 선택(choice_map)은 비전투 지형이라 버서크 자해 DoT를 끄고 대신 자동
        -- 체력/마나 회복을 켠다. 아직 실제로 연결된 전투 맵이 없어(토벌전장1~3은 RootDesk/MyDesk/test/에
        -- 검증만 된 상태, 유저의 Task 1 작업 대기 중) 화이트리스트가 아닌 "안전지대 목록에 없으면
        -- 전투 지형"으로 판정 - 나중에 실제 전투 맵이 연결돼도 코드 수정 없이 자동으로 전투 지형
        -- 취급된다.
        local map = self.Entity.CurrentMap
        local mapName = isvalid(map) and map.Name or ""
        local inSafeZone = (mapName == "Lobby") or (mapName == "choice_map")

        if (self.Trait == "버서크" or self.Trait2 == "버서크") and not inSafeZone then
            self:StartBerserkTimer()
        else
            self:StopBerserkTimer()
            -- 안전지대에서는 반응형 공격력 보정을 즉시 되돌려 항상 기본 공격력으로 되돌아오게
            -- 한다(전투 지형에서 빠져나온 순간 직전 체력 비율 기준 보너스만 남아있는 것을 방지).
            self.BerserkDamageBonusPercent = 0
            self:RecomputeDynamicAttackDamage()
        end

        if inSafeZone then
            self:StartTownRegenTimer()
            self:StopCombatTimer()
            -- 안전지대 진입 시 방어막·저체력 보너스도 함께 정리(전투 지형 밖에서 남아있으면 다음
            -- 전장 재입장 때 혼란스러운 잔여 상태가 될 수 있음).
            self.ShieldAmount = 0
            self.LowHpBonusAtkPercent = 0
            self:RecomputeDynamicAttackDamage()
        else
            self:StopTownRegenTimer()
            self:StartCombatTimer()
        end
        log("PlayerStats: UpdateZoneState map=" .. mapName .. " safe=" .. tostring(inSafeZone) .. " trait=" .. self.Trait .. " berserkTimerActive=" .. tostring(self.BerserkTimerId ~= 0) .. " regenTimerActive=" .. tostring(self.TownRegenTimerId ~= 0) .. " combatTimerActive=" .. tostring(self.CombatTimerId ~= 0))
    end

    method void StartBerserkTimer()
        -- 이미 돌고 있으면 중복 시작하지 않는다(맵 재판정이 여러 경로에서 호출될 수 있음).
        if self.BerserkTimerId ~= 0 then return end
        self.BerserkTimerId = _TimerService:SetTimerRepeat(self.BerserkTick, 1.0)
    end

    method void StopBerserkTimer()
        if self.BerserkTimerId ~= 0 then
            _TimerService:ClearTimer(self.BerserkTimerId)
            self.BerserkTimerId = 0
        end
    end

    method void StartTownRegenTimer()
        -- 이미 돌고 있으면 중복 시작하지 않는다(맵 재판정이 여러 경로에서 호출될 수 있음).
        if self.TownRegenTimerId ~= 0 then return end
        self.TownRegenTimerId = _TimerService:SetTimerRepeat(self.TownRegenTick, 1.0)
    end

    method void StopTownRegenTimer()
        if self.TownRegenTimerId ~= 0 then
            _TimerService:ClearTimer(self.TownRegenTimerId)
            self.TownRegenTimerId = 0
        end
    end

    method void StartCombatTimer()
        -- 버서크 전용 타이머와 별개로, 특성과 무관하게 전투 지형에서 항상 도는 1Hz 틱 - 여러 다른
        -- 특성(재생력/투지/순교자/시한폭탄/마나실드/수호자/유리몸)이 여기 얹혀서 각자 자기 basicEffect
        -- 필드가 있을 때만 반응한다(없으면 CombatTick 내부에서 조용히 스킵).
        if self.CombatTimerId ~= 0 then return end
        self.CombatTimerId = _TimerService:SetTimerRepeat(self.CombatTick, 1.0)
    end

    method void StopCombatTimer()
        if self.CombatTimerId ~= 0 then
            _TimerService:ClearTimer(self.CombatTimerId)
            self.CombatTimerId = 0
        end
    end

    @ExecSpace("ServerOnly")
    method void RecomputeDynamicAttackDamage()
        -- 버서크(BerserkDamageBonusPercent) + M2 Phase B 2단계 누적/조건부 보너스(HitStack/KillStack/
        -- TimeStack/LowHpBonus/LuckyDay)를 전부 BaseAttackDamage 위에 한 번에 곱해 적용한다 - 여러
        -- 타이머(BerserkTick/CombatTick)가 매번 attack.AttackDamage를 직접 덮어쓰면 서로의 값을
        -- 지워버리므로, 항상 이 메서드 하나만 실제 쓰기를 담당하게 한다.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if not isvalid(attack) then return end
        local totalBonus = self.BerserkDamageBonusPercent + self.HitStackAtkPercent + self.KillStackAtkPercent + self.TimeStackAtkPercent + self.LowHpBonusAtkPercent + self.LuckyDayAtkPercent
        attack.AttackDamage = self.BaseAttackDamage * (1 + totalBonus)
    end

    @ExecSpace("ServerOnly")
    method void CombatTick()
        -- 전투 지형에서 1초마다 실행(StartCombatTimer 참고) - 아래 각 항목은 해당 특성의 basicEffect
        -- 필드가 없으면 함수 초입에서 nil 체크로 조용히 스킵된다(범용 엔진과 동일한 no-op 원칙).
        local player = self.Entity.PlayerComponent
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if not isvalid(player) or not isvalid(attack) or player.MaxHp <= 0 or player.Hp <= 0 then return end
        local hpRatio = player.Hp / player.MaxHp

        -- 투지(lowHpAtkMult) - 체력이 threshold 이하일 때만 공격력 보너스 활성.
        local atkMult = _TraitEffectEngine:GetLowHpAtkMult(self.Trait)
        if atkMult ~= nil and hpRatio <= (atkMult.threshold or 1.0) then
            self.LowHpBonusAtkPercent = atkMult.value or 0
        else
            self.LowHpBonusAtkPercent = 0
        end
        self:RecomputeDynamicAttackDamage()

        -- 순교자(lowHpCritMult) - 체력이 threshold 이하일 때만 크리 데미지 배율 가산.
        local critMult = _TraitEffectEngine:GetLowHpCritMult(self.Trait)
        if critMult ~= nil then
            if hpRatio <= (critMult.threshold or 1.0) then
                attack.CritDamageMultiplier = self.BaseCritDamageMultiplier + (critMult.value or 0)
            else
                attack.CritDamageMultiplier = self.BaseCritDamageMultiplier
            end
        end

        -- 시한폭탄(timeStackAtk) - 초당 누적, 상한까지.
        local timeStack = _TraitEffectEngine:GetTimeStackAtk(self.Trait)
        if timeStack ~= nil then
            self.TimeStackAtkPercent = math.min(timeStack.cap or 1.0, self.TimeStackAtkPercent + (timeStack.perSecond or 0))
            self:RecomputeDynamicAttackDamage()
        end

        -- 재생력/회복가(regenIfUnhit) - 마지막 피격 후 seconds 이상 지났으면 초당 회복.
        local regenSpec = _TraitEffectEngine:GetRegenIfUnhit(self.Trait)
        if regenSpec ~= nil then
            local hitComp = self.Entity:GetComponent("script.PlayerHit")
            local sinceHit = isvalid(hitComp) and (_UtilLogic.ElapsedSeconds - hitComp.LastHitElapsed) or 999
            if sinceHit >= (regenSpec.seconds or 0) and player.Hp < player.MaxHp then
                player.Hp = math.min(player.MaxHp, player.Hp + player.MaxHp * (regenSpec.pct or 0))
            end
        end

        -- 마나실드/수호자/유리몸(periodicShield/periodicShieldGrant) - interval초마다 방어막 재생성.
        -- 이 프로젝트엔 몬스터 공격에 "치명타" 개념이 없어 수호자의 "치명타 무효"는 방어막으로 근사.
        local shieldSpec = _TraitEffectEngine:GetShieldSpec(self.Trait)
        if shieldSpec ~= nil then
            self.ShieldTickElapsed = self.ShieldTickElapsed + 1
            if self.ShieldTickElapsed >= (shieldSpec.interval or 999999) then
                self.ShieldTickElapsed = 0
                self.ShieldAmount = math.floor(player.MaxHp * (shieldSpec.pct or 0))
                log("PlayerStats: periodic shield granted amount=" .. self.ShieldAmount)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void BerserkTick()
        -- 2026-08-25 재설계 (유저 실전 리포트 "버서크가 사실상 못 쓸 정도의 쓰레기" + 직접 시뮬레이션
        -- 검증) - 기존엔 매초 최대체력의 3%를 자기 자신에게 실제로 깎는 자해 DoT였다(바닥 25%). 동일
        -- 몬스터 압박(1.5초마다 10데미지 단일 몬스터 기준)에서 무특성 대비 실제 생존 시간을 시뮬레이션한
        -- 결과 버서크만 20틱 중 14틱에 사망(무특성/균형/날렵함/절약가는 전부 20틱 끝까지 생존,
        -- 단단함은 20틱째 60%나 남김) - 자해로 미리 깎아먹은 체력이 실제 몬스터 피해를 버틸 완충
        -- 여력을 줄여, 공격력 보너스가 보상하기도 전에 죽는 순생존시간 손해였다(퍼머데스라 이 손해가
        -- 특히 치명적 - "다른 특성보다 약하다"가 아니라 "특성이 없는 것보다도 못하다"는 게 문제).
        --
        -- 자해 DoT를 완전히 제거하고, 실제로 몬스터에게 맞아 깎인 체력 비율에 비례해 실시간으로
        -- 공격력이 오르는 순수 반응형 방식으로 재설계 - 자기 체력을 스스로 깎지 않으므로 다른
        -- 특성보다 생존이 나빠지는 경우가 구조적으로 없어졌다("다치수록 강해진다"는 플레이버는
        -- 유지, "살수록 약해진다"는 자해였던 부분이라 제거). BaseAttackDamage(RecalculateDerived가
        -- 매번 갱신) 기준으로 매번 곱해서 세팅하므로 스탯 재계산과 충돌하거나 값이 누적 드리프트하지
        -- 않는다.
        local player = self.Entity.PlayerComponent
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if not isvalid(player) or not isvalid(attack) or player.MaxHp <= 0 then return end

        local hpRatio = math.max(0, player.Hp) / player.MaxHp
        self.BerserkDamageBonusPercent = (1 - hpRatio) * self.BerserkBonusCoef
        -- M2 Phase B 2단계 - 다른 특성의 동적 보너스(스택/저체력/럭키데이)와 공존할 수 있도록 직접
        -- 쓰기 대신 공용 메서드를 통해 적용(RecomputeDynamicAttackDamage 참고).
        self:RecomputeDynamicAttackDamage()
    end

    @ExecSpace("ServerOnly")
    method void TownRegenTick()
        -- 안전지대(마을)에 있는 동안 실제 1초마다 정확히 한 번, 특성과 무관하게 Hp는 최대체력의
        -- 8%를, Mp는 최대마나의 10%를 회복시킨다(유저 요청 두 건: Hp 자동회복 -> Mp 자동회복).
        -- 버서크가 마을 진입 즉시 타이머를 끄고 공격력만 리셋하지만 체력 자체는 손대지 않으므로
        -- (전투 지형에서 낮아진 체력이 남아있음) 이 타이머가 그걸 서서히 채워준다. 이미 꽉 찼으면
        -- 그냥 클램프만 될 뿐이라 타이머를 계속 돌려도 무해하다. Mp는 PlayerComponent가 아니라
        -- 이 스크립트 자신의 CurrentMp/MaxMp(RecalculateDerived가 매번 갱신)에 저장되므로
        -- PlayerAttack처럼 별도 컴포넌트 조회가 필요 없다.
        local player = self.Entity.PlayerComponent
        if not isvalid(player) or player.MaxHp <= 0 then return end
        if player.Hp < player.MaxHp then
            player.Hp = math.min(player.MaxHp, player.Hp + player.MaxHp * self.TownRegenPercent)
            log("PlayerStats: TownRegenTick healed to Hp=" .. player.Hp .. "/" .. player.MaxHp)
        end
        if self.MaxMp > 0 and self.CurrentMp < self.MaxMp then
            self.CurrentMp = math.min(self.MaxMp, self.CurrentMp + self.MaxMp * self.TownMpRegenPercent)
            log("PlayerStats: TownRegenTick restored Mp=" .. self.CurrentMp .. "/" .. self.MaxMp)
        end
    end

end
