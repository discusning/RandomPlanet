    method boolean HasTrait(string name)
        -- Trait/Trait2(3차 전직 추가 특성) 어느 쪽이든 일치하면 true - 봉인된 자/외길/봉인구 같은
        -- 전직 상호작용 특성이 Trait2로 나왔을 경우까지 함께 커버한다.
        return self.Trait == name or self.Trait2 == name
    end

