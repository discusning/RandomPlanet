@Component
script PlayerInputBinding extends Component

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Attack/Skill key binding now lives in KeyBindingLogic (loaded/saved per-player,
        -- rebindable via the KeySetting popup) so there's a single source of truth for
        -- these action-key mappings instead of two places calling SetActionKey independently.
        -- Applies current defaults immediately; KeyBindingLogic re-applies again once the
        -- player's saved bindings finish loading (see KeyBindingLogic.OnBindingsLoaded).
        _KeyBindingLogic:ApplyBindingsToLocalPlayer(self.Entity)
    end

end
