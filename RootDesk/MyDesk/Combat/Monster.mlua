@Component
script Monster extends Component

    @Sync property number MaxHp = 100
    @Sync property number Hp = 0
    @Sync property boolean RespawnOn = false
    @Sync @HideFromInspector property boolean IsDead = false
    @Sync property number RespawnDelay = 5
    @Sync property number DestroyDelay = 0.6
    property string DamageSkinRUID = "02c22d93421b4038b3c413b3e40b57ec"
    property integer XpReward = 20
    -- Countered by the attacker's DEX-driven Accuracy stat (PlayerAttack.IsAttackTarget) - see
    -- Docs/랜덤 플래닛 전체 기획서.md §2-2 (민첩 -> 명중). 0 for a basic monster like this test slime;
    -- future tougher/evasive monster types can raise it.
    property number Evasion = 0

    method void OnBeginPlay()
        -- Initializes HP and wires the defender-side damage skin id.
        self.Hp = self.MaxHp
        local skinSetting = self.Entity.DamageSkinSettingComponent
        if isvalid(skinSetting) then
            skinSetting.DamageSkinId = DataRef(self.DamageSkinRUID)
        end
    end

    @ExecSpace("ServerOnly")
    method void Dead()
        -- Flips to the DEAD state, then hides/destroys (or schedules respawn).
        self.IsDead = true
        local sc = self.Entity.StateComponent
        if sc then sc:ChangeState("DEAD") end
        local delayHide = function()
            self.Entity:SetVisible(false)
            self.Entity:SetEnable(false)
            if self.RespawnOn == false then self.Entity:Destroy() end
        end
        _TimerService:SetTimerOnce(delayHide, self.DestroyDelay)
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
        -- Restores visibility/HP and returns to IDLE.
        self.IsDead = false
        self.Entity:SetVisible(true)
        self.Entity:SetEnable(true)
        self.Hp = self.MaxHp
        local sc = self.Entity.StateComponent
        if sc then sc:ChangeState("IDLE") end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- Applies incoming damage and triggers death once HP reaches 0.
        local originalHp = self.Hp
        self.Hp = self.Hp - event.TotalDamage
        if self.Hp > 0 or originalHp <= 0 then return end
        self:GrantXpToAttacker(event.AttackerEntity)
        self:Dead()
        if self.RespawnOn then
            _TimerService:SetTimerOnce(function() self:Respawn() end, self.RespawnDelay)
        end
    end

    @ExecSpace("ServerOnly")
    method void GrantXpToAttacker(Entity attacker)
        -- Awards this monster's XpReward to the killer's PlayerStatsComponent, if any (a monster
        -- killed with no recorded attacker simply grants nothing).
        if not isvalid(attacker) then return end
        local stats = attacker:GetComponent("script.PlayerStatsComponent")
        if isvalid(stats) then
            stats:GrantXp(self.XpReward)
        end
    end

end
