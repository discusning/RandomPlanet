@Component
script Monster extends Component

    @Sync property number MaxHp = 100
    @Sync property number Hp = 0
    @Sync property boolean RespawnOn = false
    @Sync @HideFromInspector property boolean IsDead = false
    @Sync property number RespawnDelay = 5
    @Sync property number DestroyDelay = 0.6
    property string DamageSkinRUID = "02c22d93421b4038b3c413b3e40b57ec"
    -- Classic MapleStory hit spark (red 4-point flash) - user request 2026-08-19: "몬스터 피격
    -- 이펙트를 옛날 메이플 피격 이펙트랑 같게" (the native HitEffectSpawnerComponent has zero
    -- configurable properties per its .d.mlua, so it can't be pointed at a specific RUID - this
    -- manual PlayEffect call is the only way to get the authentic classic look, following the same
    -- pattern PlayerSkillComponent already uses for skill hit VFX).
    property string HitVfxRuid = "5542826f767a4bbd989ca62f22a53fa3"
    property integer XpReward = 20
    -- Countered by the attacker's DEX-driven Accuracy stat (PlayerAttack.IsAttackTarget) - see
    -- Docs/랜덤 플래닛 전체 기획서.md §2-2 (민첩 -> 명중). 0 for a basic monster like this test slime;
    -- future tougher/evasive monster types can raise it.
    property number Evasion = 0
    @Sync @HideFromInspector property boolean DisorderActive = false
    @HideFromInspector property number DisorderOriginalEvasion = 0
    -- 2026-09-10 QA - 차원의 틈 링크("중력 지원": 크리 시 낮은 확률로 적 이동속도 감소) 전용.
    -- ApplyDisorder와 동일한 원본값 추적+타이머 복원 패턴.
    @HideFromInspector property boolean GravitySlowActive = false
    @HideFromInspector property number GravitySlowOriginalInputSpeed = 0
    -- 2026-09-10 QA - 저주의 표식 링크("표식의 저주": 파티 공격이 적에게 표식 부여, 표식 대상
    -- 피해+8%) 전용. PlayerAttack.CalcDamage가 직접 읽고 쓴다.
    @HideFromInspector property number MarkedUntilElapsed = 0
    -- 물약 시스템 (M2 Phase A, 2026-09-06 - 전체 기획서 §3-3 "회복 아이템: 드랍으로 획득"). 퍼센트
    -- 정수(0~100) - 기본 12%로 시작, 전장 몬스터별로 `MapBuilder.patchComponent`나 개별 `.model`
    -- 값으로 오버라이드 가능(FieldMonster1~3 티어별 밸런스 조정과 동일 패턴).
    property integer PotionDropChance = 12
    -- M2 Phase B 2단계(2026-09-06) - 동전 던지기 사형집행인(onCritExecuteChance)의 "보스 제외" 규칙용.
    -- 기본값 false, 미니보스 개체(FieldMiniBoss)만 true로 오버라이드된다.
    property boolean IsBoss = false

    method void OnBeginPlay()
        -- Initializes HP and wires the defender-side damage skin id.
        self.Hp = self.MaxHp
        local skinSetting = self.Entity.DamageSkinSettingComponent
        if isvalid(skinSetting) then
            skinSetting.DamageSkinId = DataRef(self.DamageSkinRUID)
        end
    end

    @ExecSpace("ServerOnly")
    method void Dead()
        -- Flips to the DEAD state, then hides/destroys (or schedules respawn).
        self.IsDead = true
        local sc = self.Entity.StateComponent
        if sc then sc:ChangeState("DEAD") end
        local delayHide = function()
            self.Entity:SetVisible(false)
            self.Entity:SetEnable(false)
            if self.RespawnOn == false then self.Entity:Destroy() end
        end
        _TimerService:SetTimerOnce(delayHide, self.DestroyDelay)
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
        -- Restores visibility/HP and returns to IDLE.
        self.IsDead = false
        self.Entity:SetVisible(true)
        self.Entity:SetEnable(true)
        self.Hp = self.MaxHp
        local sc = self.Entity.StateComponent
        if sc then sc:ChangeState("IDLE") end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- Applies incoming damage and triggers death once HP reaches 0.
        local originalHp = self.Hp
        self.Hp = self.Hp - event.TotalDamage
        if self.HitVfxRuid ~= "" then
            _EffectService:PlayEffect(self.HitVfxRuid, self.Entity, Vector3(event.AttackCenter.x, event.AttackCenter.y, 0), 0, Vector3(1, 1, 1), false)
        end
        if self.Hp > 0 or originalHp <= 0 then return end
        -- 2026-09-12 시스템 업그레이드 - 처치 임팩트("킬 피드백", RoR2/Hades류 액션 게임 관행).
        -- 파티클 버스트는 모든 관전자에게 보여야 하는 월드 이펙트라 서버(ServerOnly인 이 핸들러)가
        -- 직접 재생 - 위의 HitVfxRuid 히트 스파크와 동일한 호출 패턴(_EffectService:PlayEffect가
        -- 이미 이 자리에서 서버 사이드로 정상 동작 중이므로 같은 계열인 _ParticleService도 동일하게
        -- 동작할 것으로 판단, 실측으로 확정 예정). 카메라 셰이크만 처치자 본인에게 국한되는 개인
        -- 연출이라 CombatFeelLogic의 Client RPC로 분리.
        local burstType = self.IsBoss and BasicParticleType.BigExplosion or BasicParticleType.SmallExplosion
        _ParticleService:PlayBasicParticle(burstType, self.Entity, Vector3(event.AttackCenter.x, event.AttackCenter.y, 0), 0, Vector3.one, false)
        if isvalid(event.AttackerEntity) then
            local attackerPlayer = event.AttackerEntity.PlayerComponent
            if isvalid(attackerPlayer) then
                _CombatFeelLogic:PlayKillImpact(self.IsBoss, attackerPlayer.UserId)
            end
        end
        self:GrantXpToAttacker(event.AttackerEntity)
        self:Dead()
        if self.RespawnOn then
            _TimerService:SetTimerOnce(function() self:Respawn() end, self.RespawnDelay)
        end
    end

    @ExecSpace("ServerOnly")
    method void TakeReflectedDamage(number amount)
        -- 거울 갑옷 특성(PlayerHit.HandleHitEvent)의 피해 반사 전용 진입점 - 일반 HandleHitEvent(실제
        -- HitEvent 기반)를 타지 않고 직접 Hp만 깎아, 반사 데미지가 다시 새 HitEvent를 만들어 서로
        -- 무한 반사하는 상황 자체를 원천 차단한다. 처치까지는 이어지되(Dead 호출), XP 지급은 하지
        -- 않는다(반사로 죽은 경우 "누가 처치했는가"가 모호한 엣지 케이스 - 의도적으로 생략).
        if self.IsDead or amount <= 0 then return end
        local originalHp = self.Hp
        self.Hp = self.Hp - amount
        if self.Hp > 0 or originalHp <= 0 then return end
        self:Dead()
    end

    @ExecSpace("ServerOnly")
    method void ExecuteKill(Entity attacker)
        -- 동전 던지기 사형집행인(크리 시 낮은 확률 즉사, 보스 제외) 전용 처치 경로 - PlayerAttack.OnAttack이
        -- 크리 판정 직후 호출한다. HandleHitEvent와 동일한 처치 시퀀스(XP 지급 + Dead)를 그대로 재사용.
        if self.IsDead or self.IsBoss then return end
        self.Hp = 0
        self:GrantXpToAttacker(attacker)
        self:Dead()
    end

    @ExecSpace("ServerOnly")
    method void ApplyDisorder(number evasionReduction, number duration)
        -- 도적 1차 액티브 "디스에이블" 대상 - 진짜 원본 효과(적 회피 감소) 그대로, 이미 살아있는
        -- Evasion 소비처(PlayerAttack.IsAttackTarget의 명중 굴림)를 재사용하므로 새 파이프라인
        -- 불필요. 재시전으로 값이 누적되지 않도록 활성 중이면 먼저 원래 값으로 되돌린 뒤 다시 적용.
        if self.DisorderActive then
            self.Evasion = self.DisorderOriginalEvasion
        end
        self.DisorderOriginalEvasion = self.Evasion
        self.Evasion = self.Evasion - evasionReduction
        self.DisorderActive = true
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) then
                self.Evasion = self.DisorderOriginalEvasion
                self.DisorderActive = false
            end
        end, duration)
    end

    @ExecSpace("ServerOnly")
    method void ApplyGravitySlow(number pct, number duration)
        -- 2026-09-10 QA - 차원의 틈 링크("중력 지원": 크리 시 낮은 확률로 적 이동속도 감소) 신규
        -- 연결. ApplyDisorder와 동일한 원본값 추적+타이머 복원 패턴(재시전으로 값이 누적되지 않도록
        -- 활성 중이면 먼저 원래 값으로 되돌린 뒤 다시 적용).
        local move = self.Entity.MovementComponent
        if not isvalid(move) then return end
        if self.GravitySlowActive then
            move.InputSpeed = self.GravitySlowOriginalInputSpeed
        end
        self.GravitySlowOriginalInputSpeed = move.InputSpeed
        move.InputSpeed = move.InputSpeed * (1 - pct)
        self.GravitySlowActive = true
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) then
                local m = self.Entity.MovementComponent
                if isvalid(m) then m.InputSpeed = self.GravitySlowOriginalInputSpeed end
                self.GravitySlowActive = false
            end
        end, duration)
    end

    @ExecSpace("ServerOnly")
    method void GrantXpToAttacker(Entity attacker)
        -- Awards this monster's XpReward to the killer's PlayerStatsComponent, if any (a monster
        -- killed with no recorded attacker simply grants nothing).
        if not isvalid(attacker) then return end
        local stats = attacker:GetComponent("script.PlayerStatsComponent")
        if isvalid(stats) then
            -- M2 Phase B(2026-09-08) - Trait2도 트리거형 효과를 발동할 수 있게 확장(Trait 우선).
            local bonusExpChance = _TraitEffectEngine:GetOnKillBonusExpChance(stats.Trait)
            if bonusExpChance == 0 and stats.Trait2 ~= "" then bonusExpChance = _TraitEffectEngine:GetOnKillBonusExpChance(stats.Trait2) end
            local xpToGrant = self.XpReward
            if bonusExpChance > 0 and _UtilLogic:RandomDouble() < bonusExpChance then
                xpToGrant = math.floor(xpToGrant * 1.5)
            end
            -- 2026-09-08 QA 발견 - 도굴꾼(hb)의 "보스 처치 보상 3배"가 실제로는 basicEffect={exp=0.20}
            -- (상시 +20%, 보스 무관)로 잘못 근사돼 있었고, 짝을 이루는 페널티("보스에게 받는 피해 2배")는
            -- 어디에도 구현이 없어 사실상 무비용 익스플로잇이었다. 보스 처치 시에만 3배로 재구현
            -- (basicEffect의 exp 필드는 제거, PlayerHit.HandleHitEvent에 피해 2배 페널티 짝을 추가).
            if self.IsBoss and (stats.Trait == "도굴꾼" or stats.Trait2 == "도굴꾼") then
                xpToGrant = xpToGrant * 3
                log("Monster: 도굴꾼 - 보스 처치 보상 3배 -> " .. xpToGrant)
            end
            -- 2026-09-08 QA - 거리의 방랑자 링크("탐험 지원": 몬스터 게이트에서 스탯 구슬 획득량
            -- 대폭 증가) 전용. 스탯 구슬을 경험치로 근사하는 기존 관행에 맞춰, 게이트 모드일 때만
            -- exp 보너스로 반영(선행 필요였던 것을 게이트 시스템(Phase E)이 이미 있어 신규 연결).
            if stats.LinkGateDropBonus > 0 then
                local map = self.Entity.CurrentMap
                local spawner = isvalid(map) and map:GetComponent("script.FieldWaveSpawner") or nil
                if isvalid(spawner) and spawner.IsGateMode then
                    xpToGrant = math.floor(xpToGrant * (1 + stats.LinkGateDropBonus))
                end
            end
            -- M2 Phase B 2단계(2026-09-06) - 복불복 상자(expGamble, 스탯 구슬을 경험치로 근사): 50%
            -- 확률로 2배, 50% 확률로 0.
            if _TraitEffectEngine:HasExpGamble(stats.Trait) or (stats.Trait2 ~= "" and _TraitEffectEngine:HasExpGamble(stats.Trait2)) then
                if _UtilLogic:RandomDouble() < 0.5 then
                    xpToGrant = xpToGrant * 2
                else
                    xpToGrant = 0
                end
                log("Monster: 복불복 상자 expGamble -> " .. xpToGrant)
            end
            stats:GrantXp(xpToGrant)
            stats:AddKill()
            -- M2 Phase D(2026-09-06) - 전직 퀘스트 보스 게이트(전체 기획서 §2-5). 이 몬스터가 보스면
            -- (FieldMiniBoss 등, IsBoss=true) 대기 중인 전직 요건을 해소한다.
            if self.IsBoss then
                stats:RecordBossKillForPromotion()
            end
            -- M2 Phase B(2026-09-06) - 처치 시 확률 회복(healOnKill, 예: 금욕).
            local healSpec = _TraitEffectEngine:GetHealOnKill(stats.Trait)
            if healSpec == nil and stats.Trait2 ~= "" then healSpec = _TraitEffectEngine:GetHealOnKill(stats.Trait2) end
            local player = attacker.PlayerComponent
            if healSpec and isvalid(player) and player.Hp > 0 and _UtilLogic:RandomDouble() < (healSpec.chance or 0) then
                player.Hp = math.min(player.MaxHp, player.Hp + player.MaxHp * (healSpec.pct or 0))
            end
            -- 2026-09-08 QA - 도박꾼 링크("재화 폭죽": 처치 시 낮은 확률 재화 즉시 획득) 전용.
            -- linkEffect 필드 자체가 없어 "선행 필요"로 미구현이었던 것을 신규 연결.
            if isvalid(player) and stats.LinkOnKillCurrencyChance > 0 and _UtilLogic:RandomDouble() < stats.LinkOnKillCurrencyChance then
                _AccountCurrencyLogic:GrantCurrency(player.ProfileCode, 3, tostring(player.UserId))
                log("Monster: 도박꾼 링크 재화 폭죽 - 재화+3")
            end
            -- M2 Phase B 2단계 - 적응력(killStackAtk) - 처치 누적 시 전 스탯 아주 소폭 증가를
            -- 공격력으로 근사 적용(상한까지).
            local killStack = _TraitEffectEngine:GetKillStackAtk(stats.Trait)
            if killStack == nil and stats.Trait2 ~= "" then killStack = _TraitEffectEngine:GetKillStackAtk(stats.Trait2) end
            if killStack ~= nil then
                stats.KillStackAtkPercent = math.min(killStack.cap or 1.0, stats.KillStackAtkPercent + (killStack.perKill or 0))
                stats:RecomputeDynamicAttackDamage()
            end
            -- 자석술사(burstKill) - 단시간 다중 처치 추적.
            local burstSpec = _TraitEffectEngine:GetBurstKillSpec(stats.Trait)
            if burstSpec == nil and stats.Trait2 ~= "" then burstSpec = _TraitEffectEngine:GetBurstKillSpec(stats.Trait2) end
            if burstSpec ~= nil then
                stats:RegisterBurstKill(burstSpec)
            end
            -- 2026-09-10 QA - 폭탄 돌리기(gmb)의 basicDesc "처치 시 폭발(주변 적 피해)"가
            -- basicEffect에 전혀 반영되지 않고 무관한 flat 근사치만 있던 것을 발견해 신규 구현.
            -- 이 몬스터가 죽은 위치를 중심으로 소형 AoE를 발생시켜 주변 다른 몬스터를 추가 타격.
            local explosionSpec = _TraitEffectEngine:GetOwnKillExplosion(stats.Trait)
            if explosionSpec == nil and stats.Trait2 ~= "" then explosionSpec = _TraitEffectEngine:GetOwnKillExplosion(stats.Trait2) end
            if explosionSpec ~= nil then
                local atk = attacker:GetComponent("script.PlayerAttack")
                local transform = self.Entity.TransformComponent
                if isvalid(atk) and isvalid(transform) then
                    local pos = transform.WorldPosition
                    local shape = BoxShape(Vector2(pos.x, pos.y + 0.5), Vector2(explosionSpec.radius or 2.0, explosionSpec.radius or 2.0), 0)
                    local originalDamage = atk.AttackDamage
                    atk.AttackDamage = math.floor(originalDamage * (explosionSpec.pct or 0.3))
                    atk:AttackFast(shape, "skill.killExplosion", CollisionGroups.Monster)
                    atk.AttackDamage = originalDamage
                    log("Monster: 폭탄 돌리기 - 처치 시 폭발 발동")
                end
            end
            -- 2026-09-08 QA - 영혼 포획자 링크("포획 지원": 낮은 확률로 처치 시 파티에게 짧은 무적
            -- 프레임) 전용. 확률 게이트는 여기서 굴리고, 실제 무효화는 PlayerHit.HandleHitEvent가
            -- LinkCaptureInvulnUntilElapsed 시각으로 판정.
            local captureSpec = _TraitEffectEngine:GetLinkCaptureInvuln(stats.LinkTrait1)
            if captureSpec == nil and stats.LinkTrait2 ~= "" then captureSpec = _TraitEffectEngine:GetLinkCaptureInvuln(stats.LinkTrait2) end
            if captureSpec ~= nil and _UtilLogic:RandomDouble() < (captureSpec.chance or 0) then
                stats.LinkCaptureInvulnUntilElapsed = _UtilLogic.ElapsedSeconds + (captureSpec.duration or 1)
                log("Monster: 영혼 포획자 링크 - 포획 지원 무적 발동")
            end
        end
        self:TryDropPotion(attacker)
    end

    @ExecSpace("ServerOnly")
    method void TryDropPotion(Entity attacker)
        -- 버서크 특성은 회복 아이템 적용 불가(전체 기획서 §2-3) - 드랍 자체는 굳이 막지 않는다
        -- (실제 사용 시점에 PlayerStatsComponent.RequestUsePotion이 거부하면 충분). 2026-09-12
        -- 정정 - "금욕도 동일 규칙이나 M1 축소 풀엔 없어 해당 없음"이라던 이전 메모는 stale함
        -- (M2에서 전체 115종 풀로 전환된 지 오래) - RequestUsePotion은 특정 트레잇 이름이 아니라
        -- `TraitEffectEngine:IsPotionBlocked`(basicEffect.noPotion)로 범용 판정하므로 금욕도
        -- 이미 정상적으로 막힌다, 별도 조치 불필요.
        if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then return end
        -- M2 Phase B(2026-09-06) - 상인(노다지/§2-3 "아이템 드랍률")을 비롯한 DropRateMultiplier
        -- 계열 특성이 실제로 이 드랍 확률에 반영된다(원래 임시 대체였던 처치경험치 효과는 제거됨).
        local statsComp = attacker:GetComponent("script.PlayerStatsComponent")
        local dropMult = 1.0
        if isvalid(statsComp) then
            dropMult = math.max(0, 1 + statsComp.DropRateMultiplier)
        end
        local effectiveChance = math.min(100, self.PotionDropChance * dropMult)
        local roll = _UtilLogic:RandomIntegerRange(1, 100)
        if roll > effectiveChance then return end
        -- M2 Phase B 2단계(2026-09-06) - 도박꾼(dropGamble): 처치 시 50% 확률 드랍 2배/50% 확률 0.
        local dropCount = 1
        -- 2026-09-10 QA - 변덕(bad)의 basicDesc "처치 시 낮은 확률로 드랍 2배" 본인판이 basicEffect에
        -- 없어 페널티만 적용되던 무비용 페널티 버그 신규 수정(느림보와 동일 유형).
        local ownGambleChance = isvalid(statsComp) and _TraitEffectEngine:GetOwnDropGambleChance(statsComp.Trait) or 0
        if ownGambleChance == 0 and isvalid(statsComp) and statsComp.Trait2 ~= "" then
            ownGambleChance = _TraitEffectEngine:GetOwnDropGambleChance(statsComp.Trait2)
        end
        if (isvalid(statsComp) and _TraitEffectEngine:HasDropGamble(statsComp.Trait)) or (isvalid(statsComp) and statsComp.Trait2 ~= "" and _TraitEffectEngine:HasDropGamble(statsComp.Trait2)) then
            dropCount = (_UtilLogic:RandomDouble() < 0.5) and 2 or 0
        elseif ownGambleChance > 0 and _UtilLogic:RandomDouble() < ownGambleChance then
            dropCount = (_UtilLogic:RandomDouble() < 0.5) and 2 or 0
            log("Monster: 변덕 본인 dropGambleChance 발동, dropCount=" .. dropCount)
        elseif isvalid(statsComp) then
            -- 2026-09-10 QA - 변덕 링크("불확실한 운": 처치 시 낮은 확률로 드랍 2배/드랍 없음) 신규
            -- 연결. 도박꾼 본인판과 동일한 50/50이지만 "낮은 확률로" 게이트를 먼저 통과해야 한다.
            local gambleChance = _TraitEffectEngine:GetLinkDropGambleChance(statsComp.LinkTrait1)
            if gambleChance == 0 and statsComp.LinkTrait2 ~= "" then gambleChance = _TraitEffectEngine:GetLinkDropGambleChance(statsComp.LinkTrait2) end
            if gambleChance > 0 and _UtilLogic:RandomDouble() < gambleChance then
                dropCount = (_UtilLogic:RandomDouble() < 0.5) and 2 or 0
                log("Monster: 변덕 링크 - 불확실한 운 발동, dropCount=" .. dropCount)
            end
        end
        if dropCount <= 0 then
            log("Monster: 도박꾼 dropGamble -> 0 (drop denied)")
            return
        end
        _CharacterRosterLogic:GrantPotionDrop("hppotion", dropCount, attacker.PlayerComponent.UserId)
        log("Monster: potion drop -> hppotion x" .. dropCount .. " to userId=" .. tostring(attacker.PlayerComponent.UserId))
    end

end
