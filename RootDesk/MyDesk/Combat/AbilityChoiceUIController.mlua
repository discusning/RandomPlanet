@Logic
script AbilityChoiceUIController extends Logic

    property Entity abilityGroup = "caeb32e7-260a-4481-ad3b-dd5687750930"
    property TextGUIRendererComponent traitDesc = "b44274ec-8619-48cf-8e82-776d041f5479"
    property Entity btnRedistribute = "1d5661b7-7843-4518-abf8-22a4a7c36027"
    property Entity btnBonus = "b488edec-e616-47d1-832e-072bfc9fbbd0"
    property Entity btnTrait = "32b84484-10ee-4a6c-bb00-ef92dda0fe36"
    -- M2 Phase B(2026-09-08) - 큐브마스터(rerollChoice) 전용. 3장 중 실제로 "무작위 미리보기"를
    -- 갖는 카드는 특성 변경(trait) 하나뿐이라(재분배/추가 스탯은 결과를 미리 굴려 보여주지 않는
    -- 일반 설명 카드), 재추첨은 그 미리보기 하나를 다시 굴리는 것으로 구현한다.
    property Entity btnReroll = "030b0a42-ea5b-44a9-bd61-c8eca368a30b"

    @HideFromInspector property any redistributeHandler = nil
    @HideFromInspector property any bonusHandler = nil
    @HideFromInspector property any traitHandler = nil
    @HideFromInspector property any rerollHandler = nil
    @HideFromInspector property string currentTraitCache = ""
    @HideFromInspector property string currentTrait2Cache = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Popup starts hidden - PlayerStatsComponent.OnSyncProperty calls ShowChoice() when the
        -- server flips AbilityChoicePending true (레벨업 시 이능 3택1 팝업, Phase 3).
        if isvalid(self.abilityGroup) then
            self.abilityGroup.Enable = false
        end
        if isvalid(self.btnRedistribute) then
            self.redistributeHandler = self.btnRedistribute:ConnectEvent(ButtonClickEvent, function() self:OnChoiceClicked("redistribute") end)
        end
        if isvalid(self.btnBonus) then
            self.bonusHandler = self.btnBonus:ConnectEvent(ButtonClickEvent, function() self:OnChoiceClicked("bonus") end)
        end
        if isvalid(self.btnTrait) then
            self.traitHandler = self.btnTrait:ConnectEvent(ButtonClickEvent, function() self:OnChoiceClicked("trait") end)
        end
        if isvalid(self.btnReroll) then
            self.rerollHandler = self.btnReroll:ConnectEvent(ButtonClickEvent, self.OnRerollClicked)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.redistributeHandler and isvalid(self.btnRedistribute) then
            self.btnRedistribute:DisconnectEvent(ButtonClickEvent, self.redistributeHandler)
        end
        if self.bonusHandler and isvalid(self.btnBonus) then
            self.btnBonus:DisconnectEvent(ButtonClickEvent, self.bonusHandler)
        end
        if self.traitHandler and isvalid(self.btnTrait) then
            self.btnTrait:DisconnectEvent(ButtonClickEvent, self.traitHandler)
        end
        if self.rerollHandler and isvalid(self.btnReroll) then
            self.btnReroll:DisconnectEvent(ButtonClickEvent, self.rerollHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowChoice(string currentTrait, string previewTrait, string currentTrait2)
        -- Called from PlayerStatsComponent.OnSyncProperty (local player only - every other player's
        -- PlayerStatsComponent.AbilityChoicePending is irrelevant to this client's UI). Fills the
        -- "특성 변경" card with the actual before/after trait names + short effect blurb so the
        -- choice isn't blind, then reveals the popup.
        if isvalid(self.traitDesc) then
            local desc = self:TraitBlurb(previewTrait)
            self.traitDesc.Text = currentTrait .. " → " .. previewTrait .. "\n" .. desc
        end
        -- 운명론자(hb) - basicDesc "이능 재추첨·특성 변경 불가" - 서버(RequestResolveAbilityChoice)가
        -- 최종 방어선이지만, 애초에 눌러도 아무 일 없는 죽은 버튼을 보여주지 않도록 여기서도 숨긴다.
        if isvalid(self.btnTrait) then
            self.btnTrait.Enable = not (currentTrait == "운명론자" or currentTrait2 == "운명론자")
        end
        self.currentTraitCache = currentTrait
        self.currentTrait2Cache = currentTrait2
        if isvalid(self.btnReroll) then
            -- 2026-09-12 QA - 운명론자+큐브마스터 동시 보유 캐릭터(실제 도달 가능한 Trait/Trait2
            -- 조합)에게 재추첨 버튼이 계속 보이던 것을 서버(RequestRerollAbilityPreview)와 짝 맞춰
            -- 클라이언트에서도 숨김 - 위의 btnTrait와 동일한 운명론자 체크를 추가.
            local isFatalist = (currentTrait == "운명론자" or currentTrait2 == "운명론자")
            self.btnReroll.Enable = (currentTrait == "큐브마스터" or currentTrait2 == "큐브마스터") and not isFatalist
        end
        if isvalid(self.abilityGroup) then
            self.abilityGroup.Enable = true
        end
        log("AbilityChoiceUI: ShowChoice current=" .. currentTrait .. " preview=" .. previewTrait)
    end

    @ExecSpace("ClientOnly")
    method void OnRerollClicked()
        -- 큐브마스터(rerollChoice) - "특성 변경" 카드의 미리보기 대상만 다시 굴린다(재분배/추가
        -- 스탯 카드는 애초에 미리보기가 없는 일반 설명 카드).
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end
        local stats = localPlayer:GetComponent("script.PlayerStatsComponent")
        if not isvalid(stats) then return end
        stats:RequestRerollAbilityPreview()
        log("AbilityChoiceUI: OnRerollClicked")
    end

    @ExecSpace("ClientOnly")
    method void UpdateTraitPreview(string previewTrait)
        -- PlayerStatsComponent.RequestRerollAbilityPreview의 Client 콜백 - 팝업을 닫지 않고 특성
        -- 변경 카드의 텍스트만 새로 굴린 값으로 갱신한다(ShowChoice 전체 재실행과 달리 다른 두 카드
        -- 상태나 팝업 Enable을 건드리지 않음).
        if isvalid(self.traitDesc) then
            local desc = self:TraitBlurb(previewTrait)
            self.traitDesc.Text = self.currentTraitCache .. " → " .. previewTrait .. "\n" .. desc
        end
        log("AbilityChoiceUI: UpdateTraitPreview preview=" .. previewTrait)
    end

    @ExecSpace("ClientOnly")
    method void OnChoiceClicked(string choice)
        -- Optimistic hide - the server resolves the choice and, if more level-ups are queued, syncs
        -- AbilityChoicePending back to true a moment later (see PlayerStatsComponent.
        -- MaybeOpenNextAbilityChoice's timer-deferred reopen), which re-triggers ShowChoice.
        if isvalid(self.abilityGroup) then
            self.abilityGroup.Enable = false
        end
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end
        local stats = localPlayer:GetComponent("script.PlayerStatsComponent")
        if not isvalid(stats) then return end
        stats:RequestResolveAbilityChoice(choice)
        log("AbilityChoiceUI: OnChoiceClicked choice=" .. choice)
    end

    method string TraitBlurb(string trait)
        -- M2 Phase B(2026-09-06) - TraitCatalog(115종) 조회로 교체. legacy 6종은 기존 하드코딩
        -- 문구를 그대로 유지(실측 검증된 정확한 수치 표현), 나머지 109종은 catalog의 basicDesc.
        if trait == "상인" then return "드랍률+15% (물약 드랍 확률에 실제 반영)"
        elseif trait == "버서크" then return "실제로 맞아서 체력이 깎일수록 공격력↑ (최대 +60%, 자해 없음)"
        elseif trait == "단단함" then return "전투력 생존 배율 +12%"
        elseif trait == "날렵함" then return "이동 속도 +0.6"
        elseif trait == "균형" then return "STR/DEX/INT/LUK 전부 +1"
        elseif trait == "절약가" then return "스킬 MP 소모 30% 감소"
        end
        local def = _TraitCatalog:GetTraitDef(trait)
        if def then return def.basicDesc end
        return ""
    end

end
