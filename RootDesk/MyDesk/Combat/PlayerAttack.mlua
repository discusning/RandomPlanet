@Component
script PlayerAttack extends AttackComponent

    -- @Sync required: PlayerStatsComponent.RecalculateDerived writes these ServerOnly, and
    -- CharacterInfoUIController reads them ClientOnly for the CP display. Without @Sync the client
    -- keeps the script's declared defaults forever, so every character showed identical CP.
    @Sync property number AttackDamage = 50
    @Sync property number CriticalChance = 0.3
    -- Secondary/primary stat values driven by PlayerStatsComponent.RecalculateDerived, matching
    -- Docs/랜덤 플래닛 전체 기획서.md §2-2/§8-1's official STR/DEX/INT/LUK effect table:
    -- LUK -> crit payoff, DEX -> attack rate + accuracy (vs a defender's Evasion), STR -> knockback
    -- resistance (defender-side; stored here as a convenience mirror, applied on the player's own
    -- incoming-hit path once that exists - see KnockbackResistance note below).
    @Sync property number CritDamageMultiplier = 1.5
    @Sync property number AttackCooldownSeconds = 0.6
    @Sync property number Accuracy = 91
    @HideFromInspector property any Shape = nil
    @HideFromInspector property number LastAttackTime = -999

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Prepares the reusable frontal hit box.
        self.Shape = BoxShape(Vector2.zero, Vector2(1.2, 1.2), 0)
        -- DefaultPlayer ships with no HitComponent (Global/DefaultPlayer.model is read-only for AI
        -- edits) - attach the contact-damage receiver here at spawn time instead, per model.md
        -- §2.5's AddComponent workaround. See Combat/PlayerHit.mlua for the collider/HP-loss logic
        -- this enables (monster attacks were previously a no-op with nothing to receive them).
        if not isvalid(self.Entity:GetComponent("script.PlayerHit")) then
            self.Entity:AddComponent("script.PlayerHit")
        end
        -- 유저 요청(2026-08-19) "인게임 플레이어 데미지 스킨을 일반 데미지 스킨으로 바꿔줘" - 현재
        -- Global/DefaultPlayer.model의 damageSkinId 기본값이 커스텀 스킨으로 설정되어 있는데, Global/
        -- 은 AI가 직접 수정할 수 없는 읽기 전용 파일(위 PlayerHit과 동일한 제약) - Monster.mlua가
        -- DamageSkinSettingComponent.DamageSkinId를 스폰 시점에 덮어쓰는 것과 같은 패턴으로 여기서도
        -- 엔진 기본("일반") 히트 스킨 RUID로 강제 override한다.
        local skinSetting = self.Entity.DamageSkinSettingComponent
        if isvalid(skinSetting) then
            skinSetting.DamageSkinId = DataRef("3271c3e79bf04ecba9a107d55495970d")
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- Resolves the player's manual attack key into a hit-box swing.
        if event.ActionName ~= "Attack" then return end
        self:DoAttack()
    end

    @ExecSpace("ServerOnly")
    method void DoAttack()
        -- Places the hit box in front of the player using current facing. Gated by
        -- AttackCooldownSeconds (DEX primary effect) - previously attacks had no rate limit at all.
        if _UtilLogic.ElapsedSeconds - self.LastAttackTime < self.AttackCooldownSeconds then
            return
        end
        self.LastAttackTime = _UtilLogic.ElapsedSeconds

        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        if not isvalid(transform) or not isvalid(controller) then return end
        local pos = transform.WorldPosition
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        self.Shape.Position = Vector2(pos.x + 0.6 * dir, pos.y + 0.5)
        self.Shape.Size = Vector2(1.2, 1.2)
        self.Shape.Angle = 0
        self:AttackFast(self.Shape, "melee.basic", CollisionGroups.Monster)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- 신중함(firstHitBonus) - 웨이브가 바뀐 뒤 첫 타격에만 데미지% 보너스. 집중(firstHitCritOnWaveStart)
        -- 의 LastCritWaveNumber와 동일한 웨이브-추적 패턴, 대상만 크리 확정 대신 데미지 배율.
        -- 2026-09-08 QA 스윕에서 게터/소비처 없이 데이터만 있던 갭으로 발견해 연결.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if isvalid(statsComp) then
            local bonus = _TraitEffectEngine:GetFirstHitBonus(statsComp.Trait)
            if bonus == 0 and statsComp.Trait2 ~= "" then bonus = _TraitEffectEngine:GetFirstHitBonus(statsComp.Trait2) end
            if bonus > 0 then
                local map = self.Entity.CurrentMap
                if isvalid(map) then
                    local spawner = map:GetComponent("script.FieldWaveSpawner")
                    if isvalid(spawner) and spawner.WaveNumber ~= statsComp.LastFirstHitWaveNumber then
                        statsComp.LastFirstHitWaveNumber = spawner.WaveNumber
                        return math.floor(self.AttackDamage * (1 + bonus))
                    end
                end
            end
        end
        return self.AttackDamage
    end

    method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
        -- M2 Phase B 2단계(2026-09-06) - 집중(firstHitCritOnWaveStart): 웨이브가 바뀐 뒤 첫 타격은
        -- 항상 크리티컬. statsComp.LastCritWaveNumber로 "이번 웨이브에 이미 소비했는지" 추적.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        -- M2 Phase B(2026-09-08) - Trait2도 트리거형 효과를 발동할 수 있게 확장(Trait 우선).
        if isvalid(statsComp) and (_TraitEffectEngine:HasFirstHitCritOnWaveStart(statsComp.Trait) or (statsComp.Trait2 ~= "" and _TraitEffectEngine:HasFirstHitCritOnWaveStart(statsComp.Trait2))) then
            local map = self.Entity.CurrentMap
            if isvalid(map) then
                local spawner = map:GetComponent("script.FieldWaveSpawner")
                if isvalid(spawner) and spawner.WaveNumber ~= statsComp.LastCritWaveNumber then
                    statsComp.LastCritWaveNumber = spawner.WaveNumber
                    self._T.lastWasCrit = true
                    return true
                end
            end
        end
        -- 2026-09-08 QA - 동전 던지기 사형집행인 링크("확정타": 체력10%↓ 적 공격 시 확정 크리티컬)
        -- 신규 연결. 본인 특성의 onCritExecuteChance(크리 시 즉사)와는 별개 채널.
        if isvalid(statsComp) and statsComp.LinkExecuteCritThreshold > 0 then
            local monster = defender:GetComponent("script.Monster")
            if isvalid(monster) and monster.MaxHp > 0 and (monster.Hp / monster.MaxHp) < statsComp.LinkExecuteCritThreshold then
                self._T.lastWasCrit = true
                return true
            end
        end

        local result = _UtilLogic:RandomDouble() < self.CriticalChance
        self._T.lastWasCrit = result
        return result
    end

    method float GetCriticalDamageRate()
        return self.CritDamageMultiplier
    end

    method void OnAttack(Entity defender)
        -- 버서크(1차 특성) 흡혈 - 명중한 공격마다 현재 AttackDamage(버서크 자체 보정이 이미 반영된
        -- 값, PlayerStatsComponent.OnUpdate 참고)의 15%를 회복. 파라미터에 실제로 적용된 데미지값이
        -- 없어(OnAttack은 defender만 받음) 정확한 실피해가 아닌 AttackDamage 근사치를 쓴다 - 이
        -- 프로젝트의 CP 지표 자체도 같은 수준의 근사이므로 일관된 선택.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if not isvalid(statsComp) then return end
        local player = self.Entity.PlayerComponent
        if not isvalid(player) or player.Hp <= 0 then return end

        -- M2 Phase B 2단계(2026-09-06) - 메아리(onHitCooldownReset): 명중한 공격마다 확률로 현재
        -- 장착된 두 스킬 슬롯의 쿨다운을 즉시 초기화. 트레잇과 무관하게 항상 실행(값이 없으면 0으로
        -- no-op).
        local cdResetChance = _TraitEffectEngine:GetOnHitCooldownReset(statsComp.Trait)
        if cdResetChance == 0 and statsComp.Trait2 ~= "" then cdResetChance = _TraitEffectEngine:GetOnHitCooldownReset(statsComp.Trait2) end
        if cdResetChance > 0 and _UtilLogic:RandomDouble() < cdResetChance then
            local skillComp = self.Entity:GetComponent("script.PlayerSkillComponent")
            if isvalid(skillComp) then
                skillComp.LastUseTime = -999
                skillComp.LastUseTime2 = -999
                log("PlayerAttack: 메아리 무영창 - 쿨다운 초기화")
            end
        end

        -- 동전 던지기 사형집행인(onCritExecuteChance) - 이번 타격이 크리였을 때만 발동, 보스는 제외
        -- (Monster.ExecuteKill 내부에서 IsBoss로 재확인).
        if self._T.lastWasCrit then
            local executeChance = _TraitEffectEngine:GetOnCritExecuteChance(statsComp.Trait)
            if executeChance == 0 and statsComp.Trait2 ~= "" then executeChance = _TraitEffectEngine:GetOnCritExecuteChance(statsComp.Trait2) end
            if executeChance > 0 and _UtilLogic:RandomDouble() < executeChance then
                local monster = defender:GetComponent("script.Monster")
                if isvalid(monster) then
                    monster:ExecuteKill(self.Entity)
                    log("PlayerAttack: 동전 던지기 사형집행인 - 즉사 발동")
                end
            end
        end

        if statsComp.Trait == "버서크" then
            local heal = self.AttackDamage * 0.15
            player.Hp = math.min(player.MaxHp, player.Hp + heal)
            return
        end
        -- M2 Phase B(2026-09-06) - 범용 흡혈 특성(흡혈귀/빈손 등, TraitCatalog basicEffect.lifestealPct).
        -- M2 Phase C(2026-09-06) - Trait2와 링크 패시브(LinkLifestealBonus)의 흡혈도 함께 합산.
        local trait2Lifesteal = (statsComp.Trait2 ~= "") and _TraitEffectEngine:GetLifestealPct(statsComp.Trait2) or 0
        local lifestealPct = _TraitEffectEngine:GetLifestealPct(statsComp.Trait) + trait2Lifesteal + statsComp.LinkLifestealBonus
        if lifestealPct > 0 then
            local heal = self.AttackDamage * lifestealPct
            player.Hp = math.min(player.MaxHp, player.Hp + heal)
        end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- DEX primary effect (명중/accuracy): rolls a hit chance against the defender's own Evasion
        -- stat (Monster.Evasion, LUK's 회피 secondary once a monster-attacks-player pipeline exists
        -- on the reverse direction). Floor/ceiling keep hits from ever feeling purely random.
        if isvalid(defender:GetComponent("script.Monster")) == false then return false end
        if __base:IsAttackTarget(defender, attackInfo) == false then return false end
        local monster = defender:GetComponent("script.Monster")
        local evasion = monster.Evasion or 0
        local hitChance = math.max(0.5, math.min(1.0, 0.5 + (self.Accuracy - evasion) * 0.005))
        return _UtilLogic:RandomDouble() < hitChance
    end

end
