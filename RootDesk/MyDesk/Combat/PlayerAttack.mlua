@Component
script PlayerAttack extends AttackComponent

    -- @Sync required: PlayerStatsComponent.RecalculateDerived writes these ServerOnly, and
    -- CharacterInfoUIController reads them ClientOnly for the CP display. Without @Sync the client
    -- keeps the script's declared defaults forever, so every character showed identical CP.
    @Sync property number AttackDamage = 50
    @Sync property number CriticalChance = 0.3
    -- Secondary/primary stat values driven by PlayerStatsComponent.RecalculateDerived, matching
    -- Docs/랜덤 플래닛 전체 기획서.md §2-2/§8-1's official STR/DEX/INT/LUK effect table:
    -- LUK -> crit payoff, DEX -> attack rate + accuracy (vs a defender's Evasion), STR -> knockback
    -- resistance (defender-side; stored here as a convenience mirror, applied on the player's own
    -- incoming-hit path once that exists - see KnockbackResistance note below).
    @Sync property number CritDamageMultiplier = 1.5
    @Sync property number AttackCooldownSeconds = 0.6
    @Sync property number Accuracy = 91
    @HideFromInspector property any Shape = nil
    @HideFromInspector property number LastAttackTime = -999

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Prepares the reusable frontal hit box.
        self.Shape = BoxShape(Vector2.zero, Vector2(1.2, 1.2), 0)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- Resolves the player's manual attack key into a hit-box swing.
        if event.ActionName ~= "Attack" then return end
        self:DoAttack()
    end

    @ExecSpace("ServerOnly")
    method void DoAttack()
        -- Places the hit box in front of the player using current facing. Gated by
        -- AttackCooldownSeconds (DEX primary effect) - previously attacks had no rate limit at all.
        if _UtilLogic.ElapsedSeconds - self.LastAttackTime < self.AttackCooldownSeconds then
            return
        end
        self.LastAttackTime = _UtilLogic.ElapsedSeconds

        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        if not isvalid(transform) or not isvalid(controller) then return end
        local pos = transform.WorldPosition
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        self.Shape.Position = Vector2(pos.x + 0.6 * dir, pos.y + 0.5)
        self.Shape.Size = Vector2(1.2, 1.2)
        self.Shape.Angle = 0
        self:AttackFast(self.Shape, "melee.basic", CollisionGroups.Monster)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        return self.AttackDamage
    end

    method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
        return _UtilLogic:RandomDouble() < self.CriticalChance
    end

    method float GetCriticalDamageRate()
        return self.CritDamageMultiplier
    end

    method void OnAttack(Entity defender)
        -- 버서크(1차 특성) 흡혈 - 명중한 공격마다 현재 AttackDamage(버서크 자체 보정이 이미 반영된
        -- 값, PlayerStatsComponent.OnUpdate 참고)의 15%를 회복. 파라미터에 실제로 적용된 데미지값이
        -- 없어(OnAttack은 defender만 받음) 정확한 실피해가 아닌 AttackDamage 근사치를 쓴다 - 이
        -- 프로젝트의 CP 지표 자체도 같은 수준의 근사이므로 일관된 선택.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if not isvalid(statsComp) or statsComp.Trait ~= "버서크" then return end
        local player = self.Entity.PlayerComponent
        if not isvalid(player) or player.Hp <= 0 then return end
        local heal = self.AttackDamage * 0.15
        player.Hp = math.min(player.MaxHp, player.Hp + heal)
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- DEX primary effect (명중/accuracy): rolls a hit chance against the defender's own Evasion
        -- stat (Monster.Evasion, LUK's 회피 secondary once a monster-attacks-player pipeline exists
        -- on the reverse direction). Floor/ceiling keep hits from ever feeling purely random.
        if isvalid(defender:GetComponent("script.Monster")) == false then return false end
        if __base:IsAttackTarget(defender, attackInfo) == false then return false end
        local monster = defender:GetComponent("script.Monster")
        local evasion = monster.Evasion or 0
        local hitChance = math.max(0.5, math.min(1.0, 0.5 + (self.Accuracy - evasion) * 0.005))
        return _UtilLogic:RandomDouble() < hitChance
    end

end
