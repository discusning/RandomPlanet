            linkEffect={gateDropBonus=0.30}, linkName="탐험 지원", linkDesc="몬스터 게이트에서 스탯 구슬 획득량 대폭 증가" }
        d["굶주린 살점"] = { pool="hb", basicName="고통 공유", basicDesc="피격당할 때마다 공격력 소폭 누적(런 종료까지 유지), 대신 시작 체력 낮음", basicEffect={hp=-0.20, hitStackAtk={perHit=0.02, cap=0.40}},
            linkName="고통 공유", linkDesc="파티가 피격당할 때마다 낮은 확률로 짧은 공격력 버프" }

        self.Defs = d
        log("TraitCatalog: built " .. self:CountDefs() .. " trait definitions")
    end

    method integer CountDefs()
        local n = 0
        for _ in pairs(self.Defs) do n = n + 1 end
        return n
    end

    method table GetTraitDef(string name)
        return self.Defs[name]
    end

    method table GetAllTraitNames()
        local names = {}
        for k, _ in pairs(self.Defs) do table.insert(names, k) end
        return names
    end

    method table GetPoolNames(string pool)
        local names = {}
        for k, v in pairs(self.Defs) do
            if v.pool == pool then table.insert(names, k) end
        end
        return names
    end

end
