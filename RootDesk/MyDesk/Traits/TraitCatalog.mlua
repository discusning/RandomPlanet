@Logic
script TraitCatalog extends Logic
    -- 전체 특성 115종 데이터 (Docs/랜덤 플래닛 전체 기획서.md §2-3 5풀 목록 + 부록 D 링크 패시브 +
    -- 부록 E 기본 패시브 + 부록 G 신규 15종). M2 Phase B(2026-09-06) 신설.
    --
    -- pool: "hg"=Hidden-good(20%) "avg"=average(35%) "bad"=bad(20%) "gmb"=Gamble(18%) "hb"=Hidden-bad(7%)
    -- legacy=true: M1부터 이미 완전히 커스텀 구현된 6종(상인/버서크/단단함/날렵함/균형/절약가) 중
    --   버서크만 legacy로 유지(반응형 공격력 - PlayerStatsComponent.BerserkTick, 자체 서사와 강하게
    --   결합된 유일한 메커니즘이라 범용 엔진으로 옮기지 않음). 나머지 5종은 이번에 범용 엔진으로
    --   이관하되 기존 수치를 그대로 보존(회귀 없음) - 상인은 실제 드랍 시스템(물약)이 생겨 원래
    --   의도(드랍률)로 복원.
    -- basicEffect: TraitEffectEngine이 해석하는 파라미터 테이블. 필드가 없으면(nil) "아직 수치
    --   구현 없음"(부록 D-3 🔴/🟡 중 새 서브시스템이 필요한 것들 - 도트, 소환, 순간이동 교체,
    --   스냅샷 롤백, 영구 재화, 스탯 구슬 등) - UI 툴팁 텍스트(basicName/basicDesc)는 전부 채워져
    --   있으므로 표시는 정상이나 실제 수치는 §M2-GDD Phase B에 정직하게 미구현으로 기록됨.
    --   지원 필드(전부 선택): atk(공격력%) atkF(공격력 고정치) cc(크리확률+) cm(크리배율+)
    --   as(공격속도%) acc(명중+) ev(회피%) ms(이속 고정치) msm(이속%) hp(최대체력%) hpF(최대체력 고정)
    --   mp(최대MP%) dr(피해감소%) mpc(스킬MP소모%, 음수=감소) drop(드랍률%) exp(경험치%) kb(넉백저항+)
    --   shieldOnHit={chance,pct} (피격 시 확률로 최대체력 pct%만큼 방어막 생성, PlayerHit이 소모)
    --   healOnKill={chance,pct} (처치 시 확률로 최대체력 pct% 즉시 회복)
    -- linkEffect: Phase C(링크 캐릭터 실효과 연결)가 소비할 예정 - 지금은 텍스트만.
    property table Defs = {}

    method void OnBeginPlay()
        -- ExecSpace 미지정(양쪽 실행) - 서버 로직(PlayerStatsComponent 등)과 클라이언트 UI
        -- (AbilityChoiceUIController/CharacterInfoUIController 등) 양쪽 다 이 데이터를 읽어야 한다.
        self:BuildDefs()
    end

    method void BuildDefs()
        local d = {}

        -- ===== Hidden-good (20%, 27종) =====
        d["상인"] = { pool="hg", basicName="노다지", basicDesc="드랍률+15%", basicEffect={drop=0.15},
            linkName="감정가", linkDesc="획득 스탯 구슬 종류 미리 표시" }
        d["버서크"] = { pool="hg", basicName="피의 대가", basicDesc="체력이 낮을수록 공격력 증가(자해 없음)", legacy=true,
            linkName="고립의 힘", linkDesc="링크 1슬롯만 활성 시 전스탯+12%" }
        d["링크 마스터"] = { pool="hg", basicName="각성", basicDesc="이능 획득 시 3초간 전 스탯 대폭 상승",
            linkName="인연 심화", linkDesc="링크 캐릭터 20레벨+ 시 효과+25%" }
        d["시간여행자"] = { pool="hg", basicName="유산", basicDesc="클리어 시 영구 재화+15%", basicEffect={clearCurrencyBonus=0.15},
            linkEffect={exp=0.10}, linkName="시간 도약", linkDesc="매 판 첫 3분간 파티 경험치 획득량+20%" }
        d["부활자"] = { pool="hg", basicName="불굴", basicDesc="치명적 피해를 1회 Hp 1로 버팀", basicEffect={reviveOnce=true},
            linkName="재림의 축복", linkDesc="파티 중 위기(HP10%↓) 캐릭터에게 낮은 확률로 짧은 무적" }
        d["먹보"] = { pool="hg", basicName="생명 전환", basicDesc="회복 아이템 효과량 증가", basicEffect={potionMult=0.5},
            linkEffect={potionMult=0.15}, linkName="포식의 나눔", linkDesc="파티 회복 아이템 효과량+15%" }
        d["분신(도플갱어)"] = { pool="hg", basicName="콤보 마스터", basicDesc="무피격 시간 비례 데미지 증가 (분신 소환은 선행 서브시스템 필요)",
            linkName="표식 공유", linkDesc="파티가 표식 능력 획득" }
        d["메아리"] = { pool="hg", basicName="무영창", basicDesc="공격 시 낮은 확률로 스킬 쿨다운 즉시 초기화", basicEffect={onHitCooldownReset=0.05},
            -- 2026-09-08 - "회피 성공 시" 조건은 PlayerHit의 신규 EvasionPercent 파이프라인 도입으로
            -- 실제 발동 가능해졌으나(과거엔 회피 자체가 inert라 조건이 영원히 성립 불가), 파티원의
            -- 회피 발동 타이밍에 맞춰 매번 링크 소스를 조회하는 이벤트 배선은 과한 범위라 처형자 등과
            -- 동일한 상시 flat 근사로 유지.
            linkEffect={atk=0.02}, linkName="되돌림 지원", linkDesc="회피 성공 시 데미지 증가" }
        -- 2026-09-08 재점검: "드랍 흡수 서브시스템 선행 필요"로 미구현 남아있었으나, 이 프로젝트의
        -- 드랍은 애초에 즉시 인벤토리 지급 방식(Monster.TryDropPotion -> CharacterRosterLogic.
        -- GrantPotionDrop, 걸어가서 줍는 필드 아이템 자체가 없음)이라 "흡수"할 대상이 원래 없다 -
        -- 기본 효과("단시간 다중 처치 시 폭발적 버프")는 드랍 흡수와 무관한 별개 메커니즘이라 실제로는
        -- 막혀있지 않았음. 이번 세션에 구현.
        d["자석술사"] = { pool="hg", basicName="처치 연쇄", basicDesc="3초 내 3킬 달성 시 5초간 공격력+30%",
            basicEffect={burstKill={window=3, count=3, atk=0.30, duration=5}},
            linkName="자기 폭풍", linkDesc="처치 시 낮은 확률로 주변 드랍을 강제 즉시 흡수" }
        d["마노"] = { pool="hg", basicName="파괴 본능", basicDesc="공격력+8%", basicEffect={atk=0.08},
            linkEffect={atk=0.03}, linkName="예지", linkDesc="다음 웨이브·보스 정보 표시" }
        d["마나실드"] = { pool="hg", basicName="가시 갑옷", basicDesc="피격 시 낮은 확률로 반사 피해 + 소형 방어막", basicEffect={shieldOnHit={chance=0.15,pct=0.08}},
            linkName="방어막 나눔", linkDesc="판 시작 시 파티 전원에게 1회성 소형 방어막" }
        d["큐브마스터"] = { pool="hg", basicName="재추첨 숙련", basicDesc="이능/스킬 선택지 재추첨 가능", basicEffect={rerollChoice=true},
            linkName="이능 지원", linkDesc="이능 선택지 낮은 확률 상위 옵션" }
        d["연성술사"] = { pool="hg", basicName="잔류 마력", basicDesc="처치 시 낮은 확률로 경험치 추가 획득", basicEffect={healOnKill=nil, onKillBonusExp=0.20},
            linkEffect={drop=0.03}, linkName="복제의 비법", linkDesc="파티 스탯 구슬 획득 시 낮은 확률로 추가 1개 생성" }
        d["처형자"] = { pool="hg", basicName="강타", basicDesc="평타 데미지+12%", basicEffect={atk=0.12},
            linkEffect={atk=0.03}, linkName="첫 피 지원", linkDesc="사냥터 첫 처치 시 파티 버프" }
        d["가속"] = { pool="hg", basicName="폭발적 성장", basicDesc="레벨당 공격속도 소폭 누적", basicEffect={as=0.10},
            linkEffect={as=0.04}, linkName="가속 공유", linkDesc="콤보 유지 시 파티 공속 누적" }
        d["흡혈귀"] = { pool="hg", basicName="주문 증폭", basicDesc="가하는 피해의 5%를 체력으로 회복", basicEffect={lifestealPct=0.05},
            linkEffect={lifestealPct=0.02}, linkName="흡혈의 계약", linkDesc="파티 전원 가하는 피해의 1% 흡혈" }
        d["저격수"] = { pool="hg", basicName="일점", basicDesc="크리 확률↓ 대신 크리 데미지 대폭↑", basicEffect={cc=-0.05, cm=0.35},
            linkEffect={cm=0.08}, linkName="엄호 사격", linkDesc="평타 시 낮은 확률로 지원사격 1회 추가" }
        d["재생력"] = { pool="hg", basicName="최후의 반격", basicDesc="3초간 무피격 시 초당 체력 회복", basicEffect={regenIfUnhit={seconds=3, pct=0.03}},
            linkEffect={hp=0.03}, linkName="연승 지원", linkDesc="무피격 시간 비례 파티 데미지 증가" }
        d["수호자"] = { pool="hg", basicName="연쇄 치명", basicDesc="12초마다 받는 치명타 1회 무효", basicEffect={periodicShield={interval=12, pct=0.30}},
            linkEffect={ev=0.03}, linkName="피격회피지원", linkDesc="파티 피격 직전 회피 확률 소폭 증가" }
        d["천부적 재능"] = { pool="hg", basicName="도살자", basicDesc="이능 선택 시 선택지 1개 추가", basicEffect={extraAbilityChoice=true},
            linkName="정찰", linkDesc="중간 보스 등장 예고" }
        d["진화의 손길"] = { pool="hg", basicName="진화의 손길", basicDesc="같은 스킬 누적 50회 사용 시 진화형으로 자동 교체 (선행 서브시스템 필요)",
            linkName="진화 지원", linkDesc="링크 배치 시 스킬 진화 필요 사용 횟수−20%" }
        d["환영 교체"] = { pool="hg", basicName="환영 교체", basicDesc="스킬키로 분신과 위치 교체 + 소형 피해 (선행 서브시스템 필요)",
            linkName="잔상 지원", linkDesc="대시/회피 시 짧은 무적시간 부여" }
        d["메아리치는 발걸음"] = { pool="hg", basicName="메아리치는 발걸음", basicDesc="이동 중 지나온 자리에 화상 장판 (도트 프레임워크 선행 필요)",
            linkName="발자국 지원", linkDesc="파티 이동 경로에 약한 화상 장판 공유" }
        d["차원의 틈"] = { pool="hg", basicName="차원의 틈", basicDesc="크리 시 낮은 확률로 주변 몬스터를 끌어당김", basicEffect={onCritPullChance=0.08},
            linkName="중력 지원", linkDesc="크리 시 낮은 확률로 적 이동속도 감소" }
        d["동전 던지기 사형집행인"] = { pool="hg", basicName="동전 던지기 사형집행인", basicDesc="크리 시 낮은 확률(약5%)로 대상 즉사(보스 제외)", basicEffect={onCritExecuteChance=0.05},
            linkEffect={executeCritThreshold=0.10}, linkName="처형 지원", linkDesc="파티 공격이 체력10%↓ 적 처치 시 확정타" }
        d["시간을 거스르는 자"] = { pool="hg", basicName="시간을 거스르는 자", basicDesc="치명적 피해를 받으면 3초 전으로 복구(런당 1회) (스냅샷 버퍼 선행 필요)",
            linkName="인연의 메아리", linkDesc="런당 1회 액티브 캐릭터 사망 직전 0.5초 무적" }
        d["스피드스터"] = { pool="hg", basicName="스피드스터", basicDesc="힘/지능 계수 −70%, 대신 이동속도 계수 2.5배 + 이동속도 초과분 10%p당 공격력·스킬데미지+6%(상한+90%)", basicEffect={speedster=true},
            linkEffect={msm=0.05}, linkName="질풍 지원", linkDesc="파티 전원 이동 속도 소폭 증가" }

        -- ===== average (35%, 20종) =====
        d["균형"] = { pool="avg", basicName="거인의 힘", basicDesc="모든 스탯 소폭 증가(+1)", legacy=true,
            linkEffect={atk=0.02, cc=0.01, acc=2, msm=0.02}, linkName="조화의 진", linkDesc="파티 전 스탯 균등하게 소폭 증가" }
        d["견습"] = { pool="avg", basicName="채집가", basicDesc="경험치 획득+12%", basicEffect={exp=0.12},
            linkEffect={exp=0.08}, linkName="동문수학", linkDesc="파티 경험치 획득량+8%" }
        d["절약가"] = { pool="avg", basicName="명상의 여운", basicDesc="스킬 MP 소모 감소(30%)", legacy=true,
            linkEffect={mpc=-0.05}, linkName="쿨다운 파동", linkDesc="스킬 사용 시 낮은 확률로 파티 쿨다운 소폭 감소" }
        d["단단함"] = { pool="avg", basicName="철의 의지", basicDesc="방어력 증가(피해감소 12%)", legacy=true,
            linkEffect={dr=0.03}, linkName="굳건한 진", linkDesc="파티 전원 피격 시 낮은 확률로 소형 방어막" }
        d["강건함"] = { pool="avg", basicName="생명력 순환", basicDesc="최대 체력 증가(+15%)", basicEffect={hp=0.15},
            linkEffect={hp=0.03}, linkName="생명의 샘", linkDesc="판 시작 시 파티 전원 최대체력 소량 즉시 회복" }
        d["날렵함"] = { pool="avg", basicName="질풍", basicDesc="이동 속도 증가", legacy=true,
            linkEffect={msm=0.05}, linkName="발걸음 지원", linkDesc="파티 이동속도+10%" }
        d["집중"] = { pool="avg", basicName="급소 감각", basicDesc="웨이브당 첫 타격은 항상 크리티컬", basicEffect={firstHitCritOnWaveStart=true},
            linkEffect={acc=5}, linkName="예리한 감각", linkDesc="파티 매 웨이브 첫 공격 필중" }
        d["행운아"] = { pool="avg", basicName="치명타 강화", basicDesc="크리 데미지+20%", basicEffect={cm=0.20},
            linkEffect={cm=0.05}, linkName="운명의 클로버", linkDesc="처치 시 낮은 확률로 다음 공격 크리 확정" }
        d["수련생"] = { pool="avg", basicName="연계", basicDesc="스킬 MP 소모−20%", basicEffect={mpc=-0.20},
            linkEffect={mpc=-0.05}, linkName="영창 보조", linkDesc="낮은 확률로 파티 스킬 무료 시전" }
        d["회복가"] = { pool="avg", basicName="재생", basicDesc="초당 소량 체력 회복(전투 중)", basicEffect={regenIfUnhit={seconds=0, pct=0.01}},
            linkEffect={atk=0.04}, linkName="집중 보조", linkDesc="파티 스킬 데미지+8%" }
        d["근면"] = { pool="avg", basicName="성실한 손", basicDesc="경험치 획득+8%", basicEffect={exp=0.08},
            linkEffect={drop=0.04}, linkName="자성", linkDesc="파티 스탯 구슬 획득량+8%" }
        d["민첩한 손"] = { pool="avg", basicName="재빠른 손놀림", basicDesc="공격 속도+10%", basicEffect={as=0.10},
            linkEffect={as=0.03}, linkName="연속 타격 지원", linkDesc="같은 적 연속 타격 시 낮은 확률로 즉시 재행동" }
        d["끈기"] = { pool="avg", basicName="경감", basicDesc="받는 피해−6%", basicEffect={dr=0.06},
            linkEffect={ev=0.05}, linkName="회피 지원", linkDesc="파티 회피+5%" }
        d["탐험가"] = { pool="avg", basicName="바람 걸음", basicDesc="이동 속도 증가", basicEffect={msm=0.12},
            linkEffect={drop=0.05}, linkName="발견의 길잡이", linkDesc="파티 드랍률+8%" }
        d["명상가"] = { pool="avg", basicName="확장", basicDesc="최대 MP+15%", basicEffect={mp=0.15},
