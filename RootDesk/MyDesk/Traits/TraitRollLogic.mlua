@Logic
script TraitRollLogic extends Logic
    -- 특성 5풀 가중치 추첨 (M2 Phase B, 2026-09-06). Docs/랜덤 플래닛 전체 기획서.md §8-2 최종
    -- 재조정값: Hidden-good 20% / average 35% / bad 20% / Gamble 18% / Hidden-bad 7%.
    -- Hidden-bad 완화 천장(§8-2): "40회 무출현 시 41번째 확정 지급" - 이번 구현은 **세션 한정**
    -- 카운터(월드 인스턴스 재시작 시 초기화)다. 계정 영구 저장(DataStorage)까지 연결하는 것은
    -- CharacterRosterLogic의 저장 스키마를 건드려야 해서(기존 검증된 로스터 저장/로드 흐름에 필드
    -- 추가) 리스크 대비 이번 패스 범위 밖으로 남겨둠 - Docs/RandomPlanet-M2-GDD.md Phase B 참고.
    @HideFromInspector property integer HiddenBadMissStreak = 0

    method string RollTrait(integer bonusLevel)
        -- bonusLevel: M2 Phase G(2026-09-06) 계정 영구 강화("좋은 특성 가중치 소폭 상승", 전체
        -- 기획서 §6-2 예시) - AccountCurrencyLogic의 강화 레벨(0~10). 캐릭터 생성(CreateCharacter)만
        -- 이 값을 실제로 넘긴다 - 이능 재추첨/3차 전직 추가 특성 등 런 중간 재추첨은 전부 0을 넘겨
        -- 원 확률 그대로 유지한다("캐릭터 생성 시" 가중치 상승이라는 원문 범위를 그대로 지킴).
        self.HiddenBadMissStreak = self.HiddenBadMissStreak + 1
        local pool = self:RollPool(bonusLevel)
        if pool == "hb" then self.HiddenBadMissStreak = 0 end
        return self:PickFromPool(pool)
    end

    method string RollPool(integer bonusLevel)
        if self.HiddenBadMissStreak > 40 then return "hb" end
        -- 레벨당 0.5%p씩 hb/bad에서 걷어 hg로 몰아준다(상한 레벨10 = 5%p 이동). 음수로 내려가지
        -- 않도록 실제로 걷힌 양만큼만 hg에 더한다.
        local shift = math.min(0.035, math.max(0, bonusLevel or 0) * 0.005)
        local hbP = math.max(0, 0.07 - shift)
        local badP = math.max(0, 0.20 - shift)
        local hgP = 0.20 + (0.07 - hbP) + (0.20 - badP)
        local gmbP = 0.18
        -- avgP는 나머지 전부(합이 항상 1.0로 맞도록) - 명시 변수는 안 두고 누적 상한(1.0)으로 처리.
        local roll = _UtilLogic:RandomDouble()
        local cum = hbP
        if roll < cum then return "hb" end
        cum = cum + gmbP
        if roll < cum then return "gmb" end
        cum = cum + hgP
        if roll < cum then return "hg" end
        cum = cum + badP
        if roll < cum then return "bad" end
        return "avg"
    end

    method string PickFromPool(string pool)
        local names = _TraitCatalog:GetPoolNames(pool)
        if #names == 0 then return "균형" end
        return names[_UtilLogic:RandomIntegerRange(1, #names)]
    end

    method string RollHiddenPool()
        -- 부패한 계약서(basicEffect.forceHiddenRerollAt13) 전용 - 3차 전직 추가 특성 추첨이 무조건
        -- Hidden 풀(good/bad 불문)에서만 나오도록 강제. 두 풀 중 균등 50/50으로 먼저 고른 뒤 그 풀
        -- 내에서 균등 추첨(전체 풀 확률 가중치와는 별개의 특수 규칙).
        local pool = (_UtilLogic:RandomDouble() < 0.5) and "hg" or "hb"
        return self:PickFromPool(pool)
    end

    method string RollDifferentTrait(string current)
        -- 현재 특성과 다른 결과가 나올 때까지 재추첨(이능 "특성 변경" / 3차 전직 추가 추첨 등에서 사용).
        local pick = self:RollTrait(0)
        local guard = 0
        while pick == current and guard < 30 do
            pick = self:RollTrait(0)
            guard = guard + 1
        end
        return pick
    end

end
