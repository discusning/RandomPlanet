@Component
script CharacterSelectStageController extends Component
    property Entity standee1 = "90b86502-cc4b-408b-a42a-50036a809f26"
    property Entity standee2 = "4f41ba7d-bd7b-49aa-a6e9-75ddd76a54b5"
    property Entity standee3 = "6a4ce64a-5ffb-4d58-bfd9-c7afa9d69427"
    property Entity standee4 = "9ef0ee9e-7a3a-4a5f-a34a-d7f35b430eb5"
    property Entity standee5 = "4edff8ea-3f4f-4af8-8d42-00a39488de72"
    property Entity standee6 = "aa14874c-259a-46ac-862c-0535f638d98b"
    property Entity countText = "16584510-7692-4526-a5ca-89716f9ff30e"
    property Entity cardGroup = "1879e4ab-8a6e-4f06-9c8c-3370223bebe3"
    property Entity squadGroup = "5f96f6e4-814c-42e0-b42a-2b5926f6723b"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Wires standee/button touch handlers and draws the initial (slot 1 selected, all-empty) state.
        -- Roster data itself (data/dailyRemaining) now lives on CharacterRosterLogic, not here - see
        -- that script for why (this component's state becomes unreachable once the player leaves
        -- choice_map, but the Lobby also needs to read/mutate the same roster).
        self._T.standees = { self.standee1, self.standee2, self.standee3, self.standee4, self.standee5, self.standee6 }
        self._T.currentIndex = 1
        self._T.handlers = {}
        self._T.lastTouchIndex = nil
        self._T.lastTouchTime = -1
        self._T.pendingOpenCard = false
        self:InitRandomPools()

        -- Standee clicks go through ScreenTouchEvent + world-position hit testing (OnScreenTouched),
        -- not per-standee TouchReceiveComponent/TouchEvent - see OnScreenTouched for why.
        local hScreen = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouched)
        table.insert(self._T.handlers, { entity = _InputService, eventType = ScreenTouchEvent, eventHandler = hScreen })

        log("CharacterSelectStage: OnBeginPlay, standee1 valid=" .. tostring(isvalid(self.standee1)) .. " standee6 valid=" .. tostring(isvalid(self.standee6)) .. " cardGroup valid=" .. tostring(isvalid(self.cardGroup)))
        -- HideLocalPlayer/ShowLocalPlayer moved to CharacterRosterLogic (2026-07-23) so the Lobby's
        -- return-portal flow can call the hide side too - see that script for why.
        _CharacterRosterLogic:HideLocalPlayer()

        -- Re-equip every already-rolled character's look onto its (freshly-instantiated) standee.
        -- choice_map's root entity - and everything under it, including these standees - gets fully
        -- destroyed and recreated (not just deactivated) each time the player leaves and re-enters
        -- this map, so the CostumeManagerComponent:SetEquip calls CreateCharacter() applied to the
        -- OLD standee instances don't carry over to the new ones; without this, a returning player
        -- sees their own already-created characters back at the template's default blank look.
        local roster = _CharacterRosterLogic:GetRoster()
        for i, standee in ipairs(self._T.standees) do
            local data = roster[i]
            if data ~= nil then
                _CharacterRosterLogic:ApplyLookToStandee(standee, data.look, data.equipment)
            end
        end

        self:RefreshStage()
    end

    @ExecSpace("ClientOnly")
    method void OnRosterLoaded()
        -- Called by CharacterRosterLogic once the async server load completes (see that script's
        -- RequestLoadRoster/OnRosterLoaded). This entity's own OnBeginPlay above already ran against
        -- an empty roster - the load is a network round trip that finishes later - so without this
        -- the stage would stay blank until the player's next click. Re-applies looks to any
        -- already-owned characters and redraws, mirroring the OnBeginPlay loop above.
        local roster = _CharacterRosterLogic:GetRoster()
        for i, standee in ipairs(self._T.standees) do
            local data = roster[i]
            if data ~= nil then
                _CharacterRosterLogic:ApplyLookToStandee(standee, data.look, data.equipment)
            end
        end
        self:RefreshStage()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Releases the standee/button touch handlers.
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method integer GetCurrentIndex()
        -- Which slot is currently selected/viewed in this stage's UI (not necessarily the slot
        -- actually being played - see CharacterRosterLogic.GetActiveIndex for that). Read by
        -- CharacterCardController.OnPlayClicked right before it sets the active index and enters the game.
        return self._T.currentIndex
    end

    @ExecSpace("ClientOnly")
    method void InitRandomPools()
        -- Random-look pools for character creation. Never touches the live player's own costume
        -- (UseCustomEquipOnly=true on AvatarBody and on DefaultPlayer) - every slot is a fully
        -- random default-avatar roll. "Gender" isn't a distinct field in this avatar system;
        -- body/skin-tone + hair + face all roll independently for visual variety.
        -- Coat/Pants/Shoes are intentionally NOT rolled - a separate in-game equipment system will
        -- own gear, so new characters start with none (see ApplyLook/RequestEnterGame).
        -- hairPool/facePool widened 2026-07-20 (6->60 each, via msw-search searchAvatarItems
        -- canonicalOnly=false) - hair color and "eye" color/style are not separate slots in this
        -- avatar system (no CustomHairColorEquip/CustomEyeEquip); each differently-colored
        -- hairstyle or face/eye expression is its own distinct avataritem RUID, so a wider RUID
        -- pool is what actually delivers hair-color and eye-color/type randomness (see Face maps
        -- to eye expression - msw-avatar has no separate "Eye" category, only Face).
        -- +20/+20 "newer" items appended same day - this resource API has no created/updated-at
        -- field, so recency is approximated by the numeric suffix of each item's `dname` (e.g.
        -- "hair-12809"), which appears to be an incrementing catalog id (higher = added later).
        -- Not a guaranteed release-date sort, but the best available proxy - see Gotchas.
        self._T.traitPool = { "상인", "버서크", "단단함", "날렵함", "균형", "절약가" }
        -- bodyPool fixed to a single skin tone 2026-07-20 ("뽀송 꽃잎 피부") - user wants body/skin
        -- no longer randomized, only hair/face still roll. A 1-item pool keeps CreateCharacter's
        -- existing RandomIntegerRange(1, #pool) pick working unchanged (always resolves to this one).
        self._T.bodyPool = { "04e82396b2ba40ab9d860f993447f3eb" }
        self._T.hairPool = { "56ee34976c1e4bea990df9821c376661", "59aa5f8b64c7496ebb059ec91618694e", "96917c5a13cf422db33bdbcfc0331b18", "5079d11f0e22443dac284718fe3ed0d5", "b8de224237424a3095b71566b705eb63", "ae27075d1d0440f1ad908e460d9fb4e4", "694c6c41959240ff8d2beea82a755ab6", "3adf86290e5644aaaddf9c92c87cf5bf", "54fd9fd8b4e64d2589a1c269a1b47717", "d4c0fd3852ce497cbd4449a3c8c1e569", "d3e89b0ae2ce4319a6d4ddf6e172ae4e", "6a4f6c0fcfb540689ffd07786a4ac872", "64f1c348916d47f09d7b357a8bebde30", "7d55213a1527409aa295f444019b5238", "e85482fc4ba6486698d186a182b5e164", "2893c3d39ad241459ffcab222628294a", "a7519f760f86452daf0efbbc46c6f673", "2fe38ec018a24c7180190c7d1513fa8a", "d664cc9370574380af98781e65f86abc", "79641da3cb9e4e6987a540e5b3f57a44", "5469086abe1e413babf014cf210862dd", "e2a96e5d94304dd38707cac10f166bfc", "557dbc6724d84296a0572701199ad251", "1839530e06d6407391294b3329f3d058", "5086502f9904454187dfcc3c26a0c5ce", "57547d8e6788454e972d1e4d811e5843", "24512511a1584ce0b0119917f9e5a518", "8ba1773a75414176abf170c5131b4bf1", "3e94a07578b7423db3f32a83dc492ce0", "7d59223d5c324a5c864ed3b04774f74a", "52366068d57d4344b5a2adb45d5d06ec", "092653016adb46beb2e7c2c82b09e1c8", "ee2e7fc580f64d7b8f1532ac73aee6b7", "984c98fe9e3045f18f5c6d0e44ed9e87", "d1d83f7283ab4f198c168f2b753c6d58", "c7fda194b92e44bd8bf07e1d176c78ab", "8897cdad8ab4462788b23355aa3d6bd4", "4818349232774244950c53754f57c2d5", "de30f89d240b41aeb38753cc24d2faeb", "eee9f5b9aefa4d738702a7e017485aed", "3377d108a5e64f49bf34849e8c356251", "d403278115754a96a998cf6092270c3c", "ed942fc8a8134d359b064d1d73efdd1e", "37a3183d748940199c46fb25fb55b952", "25b062cccb7d4083a73d21e049872ad4", "6c0446accf5e4fb38106dabf440cee24", "cf71b587490b42e08967653a6713e0bf", "a32698022b3940ac93bdb8407114bc00", "ddb96259b5e246759317f1a0a08b5c6d", "0fafc18c8de94aa3b9b520359ecb7ad8", "02e61fe7a68644a5b27bfe34ffd8e732", "e2dcf2b213b44ca3a1c69bbdc1c05299", "dbdbaf764aa944b597fc99183feae758", "b21dab465edb4111b69d1570f9094182", "9153a2dca2b342b5b8a288eead