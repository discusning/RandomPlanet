    end

    @ExecSpace("ClientOnly")
    method void OnScreenTouched(ScreenTouchEvent event)
        -- Standee clicks use this screen->world hit test instead of TouchReceiveComponent, because
        -- TouchReceiveComponent's click zone on a standee shrinks to a tiny sliver around the root's
        -- exact Transform position once the AvatarBody child (not the root) is the visible renderer -
        -- true even with AutoFitToSize=false and a large manual TouchArea (tested up to 4x4 units,
        -- still failed a click 0.4 world units above center). A human aiming at the character's
        -- visible body/face (well above the foot-anchored root) reliably misses that sliver. This
        -- checks world-position distance against each standee's actual Transform instead.
        if _InputService:IsPointerOverUI() then
            return
        end

        -- CRITICAL: roster load is an async server round trip (see CharacterRosterLogic.OnBeginPlay);
        -- self._T.data (via GetRoster()) reads as an empty {} until it resolves. Without this guard,
        -- a click landing in that window sees every slot as "empty" and CreateCharacter happily
        -- overwrites an already-owned slot with a freshly rolled character - reproduced live via
        -- maker_execute_script (forced loadComplete=false, touched slot 1, got a brand new character
        -- with a different trait). The overwrite's own SaveRoster is itself guarded and no-ops while
        -- load is still pending, so nothing is lost yet at that instant - but the corrupted local
        -- roster keeps living in memory, and the FIRST later save the player triggers during normal
        -- play (equip, level up, swap) persists it for real, permanently replacing the original
        -- character. Simplest fix: don't let a touch reach CreateCharacter at all until load is done.
        if not _CharacterRosterLogic:IsRosterLoadComplete() then
            return
        end

        local roster = _CharacterRosterLogic:GetRoster()
        local worldPos = _UILogic:ScreenToWorldPosition(event.TouchPoint)
        for i, standee in ipairs(self._T.standees) do
            if isvalid(standee) then
                local pos = standee.TransformComponent.WorldPosition
                local dx = worldPos.x - pos.x
                local dy = worldPos.y - pos.y
                local hit
                if roster[i] == nil then
                    -- Empty slot: creation now fires ONLY when the click lands on the
                    -- "캐릭터 생성" button chip (CreateBg/CreateBorder, local center ~(0.24,-1.72)
                    -- as of the 2026-07-20 pixel-measured box reposition, half-size ~(0.95,0.35))
                    -- - clicking elsewhere on the empty standee's area (e.g. where the avatar would
                    -- stand) no longer creates a character.
                    local bdx = dx - 0.24
                    local bdy = dy - (-1.72)
                    hit = bdx > -0.95 and bdx < 0.95 and bdy > -0.35 and bdy < 0.35
                else
                    -- Occupied slot: keep the generous box covering the visible avatar
                    -- (feet ~0.85 below root, head ~0.55 above root) for select/open-card.
                    hit = dx > -0.75 and dx < 0.75 and dy > -2.1 and dy < 0.95
                end
                if hit then
                    self:OnStandeeTouched(i)
                    return
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnStandeeTouched(integer index)
        -- Single click selects the slot (glow moves there) without opening the detail card. A second
        -- click on the SAME occupied slot within DOUBLE_CLICK_WINDOW opens the card instead - this is
        -- what lets the world delete button move into the card's corner (see RefreshStage/DeleteCurrentCharacter)
        -- without colliding with a neighboring standee's create-chip, since the card only appears on an
        -- explicit double click, not on every select. Clicking an empty slot still creates immediately
        -- and reveals right away (one click, no separate button) - the gacha reveal moment doesn't wait
        -- for a double click.
        local DOUBLE_CLICK_WINDOW = 0.4
        local now = _UtilLogic.ElapsedSeconds
        local roster = _CharacterRosterLogic:GetRoster()
        local wasOccupied = roster[index] ~= nil
        local isDoubleClick = wasOccupied and (self._T.lastTouchIndex == index) and ((now - self._T.lastTouchTime) < DOUBLE_CLICK_WINDOW)
        self._T.lastTouchIndex = index
        self._T.lastTouchTime = now

        log("CharacterSelectStage: standee touched, index=" .. index .. " doubleClick=" .. tostring(isDoubleClick))
        self._T.currentIndex = index
        local wasEmpty = not wasOccupied
        if wasEmpty then
            self:CreateCharacter(index)
        end
        self._T.pendingOpenCard = isDoubleClick or wasEmpty
        self:RefreshStage()
    end

    @ExecSpace("ClientOnly")
    method void CreateCharacter(integer idx)
        -- Rolls a fully random character (stats/trait/look) into slot idx (if empty and under the
        -- daily cap) and applies the look to that standee's avatar right away - costume equips are
        -- a one-time cost per creation, not repeated on every RefreshStage.
        -- Second layer of the same guard as OnScreenTouched (see its comment) - belt-and-suspenders
        -- against any other future caller reaching this before the roster has actually loaded.
        if not _CharacterRosterLogic:IsRosterLoadComplete() then
            return
        end
        local roster = _CharacterRosterLogic:GetRoster()
        if roster[idx] ~= nil then
            return
        end
        if _CharacterRosterLogic:GetDailyRemaining() <= 0 then
            log("CharacterSelectStage: daily creation limit reached")
            return
        end

        local stats = self:RollStats()
        local trait = self._T.traitPool[_UtilLogic:RandomIntegerRange(1, #self._T.traitPool)]
        local look = {
            body = self._T.bodyPool[_UtilLogic:RandomIntegerRange(1, #self._T.bodyPool)],
            hair = self._T.hairPool[_UtilLogic:RandomIntegerRange(1, #self._T.hairPool)],
            face = self._T.facePool[_UtilLogic:RandomIntegerRange(1, #self._T.facePool)],
        }
        -- 1차 스킬 후보 3개 제시 -> 카드의 SkillButton으로 1개 선택 (기본값은 후보 1번). See
        -- CharacterCardController.OnSkillButtonClicked for the cycle-through-3 picker.
        local skillCandidates = _SkillCatalog:RollThreeSkills()
        roster[idx] = {
            level = 1, trait = trait, str = stats.str, dex = stats.dex, intel = stats.intel, luk = stats.luk, look = look,
            skillCandidates = skillCandidates, skillId = skillCandidates[1],
        }
        -- Starter equipment kit (one of every catalog item, unequipped) - the only item source
        -- for now since there's no shop/loot system yet. See EquipmentLogic.GrantStarterKit.
        _EquipmentLogic:GrantStarterKit(roster[idx])
        _CharacterRosterLogic:SetDailyRemaining(_CharacterRosterLogic:GetDailyRemaining() - 1)
        self._T.justCreatedIndex = idx

        -- roster[idx].equipment is nil at this point (nothing equipped yet, everything just
        -- landed in inventory) - ApplyLookToStandee/EquipmentLogic handle a nil equipment table.
        _CharacterRosterLogic:ApplyLookToStandee(self._T.standees[idx], look, roster[idx].equipment)
        log("CharacterSelectStage: created character in slot " .. idx .. " trait=" .. trait)
    end

    @ExecSpace("ClientOnly")
    method void DeleteCurrentCharacter()
        -- Called from the card's delete button (bottom-right corner, see CharacterCardController) -
        -- no longer a world-entity touch handler. Clears the current slot so it can be reused, but
        -- does NOT refund dailyRemaining - the daily count limits how many times you may roll a
        -- character today, not how many slots are occupied. Refunding on delete would let
        -- create->delete->create reroll indefinitely.
        local idx = self._T.currentIndex
        local roster = _CharacterRosterLogic:GetRoster()
        if roster[idx] == nil then
            return
        end

        roster[idx] = nil
        log("CharacterSelectStage: deleted character in slot " .. idx)
        _CharacterRosterLogic:SaveRoster()
        self:RefreshStage()
    end

    @ExecSpace("ClientOnly")
    method table RollStats()
        -- Distributes 20 total points across STR/DEX/INT/LUK with a minimum of 1 each (GDD 8-1 baseline).
        local values = { 1, 1, 1, 1 }
        for i = 1, 16 do
            local pick = _UtilLogic:RandomIntegerRange(1, 4)
            values[pick] = values[pick] + 1
        end
        return { str = values[1], dex = values[2], intel = values[3], luk = values[4] }
    end

    @ExecSpace("ClientOnly")
    method void RefreshStage()
        -- Redraws all 6 standees (glow/nametag/avatar visibility), the detail card, the delete
        -- button, and the daily count. Costume equips are NOT re-applied here (see CreateCharacter).
        local idx = self._T.currentIndex
        local roster = _CharacterRosterLogic:GetRoster()

        for i, standee in ipairs(self._T.standees) do
            if not isvalid(standee) then
                continue
            end

            local data = roster[i]

            -- Gold ring shows only on the selected slot AND only once it's occupied - an empty slot
            -- (including the default currentIndex=1 on first load, before anything is created) must
            -- stay ring-free, which was the original complaint that led to force-disabling this.
            local glow = standee:GetChildByName("Glow")
            if isvalid(glow) then
                glow.Enable = (i == idx) and (data ~= nil)
            end

            local nameTag = standee:GetChildByName("NameTag")
            if isvalid(nameTag) then
                if data == nil then
                    -- Empty slot doubles as its own "create" button (see OnScreenTouched/OnStandeeTouched) -
                    -- label it accordingly now that the separate world "생성" button has been removed.
                    -- Dark text matches the gold CreateBg chip behind it (see below) for contrast.
                    nameTag.TextRendererComponent.Text = "캐릭터 생성"
                    nameTag.TextRendererComponent.FontColor = Color(0.12, 0.09, 0.03, 1)
                else
                    nameTag.TextRendererComponent.Text = "Lv." .. data.level
                    nameTag.TextRendererComponent.FontColor = Color(0.85, 0.85, 0.9, 1)
                end
            end

            -- Gold "생성" chip behind the label - only for empty slots, so it reads as a button
            -- against the map background instead of low-contrast bare text (was hard to read).
            -- Toggled via the SpriteRendererComponent's own Enable, not the entity-level Enable -
            -- entity-level Enable silently failed to stick for one specific standee instance
            -- (Standee3) after repeated placeModel re-syncs this session, while every other slot's
            -- entity-level toggle kept working; component-level Enable proved reliable in a live
            -- script test and sidesteps whatever made that one entity's Enable @Sync state stale.
            local createBg = standee:GetChildByName("CreateBg")
            if isvalid(createBg) then
                createBg.SpriteRendererComponent.Enable = (data == nil)
            end

            -- The standee root's own silhouette sprite is always hidden now - it used to double as a
            -- second "button"-looking box stacked directly above the CreateBg/NameTag create-chip,
            -- sharing the exact same click zone (OnScreenTouched hit-tests the whole standee box
            -- regardless of which visual is showing), which read as a redundant duplicate button.
            -- The CreateBg chip below is now the sole visual affordance for an empty slot.
            standee.SpriteRendererComponent.Enable = false
            local avatarBody = standee:GetChildByName("AvatarBody")
            if isvalid(avatarBody) then
                avatarBody.AvatarRendererComponent.Enable = (data ~= nil)
            end
        end

        local selected = roster[idx]

        local card = self.cardGroup:GetComponent("script.CharacterCardController")
        if isvalid(card) then
            if selected == nil then
                card:HideCard()
            elseif self._T.justCreatedIndex == idx then
                -- Only a freshly rolled character gets the gacha-style reveal; reselecting an
                -- already-existing one (including this same one on a later click) is instant.
                card:RevealCard(selected)
                self._T.justCreatedIndex = nil
            elseif self._T.pendingOpenCard then
                -- Explicit double click on an occupied slot - open the card (see OnStandeeTouched).
                card:ShowCard(selected)
            else
                -- Single click on an already-occupied slot: just move selection/glow there, don't
                -- pop the card open (and close it if it was showing a different character).
                card:HideCard()
            end
        end
        self._T.pendingOpenCard = false

        self.countText.TextRendererComponent.Text = "오늘 생성 가능: " .. _CharacterRosterLogic:GetDailyRemaining() .. "/6"
    end

    @ExecSpace("Server")
    method void RequestEnterGame(table look, table equipment, table stats, string skillId)
        -- Client (the character card's PLAY button) asked to enter the village lobby. Applies the
        -- chosen slot's rolled look + equipped gear onto the actual player entity via the shared
        -- roster logic - the player's own MSW-account avatar is never shown (DefaultPlayer.model
        -- has UseCustomEquipOnly=true), only this random look. Destination is the Lobby map's main
        -- ground foothold (y=-1.25, spans x=5.54~33.16), landing 0.4 units above it per the standard
        -- MapleTile spawn-clearance convention.
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then
            return
        end

        _CharacterRosterLogic:ApplyLookToPlayer(player, look, equipment)

        -- Pushes the effective (base + equipment bonus) stats onto the real combat-facing
        -- components (PlayerComponent.MaxHp, PlayerAttack.AttackDamage/CriticalChance,
        -- MovementComponent.InputSpeed) - see PlayerStatsComponent.ApplyStats.
        local statsComp = player:GetComponent("script.PlayerStatsComponent")
        if isvalid(statsComp) then
            statsComp:ApplyStats(stats)
        end

        local skillComp = player:GetComponent("script.PlayerSkillComponent")
        if isvalid(skillComp) and skillId ~= nil then
            skillComp:GrantInitialSkill(skillId)
        end

        -- NOTE: undoing HideLocalPlayer's visibility hide does NOT happen here. Component.Enable is
        -- an engine @Sync property (server->client one-way); the client-only hide never changed the
        -- server's true value, so a same-value server write here would be a silent no-op that never
        -- re-syncs to the client. The client calls ShowLocalPlayer() itself instead (see that method).

        -- Lands on the "town square" ground foothold (y=-1.22, spans x=54.05~66.15) between
        -- portal-3 (x=55.37) and the squad NPC (x=63.6) - the zone that actually has content now.
        _TeleportService:TeleportToMapPosition(player, Vector3(58, -0.82, 0), "Lobby")
    end
end
