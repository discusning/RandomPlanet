@Logic
script AvatarLookLogic extends Logic
    -- 2026-09-15 코드 구조화 7/9 - CharacterRosterLogic.mlua에서 아바타 외형(룩/장비) 적용 로직을
    -- 분리. 세 메서드 모두 self._T(로스터 상태)를 건드리지 않는 순수 적용 함수라 원래 컴포넌트
    -- 인스턴스 파라미터 없이 그대로 이동 가능.

    @ExecSpace("ClientOnly")
    method void ApplyLookToStandee(Entity standee, table look, table equipment)
        -- Equips a rolled look onto a standee's AvatarBody child - shared by choice_map's creation
        -- flow and the Lobby's "other owned characters standing around" display. `equipment` may
        -- be nil (nothing equipped yet) - forwarded to EquipmentLogic either way, see that
        -- method's own nil handling.
        if not isvalid(standee) then
            return
        end
        local avatarBody = standee:GetChildByName("AvatarBody")
        if not isvalid(avatarBody) then
            return
        end
        local costume = avatarBody.CostumeManagerComponent
        costume:SetEquip(MapleAvatarItemCategory.Body, look.body)
        costume:SetEquip(MapleAvatarItemCategory.Hair, look.hair)
        costume:SetEquip(MapleAvatarItemCategory.Face, look.face)
        _EquipmentLogic:ApplyEquipmentToAvatar(avatarBody, equipment)
    end

    @ExecSpace("ServerOnly")
    method void ApplyLookToPlayer(Entity player, table look, table equipment)
        -- Equips a rolled look onto the real player entity's CostumeManagerComponent. Shared by the
        -- initial choice_map PLAY entry and the Lobby's character-swap - both just re-skin the same
        -- player entity, only PLAY additionally teleports.
        local costume = player.CostumeManagerComponent
        if not isvalid(costume) then
            return
        end
        costume.UseCustomEquipOnly = true
        costume:SetEquip(MapleAvatarItemCategory.Body, look.body)
        costume:SetEquip(MapleAvatarItemCategory.Hair, look.hair)
        costume:SetEquip(MapleAvatarItemCategory.Face, look.face)
        _EquipmentLogic:ApplyEquipmentToAvatar(player, equipment)
    end

    @ExecSpace("ServerOnly")
    method void ApplyEquipmentToPlayer(Entity player, table equipment)
        -- Post-validation body of CharacterRosterLogic.RequestApplyEquipmentToPlayer - the
        -- senderUserId check + player lookup stays in that wrapper (senderUserId is only valid in
        -- the method the RPC actually lands on, not in a delegated call - see this project's
        -- established AbilityChoiceLogic extraction pattern), which resolves `player` and passes it
        -- here. Re-applies the active character's current equipment onto the real player's
        -- CostumeManagerComponent after an equip/unequip/scroll change from the Equipment UI (see
        -- EquipmentUIController). Same ServerOnly-costume-write requirement as ApplyLookToPlayer -
        -- a ClientOnly SetEquip on the local player would only be a local visual override that
        -- never reaches the server's authoritative synced value.
        _EquipmentLogic:ApplyEquipmentToAvatar(player, equipment)
    end

end
