@Logic
script AccountCurrencyLogic extends Logic
    -- 계정 영구 재화 + 계정 영구 강화 (M2 Phase G, 2026-09-06 - 전체 기획서 §6-1 "영구 재화: 클리어
    -- 정산 -> 계정 메타 강화" + §6-2 "계정 영구 강화 예시: 시작 스탯 보너스 / 좋은 특성 가중치 상승").
    -- RestGaugeLogic/BestRecordLogic과 동일한 계정 UserDataStorage 패턴(profileCode 기준) 재사용.
    -- 클라이언트가 로드 결과를 self._T에 캐시해둬서, ClientOnly 소비처(CreateCharacter의 시작 스탯
    -- 보너스, TraitRollLogic의 좋은 특성 가중치)가 서버 왕복 없이 즉시 읽을 수 있게 한다.
    property string StorageName = "AccountCurrency"
    property integer MaxUpgradeLevel = 10
    property integer UpgradeBaseCost = 50
    -- 캐릭터 1회 생성 시 정수 적립량 / 좋은 특성 추첨에 소모하는 정수(정수 칸 설명과 같은 값).
    property integer CreationGain = 100
    property integer CreationBoostCost = 500

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.value = 0
        self._T.upgradeLevel = 0
        self._T.loadComplete = false
        self:RequestLoad()
    end

    @ExecSpace("ClientOnly")
    method number GetCurrency()
        return self._T.value
    end

    @ExecSpace("ClientOnly")
    method integer GetUpgradeLevel()
        return self._T.upgradeLevel
    end

    @ExecSpace("ClientOnly")
    method boolean IsLoadComplete()
        return self._T.loadComplete == true
    end

    method integer ComputeNextCost(integer level)
        -- 양쪽에서 다 쓰는 순수 계산(서버는 RequestPurchaseUpgrade 검증용, 클라이언트는 UI 표시용).
        return self.UpgradeBaseCost * (level + 1)
    end

    @ExecSpace("Server")
    method void RequestLoad()
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then
            return
        end
        local profileCode = player.PlayerComponent.ProfileCode
        local state = self:LoadState(profileCode)
        self:OnLoaded(state.value, state.upgradeLevel)
    end

    @ExecSpace("ServerOnly")
    method table LoadState(string profileCode)
        -- ok=false means the stored balance could NOT be read (network/storage error, not "never saved").
        -- Callers must abort the write in that case: treating it as 0 and saving value+delta would wipe the account.
        local storage = _DataStorageService:GetUserDataStorage(profileCode)
        local errorCode, raw = storage:GetAndWait(self.StorageName)
        local value, level = 0, 0
        local ok = (errorCode == 0 or errorCode == 1000002)   -- 1000002 = NotFound: brand-new account, 0 is correct
        if errorCode == 0 and raw ~= nil and raw ~= "" then
            local decoded = _HttpService:JSONDecode(raw)
            value = decoded.value or 0
            level = decoded.upgradeLevel or 0
        end
        return { value = value, upgradeLevel = level, ok = ok }
    end

    @ExecSpace("ServerOnly")
    method boolean SaveState(string profileCode, number value, integer level)
        -- Synchronous write (SetAndWait) so the caller can hold the profile lock across the whole
        -- read-modify-write. The previous fire-and-forget SetAsync let the next request read the old value
        -- before the write landed. Returns false if the write failed (caller must not report success).
        local storage = _DataStorageService:GetUserDataStorage(profileCode)
        local json = _HttpService:JSONEncode({ value = value, upgradeLevel = level })
        local errorCode = storage:SetAndWait(self.StorageName, json)
        if errorCode ~= nil and errorCode ~= 0 then
            log_error("AccountCurrency: SetAndWait failed, errorCode=" .. tostring(errorCode))
            return false
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void LockProfile(string profileCode)
        -- Serializes every read-modify-write of one account's currency (creation, grant, upgrade).
        -- Root cause of the lost updates: each request does LoadState (GetAndWait, yields) -> SaveState, so
        -- back-to-back requests all read the same old balance and the last save overwrites the others
        -- (observed: 4 calls each logged total=1929). A per-profile busy flag makes later requests wait
        -- until the earlier save has completed. Per server instance, which is the only writer here.
        if self._T.busy == nil then
            self._T.busy = {}
        end
        while self._T.busy[profileCode] == true do
            wait(0.05)
        end
        self._T.busy[profileCode] = true
    end

    @ExecSpace("ServerOnly")
    method void UnlockProfile(string profileCode)
        -- Must be called on every path after LockProfile (including early returns).
        if self._T.busy ~= nil then
            self._T.busy[profileCode] = nil
        end
    end

    @ExecSpace("Client")
    method void OnLoaded(number value, integer level)
        self._T.value = value
        self._T.upgradeLevel = level
        self._T.loadComplete = true
        log("AccountCurrency: loaded value=" .. value .. " upgradeLevel=" .. level)
        _AccountUpgradeUIController:RefreshDisplay()
        -- 통화 로드가 로스터 로드와 다른 타이밍에 끝나도 로비 텍스트가 갱신되도록 스테이지를 다시 그린다.
        local mapEntity = _EntityService:GetEntityByPath("/maps/choice_map")
        if isvalid(mapEntity) then
            local controller = mapEntity:GetComponent("script.CharacterSelectStageController")
            if isvalid(controller) then
                controller:RefreshStage()
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void GrantCurrency(string profileCode, integer amount, string userId)
        -- PlayerStatsComponent.GrantRunEndCurrency(런 종료 정산)에서 호출 - Server RPC 응답이 아니라
        -- 서버 자체 판단으로 트리거되므로(사망 이벤트) senderUserId가 없어, 알려야 할 클라이언트를
        -- 직접 targetUserId로 지정해야 한다(OnCurrencyGranted 호출부 참고).
        if amount <= 0 then return end
        self:LockProfile(profileCode)
        local state = self:LoadState(profileCode)
        if not state.ok then
            self:UnlockProfile(profileCode)
            log_error("AccountCurrency: grant aborted, balance unreadable profileCode=" .. profileCode)
            return
        end
        local newValue = state.value + amount
        local saved = self:SaveState(profileCode, newValue, state.upgradeLevel)
        self:UnlockProfile(profileCode)
        if not saved then return end
        log("AccountCurrency: granted " .. amount .. " to profileCode=" .. profileCode .. " -> total=" .. newValue)
        self:OnCurrencyGranted(amount, newValue, userId)
    end

    @ExecSpace("Client")
    method void OnCurrencyGranted(number amount, number newValue)
        self._T.value = newValue
        _AccountUpgradeUIController:RefreshDisplay()
        log("AccountCurrency: OnCurrencyGranted amount=" .. amount .. " newValue=" .. newValue)
    end

    @ExecSpace("Server")
    method void RequestPurchaseUpgrade()
        -- 공격대 편성창의 "강화" 버튼(AccountUpgradeUIController) -> 여기로 온다. 레벨당 비용이
        -- 오르는 단순 선형 누진(ComputeNextCost) - 최대 레벨(10) 도달 시 더 이상 구매 불가.
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then return end
        local profileCode = player.PlayerComponent.ProfileCode
        self:LockProfile(profileCode)
        local state = self:LoadState(profileCode)
        if not state.ok or state.upgradeLevel >= self.MaxUpgradeLevel then
            self:UnlockProfile(profileCode)
            self:OnUpgradeResult(false, state.value, state.upgradeLevel)
            return
        end
        local cost = self:ComputeNextCost(state.upgradeLevel)
        if state.value < cost then
            self:UnlockProfile(profileCode)
            self:OnUpgradeResult(false, state.value, state.upgradeLevel)
            return
        end
        local newValue = state.value - cost
        local newLevel = state.upgradeLevel + 1
        local saved = self:SaveState(profileCode, newValue, newLevel)
        self:UnlockProfile(profileCode)
        if not saved then
            self:OnUpgradeResult(false, state.value, state.upgradeLevel)
            return
        end
        log("AccountCurrency: purchased upgrade level=" .. newLevel .. " cost=" .. cost .. " remaining=" .. newValue)
        self:OnUpgradeResult(true, newValue, newLevel)
    end

    @ExecSpace("Client")
    method void OnUpgradeResult(boolean success, number newValue, integer newLevel)
        -- Server RPC(RequestPurchaseUpgrade)의 응답 - senderUserId 컨텍스트 안에서 호출되므로
        -- targetUserId를 명시하지 않아도 요청한 클라이언트에게 자동으로 돌아온다(이 프로젝트의
        -- RestGaugeLogic.OnGaugeLoaded와 동일한 기존 검증 패턴).
        if success then
            self._T.value = newValue
            self._T.upgradeLevel = newLevel
        end
        _AccountUpgradeUIController:OnPurchaseResult(success)
    end

    @ExecSpace("ClientOnly")
    method integer GetCreationBoostCost()
        -- 캐릭터 생성 시 소모하는 정수(좋은 특성 추첨권). 로비 정수 칸 설명에도 같은 값을 쓴다.
        return self.CreationBoostCost
    end

    @ExecSpace("Server")
    method void RequestCreationCurrency(boolean consume)
        -- 캐릭터 1회 생성: 정수 +CreationGain. consume이면 CreationBoostCost를 소모한다(서버가 잔액을 다시 검증).
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then return end
        local profileCode = player.PlayerComponent.ProfileCode
        -- Decision on a refused consume: the server is authoritative. A refused (or unreadable) request
        -- charges nothing and grants no +100; the client then rolls back the just-created slot
        -- (CharacterSelectStageController.OnCreationResult), so the free-boost trait never stands without payment.
        self:LockProfile(profileCode)
        local state = self:LoadState(profileCode)
        if not state.ok then
            self:UnlockProfile(profileCode)
            log_error("AccountCurrency: creation aborted, balance unreadable profileCode=" .. profileCode)
            self:OnCreationCurrencyResult(false, -1)
            return
        end
        local spend = 0
        if consume then
            if state.value < self.CreationBoostCost then
                self:UnlockProfile(profileCode)
                self:OnCreationCurrencyResult(false, state.value)
                return
            end
            spend = self.CreationBoostCost
        end
        local newValue = state.value + self.CreationGain - spend
        local saved = self:SaveState(profileCode, newValue, state.upgradeLevel)
        self:UnlockProfile(profileCode)
        if not saved then
            self:OnCreationCurrencyResult(false, -1)
            return
        end
        log("AccountCurrency: creation gain=" .. self.CreationGain .. " spent=" .. spend .. " total=" .. newValue)
        self:OnCreationCurrencyResult(true, newValue)
    end

    @ExecSpace("Client")
    method void OnCreationCurrencyResult(boolean success, number newValue)
        -- Server answer to RequestCreationCurrency. newValue < 0 means "balance unknown" (storage error),
        -- in which case the local value is kept. On failure the stage must undo the pending creation.
        if newValue >= 0 then
            self._T.value = newValue
        end
        log("AccountCurrency: creation result success=" .. tostring(success) .. " value=" .. newValue)
        local mapEntity = _EntityService:GetEntityByPath("/maps/choice_map")
        if isvalid(mapEntity) then
            local controller = mapEntity:GetComponent("script.CharacterSelectStageController")
            if isvalid(controller) then
                controller:OnCreationResult(success)
            end
        end
    end

end
