@Component
script CurrencyChipHudController extends Component
    -- 로비(choice_map) 좌상단 "정수" 칸. 보유 정수를 보여 주고, 누르면 설명 팝업을 띄운다.
    -- 정수가 생성 소모량(CreationBoostCost, 500) 이상이면 칸이 은은하게 빛난다.
    -- 칸은 로비에서만 보이며, 값은 AccountCurrencyLogic을 매 프레임 읽어 갱신한다(별도 콜백 배선 없음).
    -- 그룹 루트(/ui/CurrencyChipHud)에 붙은 Component다(BottomBarController와 같은 방식).
    property TextGUIRendererComponent chipText = "f7bd0a4f-b8fd-4b06-b50e-159f0dbd846d"
    property SpriteGUIRendererComponent chipGlow = "ad0044f5-a6f6-490d-99b0-012d6796b9a8"
    -- 그룹 루트 참조(스타포스 컨트롤러와 같은 방식 - 참조가 있어야 로비에서 그룹이 실행 화면에 올라온다).
    property Entity hudRoot = "943e34b8-1b59-42e0-801e-22ae9bb72c59"
    property Entity chipRoot = "85342860-53f8-4dbc-803a-5fbd3da99c03"
    property Entity btnChip = "9b789da1-222a-4bc6-9b00-22e7c762a691"
    property Entity infoGroup = "6e65cf63-8a31-4412-a2b8-228afd77acd3"
    property Entity btnInfoClose = "e50ef06d-a087-4711-9c68-9184261f0bc2"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 설명 팝업은 처음에 숨기고, 칸/닫기 버튼 클릭 핸들러를 연결한다.
        self._T.handlers = {}
        self._T.lastValue = -1
        self._T.time = 0
        if isvalid(self.infoGroup) then
            self.infoGroup.Enable = false
        end
        self:Bind(self.btnChip, function() self:ToggleInfo() end)
        self:Bind(self.btnInfoClose, function() self:HideInfo() end)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            if isvalid(rec.entity) then
                rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity button, any callback)
        -- 버튼 클릭 핸들러 연결 + OnEndPlay 해제용 기록 (StarforceUIController와 동일 패턴).
        if not isvalid(button) then return end
        local h = button:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self._T.handlers, { entity = button, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void ToggleInfo()
        -- 설명 팝업을 켜고 끈다.
        if isvalid(self.infoGroup) then
            self.infoGroup.Enable = not self.infoGroup.Enable
        end
    end

    @ExecSpace("ClientOnly")
    method void HideInfo()
        if isvalid(self.infoGroup) then
            self.infoGroup.Enable = false
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 로비가 아니면 칸과 팝업을 모두 숨긴다.
        local onLobby = false
        local player = _UserService.LocalPlayer
        if isvalid(player) then
            onLobby = player.CurrentMapName == "choice_map"
        end
        if isvalid(self.chipRoot) then
            self.chipRoot.Enable = onLobby
        end
        if not onLobby then
            self:HideInfo()
            return
        end

        local value = _AccountCurrencyLogic:GetCurrency()
        local boost = _AccountCurrencyLogic:GetCreationBoostCost()
        if value ~= self._T.lastValue then
            self._T.lastValue = value
            if isvalid(self.chipText) then
                self.chipText.Text = "정수 " .. value
            end
        end

        -- 소모 기준 이상이면 은은하게 맥동하는 금빛 테두리, 아니면 투명.
        if isvalid(self.chipGlow) then
            if value >= boost then
                self._T.time = self._T.time + delta
                local a = 0.18 + 0.12 * (0.5 + 0.5 * math.sin(self._T.time * 3))
                self.chipGlow.Color = Color(1, 0.85, 0.4, a)
            else
                self.chipGlow.Color = Color(1, 0.85, 0.4, 0)
            end
        end
    end
end
