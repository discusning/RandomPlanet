@Logic
script StatOrbLogic extends Logic
    -- 랜덤 스탯 구슬(2026-10-05) - 전장/카오스 게이트 몬스터 처치 시 필드에 떨어지는 구슬을 먹으면
    -- 힘/럭/인트/덱스 중 하나가 랜덤 수치만큼 영구히 오른다(원래 키우던 캐릭터가 전장을 돌수록 강해짐).
    -- 드랍 확률은 "전장 기본 확률 x 난이도 배율 x (게이트면 5배)", 종류는 4종 균등 추첨,
    -- 수치는 1~3(가중치 60/30/10). 적용은 런 중 실시간 스탯(PlayerStatsComponent)에 더하고, 로스터에는
    -- 고급 스탯 구슬과 같은 경로(UpdateActiveBaseStat)로 기본값이 저장되며, 색상 표시용 누적치(orbGain)만
    -- CharacterRosterLogic.GrantStatOrbGain이 따로 저장한다.

    -- 전장 1회 처치당 구슬 드랍 확률(%). 2026-10-05 유저 결정으로 1.0 -> 0.25(1/4)로 하향.
    -- 하급 전장 한 판 약 50킬이면 평균 약 0.13개. 실측(한 판 약 50킬, 0개)과 일치하는 수준으로 맞췄다.
    property number BaseDropChancePercent = 0.25
    -- 카오스 게이트는 같은 조건의 전장 대비 5배(유저 요청).
    property number GateDropMultiplier = 5.0
    -- 난이도 1~4(하급~최상급)별 배율. 최상급도 평균 한 판에 1개 남짓 - 게이트에서만 큰 성장이 되도록.
    property number TierDropMultiplierStep = 0.25

    -- 구슬 종류 - 키는 Stat 필드값이자 로스터 기본 필드명(Str/Dex/Intel/Luk)과 1:1로 대응한다.
    -- 색상은 구슬 스프라이트 틴트에 쓰이고, 표시용 "+N"도 같은 색을 쓴다.
    method table GetOrbTypes()
        return {
            { stat = "Str", label = "힘", color = Color(0.95, 0.18, 0.15, 1) },
            { stat = "Luk", label = "럭", color = Color(0.98, 0.85, 0.12, 1) },
            { stat = "Intel", label = "인트", color = Color(0.20, 0.45, 0.98, 1) },
            { stat = "Dex", label = "덱스", color = Color(0.22, 0.85, 0.30, 1) },
        }
    end

    method Color GetOrbColor(string stat)
        for _, t in ipairs(self:GetOrbTypes()) do
            if t.stat == stat then return t.color end
        end
        return Color(1, 1, 1, 1)
    end

    method number GetDropChancePercent(boolean isGate, integer tier)
        -- 난이도 배율은 1.0 + (tier-1) x step. 게이트는 여기에 5배를 곱한다.
        local tierMult = 1.0 + (math.max(1, math.min(4, tier)) - 1) * self.TierDropMultiplierStep
        local gateMult = isGate and self.GateDropMultiplier or 1.0
        return self.BaseDropChancePercent * tierMult * gateMult
    end

    method string RollOrbStat()
        -- 4종 균등 추첨.
        local types = self:GetOrbTypes()
        local idx = _UtilLogic:RandomIntegerRange(1, #types)
        return types[idx].stat
    end

    method integer RollOrbAmount()
        -- 수치 1~3, 가중치 60/30/10.
        local r = _UtilLogic:RandomIntegerRange(1, 100)
        if r <= 60 then return 1 end
        if r <= 90 then return 2 end
        return 3
    end

    @ExecSpace("ServerOnly")
    method void ApplyPickupGain(Entity player, string stat, integer amount)
        -- 구슬 흡수 시 서버에서 호출. 런 중 실시간 스탯을 올리면 OnSyncProperty -> UpdateActiveBaseStat
        -- 경로로 로스터 기본값이 저장되고, 색상 누적치는 클라이언트 RPC로 따로 기록한다.
        local stats = player:GetComponent("script.PlayerStatsComponent")
        if not isvalid(stats) then return end
        stats[stat] = stats[stat] + amount
        _CharacterRosterLogic:GrantStatOrbGain(stat, amount, player.PlayerComponent.UserId)
        log("StatOrb: picked " .. stat .. " +" .. amount .. " -> " .. stats[stat])
    end

end
