@Component
script KeyBindingPopupController extends Component

    property Entity dimmer = "bf62995f-7330-4263-913b-c57377356a76"
    property Entity window = "e450795c-93e6-4616-8035-2b5d57c1c30e"
    property Entity btnClose = "f513dcb1-00c3-493f-9d8d-b1f36acfc9f6"
    property Entity btnReset = "3d1f9304-db68-4527-8a1b-9ac97fff4d44"

    -- One Entity property per draggable action icon - kept as named properties (not a runtime
    -- array) so the UIBuilder bind-injection step (see build_keysetting_ui.cjs) has concrete
    -- property names to write real UUIDs into. self._T.icons (built in OnBeginPlay) is what
    -- everything else - wiring, drag, refresh - actually iterates over, so adding a 7th action
    -- later only means one more property line + one more self._T.icons entry, not a new copy of
    -- every handler method the way the original 2-icon version needed.
    property Entity iconAttack = "c367b4c7-da4a-45e6-ad6a-065705a1186b"
    property Entity iconSkill = "ca9d8410-f17d-4de1-9690-73789ad488c0"
    property Entity iconSkill2 = "61207b89-0a0f-4303-a500-9bc09ea23ccf"
    -- 2026-09-16 유저 요청("보유 스킬 전부를 원하는 키에 자유 배치") - 슬롯3~8용 아이콘. IconSkill/
    -- IconSkill2를 템플릿으로 ui/KeySettingGroup.ui에 복제 추가(build_keysetting_ui.cjs 갱신 필요).
    property Entity iconSkill3 = "6c35e8c2-b90a-42bf-8c4a-53be013e0582"
    property Entity iconSkill4 = "e596d25e-518c-4c85-8f0e-1935b7d8bec5"
    property Entity iconSkill5 = "daf4d201-d373-40ce-8ead-1ff056d04930"
    property Entity iconSkill6 = "74f10414-eaa2-45a8-b1d6-0c7b4338a5da"
    property Entity iconSkill7 = "c6fac18d-47a3-4eb9-a065-4c70127d5a29"
    property Entity iconSkill8 = "25cb0a50-f99b-433c-83dc-72dcfdefaf4f"
    -- 2026-09-20 유저 요청("점프는 점프키로 지정된 키로만") - 점프도 재배정 가능한 액션으로 승격.
    -- UUID는 UIBuilder write({bind})로 주입.
    property Entity iconJump = "8995a049-4f51-4860-829f-a9001add049a"
    property Entity iconInventory = "03b91a10-46fb-4cf0-b1bf-1b46dea4afb2"
    property Entity iconEquipment = "c16dcab1-1061-4651-b64c-34c6306027cc"
    property Entity iconCharacterInfo = "00cb1532-63ec-4bfd-b8bb-788bec66d2b7"
    property Entity iconSkillWindow = "4b24521f-fcef-4de0-a2e0-d97f6f321a6b"
    -- 2026-09-15 유저 요청 - HP/MP 포션 즉시사용 단축키(KeyBindingLogic.BuildRegistry의
    -- itemAction 항목). UUID는 UIBuilder write({bind})로 주입.
    property Entity iconUseHpPotion = "02d349cb-e431-4ec0-a195-06b58d701b0e"
    property Entity iconUseMpPotion = "209da69d-ebf6-4ec6-a018-de0f90a6cf2c"
    -- 2026-09-22 키 설정 개편 - 창 제목줄 드래그 핸들(창 이동)과 키보드 패널(스킬창/인벤토리에서
    -- 끌어온 항목을 놓을 때 화면 좌표를 키 좌표로 환산하는 기준). UUID는 UIBuilder bind로 주입.
    property Entity dragHandle = "be6e1438-08b7-4ea4-824a-7fca2a5b3567"
    property Entity keyboardPanel = "4f14dda1-2923-4848-a1d3-856430a25b52"
    -- 열릴 때 창을 놓는 X 위치(왼쪽에 붙여 오른쪽에 스킬창/인벤토리 카드가 들어갈 자리를 남긴다).
    property number dockX = -277

    property any windowDragHandler = nil
    property any keyToggleHandler = nil
    property any closeHandler = nil
    property any resetHandler = nil

    property boolean isOpen = false

    -- Snap-to-key distance (Window/Keyboard-local UI pixels, same space the key
    -- layout table and the icons' anchoredPosition both live in). A dropped icon
    -- farther than this from every key center just snaps back to its current key.
    property number snapDistance = 40

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.dimmer.Enable = false
        self.window.Enable = false
        self._T.keyLayout = self:BuildKeyLayout()

        self.keyToggleHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
        self.closeHandler = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        self.resetHandler = self.btnReset:ConnectEvent(ButtonClickEvent, self.OnResetClicked)
        if isvalid(self.dragHandle) then
            self.windowDragHandler = self.dragHandle:ConnectEvent(UITouchDragEvent, self.OnWindowDrag)
        end

        -- { actionName, entity, dragHandler, endDragHandler, skillSlot? } per icon - actionName must
        -- match a KeyBindingLogic.BuildRegistry() entry exactly (see KeyBindingLogic.mlua).
        -- skillSlot (1~8, only on the 8 Skill* icons) tells RefreshIcons which
        -- PlayerSkillComponent:GetEquippedSkillId(slot) to read for that icon's dynamic label/color -
        -- 2026-09-16, see RefreshIcons below.
        self._T.icons = {
            { actionName = "Attack", entity = self.iconAttack },
            { actionName = "Jump", entity = self.iconJump },
            { actionName = "Skill", entity = self.iconSkill, skillSlot = 1 },
            { actionName = "Skill2", entity = self.iconSkill2, skillSlot = 2 },
            { actionName = "Skill3", entity = self.iconSkill3, skillSlot = 3 },
            { actionName = "Skill4", entity = self.iconSkill4, skillSlot = 4 },
            { actionName = "Skill5", entity = self.iconSkill5, skillSlot = 5 },
            { actionName = "Skill6", entity = self.iconSkill6, skillSlot = 6 },
            { actionName = "Skill7", entity = self.iconSkill7, skillSlot = 7 },
            { actionName = "Skill8", entity = self.iconSkill8, skillSlot = 8 },
            { actionName = "Inventory", entity = self.iconInventory },
            { actionName = "Equipment", entity = self.iconEquipment },
            { actionName = "CharacterInfo", entity = self.iconCharacterInfo },
            { actionName = "SkillWindow", entity = self.iconSkillWindow },
            { actionName = "UseHpPotion", entity = self.iconUseHpPotion },
            { actionName = "UseMpPotion", entity = self.iconUseMpPotion },
        }
        for _, icon in ipairs(self._T.icons) do
            if isvalid(icon.entity) then
                local capturedIcon = icon
                icon.dragHandler = capturedIcon.entity:ConnectEvent(UITouchDragEvent, function(event)
                    self:OnDrag(capturedIcon.entity, event)
                end)
                icon.endDragHandler = capturedIcon.entity:ConnectEvent(UITouchEndDragEvent, function()
                    self:EndDrag(capturedIcon.entity, capturedIcon.actionName)
                end)
            end
        end

        self:RefreshIcons()
        log("KeyBindingPopup: OnBeginPlay, keyLayoutCount=" .. tostring(#self._T.keyLayout) .. " iconCount=" .. tostring(#self._T.icons))
    end

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- Toggles the popup. While open, keyboard focus is otherwise free (rebinding
        -- happens purely by drag now, so no "awaiting key press" capture is needed).
        if event.key == KeyboardKey.P then
            self:Toggle()
        end
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        if self.isOpen then
            self:Close()
        else
            self:Open()
        end
    end

    @ExecSpace("ClientOnly")
    method void Open()
        -- 2026-09-22 키 설정 개편 - 이 창은 이제 다른 창(스킬창/인벤토리 등)을 닫지 않고 함께 열린다
        -- (스킬창·인벤토리의 스킬/물약을 이 창의 키로 끌어다 놓아야 하므로). 전체 화면 딤도 없다.
        -- 창을 왼쪽에 붙이고, 이미 열려 있는 스킬창/인벤토리 카드는 오른쪽 빈 자리로 옮겨 겹치지 않게 한다.
        self.isOpen = true
        self.window.Enable = true
        self.window.UITransformComponent.anchoredPosition = Vector2(self.dockX, 0)
        _WindowHotkeyLogic:DockOpenCompanions()
        self:RefreshIcons()
    end

    @ExecSpace("ClientOnly")
    method void Close()
        self.isOpen = false
        self.window.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnWindowDrag(UITouchDragEvent event)
        -- 제목줄 드래그로 창 이동(다른 창들과 같은 공용 이동 로직).
        _WindowHotkeyLogic:ApplyDragDelta(self.window.UITransformComponent, event)
    end

    @ExecSpace("ClientOnly")
    method boolean DropPayloadAt(Vector2 touchPoint, table payload)
        -- HotkeyDragLogic.EndDrag가 스킬창/인벤토리에서 끌어온 항목을 놓은 화면 좌표를 넘긴다. 창이 열려
        -- 있고 키 위에 놓았을 때만 배정한다(KeyBindingLogic이 규칙 - 빈 키/스킬 슬롯 교체만 허용).
        -- 화면 좌표 -> UI 좌표(최상위 UI 중앙 기준) -> 키보드 패널 로컬 좌표(창 위치 + 키보드 오프셋을 뺌,
        -- 둘 다 중앙 앵커/피벗/스케일 1이라 단순 뺄셈으로 환산된다).
        if not self.isOpen or payload == nil then
            return false
        end
        local ui = _UILogic:ScreenToUIPosition(touchPoint)
        local windowPos = self.window.UITransformComponent.anchoredPosition
        local keyboardPos = isvalid(self.keyboardPanel) and self.keyboardPanel.UITransformComponent.anchoredPosition or Vector2(0, -34)
        local localX = ui.x - (windowPos.x + keyboardPos.x)
        local localY = ui.y - (windowPos.y + keyboardPos.y)
        local nearest = self:FindNearestKey(localX, localY)
        if nearest == nil then
            log("KeyBindingPopup: DropPayloadAt no key at local=(" .. tostring(localX) .. "," .. tostring(localY) .. ")")
            return false
        end
        local ok = false
        if payload.kind == "skill" then
            ok = _KeyBindingLogic:AssignSkillToKey(payload.id, nearest.key)
        elseif payload.kind == "item" then
            ok = _KeyBindingLogic:AssignItemActionToKey(payload.action, nearest.key)
        end
        log("KeyBindingPopup: DropPayloadAt kind=" .. tostring(payload.kind) .. " key=" .. tostring(nearest.key) .. " ok=" .. tostring(ok))
        self:RefreshIcons()
        return ok
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        -- Alias so BottomBarController.CloseWindow (shared by all 5 bottom-bar windows) can close
        -- this popup too, using the same c:Hide() call it already makes on every other window.
        self:Close()
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        self:Close()
    end

    @ExecSpace("ClientOnly")
    method void OnResetClicked()
        _KeyBindingLogic:ResetToDefaults()
        self:RefreshIcons()
    end

    @ExecSpace("ClientOnly")
    method void OnDrag(Entity icon, UITouchDragEvent event)
        local transform = icon.UITransformComponent
        local pos = transform.anchoredPosition
        transform.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
    end

    @ExecSpace("ClientOnly")
    method void EndDrag(Entity icon, string actionName)
        local pos = icon.UITransformComponent.anchoredPosition
        -- 2026-09-22 - 스킬/물약 아이콘은 키보드 밖으로 끌어내면 해제(미배정)된다. 공격/점프/창
        -- 단축키 아이콘은 이동만 가능(없으면 조작이 막히므로 밖에 놓으면 제자리로 돌아감).
        if _KeyBindingLogic:IsRemovableAction(actionName) and self:IsOutsideKeyboard(pos.x, pos.y) then
            self:RemoveAction(actionName)
            self:RefreshIcons()
            return
        end
        local nearest = self:FindNearestKey(pos.x, pos.y)
        if nearest ~= nil then
            -- TryRebind already handles the MapleStory-style swap when the target
            -- key currently belongs to the other action (KeyBindingLogic.mlua).
            local ok = _KeyBindingLogic:TryRebind(actionName, nearest.key)
            log("KeyBindingPopup: EndDrag action=" .. actionName .. " droppedOn=" .. tostring(nearest.key) .. " rebindOk=" .. tostring(ok))
        else
            log("KeyBindingPopup: EndDrag action=" .. actionName .. " no key in range, snapping back")
        end
        -- Always re-snap both icons to their (possibly just-swapped) current keys,
        -- whether the drop landed on a valid key or missed every snap radius.
        self:RefreshIcons()
    end

    method boolean IsOutsideKeyboard(number x, number y)
        -- 키 배치(keyLayout) 전체를 감싸는 사각형에서 margin 이상 벗어났는가 - "키보드 밖으로 끌어내기".
        local margin = 60
        local minX, maxX, minY, maxY = 99999, -99999, 99999, -99999
        for _, entry in ipairs(self._T.keyLayout) do
            if entry.x < minX then minX = entry.x end
            if entry.x > maxX then maxX = entry.x end
            if entry.y < minY then minY = entry.y end
            if entry.y > maxY then maxY = entry.y end
        end
        return x < minX - margin or x > maxX + margin or y < minY - margin or y > maxY + margin
    end

    @ExecSpace("ClientOnly")
    method void RemoveAction(string actionName)
        -- 스킬 슬롯이면 슬롯을 비우고(스킬은 보유 그대로), 물약이면 키를 미배정으로 되돌린다.
        local entry = _KeyBindingLogic:GetRegistryEntry(actionName)
        if entry == nil then return end
        if entry.kind == "skillSlot" then
            _KeyBindingLogic:RemoveSkillFromSlot(entry.slot)
        elseif entry.kind == "itemAction" then
            _KeyBindingLogic:ClearItemAction(actionName)
        end
        log("KeyBindingPopup: RemoveAction " .. actionName)
    end

    method number KeyHalfWidth(any key)
        -- 넓은 키(스페이스/시프트/엔터 등)는 중심에서 멀리 놓아도 그 키 위로 인식되도록 반폭을 돌려준다
        -- (ui/KeySettingGroup.ui의 Key_* 크기와 같은 값). 나머지 일반 키는 52px = 반폭 26.
        if key == KeyboardKey.Space then return 189
        elseif key == KeyboardKey.RightShift then return 80
        elseif key == KeyboardKey.LeftShift or key == KeyboardKey.Return then return 65
        elseif key == KeyboardKey.Backspace then return 57
        elseif key == KeyboardKey.CapsLock then return 49
        elseif key == KeyboardKey.Tab or key == KeyboardKey.Backslash then return 41
        elseif key == KeyboardKey.LeftControl or key == KeyboardKey.RightControl or key == KeyboardKey.LeftAlt or key == KeyboardKey.RightAlt
            or key == KeyboardKey.LeftWindows or key == KeyboardKey.RightWindows or key == KeyboardKey.Menu then return 34
        end
        return 26
    end

    method any FindNearestKey(number x, number y)
        -- 먼저 키 사각형 안에 정확히 놓았는지 본다(넓은 키 포함). 아니면 스냅 거리 안의 가장 가까운 키.
        for _, entry in ipairs(self._T.keyLayout) do
            if math.abs(entry.x - x) <= self:KeyHalfWidth(entry.key) and math.abs(entry.y - y) <= 26 then
                return entry
            end
        end
        local best = nil
        local bestDist = self.snapDistance
        for _, entry in ipairs(self._T.keyLayout) do
            local dx = entry.x - x
            local dy = entry.y - y
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist <= bestDist then
                bestDist = dist
                best = entry
            end
        end
        return best
    end

    method any FindKeyPosition(any key)
        for _, entry in ipairs(self._T.keyLayout) do
            if entry.key == key then
                return entry
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void RefreshIcons()
        -- 2026-09-22 - 키가 없는(None) 액션과 스킬이 배정되지 않은 스킬 슬롯의 아이콘은 키보드 위에
        -- 놓을 자리가 없으므로 숨긴다(스킬/물약은 스킬창·인벤토리에서 끌어다 놓아야 나타난다).
        for _, icon in ipairs(self._T.icons) do
            local key = _KeyBindingLogic:GetKeyForAction(icon.actionName)
            local visible = key ~= nil and key ~= KeyboardKey.None
            if icon.skillSlot ~= nil then
                visible = visible and _KeyBindingLogic:GetSkillForSlot(icon.skillSlot) ~= ""
            end
            if isvalid(icon.entity) then
                icon.entity.Enable = visible
            end
            if visible then
                self:SnapIconToKey(icon.entity, key)
                if icon.skillSlot ~= nil then
                    self:RefreshSkillIconLabel(icon.entity, icon.skillSlot)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshSkillIconLabel(Entity icon, integer slot)
        -- 2026-09-16 유저 요청 - 스킬 아이콘은 IconAttack 등 나머지 액션 아이콘과 달리 정적
        -- 아이콘이 아니라, 그 슬롯에 배정된 스킬 이름/종류색을 매번 실제 값으로 다시 그린다 -
        -- SkillUIController.ColorForKind와 동일한 색 규칙을 여기서도 씀(간단한 표라 별도 공용
        -- 헬퍼로 뽑기보단 그대로 복제 - 두 파일 다 매우 짧은 표).
        -- 2026-09-22 - 배정 정보는 이제 KeyBindingLogic(클라이언트)이 진실 소스라 거기서 읽는다.
        if not isvalid(icon) then return end
        local textComp = icon.TextGUIRendererComponent
        local spriteComp = icon.SpriteGUIRendererComponent
        local skillId = _KeyBindingLogic:GetSkillForSlot(slot)
        if skillId == "" then
            if isvalid(textComp) then textComp.Text = "-" end
            if isvalid(spriteComp) then spriteComp.Color = Color(0.3, 0.26, 0.2, 0.4) end
            return
        end
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then return end
        if isvalid(textComp) then textComp.Text = def.name end
        if isvalid(spriteComp) then spriteComp.Color = self:ColorForKind(def.kind) end
    end

    method Color ColorForKind(string kind)
        if kind == "melee_single" or kind == "multi_hit" then
            return Color(0.75, 0.16, 0.14, 0.85)
        elseif kind == "ranged_single" or kind == "ranged_pierce" then
            return Color(0.14, 0.34, 0.75, 0.85)
        elseif kind == "buff" then
            return Color(0.2, 0.62, 0.32, 0.85)
        elseif kind == "dash" then
            return Color(0.85, 0.52, 0.14, 0.85)
        end
        return Color(0.5, 0.5, 0.5, 0.85)
    end

    @ExecSpace("ClientOnly")
    method void SnapIconToKey(Entity icon, any key)
        if not isvalid(icon) then
            return
        end
        local entry = self:FindKeyPosition(key)
        if entry == nil then
            return
        end
        icon.UITransformComponent.anchoredPosition = Vector2(entry.x, entry.y)
    end

    method table BuildKeyLayout()
        -- Generated by build_keysetting_ui.cjs — keep in sync with ui/KeySettingGroup.ui.
        -- Coordinates are Window/Keyboard-local anchoredPosition (same space IconAttack/IconSkill live in).
        return {
            { key = KeyboardKey.Escape, x = -555, y = 155 },
            { key = KeyboardKey.F1, x = -462, y = 155 },
            { key = KeyboardKey.F2, x = -400, y = 155 },
            { key = KeyboardKey.F3, x = -338, y = 155 },
            { key = KeyboardKey.F4, x = -276, y = 155 },
            { key = KeyboardKey.F5, x = -183, y = 155 },
            { key = KeyboardKey.F6, x = -121, y = 155 },
            { key = KeyboardKey.F7, x = -59, y = 155 },
            { key = KeyboardKey.F8, x = 3, y = 155 },
            { key = KeyboardKey.F9, x = 96, y = 155 },
            { key = KeyboardKey.F10, x = 158, y = 155 },
            { key = KeyboardKey.F11, x = 220, y = 155 },
            { key = KeyboardKey.F12, x = 282, y = 155 },
            { key = KeyboardKey.BackQuote, x = -555, y = 93 },
            { key = KeyboardKey.Alpha1, x = -493, y = 93 },
            { key = KeyboardKey.Alpha2, x = -431, y = 93 },
            { key = KeyboardKey.Alpha3, x = -369, y = 93 },
            { key = KeyboardKey.Alpha4, x = -307, y = 93 },
            { key = KeyboardKey.Alpha5, x = -245, y = 93 },
            { key = KeyboardKey.Alpha6, x = -183, y = 93 },
            { key = KeyboardKey.Alpha7, x = -121, y = 93 },
            { key = KeyboardKey.Alpha8, x = -59, y = 93 },
            { key = KeyboardKey.Alpha9, x = 3, y = 93 },
            { key = KeyboardKey.Alpha0, x = 65, y = 93 },
            { key = KeyboardKey.Minus, x = 127, y = 93 },
            { key = KeyboardKey.Equals, x = 189, y = 93 },
            { key = KeyboardKey.Backspace, x = 282, y = 93 },
            { key = KeyboardKey.Tab, x = -539, y = 31 },
            { key = KeyboardKey.Q, x = -462, y = 31 },
            { key = KeyboardKey.W, x = -400, y = 31 },
            { key = KeyboardKey.E, x = -338, y = 31 },
            { key = KeyboardKey.R, x = -276, y = 31 },
            { key = KeyboardKey.T, x = -214, y = 31 },
            { key = KeyboardKey.Y, x = -152, y = 31 },
            { key = KeyboardKey.U, x = -90, y = 31 },
            { key = KeyboardKey.I, x = -28, y = 31 },
            { key = KeyboardKey.O, x = 34, y = 31 },
            { key = KeyboardKey.P, x = 96, y = 31 },
            { key = KeyboardKey.LeftBracket, x = 158, y = 31 },
            { key = KeyboardKey.RightBracket, x = 220, y = 31 },
            { key = KeyboardKey.Backslash, x = 298, y = 31 },
            { key = KeyboardKey.CapsLock, x = -532, y = -31 },
            { key = KeyboardKey.A, x = -446, y = -31 },
            { key = KeyboardKey.S, x = -384, y = -31 },
            { key = KeyboardKey.D, x = -322, y = -31 },
            { key = KeyboardKey.F, x = -260, y = -31 },
            { key = KeyboardKey.G, x = -198, y = -31 },
            { key = KeyboardKey.H, x = -136, y = -31 },
