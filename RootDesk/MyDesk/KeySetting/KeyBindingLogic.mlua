@Logic
script KeyBindingLogic extends Logic

    property string StorageName = "KeyBinding"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self:EnsureInitialized()
        self:RequestLoadBindings()
    end

    method void EnsureInitialized()
        -- Defends against call order between this Logic's OnBeginPlay and
        -- PlayerInputBinding's Component OnBeginPlay (Logic vs Component
        -- OnBeginPlay order across different entities is not guaranteed) -
        -- every public method routes through this instead of assuming
        -- OnBeginPlay already ran.
        if self._T.registry ~= nil then
            return
        end
        self._T.registry = self:BuildRegistry()
        self._T.currentKeys = {}
        for _, entry in ipairs(self._T.registry) do
            self._T.currentKeys[entry.actionName] = entry.defaultKey
        end
        -- 슬롯 N(1~8)에 배정된 스킬 id("" = 미배정). 클라이언트가 UI/저장의 진실 소스로 삼고, 서버
        -- PlayerSkillComponent.EquippedSkillIdN에는 RPC로 반영한다(서버가 보유 여부를 최종 검증).
        self._T.slotSkill = {}
        for slot = 1, 8 do
            self._T.slotSkill[slot] = ""
        end
        self._T.loadComplete = false
    end

    method table BuildRegistry()
        -- Rebindable actions, split by kind:
        --   "controllerAction" - flows through the native PlayerControllerComponent:SetActionKey
        --     pipeline (PlayerInputBinding.mlua). Only Attack/Skill so far, unlike Jump/Crouch/Sit/
        --     EnterPortal which this project has never explicitly bound and whose current-key
        --     behavior is unverified - scoped out of the rebind UI for now.
        --   "uiToggle" - window open/close shortcuts (Inventory/Equipment/CharacterInfo/SkillWindow).
        --     These have no native action-key equivalent - WindowHotkeyLogic polls
        --     GetUiToggleActionForKey() on every KeyDownEvent instead of going through
        --     PlayerControllerComponent, since that pipeline is combat-action-only.
        --   "itemAction" (2026-09-15 유저 요청 - "소비아이템 중 사용 가능 아이템은 키보드 세팅에
        --     들어갈 수 있게") - 물약처럼 "즉시 사용" 소비아이템 전용. 실제 메이플스토리 키 설정도
        --     아이템(물약) 단축키와 스킬/기능 단축키를 같은 창에서 드래그로 배정하는 방식이라 동일
        --     구조로 확장 - WindowHotkeyLogic이 GetItemActionForKey()로 폴링해
        --     EquipmentLogic:UseFirstPotionOfType(...)을 호출한다. 주문서(scrollId)는 장비에 직접
        --     부여하는 강화 아이템이라 "즉시 사용" 개념 자체가 없어 - 실제 메이플스토리에서도
        --     주문서는 인벤토리에서 장비에 드래그해 적용하지 키 단축키로 쓰지 않는다 - 의도적으로
        --     itemAction에 넣지 않는다.
        return {
            { actionName = "Attack", displayName = "공격", defaultKey = KeyboardKey.LeftControl, kind = "controllerAction" },
            -- 2026-09-20 유저 요청 - "스페이스바를 누르면 점프되는데, 점프는 점프키로 지정된 키로만
            -- 가능하게". 예전엔 점프를 한 번도 명시적으로 바인딩하지 않아(위 주석) 엔진 기본값
            -- Space가 항상 점프였고, 키 세팅에서 Space를 다른 기능에 배정해도 점프가 같이 발동됐다.
            -- 이제 다른 액션과 똑같이 등록해 ApplyBindingsToLocalPlayer가 RemoveAllActionKeyByActionName
            -- 후 지정된 키 하나만 점프에 묶는다(기본값 Space, 키 세팅에서 재배정 가능).
            { actionName = "Jump", displayName = "점프", defaultKey = KeyboardKey.Space, kind = "controllerAction" },
            -- 2026-09-22 유저 요청("스킬 8개를 강제로 키에 박아두지 말고 필요한 스킬만 넣고 빼게" -
            -- Docs/RandomPlanet-KeyRework-Plan.md) - 스킬 슬롯 1~8은 이제 "핫키 위치"다. 기본 키는 없음
            -- (KeyboardKey.None = 미배정)이고, 유저가 스킬창/키보드에서 스킬을 키에 끌어다 놓아야 슬롯이
            -- 채워진다(AssignSkillToKey). 액션명("Skill"=슬롯1, "SkillN"=슬롯N)은 서버
            -- PlayerSkillComponent.HandlePlayerActionEvent와 반드시 일치해야 한다. kind="skillSlot"은
            -- 네이티브 PlayerControllerComponent.SetActionKey 파이프라인은 controllerAction과 같지만,
            -- (1) 계정 공통 저장소가 아니라 캐릭터별 로스터(skillLayout)에 저장되고 (2) 키 설정 창에서
            -- 삭제(미배정으로 되돌리기)가 가능하다.
            { actionName = "Skill", displayName = "스킬1", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 1 },
            { actionName = "Skill2", displayName = "스킬2", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 2 },
            { actionName = "Skill3", displayName = "스킬3", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 3 },
            { actionName = "Skill4", displayName = "스킬4", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 4 },
            { actionName = "Skill5", displayName = "스킬5", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 5 },
            { actionName = "Skill6", displayName = "스킬6", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 6 },
            { actionName = "Skill7", displayName = "스킬7", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 7 },
            { actionName = "Skill8", displayName = "스킬8", defaultKey = KeyboardKey.None, kind = "skillSlot", slot = 8 },
            { actionName = "Inventory", displayName = "인벤토리", defaultKey = KeyboardKey.I, kind = "uiToggle" },
            -- 2026-09-20 QA - 스킬3 기본키(E)와 장비창 기본키(E)가 겹쳐 E 한 번에 장비창 토글과
            -- 스킬3 발동이 동시에 일어났다(실측 확인). 스킬 키(QWER/ASDF 핫바)를 유지하고 장비창을 U로
            -- 옮긴다. 이미 저장된 유저 바인딩의 중복은 ResolveDuplicateKeys가 로드 시 자동 정리.
            { actionName = "Equipment", displayName = "장비", defaultKey = KeyboardKey.U, kind = "uiToggle" },
            { actionName = "CharacterInfo", displayName = "캐릭터정보", defaultKey = KeyboardKey.C, kind = "uiToggle" },
            { actionName = "SkillWindow", displayName = "스킬창", defaultKey = KeyboardKey.K, kind = "uiToggle" },
            { actionName = "UseHpPotion", displayName = "HP 포션", defaultKey = KeyboardKey.Alpha1, kind = "itemAction" },
            { actionName = "UseMpPotion", displayName = "MP 포션", defaultKey = KeyboardKey.Alpha2, kind = "itemAction" },
            -- "fieldAction" - not a controllerAction (no PlayerControllerComponent equivalent) and
            -- not a uiToggle (doesn't open a bottom-bar window) - Field/BattlefieldReturnLogic reads
            -- GetKeyForAction("ReturnToLobby") directly instead of going through
            -- GetUiToggleActionForKey. Still participates in TryRebind's swap-on-conflict logic
            -- (that loop scans currentKeys regardless of kind) and is stored/restored the same way
            -- as every other action, but has no drag-icon in the Key Setting popup yet - add one
            -- there (see KeyBindingPopupController's icon-per-action comment) if it should become
            -- player-rebindable through that UI too.
            { actionName = "ReturnToLobby", displayName = "귀환(토벌전장)", defaultKey = KeyboardKey.B, kind = "fieldAction" },
            -- 2026-09-21 유저 요청 - 몬스터 처치 시 필드에 떨어지는 메소를 줍는 키(MesoPickupLogic).
            -- ReturnToLobby와 동일한 fieldAction - Z는 기존 레지스트리 어디서도 쓰지 않는 빈 키.
            { actionName = "PickupMeso", displayName = "메소 줍기", defaultKey = KeyboardKey.Z, kind = "fieldAction" },
        }
    end

    method any GetRegistryEntry(string actionName)
        self:EnsureInitialized()
        for _, entry in ipairs(self._T.registry) do
            if entry.actionName == actionName then
                return entry
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetUiToggleActionForKey(any key)
        -- Used by WindowHotkeyLogic on every KeyDownEvent to check whether the pressed key is
        -- currently bound to one of the uiToggle actions (Inventory/Equipment/CharacterInfo/
        -- SkillWindow) - these never touch PlayerControllerComponent, so there is no native lookup
        -- for them the way GetActionName(key) works for Attack/Skill.
        self:EnsureInitialized()
        if key == nil or key == KeyboardKey.None then
            return nil
        end
        for _, entry in ipairs(self._T.registry) do
            if entry.kind == "uiToggle" and self._T.currentKeys[entry.actionName] == key then
                return entry.actionName
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetItemActionForKey(any key)
        -- GetUiToggleActionForKey와 동일 패턴 - WindowHotkeyLogic이 KeyDownEvent마다 폴링해
        -- itemAction(HP/MP 포션) 바인딩과 일치하는지 확인한다.
        self:EnsureInitialized()
        if key == nil or key == KeyboardKey.None then
            return nil
        end
        for _, entry in ipairs(self._T.registry) do
            if entry.kind == "itemAction" and self._T.currentKeys[entry.actionName] == key then
                return entry.actionName
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetKeyForAction(string actionName)
        self:EnsureInitialized()
        return self._T.currentKeys[actionName]
    end

    @ExecSpace("ClientOnly")
    method boolean IsLoadComplete()
        self:EnsureInitialized()
        return self._T.loadComplete
    end

    method boolean IsValidRebindKey(any key)
        -- Mouse buttons never reach this as a keyboard rebind target; Enter/Escape
        -- are reserved (Escape cancels the popup's "awaiting key" capture).
        if key == nil or key == KeyboardKey.None then
            return false
        end
        if key == KeyboardKey.Mouse0 or key == KeyboardKey.Mouse1 or key == KeyboardKey.Mouse2 then
            return false
        end
        if key == KeyboardKey.Return or key == KeyboardKey.KeypadEnter then
            return false
        end
        if key == KeyboardKey.Escape then
            return false
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean TryRebind(string actionName, any newKey)
        self:EnsureInitialized()

        if self._T.currentKeys[actionName] == nil then
            return false
        end
        if not self:IsValidRebindKey(newKey) then
            return false
        end

        local oldKey = self._T.currentKeys[actionName]
        if oldKey == newKey then
            return true
        end

        -- MapleStory-style swap: if newKey is already bound to another action we manage
        -- (of EITHER kind - controllerAction or uiToggle), the two actions trade keys instead of
        -- one silently losing its binding. Conflict detection is purely against our own
        -- currentKeys table now (not controller:GetActionName), since uiToggle actions
        -- (Inventory/Equipment/CharacterInfo/SkillWindow) have no native controller entry at all -
        -- currentKeys is the single source of truth for every action regardless of kind.
        local conflictAction = nil
        for name, key in pairs(self._T.currentKeys) do
            if name ~= actionName and key == newKey then
                conflictAction = name
                break
            end
        end
        -- 2026-09-22 - 지금 키가 없는(None) 액션(미배정 물약 등)은 교환할 "내 키"가 없으므로, 남이
        -- 쓰는 키로는 옮길 수 없다(교환하면 상대가 키를 잃는다). 빈 키로만 배정된다.
        if conflictAction ~= nil and oldKey == KeyboardKey.None then
            return false
        end

        self._T.currentKeys[actionName] = newKey
        if conflictAction ~= nil then
            self._T.currentKeys[conflictAction] = oldKey
        end

        self:ApplyControllerBindingForAction(actionName)
        if conflictAction ~= nil then
            self:ApplyControllerBindingForAction(conflictAction)
        end

        self:SaveBindings()
        -- 스킬 슬롯이 관련된 이동/교환은 캐릭터별 로스터(skillLayout)에도 반영한다.
        local movedEntry = self:GetRegistryEntry(actionName)
        local conflictEntry = conflictAction ~= nil and self:GetRegistryEntry(conflictAction) or nil
        if (movedEntry ~= nil and movedEntry.kind == "skillSlot") or (conflictEntry ~= nil and conflictEntry.kind == "skillSlot") then
            self:PersistSkillLayout()
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method void ApplyControllerBindingForAction(string actionName)
        -- Only controllerAction-kind entries touch the native PlayerControllerComponent - uiToggle
        -- actions are tracked purely in currentKeys and read by WindowHotkeyLogic on each
        -- KeyDownEvent (see GetUiToggleActionForKey), since SetActionKey's PlayerActionEvent
        -- pipeline is combat-action-only, not a general hotkey system.
        local entry = self:GetRegistryEntry(actionName)
        if entry == nil or (entry.kind ~= "controllerAction" and entry.kind ~= "skillSlot") then
            return
        end
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            return
        end
        local controller = localPlayer.PlayerControllerComponent
        if not isvalid(controller) then
            return
        end
        -- Uses RemoveAllActionKeyByActionName (by action, not by tracked oldKey) because
        -- SetActionKey is additive - it does not clear a previous key bound to the same action.
        -- ApplyBindingsToLocalPlayer calls this twice per session (fresh defaults immediately, then
        -- again once the async load resolves), so a leftover key can be bound to an action that
        -- currentKeys never recorded. Clearing by action name keeps the native controller and
        -- currentKeys in sync regardless.
        controller:RemoveAllActionKeyByActionName(actionName)
        -- 미배정(None) 스킬 슬롯은 어떤 물리 키에도 묶지 않는다.
        local key = self._T.currentKeys[actionName]
        if key ~= nil and key ~= KeyboardKey.None then
            controller:SetActionKey(key, actionName)
        end
    end

    @ExecSpace("ClientOnly")
    method void ResetToDefaults()
        self:EnsureInitialized()
        for _, entry in ipairs(self._T.registry) do
            -- 스킬 슬롯은 기본값이 "미배정"이라 되돌릴 키가 없다 - "기본값" 버튼이 유저가 애써 배정한
            -- 스킬 배치를 지우지 않도록 건드리지 않는다(다른 기능 키와 충돌해 교환되면 키만 이동).
            if entry.kind ~= "skillSlot" then
                self:TryRebind(entry.actionName, entry.defaultKey)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyBindingsToLocalPlayer(Entity playerEntity)
        self:EnsureInitialized()
        if not isvalid(playerEntity) then
            return
        end
        local controller = playerEntity.PlayerControllerComponent
        if not isvalid(controller) then
            return
        end
        for _, entry in ipairs(self._T.registry) do
            if entry.kind == "controllerAction" or entry.kind == "skillSlot" then
                local key = self._T.currentKeys[entry.actionName] or entry.defaultKey
                -- Called twice per session (defaults immediately, then again once
                -- the async load resolves) - clear any previously bound key for
                -- this action first so re-application never leaves two keys
                -- pointing at the same action (see ApplyControllerBindingForAction).
                controller:RemoveAllActionKeyByActionName(entry.actionName)
                -- 미배정(None) 스킬 슬롯은 물리 키에 묶지 않는다.
                if key ~= KeyboardKey.None then
                    controller:SetActionKey(key, entry.actionName)
                end
            end
        end
    end

    method string SlotActionName(integer slot)
        -- 슬롯 번호 -> 키바인딩 액션명. 서버 PlayerSkillComponent.HandlePlayerActionEvent의
        -- slotByAction과 반드시 같은 규칙("Skill"=슬롯1, "SkillN"=슬롯N).
        if slot == 1 then
            return "Skill"
        end
        return "Skill" .. tostring(slot)
    end

    @ExecSpace("ClientOnly")
    method string GetSkillForSlot(integer slot)
        self:EnsureInitialized()
        return self._T.slotSkill[slot] or ""
    end

    @ExecSpace("ClientOnly")
    method any GetSlotOfSkill(string skillId)
        -- 이 스킬이 배정된 슬롯 번호. 미배정이면 nil.
        self:EnsureInitialized()
        if skillId == nil or skillId == "" then
            return nil
        end
        for slot = 1, 8 do
            if self._T.slotSkill[slot] == skillId then
                return slot
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetKeyForSkill(string skillId)
        -- 이 스킬이 묶인 물리 키. 미배정이면 nil.
        local slot = self:GetSlotOfSkill(skillId)
        if slot == nil then
            return nil
        end
        return self:GetKeyForAction(self:SlotActionName(slot))
    end

    @ExecSpace("ClientOnly")
    method any GetActionForKey(any key)
        -- 지금 이 물리 키를 쓰고 있는 액션명(레지스트리 전체 기준). 아무도 안 쓰면 nil.
        self:EnsureInitialized()
        if key == nil or key == KeyboardKey.None then
            return nil
        end
        for name, k in pairs(self._T.currentKeys) do
            if k == key then
                return name
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any FindFreeSlot()
        -- 스킬이 배정되지 않은 첫 슬롯(그 슬롯의 키는 항상 None). 8슬롯이 다 차 있으면 nil.
        self:EnsureInitialized()
        for slot = 1, 8 do
            if self._T.slotSkill[slot] == "" then
                return slot
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any FindFreeHotkey()
        -- 스킬창의 "키 배정하기" 버튼(클릭 한 번으로 배정하는 보조 경로 - 드래그가 어려울 때)이 쓰는 후보:
        -- 스킬 핫바처럼 쓰기 좋은 키 순서(Q W E R A S D F ...)로, 어떤 액션도 안 쓰는 첫 키. 없으면 nil.
        self:EnsureInitialized()
        local preferred = {
            KeyboardKey.Q, KeyboardKey.W, KeyboardKey.E, KeyboardKey.R,
            KeyboardKey.A, KeyboardKey.S, KeyboardKey.D, KeyboardKey.F,
            KeyboardKey.G, KeyboardKey.H, KeyboardKey.J, KeyboardKey.T,
            KeyboardKey.Y, KeyboardKey.X, KeyboardKey.V, KeyboardKey.N,
        }
        for _, key in ipairs(preferred) do
            if self:GetActionForKey(key) == nil then
                return key
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method boolean AssignSkillToKey(string skillId, any key)
        -- 스킬창에서 키보드의 키로 스킬을 끌어다 놓았을 때(또는 키 설정 창 안에서 새로 배정할 때).
        --  * 키가 비어 있으면: 빈 슬롯 하나를 잡아 그 키에 묶고 스킬을 넣는다.
        --  * 키를 다른 "스킬 슬롯"이 쓰고 있으면: 그 슬롯의 스킬을 이 스킬로 교체한다(기존 스킬은 미배정).
        --  * 키를 공격/점프/창 단축키/물약이 쓰고 있으면: 거부한다(기본 조작을 덮어쓰지 않음).
        -- 같은 스킬이 이미 다른 슬롯에 있으면 그쪽을 비운다(한 스킬은 한 키에만).
        self:EnsureInitialized()
        if skillId == nil or skillId == "" then
            return false
        end
        if not self:IsValidRebindKey(key) then
            return false
        end
        local holder = self:GetActionForKey(key)
        local targetSlot = nil
        if holder ~= nil then
            local holderEntry = self:GetRegistryEntry(holder)
            if holderEntry == nil or holderEntry.kind ~= "skillSlot" then
                log("KeyBinding: AssignSkillToKey rejected, key held by " .. tostring(holder))
                return false
            end
            targetSlot = holderEntry.slot
        else
            targetSlot = self:FindFreeSlot()
            if targetSlot == nil then
                log("KeyBinding: AssignSkillToKey rejected, no free slot")
                return false
            end
        end
        local existing = self:GetSlotOfSkill(skillId)
        if existing ~= nil and existing == targetSlot then
            return true
        end
        if existing ~= nil then
            self:ClearSlotInternal(existing)
        end
        local action = self:SlotActionName(targetSlot)
        self._T.slotSkill[targetSlot] = skillId
        if holder == nil then
            self._T.currentKeys[action] = key
            self:ApplyControllerBindingForAction(action)
        end
        if existing ~= nil then
            self:PushSlotToServer(existing)
        end
        self:PushSlotToServer(targetSlot)
        self:PersistSkillLayout()
        log("KeyBinding: AssignSkillToKey skill=" .. skillId .. " key=" .. tostring(key) .. " slot=" .. tostring(targetSlot))
        return true
    end

    @ExecSpace("ClientOnly")
    method void ClearSlotInternal(integer slot)
        -- 슬롯 하나를 미배정으로 되돌린다(스킬 제거 + 키 해제 + 네이티브 바인딩 제거). 서버/로스터
        -- 반영은 호출부가 한다(여러 슬롯을 바꾸는 흐름에서 한 번만 저장하기 위해).
        local action = self:SlotActionName(slot)
        self._T.slotSkill[slot] = ""
        self._T.currentKeys[action] = KeyboardKey.None
        self:ApplyControllerBindingForAction(action)
    end

    @ExecSpace("ClientOnly")
    method boolean RemoveSkillFromSlot(integer slot)
        -- 키 설정 창에서 스킬 아이콘을 키보드 밖으로 끌어냈을 때 - 그 슬롯을 비운다(스킬은 보유
        -- 그대로, 키만 풀림).
        self:EnsureInitialized()
        if slot == nil or slot < 1 or slot > 8 or self._T.slotSkill[slot] == "" then
            return false
        end
        self:ClearSlotInternal(slot)
        self:PushSlotToServer(slot)
        self:PersistSkillLayout()
        log("KeyBinding: RemoveSkillFromSlot slot=" .. tostring(slot))
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean AssignItemActionToKey(string actionName, any key)
        -- 인벤토리 물약(UseHpPotion/UseMpPotion)을 키에 끌어다 놓았을 때. 빈 키에만 묶는다(이미 다른
        -- 기능이 쓰는 키는 거부 - 같은 액션이 이미 그 키면 그대로 성공).
        self:EnsureInitialized()
        local entry = self:GetRegistryEntry(actionName)
        if entry == nil or entry.kind ~= "itemAction" then
            return false
        end
        if not self:IsValidRebindKey(key) then
            return false
        end
        local holder = self:GetActionForKey(key)
        if holder == actionName then
            return true
        end
        if holder ~= nil then
            log("KeyBinding: AssignItemActionToKey rejected, key held by " .. tostring(holder))
            return false
        end
        self._T.currentKeys[actionName] = key
        self:SaveBindings()
        log("KeyBinding: AssignItemActionToKey " .. actionName .. " -> " .. tostring(key))
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean ClearItemAction(string actionName)
        -- 물약 키를 미배정으로 되돌린다(키 설정 창에서 물약 아이콘을 키보드 밖으로 끌어낼 때).
        self:EnsureInitialized()
        local entry = self:GetRegistryEntry(actionName)
        if entry == nil or entry.kind ~= "itemAction" then
            return false
        end
        if self._T.currentKeys[actionName] == KeyboardKey.None then
            return false
        end
        self._T.currentKeys[actionName] = KeyboardKey.None
        self:SaveBindings()
        log("KeyBinding: ClearItemAction " .. actionName)
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean IsRemovableAction(string actionName)
        -- 키 설정 창에서 "키보드 밖으로 끌어내 해제"가 가능한 액션인가(스킬 슬롯, 물약). 공격/점프/창
        -- 단축키/귀환/줍기는 없으면 게임 조작이 막히므로 이동만 가능.
        local entry = self:GetRegistryEntry(actionName)
        return entry ~= nil and (entry.kind == "skillSlot" or entry.kind == "itemAction")
    end

    @ExecSpace("ClientOnly")
    method void PushSlotToServer(integer slot)
        -- 슬롯 하나의 현재 스킬(빈 문자열이면 해제)을 서버 PlayerSkillComponent에 반영한다. 서버가
        -- 보유 여부/본인 여부를 최종 검증한다.
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            return
        end
        local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
        if not isvalid(skillComp) then
            return
        end
        skillComp:RequestAssignSkillToSlot(slot, self._T.slotSkill[slot] or "")
    end

    @ExecSpace("ClientOnly")
    method table BuildSkillLayout()
        -- 캐릭터별 로스터에 저장할 형태 { ["1"] = { key = "Q", skill = "id" }, ... } - 배정된 슬롯만.
        self:EnsureInitialized()
        local out = {}
        for slot = 1, 8 do
            local id = self._T.slotSkill[slot]
            local key = self._T.currentKeys[self:SlotActionName(slot)]
            if id ~= "" and key ~= nil and key ~= KeyboardKey.None then
                out[tostring(slot)] = { key = tostring(key), skill = id }
            end
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method void PersistSkillLayout()
        -- 현재 슬롯 배치를 활성 캐릭터의 로스터 데이터에 저장한다(캐릭터별 - 직업마다 스킬이 다르므로).
        _CharacterRosterLogic:UpdateActiveSkillLayout(self:BuildSkillLayout())
    end

    @ExecSpace("ClientOnly")
    method void ApplySkillLayoutForActiveCharacter()
        -- 캐릭터 진입/교체 직후 호출 - 활성 캐릭터의 저장된 스킬 배치를 복원한다. 먼저 8슬롯을 전부
        -- 비워(이전 캐릭터의 배치가 남지 않게) 컨트롤러에 반영하고, 저장된 배치를 검증(유효한 키,
        -- 다른 기능이 안 쓰는 키)해 채운 뒤, 서버에 8슬롯 전체를 한꺼번에 알린다. 서버가 보유 여부를
        -- 최종 검증하므로 여기서는 보유 스킬 목록을 확인하지 않는다(티어 스킬 동기화가 늦어도 안전).
        self:EnsureInitialized()
        local layout = _CharacterRosterLogic:GetActiveSkillLayout()
        for slot = 1, 8 do
            self._T.slotSkill[slot] = ""
            self._T.currentKeys[self:SlotActionName(slot)] = KeyboardKey.None
        end
        for slot = 1, 8 do
            local rec = layout[tostring(slot)]
            if rec ~= nil and rec.skill ~= nil and rec.skill ~= "" and rec.key ~= nil then
                local key = KeyboardKey.CastFrom(rec.key)
                if key ~= nil and self:IsValidRebindKey(key) and self:GetActionForKey(key) == nil then
                    self._T.slotSkill[slot] = rec.skill
                    self._T.currentKeys[self:SlotActionName(slot)] = key
                end
            end
        end
        for slot = 1, 8 do
            self:ApplyControllerBindingForAction(self:SlotActionName(slot))
        end
        local localPlayer = _UserService.LocalPlayer
        if isvalid(localPlayer) then
            local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
            if isvalid(skillComp) then
                local arr = {}
                for slot = 1, 8 do
                    arr[slot] = self._T.slotSkill[slot]
                end
                skillComp:RequestApplySkillLayout(arr)
            end
        end
        log("KeyBinding: ApplySkillLayoutForActiveCharacter " .. self._T.slotSkill[1] .. "/" .. self._T.slotSkill[2] .. "/" .. self._T.slotSkill[3] .. "/" .. self._T.slotSkill[4] .. "/" .. self._T.slotSkill[5] .. "/" .. self._T.slotSkill[6] .. "/" .. self._T.slotSkill[7] .. "/" .. self._T.slotSkill[8])
    end

    @ExecSpace("ClientOnly")
    method string GetSymbol(any key)
        if key == nil or key == KeyboardKey.None then
            return "-"
        end
        local symbolTable = {
            [KeyboardKey.Return] = "Enter",
            [KeyboardKey.Escape] = "ESC",
            [KeyboardKey.Space] = "Space",
            [KeyboardKey.UpArrow] = "Up",
            [KeyboardKey.DownArrow] = "Down",
            [KeyboardKey.LeftArrow] = "Left",
            [KeyboardKey.RightArrow] = "Right",
            [KeyboardKey.LeftControl] = "Ctrl",
            [KeyboardKey.RightControl] = "Ctrl",
            [KeyboardKey.LeftShift] = "Shift",
            [KeyboardKey.RightShift] = "Shift",
            [KeyboardKey.LeftAlt] = "Alt",
            [KeyboardKey.RightAlt] = "Alt",
        }
        local sym = symbolTable[key]
        if sym ~= nil then
            return sym
        end
        return tostring(key)
    end

    @ExecSpace("Server")
    method void RequestLoadBindings()
        -- Mirrors CharacterRosterLogic.RequestLoadRoster's proven load pattern
        -- (GetUserDataStorage keyed by ProfileCode, NotFound=1000002 treated as
        -- "new player, use defaults").
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then
            return
        end
        local profileCode = player.PlayerComponent.ProfileCode
        local storage = _DataStorageService:GetUserDataStorage(profileCode)
        local errorCode, raw = storage:GetAndWait(self.StorageName)

        -- Values stay as plain strings (KeyboardKey Name, e.g. "LeftControl") here -
        -- KeyboardKey itself is an engine enum and cannot cross the Server->Client
        -- RPC boundary (LEA-3036 InvalidCast). Only the client converts back via
        -- KeyboardKey.CastFrom, after the value has already arrived locally.
        local keys = {}
        if errorCode == 0 and raw ~= nil and raw ~= "" then
            local decoded = _HttpService:JSONDecode(raw)
            for actionName, keyName in pairs(decoded or {}) do
                keys[actionName] = keyName
            end
        elseif errorCode ~= 0 and errorCode ~= 1000002 then
            log_error("KeyBinding: RequestLoadBindings GetAndWait failed, errorCode=" .. tostring(errorCode))
        end

        self:OnBindingsLoaded(keys, senderUserId)
    end

    @ExecSpace("Client")
    method void OnBindingsLoaded(table savedKeys)
        self:EnsureInitialized()
        for actionName, keyName in pairs(savedKeys) do
            -- 2026-09-22 - 스킬 슬롯 키는 이제 캐릭터별 로스터(skillLayout)가 소유한다. 예전 버전이
            -- 계정 저장소에 남긴 Skill/Skill2~8 값은 무시한다(다음 SaveBindings에서 자연히 사라짐).
            local savedEntry = self:GetRegistryEntry(actionName)
            if savedEntry ~= nil and savedEntry.kind ~= "skillSlot" and self._T.currentKeys[actionName] ~= nil then
                local key = KeyboardKey.CastFrom(keyName)
                if key ~= nil then
                    self._T.currentKeys[actionName] = key
                end
            end
        end
        self._T.loadComplete = true
        self:ResolveDuplicateKeys()

        local localPlayer = _UserService.LocalPlayer
        if isvalid(localPlayer) then
            self:ApplyBindingsToLocalPlayer(localPlayer)
        end
        log("KeyBinding: OnBindingsLoaded, hadSavedData=" .. tostring(next(savedKeys) ~= nil))
    end

    @ExecSpace("ClientOnly")
    method void ResolveDuplicateKeys()
        -- 2026-09-20 QA - 한 물리 키가 두 액션에 동시에 묶여 있으면(예: 예전 기본값 E = 스킬3 +
        -- 장비창) 키 한 번에 두 동작이 발동된다. 레지스트리 순서상 앞선 액션(스킬 등 전투 액션)이 키를
        -- 유지하고, 뒤에 오는 액션은 자기 기본키가 비어있으면 그리로, 아니면 후보 키 중 빈 키로 옮긴다.
        -- 옮긴 결과가 있으면 저장까지 한다. P는 키 세팅 창 토글 전용이라 후보에서 제외.
        self:EnsureInitialized()
        local used = {}
        local changed = false
        local fallback = { KeyboardKey.U, KeyboardKey.T, KeyboardKey.G, KeyboardKey.Z, KeyboardKey.X, KeyboardKey.V, KeyboardKey.N, KeyboardKey.M }
        local taken = {}
        for _, entry in ipairs(self._T.registry) do
            local heldKey = self._T.currentKeys[entry.actionName]
            if heldKey ~= KeyboardKey.None then
                taken[heldKey] = true
            end
        end
        for _, entry in ipairs(self._T.registry) do
            local key = self._T.currentKeys[entry.actionName]
            -- 미배정(None)은 여러 액션이 동시에 가져도 중복이 아니다.
            if key == KeyboardKey.None then
                -- skip
            elseif used[key] then
                local newKey = nil
                if not taken[entry.defaultKey] then
                    newKey = entry.defaultKey
                else
                    for _, cand in ipairs(fallback) do
                        if not taken[cand] then
                            newKey = cand
                            break
                        end
                    end
                end
                if newKey ~= nil then
                    self._T.currentKeys[entry.actionName] = newKey
                    taken[newKey] = true
                    used[newKey] = true
                    changed = true
                    log("KeyBinding: ResolveDuplicateKeys " .. entry.actionName .. " " .. tostring(key) .. " -> " .. tostring(newKey))
                end
            else
                used[key] = true
            end
        end
        if changed then
            self:SaveBindings()
            self:PersistSkillLayout()
        end
    end

    @ExecSpace("ClientOnly")
    method void SaveBindings()
        self:EnsureInitialized()
        if not self._T.loadComplete then
            log_warning("KeyBinding: SaveBindings skipped, load not complete yet")
            return
        end
        -- Convert KeyboardKey -> string (Name) here, client-side, before crossing
        -- to the server - KeyboardKey is an engine enum and cannot cross the
        -- Client->Server RPC boundary directly (LEA-3036 InvalidCast).
        local payload = {}
        for actionName, key in pairs(self._T.currentKeys) do
            -- 스킬 슬롯은 캐릭터별 로스터에 저장되므로 계정 공통 저장소에서는 제외한다.
            local entry = self:GetRegistryEntry(actionName)
            if entry ~= nil and entry.kind ~= "skillSlot" then
                payload[actionName] = tostring(key)
            end
        end
        self:RequestSaveBindings(payload)
    end

    @ExecSpace("Server")
    method void RequestSaveBindings(table keys)
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then
            return
        end
        local profileCode = player.PlayerComponent.ProfileCode

        if next(keys) == nil then
            return
        end

        local json = _HttpService:JSONEncode(keys)
        local storage = _DataStorageService:GetUserDataStorage(profileCode)
        storage:SetAsync(self.StorageName, json, function(errorCode, key)
            if errorCode ~= 0 then
                log_error("KeyBinding: RequestSaveBindings SetAsync failed, errorCode=" .. tostring(errorCode))
            end
        end)
    end

end
