@Logic
script WindowHotkeyLogic extends Logic
    -- Global listener for the uiToggle/itemAction-kind actions in KeyBindingLogic's registry
    -- (Inventory/Equipment/CharacterInfo/SkillWindow window toggles + HP/MP 포션 즉시 사용). These
    -- have no native PlayerControllerComponent action - that pipeline is combat-action-only
    -- (Attack/Skill) - so this Logic is the single place that turns "a rebindable key was pressed"
    -- into either "toggle the matching bottom-bar window" (routed through BottomBarController so the
    -- existing CloseOtherWindows mutual-exclusivity still applies whether the window was opened by
    -- mouse click or by hotkey) or "use the matching potion" (2026-09-15 유저 요청, routed through
    -- EquipmentLogic so the click-driven Inventory path and the hotkey path share one consumption
    -- method).

    property any keyHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
    end

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- Mirrors the PlayerControllerComponent.Enable gate in CharacterRosterLogic.Hide/
        -- ShowLocalPlayer - windows should not be openable while parked on choice_map (the bottom
        -- bar itself is hidden there too, via SetBottomBarVisible(false)).
        if not _CharacterRosterLogic:IsGameplayActive() then
            return
        end
        if event.key == KeyboardKey.Escape then
            self:CloseAnyOpenWindow()
            return
        end
        local itemAction = _KeyBindingLogic:GetItemActionForKey(event.key)
        if itemAction ~= nil then
            self:TriggerItemAction(itemAction)
            return
        end
        local actionName = _KeyBindingLogic:GetUiToggleActionForKey(event.key)
        if actionName == nil then
            return
        end
        self:ToggleWindowForAction(actionName)
    end

    @ExecSpace("ClientOnly")
    method void CloseAnyOpenWindow()
        -- Classic MapleStory ESC behavior - closes whichever popup card is currently on screen
        -- (inventory/equipment/character info/settings/skill, plus the key-setting and squad-
        -- formation "link passive" cards). CloseOtherWindows("") with no path to keep closes every
        -- one of them - the exact same mutual-exclusion sweep a bottom-bar click or hotkey already
        -- triggers before opening its own target, just with no new window opened afterward. Safe to
        -- call with nothing open (each window's Hide()/Close() is idempotent).
        local bar = self:GetBottomBar()
        if not isvalid(bar) then
            return
        end
        bar:CloseOtherWindows("")
    end

    @ExecSpace("ClientOnly")
    method void TriggerItemAction(string actionName)
        -- 2026-09-15 유저 요청 - HP/MP 포션을 인벤토리 창을 열지 않고 단축키로 즉시 사용.
        -- 실제 소모 로직은 EquipmentLogic이 소유(인벤토리 클릭 경로와 공유) - 여기서는 단순히
        -- actionName -> restoreType 매핑만 한다.
        if actionName == "UseHpPotion" then
            _EquipmentLogic:UseFirstPotionOfType("hp")
        elseif actionName == "UseMpPotion" then
            _EquipmentLogic:UseFirstPotionOfType("mp")
        end
    end

    @ExecSpace("ClientOnly")
    method void ToggleWindowForAction(string actionName)
        local bar = self:GetBottomBar()
        if not isvalid(bar) then
            return
        end
        local target = self:ResolveWindow(actionName)
        if target == nil then
            return
        end
        bar:CloseOtherWindows(target.path)
        bar:ToggleWindow(target.path, target.scriptType)
    end

    method any ResolveWindow(string actionName)
        -- Single-table return (not a Lua multi-return) - this workspace's mlua compiler flags
        -- `return a, b` from a declared single-value method (LWA-1111), so the two fields travel
        -- together in one table instead.
        if actionName == "Inventory" then
            return { path = "/ui/InventoryGroup", scriptType = "script.InventoryUIController" }
        elseif actionName == "Equipment" then
            return { path = "/ui/EquipmentGroup", scriptType = "script.EquipmentUIController" }
        elseif actionName == "CharacterInfo" then
            return { path = "/ui/CharacterInfoGroup", scriptType = "script.CharacterInfoUIController" }
        elseif actionName == "SkillWindow" then
            return { path = "/ui/SkillGroup", scriptType = "script.SkillUIController" }
        end
        return nil
    end

    method any GetBottomBar()
        local barGroup = _EntityService:GetEntityByPath("/ui/BottomBarGroup")
        if not isvalid(barGroup) then
            return nil
        end
        return barGroup:GetComponent("script.BottomBarController")
    end

    @ExecSpace("ClientOnly")
    method boolean IsKeySettingOpen()
        -- 키 설정 창(KeyBindingPopupController)이 지금 열려 있는가.
        local group = _EntityService:GetEntityByPath("/ui/KeySettingGroup")
        if not isvalid(group) then
            return false
        end
        local popup = group:GetComponent("script.KeyBindingPopupController")
        return isvalid(popup) and popup.isOpen
    end

    @ExecSpace("ClientOnly")
    method void DockCardBesideKeyWindow(string cardPath, number cardWidth)
        -- 2026-09-22 키 설정 개편 - 키 설정 창이 열려 있으면, 스킬창/인벤토리 같은 "드래그 원본" 카드를
        -- 화면 오른쪽 끝(여백 20)에 붙여 키 설정 창(왼쪽에 붙음)과 겹치지 않게 한다. 열려 있지 않으면
        -- 카드는 원래 위치를 그대로 쓴다.
        if not self:IsKeySettingOpen() then
            return
        end
        local card = _EntityService:GetEntityByPath(cardPath)
        if not isvalid(card) then
            return
        end
        card.UITransformComponent.anchoredPosition = Vector2(960 - 20 - cardWidth / 2, 0)
    end

    @ExecSpace("ClientOnly")
    method void DockOpenCompanions()
        -- 키 설정 창이 열리는 순간, 이미 열려 있는 드래그 원본 창(스킬창/인벤토리)을 오른쪽으로 옮긴다.
        local companions = {
            { root = "/ui/SkillGroup", card = "/ui/SkillGroup/Card", width = 480 },
            { root = "/ui/InventoryGroup", card = "/ui/InventoryGroup/Card", width = 520 },
        }
        for _, c in ipairs(companions) do
            local root = _EntityService:GetEntityByPath(c.root)
            if isvalid(root) and root.Enable then
                self:DockCardBesideKeyWindow(c.card, c.width)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyDragDelta(UITransformComponent cardTransform, UITouchDragEvent event)
        -- 2026-09-15 코드 최적화 - 창 제목줄 드래그 이동 로직이 Equipment/Inventory/
        -- CharacterInfo/Settings 4개 팝업 컨트롤러의 OnDrag에 완전히 동일하게(수식까지) 중복돼
        -- 있던 것을 통합. 각 컨트롤러의 dragHandle이 UITouchDragEvent를 이 그대로 전달한다.
        if not isvalid(cardTransform) then return end
        local pos = cardTransform.anchoredPosition
        cardTransform.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.keyHandler then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
        end
    end

end
