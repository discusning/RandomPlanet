@Component
script EquipmentUIController extends Component
    -- Equipment popup controller - paperdoll-only (inventory rows moved to InventoryUIController,
    -- see AGENTS.md's latest UI-split request: Equipment and Inventory are now separate windows).
    property Entity btnClose = "3d26f324-8c2c-49c6-b768-f549840e5ddd"
    property Entity statSummary = "75b19f09-ee5a-4b07-98c1-026f23c493db"
    property Entity slotWeapon = "44dd39d9-e767-4fd5-a654-6f1d2d8507a5"
    property Entity slotCap = "046a1503-cd94-47d1-85c6-43f515a1c816"
    property Entity slotCoat = "234e590c-41d2-4acd-b79e-b7eb2f0f0789"
    property Entity slotPants = "45d5c055-8704-496d-b0c8-264f560703c4"
    property Entity slotShoes = "6f6caba0-cd77-49cc-ab85-b4c24af478a6"
    property Entity slotGlove = "6c021631-79af-4255-9a43-7ed4b9830a36"
    property Entity slotShield = "c62c078d-ba46-4844-8494-9d8b48bbe914"
    property Entity slotEaraccessory = "235a38fe-bb3f-497a-b2c4-1d6e894cca1b"
    -- Title-bar drag strip (left of the close button) + the window panel it moves - lets the
    -- player reposition the window by mouse-down-dragging the title, matching classic MapleStory
    -- window behavior (see AGENTS.md's window-drag request).
    property Entity dragHandle = "86c1a89d-a08a-4e0d-929f-84c2aa7e36e8"
    property UITransformComponent cardTransform = "3c92ee94-5d13-49af-99a2-fe3e5bd3e5c8"
    -- Neutral slot background RUID (same sprite every empty/labeled slot was built with) - Refresh
    -- must reset ImageRUID back to this on unequip, or a stale item thumbnail from before the
    -- unequip keeps rendering under the tan tint (found via playtest: unequip left the sword icon
    -- visible in the weapon slot even though STR correctly dropped back down).
    property string DefaultSlotRUID = "2860136c06ab075439721c027de365af"

    -- Empty-slot tan vs filled-slot white (so the real item thumbnail reads at full color) -
    -- matches this project's established gold/parchment palette.
    method Color _EmptyColor()
        return Color(0.86, 0.75, 0.52, 1)
    end

    method Color _FilledColor()
        return Color(1, 1, 1, 1)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Hidden by default (same toggle pattern as CharacterCardController/SquadFormationController
        -- - this script sits on the group root, so self.Entity.Enable gates the whole popup).
        self._T.handlers = {}
        self._T.slotButtons = {
            weapon = self.slotWeapon, cap = self.slotCap, coat = self.slotCoat, pants = self.slotPants,
            shoes = self.slotShoes, glove = self.slotGlove, shield = self.slotShield, earaccessory = self.slotEaraccessory,
        }

        local hClose = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        table.insert(self._T.handlers, { entity = self.btnClose, eventType = ButtonClickEvent, eventHandler = hClose })

        for slot, btn in pairs(self._T.slotButtons) do
            local capturedSlot = slot
            local h = btn:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked(capturedSlot) end)
            table.insert(self._T.handlers, { entity = btn, eventType = ButtonClickEvent, eventHandler = h })
        end

        if isvalid(self.dragHandle) then
            local hDrag = self.dragHandle:ConnectEvent(UITouchDragEvent, self.OnDrag)
            table.insert(self._T.handlers, { entity = self.dragHandle, eventType = UITouchDragEvent, eventHandler = hDrag })
        end

        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnDrag(UITouchDragEvent event)
        -- Moves the whole window panel by the drag delta - only the title-bar strip
        -- (dragHandle) generates this event, so clicks inside the window body/slots are unaffected.
        if not isvalid(self.cardTransform) then return end
        local pos = self.cardTransform.anchoredPosition
        self.cardTransform.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
    end

    @ExecSpace("ClientOnly")
    method void Show()
        self.Entity.Enable = true
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        if self.Entity.Enable then
            self:Hide()
        else
            self:Show()
        end
    end

    @ExecSpace("ClientOnly")
    method any GetActiveCharacterData()
        -- The Equipment UI is only ever opened from the Lobby, where the active roster slot is
        -- the real player being controlled - see LobbyStageController's bottom-bar wiring.
        local activeIdx = _CharacterRosterLogic:GetActiveIndex()
        if activeIdx == nil then
            return nil
        end
        local roster = _CharacterRosterLogic:GetRoster()
        return roster[activeIdx]
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        local data = self:GetActiveCharacterData()
        if data == nil then
            self:Hide()
            return
        end

        local str = _EquipmentLogic:GetEffectiveStat(data, "str")
        local dex = _EquipmentLogic:GetEffectiveStat(data, "dex")
        local intel = _EquipmentLogic:GetEffectiveStat(data, "int")
        local luk = _EquipmentLogic:GetEffectiveStat(data, "luk")
        self.statSummary.TextGUIRendererComponent.Text = "STR " .. str .. "\nDEX " .. dex .. "\nINT " .. intel .. "\nLUK " .. luk

        local equipment = data.equipment or {}
        local slotLabels = { weapon = "무기", cap = "모자", coat = "상의", pants = "하의", shoes = "신발", glove = "장갑", shield = "방패", earaccessory = "귀고리" }
        for slot, btn in pairs(self._T.slotButtons) do
            local inst = equipment[slot]
            local sprite = btn.SpriteGUIRendererComponent
            local text = btn.TextGUIRendererComponent
            if inst ~= nil then
                local tpl = _EquipmentLogic:GetItemTemplate(inst.itemId)
                if tpl ~= nil and tpl.ruid ~= nil and tpl.ruid ~= "" then
                    sprite.ImageRUID = DataRef("thumbnail://" .. tpl.ruid)
                    sprite.Color = self:_FilledColor()
                    text.Text = ""
                else
                    sprite.ImageRUID = DataRef(self.DefaultSlotRUID)
                    sprite.Color = self:_EmptyColor()
                    text.Text = (tpl ~= nil) and tpl.name or "?"
                end
            else
                sprite.ImageRUID = DataRef(self.DefaultSlotRUID)
                sprite.Color = self:_EmptyColor()
                text.Text = slotLabels[slot]
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnSlotClicked(string slot)
        local data = self:GetActiveCharacterData()
        if data == nil then
            return
        end

        local changed = false
        local selectedIdx = _EquipmentLogic:GetSelectedInventoryIndex()
        if selectedIdx == nil then
            -- Nothing armed in the Inventory window - clicking a filled slot unequips it.
            changed = _EquipmentLogic:UnequipSlot(data, slot)
        else
            local inst = (data.inventory or {})[selectedIdx]
            if inst ~= nil and inst.itemId ~= nil then
                -- A gear item is armed - only equip it if the clicked slot matches the item's own
                -- slot (clicking an unrelated slot box is a silent no-op).
                local tpl = _EquipmentLogic:GetItemTemplate(inst.itemId)
                if tpl ~= nil and tpl.slot == slot then
                    changed = _EquipmentLogic:EquipItem(data, selectedIdx)
                end
            elseif inst ~= nil and inst.scrollId ~= nil then
                -- A scroll is armed - apply it to whatever is equipped in the clicked slot.
                local result = _EquipmentLogic:ApplyScroll(data, selectedIdx, slot)
                log("EquipmentUI: " .. result.message)
                -- 2026-09-12 시스템 업그레이드 - 강화(주문서) 성공/실패 피드백(클래식 메이플스토리
                -- 관행). 지금까지 결과가 log()에만 찍히고 화면엔 스탯이 조용히 바뀌는 것 말고 아무
                -- 표시가 없어, 성공/실패를 플레이어가 전혀 알 수 없었다. Refresh() 호출 후(아래) 슬롯
                -- 색을 짧게 초록/빨강으로 물들여 결과를 알린다.
                -- 2026-09-12 QA(전반적 QA 3차 확장) - `changed`/플래시 둘 다 `result.applied`로
                -- 게이팅하도록 수정. 이전에는 ApplyScroll의 6가지 "아무것도 소모 안 됨" 이른 반환
                -- (주문서 없음/대상 슬롯 비어있음/강화 횟수 초과 등)도 실제 롤 실패와 똑같이
                -- `success=false`만 봐서 무조건 `changed=true`(불필요한 로스터 저장)였고, 새로 추가한
                -- 빨간 실패 플래시까지 "아무 일도 안 일어났는데 실패했다"고 잘못 표시할 뻔했다.
                changed = result.applied == true
                if result.applied then
                    self._T.pendingScrollFlash = { slot = slot, success = result.success }
                end
            end
            _EquipmentLogic:SetSelectedInventoryIndex(nil)
        end

        if changed then
            _CharacterRosterLogic:RequestApplyEquipmentToPlayer(data.equipment)
            _CharacterRosterLogic:SaveRoster()
        end
        self:Refresh()
        self:RefreshInventoryWindowIfOpen()
        if self._T.pendingScrollFlash ~= nil then
            self:PlayScrollFeedback(self._T.pendingScrollFlash.slot, self._T.pendingScrollFlash.success)
            self._T.pendingScrollFlash = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayScrollFeedback(string slot, boolean success)
        -- 강화 슬롯을 짧게(0.35초) 초록(성공)/빨강(실패)으로 물들인 뒤 Refresh()로 원래 상태(장착된
        -- 아이템 썸네일의 정상 흰색, 혹은 빈 슬롯의 탠 색)를 다시 계산해 복원한다 - 색을 하드코딩해
        -- 복원하는 대신 기존 Refresh 로직을 재사용해 그 사이 상태가 바뀌어도 항상 정확하다.
        local btn = self._T.slotButtons[slot]
        if not isvalid(btn) then return end
        local sprite = btn.SpriteGUIRendererComponent
        if not isvalid(sprite) then return end
        sprite.Color = success and Color(0.4, 1.0, 0.4, 1) or Color(1.0, 0.35, 0.35, 1)
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) then
                self:Refresh()
            end
        end, 0.35)
    end

    @ExecSpace("ClientOnly")
    method void RefreshInventoryWindowIfOpen()
        -- Equip/unequip/scroll all mutate the same shared inventory array the Inventory window
        -- displays - keep it in sync if it's currently open.
        local invGroup = _EntityService:GetEntityByPath("/ui/InventoryGroup")
        if isvalid(invGroup) and invGroup.Enable then
            local invController = invGroup:GetComponent("script.InventoryUIController")
            if isvalid(invController) then
                invController:Refresh()
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        self:Hide()
    end
end
