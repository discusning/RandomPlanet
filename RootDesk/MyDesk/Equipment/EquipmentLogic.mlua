@Logic
script EquipmentLogic extends Logic

    property string ItemsDataSetName = "EquipmentItems"
    property string ScrollsDataSetName = "EquipmentScrolls"
    -- 기본 무기이자 스타포스 대상(죽도). 외형은 투명(ruid 비움)이라 아바타에 무기가 그려지지 않는다.
    property string DefaultWeaponId = "bamboo_sword"
    property integer StarforceMaxStar = 25
    property integer StarforceSafeStar = 12
    -- 강화 1단계당 추가 공격력(무기 강화로만 얻는다). 25성이면 +12.5.
    property number StarforceAttackPerStar = 0.5

    method void OnBeginPlay()
        -- Unannotated (not ClientOnly) so both the client process's instance AND the server
        -- process's instance load their own local catalog cache - ApplyEquipmentToAvatar needs
        -- the catalog on whichever side calls it (client for standees, server for the real
        -- player's CostumeManagerComponent, matching AvatarLookLogic.ApplyLookToPlayer's
        -- ServerOnly pattern).
        self._T.itemCatalog = {}
        self._T.scrollCatalog = {}
        self:LoadCatalogs()
    end

    method void LoadCatalogs()
        -- Reads the two equipment UserDataSets into in-memory lookup tables, keyed by id.
        local items = _DataService:GetTable(self.ItemsDataSetName)
        for _, row in ipairs(items:GetAllRow()) do
            local id = row:GetItem("id")
            self._T.itemCatalog[id] = {
                id = id,
                name = row:GetItem("name"),
                slot = row:GetItem("slot"),
                ruid = row:GetItem("ruid"),
                bonusStr = tonumber(row:GetItem("bonusStr")) or 0,
                bonusDex = tonumber(row:GetItem("bonusDex")) or 0,
                bonusInt = tonumber(row:GetItem("bonusInt")) or 0,
                bonusLuk = tonumber(row:GetItem("bonusLuk")) or 0,
                maxUpgradeSlots = tonumber(row:GetItem("maxUpgradeSlots")) or 0,
            }
        end

        -- 죽도(기본 무기, 스타포스 전용). 외형 RUID를 비워서 장착해도 아바타에 무기가 그려지지 않는다.
        -- 주문서 강화 대신 스타포스로만 강화하며, 0~25성. 터지면 아이템은 남고 12성으로 되돌아간다.
        self._T.itemCatalog[self.DefaultWeaponId] = {
            id = self.DefaultWeaponId, name = "죽도", slot = "weapon", ruid = "", iconRuid = "9fe4b7743e5b4be8853b44624f81f1d0",
            bonusStr = 0, bonusDex = 0, bonusInt = 0, bonusLuk = 0, maxUpgradeSlots = 0, starforce = true,
        }
        -- 옛 투명 무기 항목(호환용). 기존 인스턴스는 ApplyTransparentWeaponDefault가 죽도로 옮긴다.
        self._T.itemCatalog["transparent_weapon"] = {
            id = "transparent_weapon", name = "투명 무기", slot = "weapon", ruid = "", iconRuid = "89c49a2885324eb48aafa342c6f670d1",
            bonusStr = 0, bonusDex = 0, bonusInt = 0, bonusLuk = 0, maxUpgradeSlots = 0, starforce = true,
        }
        -- 스타포스 확률표(단위: 1/100000 = 0.001%). index = 현재 별 + 1.
        -- 구 스타포스 표(일반 장비). 출처: github.com/Red-Barn/maplestory-n-util/issues/33 (사용자 제공 표, 행 합 100% 확인).
        -- success = 성공(별+1) / drop = 하락(별-1) / destroy = 파괴(12성 회귀, 12성 이상에서만 발생) / 나머지 = 유지.
        -- 세이프 모드는 파괴만 막는다(유지로 바뀜). 하락은 막지 않는다.
        self._T.starRates = {
            { success = 95000, drop = 0,     destroy = 0 },
            { success = 90000, drop = 0,     destroy = 0 },
            { success = 85000, drop = 0,     destroy = 0 },
            { success = 85000, drop = 0,     destroy = 0 },
            { success = 80000, drop = 0,     destroy = 0 },
            { success = 75000, drop = 0,     destroy = 0 },
            { success = 70000, drop = 0,     destroy = 0 },
            { success = 65000, drop = 0,     destroy = 0 },
            { success = 60000, drop = 0,     destroy = 0 },
            { success = 55000, drop = 0,     destroy = 0 },
            { success = 50000, drop = 0,     destroy = 0 },
            { success = 45000, drop = 55000, destroy = 0 },
            { success = 40000, drop = 59400, destroy = 600 },
            { success = 35000, drop = 63700, destroy = 1300 },
            { success = 30000, drop = 68600, destroy = 1400 },
            { success = 30000, drop = 0,     destroy = 2100 },
            { success = 30000, drop = 67900, destroy = 2100 },
            { success = 30000, drop = 67900, destroy = 2100 },
            { success = 30000, drop = 67200, destroy = 2800 },
            { success = 30000, drop = 67200, destroy = 2800 },
            { success = 30000, drop = 0,     destroy = 7000 },
            { success = 30000, drop = 63000, destroy = 7000 },
            { success = 3000,  drop = 77600, destroy = 19400 },
            { success = 2000,  drop = 68600, destroy = 29400 },
            { success = 1000,  drop = 59400, destroy = 39600 },
        }

        local scrolls = _DataService:GetTable(self.ScrollsDataSetName)
        for _, row in ipairs(scrolls:GetAllRow()) do
            local id = row:GetItem("id")
            self._T.scrollCatalog[id] = {
                id = id,
                name = row:GetItem("name"),
                stat = row:GetItem("stat"),
                amount = tonumber(row:GetItem("amount")) or 0,
                successRate = tonumber(row:GetItem("successRate")) or 0,
                ruid = row:GetItem("ruid"),
            }
        end
        log("EquipmentLogic: catalogs loaded, items=" .. #self:ListItemTemplates() .. " scrolls=" .. #self:ListScrollTemplates())
    end

    method table GetSlotList()
        -- The 8 basic equip slots (old-MapleStory earliest set), each mapped 1:1 to a real
        -- CostumeManagerComponent category in ApplyEquipmentToAvatar - see msw-avatar.
        return { "weapon", "cap", "coat", "pants", "shoes", "glove", "shield", "earaccessory" }
    end

    method table GetItemTemplate(string itemId)
        return self._T.itemCatalog[itemId]
    end

    method table GetScrollTemplate(string scrollId)
        return self._T.scrollCatalog[scrollId]
    end

    method table GetPotionTemplate(string potionId)
        -- 물약 시스템 (M2 Phase A, 2026-09-06 / 2026-09-15 HP+MP 확장) - 종류가 2개뿐이라
        -- 아이템/주문서처럼 별도 UserDataSet을 만들지 않고 하드코딩(불필요한 인프라 회피, 종류가
        -- 더 늘어나면 그때 이관). RUID는 둘 다 msw-search로 확보한 실제 클래식 메이플스토리
        -- 스프라이트(같은 포션 실루엣, 색만 다름 - 동일 pivot/28x28). restoreType으로 HP/MP
        -- 어느 쪽을 회복하는지 구분 - PlayerStatsComponent.RequestUsePotion이 소비.
        -- 2026-09-20 QA("물약 상점 없음") - price는 로비 물약 상인(PotionShopUIController)이 캐릭터
        -- 인게임 재화 "골드"(CharacterRosterLogic.GetGold - 몬스터 처치로 획득)로 판매할 개당 가격.
        -- 계정 영구 재화 "정수"와는 별개다.
        if potionId == "hppotion" then
            return { id = "hppotion", name = "빨간 포션", ruid = "234aca1a4ce946119b68e3717991e775", restoreType = "hp", restorePercent = 0.3, price = 10 }
        elseif potionId == "mppotion" then
            return { id = "mppotion", name = "파란 포션", ruid = "7e9b39b73f4945b1a8d77db6c99a6946", restoreType = "mp", restorePercent = 0.3, price = 10 }
        end
        return nil
    end

    method table ListPotionTemplates()
        return { self:GetPotionTemplate("hppotion"), self:GetPotionTemplate("mppotion") }
    end

    @ExecSpace("ClientOnly")
    method any FindPotionIndexByType(table characterData, string restoreType)
        -- 인벤토리에서 restoreType("hp"/"mp")과 일치하는 첫 물약 인스턴스의 인덱스를 찾는다.
        -- 키보드 단축키 경로(WindowHotkeyLogic)가 인벤토리 창을 열지 않고도 물약을 찾을 때 쓴다.
        local inv = characterData.inventory
        if inv == nil then return nil end
        for index, inst in ipairs(inv) do
            if inst.potionId ~= nil then
                local tpl = self:GetPotionTemplate(inst.potionId)
                if tpl ~= nil and tpl.restoreType == restoreType then
                    return index
                end
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method boolean UsePotionAtIndex(integer index)
        -- 물약 사용 본체 (2026-09-15 최적화 - InventoryUIController.UsePotion에서 이동, 인벤토리
        -- 클릭 경로와 키보드 단축키 경로가 동일 로직을 공유하도록 통합). 버서크 특성(전체 기획서
        -- §2-3 "회복 아이템 적용 불가")은 소모 자체를 막아 아이템 낭비를 방지 - 서버 쪽
        -- PlayerStatsComponent.RequestUsePotion도 동일 조건을 한 번 더 검사하지만(방어적
        -- 이중 체크), 클릭/단축키 시점에 바로 막아주는 게 UX상 더 낫다.
        local data = _CharacterRosterLogic:GetActiveCharacterData()
        if data == nil or data.inventory == nil or data.inventory[index] == nil then return false end
        local inst = data.inventory[index]
        if inst.potionId == nil then return false end

        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return false end
        local stats = localPlayer:GetComponent("script.PlayerStatsComponent")
        -- 2026-09-12 QA - Trait2에 버서크를 보유한 캐릭터가 이 체크를 통과해 물약이 실제로
        -- 소모(로스터 저장까지)된 뒤에야 서버가 회복만 거부하던 버그 - Trait2도 함께 검사.
        if isvalid(stats) and (stats.Trait == "버서크" or stats.Trait2 == "버서크") then
            log("EquipmentLogic: potion use blocked - 버서크 특성은 회복 아이템 적용 불가")
            return false
        end

        local potionId = inst.potionId
        inst.count = (inst.count or 1) - 1
        if inst.count <= 0 then
            table.remove(data.inventory, index)
        end
        _CharacterRosterLogic:SaveRoster()
        if isvalid(stats) then
            stats:RequestUsePotion(potionId)
        end
        _CharacterRosterLogic:RefreshUIWindowIfOpen("/ui/InventoryGroup", "script.InventoryUIController")
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean UseFirstPotionOfType(string restoreType)
        -- 키보드 단축키(KeyBindingLogic itemAction) 경로 전용 진입점 - 인벤토리 창을 열지 않고도
        -- 보유한 첫 물약을 바로 사용한다. WindowHotkeyLogic이 호출한다.
        local data = _CharacterRosterLogic:GetActiveCharacterData()
        if data == nil then return false end
        local index = self:FindPotionIndexByType(data, restoreType)
        if index == nil then return false end
        return self:UsePotionAtIndex(index)
    end

    method table ListItemTemplates()
        local out = {}
        for _, slot in ipairs(self:GetSlotList()) do
            for _, tpl in pairs(self._T.itemCatalog) do
                if tpl.slot == slot then
                    table.insert(out, tpl)
                end
            end
        end
        return out
    end

    method table ListScrollTemplates()
        local out = {}
        for _, tpl in pairs(self._T.scrollCatalog) do
            table.insert(out, tpl)
        end
        return out
    end

    method integer GetStarforceCost(integer star)
        -- 스타포스 1회 골드 비용. 현재 성(star) 기준. 구 확률표 기대값과 전장 수입(전장3 1판 약 1,090G)을 맞춘 안:
        -- 기본 25 + 2 x 현재 성 / 12성 이상 2배 / 17성 이상 3배. 15성 약 6판(전장3), 20성 약 70판(전장3) 수준.
        local base = 25 + 2 * star
        if star >= 17 then return base * 3 end
        if star >= 12 then return base * 2 end
        return base
    end

    method number GetWeaponAttackBonus(table equipment)
        -- 무기 강화(스타포스)로 얻는 추가 공격력. 스타포스 장비를 무기 슬롯에 끼웠을 때만, 강화 단계 x StarforceAttackPerStar.
        -- 공격력 계산(PlayerStatsComponent.RecalculateDerived)에서 기본 공격력에 더해지므로 특성/버프 배율이 그대로 곱해진다.
        local inst = equipment and equipment.weapon or nil
        if inst == nil then return 0 end
        local tpl = self._T.itemCatalog[inst.itemId]
        if tpl == nil or tpl.starforce ~= true then return 0 end
        return (inst.starLevel or 0) * self.StarforceAttackPerStar
    end

    @ExecSpace("ClientOnly")
    method boolean ApplyTransparentWeaponDefault(table characterData)
        -- 2026-10-06 기본 무기 제거 - 모든 캐릭터는 무기 슬롯에 투명 무기가 항상 장착돼 있다. 일반 무기(검 등)는
        -- 인벤토리와 무기 슬롯 모두에서 없어진다. 직업 스킬의 무기 모션은 투명 무기를 잠깐 바꿔 쓰는 방식이다.
        -- 바뀌었으면 true를 돌려준다(호출부가 저장 여부를 판단).
        local tw = self.DefaultWeaponId
        local changed = false
        characterData.inventory = characterData.inventory or {}
        local kept = {}
        for _, inst in ipairs(characterData.inventory) do
            local tpl = inst.itemId ~= nil and self._T.itemCatalog[inst.itemId] or nil
            -- 검(weapon_sword)은 2026-10-06 카탈로그에서 삭제됐으므로 잔존 인스턴스도 함께 지운다.
            if inst.itemId == "weapon_sword" or (tpl ~= nil and tpl.slot == "weapon" and inst.itemId ~= tw) then
                changed = true
            else
                table.insert(kept, inst)
            end
        end
        characterData.inventory = kept
        characterData.equipment = characterData.equipment or {}
        local cur = characterData.equipment.weapon
        if cur ~= nil and cur.itemId == "transparent_weapon" then
            -- 옛 투명 무기 장비는 강화 단계를 유지한 채 죽도로 옮긴다.
            cur.itemId = tw
            changed = true
        elseif cur == nil or cur.itemId ~= tw then
            characterData.equipment.weapon = { itemId = tw, upgradesUsed = 0, bonusStr = 0, bonusDex = 0, bonusInt = 0, bonusLuk = 0 }
            changed = true
        end
        return changed
    end

    @ExecSpace("ClientOnly")
    method void GrantStarterKit(table characterData)
        -- One of every catalog item (unequipped) + 2 of every scroll. This is the only item
        -- source for now - there's no shop/loot/drop-table system yet (Phase 3+ territory per
        -- the GDD), so granting the full catalog at creation is what makes the equip/scroll
        -- flow testable end-to-end without building that infrastructure early.
        -- 2026-10-06 - 무기 슬롯 템플릿(검 등)은 지급하지 않는다. 투명 무기는 생성 시 무기 슬롯에 장착된다.
        characterData.inventory = characterData.inventory or {}
        for _, tpl in ipairs(self:ListItemTemplates()) do
            if tpl.slot ~= "weapon" then
                table.insert(characterData.inventory, { itemId = tpl.id, upgradesUsed = 0, bonusStr = 0, bonusDex = 0, bonusInt = 0, bonusLuk = 0 })
            end
        end
        self:ApplyTransparentWeaponDefault(characterData)
        for _, tpl in ipairs(self:ListScrollTemplates()) do
            table.insert(characterData.inventory, { scrollId = tpl.id })
            table.insert(characterData.inventory, { scrollId = tpl.id })
        end
        -- 2026-09-15 유저 요청 - 신규 캐릭터가 물약 하나 없이 시작해서(드랍 확률 12%) 포션 시스템을
        -- 아예 못 만나보는 경우가 많다는 QA 피드백 - HP/MP 물약을 각각 20개씩 기본 지급. 인스턴스
        -- 구조는 GrantPotionDrop과 동일(1인스턴스=count 필드로 스택), potionId/count 짝만 직접 채워
        -- 넣는다 - 아직 캐릭터가 로스터에 저장되기 전(SaveRoster 이전) 시점이라 그 RPC를 타지 않고
        -- 인벤토리 배열에 바로 추가.
        for _, tpl in ipairs(self:ListPotionTemplates()) do
            table.insert(characterData.inventory, { potionId = tpl.id, count = 20 })
        end
    end

    @ExecSpace("ClientOnly")
    method integer GetEffectiveStat(table characterData, string stat)
        -- Base rolled stat (str/dex/int/luk) + every equipped item's template bonus + any bonus
        -- added to that specific item instance by successful scrolls.
        -- The roster's base INT field is named "intel" (CharacterSelectStageController.CreateCharacter),
        -- not "int" - the "int" identifier below is only the effective-stat key shared with
        -- tpl.bonusInt/inst.bonusInt, so it must be remapped for the base-value lookup specifically.
        local baseField = stat
        if stat == "int" then
            baseField = "intel"
        end
        local total = characterData[baseField] or 0
        local equipment = characterData.equipment
        if equipment == nil then
            return total
        end
        for _, inst in pairs(equipment) do
            local tpl = self._T.itemCatalog[inst.itemId]
            if tpl ~= nil then
                if stat == "str" then
                    total = total + tpl.bonusStr + (inst.bonusStr or 0)
                elseif stat == "dex" then
                    total = total + tpl.bonusDex + (inst.bonusDex or 0)
                elseif stat == "int" then
                    total = total + tpl.bonusInt + (inst.bonusInt or 0)
                elseif stat == "luk" then
                    total = total + tpl.bonusLuk + (inst.bonusLuk or 0)
                end
            end
        end
        return total
    end

    @ExecSpace("ClientOnly")
    method boolean EquipItem(table characterData, integer inventoryIndex)
        -- Moves inventory[inventoryIndex] (a gear item, identified by having .itemId) into its
        -- matching equip slot, swapping whatever was equipped there back into the inventory.
        -- Returns false (no-op) for a missing index or a scroll instance (.scrollId, not .itemId).
        local inv = characterData.inventory
        if inv == nil or inv[inventoryIndex] == nil then
            return false
        end
        local inst = inv[inventoryIndex]
        if inst.itemId == nil then
            return false
        end
        local tpl = self._T.itemCatalog[inst.itemId]
        if tpl == nil then
            return false
        end
        characterData.equipment = characterData.equipment or {}
        local previous = characterData.equipment[tpl.slot]
        table.remove(inv, inventoryIndex)
        characterData.equipment[tpl.slot] = inst
        if previous ~= nil then
            table.insert(inv, previous)
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean UnequipSlot(table characterData, string slot)
        -- Moves the item currently in `slot` back into the inventory and clears the slot.
        if characterData.equipment == nil or characterData.equipment[slot] == nil then
            return false
        end
        characterData.inventory = characterData.inventory or {}
        table.insert(characterData.inventory, characterData.equipment[slot])
        characterData.equipment[slot] = nil
        return true
    end

    @ExecSpace("ClientOnly")
    method table ApplyScroll(table characterData, integer scrollInventoryIndex, string targetSlot)
        -- Consumes inventory[scrollInventoryIndex] (must be a scroll, i.e. have .scrollId) against
        -- the item currently equipped in targetSlot. Returns { success, applied, message } for the
        -- UI to display. Matches classic MapleStory scrolling: the upgrade slot is consumed on both
        -- success AND failure, but failure never destroys the item (a deliberate MVP
        -- simplification - see Archive/As-built.md).
        -- 2026-09-12 QA(전반적 QA 3차 확장) - `applied` 필드 신규 추가. 이전에는 모든 이른 반환(주문서
        -- 없음/대상 슬롯 비어있음/강화 횟수 초과 등, 실제로 아무것도 소모되지 않는 6가지 케이스)이
        -- 실제 롤 실패(스크롤 소모 후 강화 실패)와 똑같이 `success=false`만 반환해 호출부
        -- (EquipmentUIController.OnSlotClicked)가 이 둘을 구분할 수 없었다 - 그 결과 (a) 아무것도
        -- 안 바뀐 클릭에도 매번 `changed=true`로 로스터 저장이 불필요하게 발생했고, (b) 이번 세션에
        -- 추가한 강화 성공/실패 색 플래시가 "스크롤이 소모돼 롤이 실패"한 게 아니라 "애초에 클릭이
        -- 무효"였던 경우에도 빨간 실패 플래시를 띄워 플레이어를 오도할 위험이 있었다.
        local inv = characterData.inventory
        if inv == nil or inv[scrollInventoryIndex] == nil then
            return { success = false, applied = false, message = "주문서를 찾을 수 없습니다" }
        end
        local scrollInst = inv[scrollInventoryIndex]
        if scrollInst.scrollId == nil then
            return { success = false, applied = false, message = "주문서가 아닙니다" }
        end
        local scrollTpl = self._T.scrollCatalog[scrollInst.scrollId]
        if scrollTpl == nil then
            return { success = false, applied = false, message = "알 수 없는 주문서입니다" }
        end
        if characterData.equipment == nil or characterData.equipment[targetSlot] == nil then
            return { success = false, applied = false, message = "장착된 장비가 없습니다" }
        end
        local targetInst = characterData.equipment[targetSlot]
        local targetTpl = self._T.itemCatalog[targetInst.itemId]
        if targetTpl == nil then
            return { success = false, applied = false, message = "알 수 없는 장비입니다" }
        end
        if targetInst.upgradesUsed >= targetTpl.maxUpgradeSlots then
            return { success = false, applied = false, message = "강화 횟수를 모두 사용했습니다" }
        end

        table.remove(inv, scrollInventoryIndex)
        targetInst.upgradesUsed = targetInst.upgradesUsed + 1

        local roll = _UtilLogic:RandomIntegerRange(1, 100)
        if roll <= scrollTpl.successRate then
            if scrollTpl.stat == "str" then
                targetInst.bonusStr = (targetInst.bonusStr or 0) + scrollTpl.amount
            elseif scrollTpl.stat == "dex" then
                targetInst.bonusDex = (targetInst.bonusDex or 0) + scrollTpl.amount
            elseif scrollTpl.stat == "int" then
                targetInst.bonusInt = (targetInst.bonusInt or 0) + scrollTpl.amount
            elseif scrollTpl.stat == "luk" then
                targetInst.bonusLuk = (targetInst.bonusLuk or 0) + scrollTpl.amount
            end
            return { success = true, applied = true, message = scrollTpl.name .. " 강화 성공!" }
        end
        return { success = false, applied = true, message = scrollTpl.name .. " 강화 실패..." }
    end

    @ExecSpace("ClientOnly")
    method boolean IsStarforceItemInSlot(table characterData, string slot)
        -- 해당 슬롯에 스타포스 대상 장비(투명 무기)가 장착되어 있는지 확인한다. UI가 주문서 흐름과 갈라질 때 쓴다.
        local inst = characterData.equipment and characterData.equipment[slot]
        if inst == nil then return false end
        local tpl = self._T.itemCatalog[inst.itemId]
        return tpl ~= nil and tpl.starforce == true
    end

    @ExecSpace("ClientOnly")
    method string GetStarforceIconRuid(integer star)
        -- 강화 단계(0~25성)별 검 그림 RUID. 등급이 오를수록 화려해지는 순서(0성 = 죽도). 리소스 조사(64px 썸네일 육안 기준).
        local icons = {
            "9fe4b7743e5b4be8853b44624f81f1d0", "bc5de7124e584423b6bbc33cbf3a65c1", "9edfb2ac8d4948ae9d6d789c99e0b966",
            "88e6d4f9c00b407fa2be9d6aaafab276", "41e876d1b5bf47ba93f847b5d9eb44ca", "189da705e84844f8abe5e88bdaf772b1",
            "4ae31faa0b4a4684a4d99182c4259b34", "e6b653e8ad314ed2a68e21ba85d12905", "f0ebe1ad4f6a4b4581965d7efca24eea",
            "13df07e1868a4d0db34ab0ba183e7867", "1b3c98811158440aac84cfe35b66dabc", "6d5820a166484c18a2ed34323f2ddfdb",
            "74582c03223b4a5683367f42534d30e7", "0dbd0157f2154e609b5903d2af75d56e", "31933008f2ae4429aa7a47c26ec84671",
            "01a71c72658c479db82970a5a5f201bb", "c1a81fa8bfec4109b33334490858ea27", "4d9b1be0deb2486a91b3762f4ca4824d",
            "6a3825775fc64ef38b65b234caa26ba6", "fa6420189ec5448181d77df710bcf8aa", "ba3ffb4979764a218f62aaf7e9518bbf",
            "b7884d08a2e546b9b6994248a7069b76", "7a3a869df1de456596e5c20f3a784ffc", "efcf8cc221c341ffbfa015b11041c565",
            "c81ef958b88d423fb663009283ca02e9", "b52d1bc4c7f744e98c16aa1cc5361bc1",
        }
        local idx = math.max(0, math.min(25, star)) + 1
        return icons[idx]
    end

    @ExecSpace("ClientOnly")
    method table GetStarforceRate(integer star)
        -- 현재 별에서의 성공/하락/파괴 천분율(1/100000 단위). StarforceAttempt와 같은 표를 쓴다.
        local rate = self._T.starRates[star + 1]
        if rate == nil then
            return { success = 0, drop = 0, destroy = 0 }
        end
        return { success = rate.success, drop = rate.drop, destroy = rate.destroy }
    end

    @ExecSpace("ClientOnly")
    method table StarforceAttempt(table characterData, string slot, boolean safeMode)
        -- 스타포스 1회 시도. 주문서를 쓰지 않는다. 결과 outcome: success(별+1) / fail(변화 없음) / destroy(12성 회귀).
        -- 파괴되어도 아이템은 사라지지 않고 별만 12성으로 돌아간다(전승 없음). 25성에서는 더 강화하지 않는다.
        local inst = characterData.equipment and characterData.equipment[slot]
        if inst == nil then
            return { applied = false, success = false, outcome = "none", star = 0, message = "장착된 장비가 없습니다" }
        end
        if not self:IsStarforceItemInSlot(characterData, slot) then
            return { applied = false, success = false, outcome = "none", star = 0, message = "스타포스 장비가 아닙니다" }
        end
        local star = inst.starLevel or 0
        if star >= self.StarforceMaxStar then
            return { applied = false, success = false, outcome = "none", star = star, message = "이미 " .. star .. "성입니다" }
        end
        local rate = self._T.starRates[star + 1]
        local roll = _UtilLogic:RandomIntegerRange(1, 100000)
        if roll <= rate.success then
            inst.starLevel = star + 1
            return { applied = true, success = true, outcome = "success", star = inst.starLevel, message = inst.starLevel .. "성 강화 성공!" }
        end
        -- 구 스타포스 순서: 성공 -> 파괴(12성 이상) -> 하락(별-1) -> 유지.
        if rate.destroy > 0 and roll <= rate.success + rate.destroy then
            -- 세이프 모드: 파괴 자리에서 현재 별을 유지한다. 추가 비용은 호출부에서 차감.
            if safeMode == true then
                return { applied = true, success = false, outcome = "safe", star = star, message = "세이프 모드 - 파괴 방지, " .. star .. "성 유지" }
            end
            inst.starLevel = self.StarforceSafeStar
            return { applied = true, success = false, outcome = "destroy", star = inst.starLevel, message = "파괴! " .. self.StarforceSafeStar .. "성으로 회귀합니다" }
        end
        if rate.drop > 0 and roll <= rate.success + rate.destroy + rate.drop then
            inst.starLevel = math.max(0, star - 1)
            return { applied = true, success = false, outcome = "drop", star = inst.starLevel, message = "하락! " .. inst.starLevel .. "성으로 떨어졌습니다" }
        end
        return { applied = true, success = false, outcome = "fail", star = star, message = star .. "성 유지 - 강화 실패" }
    end

    method void ApplyEquipmentToAvatar(Entity costumeEntity, table equipment)
        -- Sets every equip slot's item RUID (or "" to unequip) onto costumeEntity's
        -- CostumeManagerComponent. `equipment` may be nil (nothing equipped yet - e.g. right
        -- after character creation). No ExecSpace annotation - runs on whichever side the caller
        -- is on: ClientOnly callers apply this to a standee's AvatarBody child (display-only),
        -- ServerOnly callers (AvatarLookLogic.ApplyLookToPlayer) apply it to the real
        -- player entity's own CostumeManagerComponent, matching that method's existing pattern
        -- for body/hair/face.
        if not isvalid(costumeEntity) then
            return
        end
        local costume = costumeEntity.CostumeManagerComponent
        if not isvalid(costume) then
            return
        end
        local slotToCategory = {
            weapon = MapleAvatarItemCategory.OneHandedWeapon,
            cap = MapleAvatarItemCategory.Cap,
            coat = MapleAvatarItemCategory.Coat,
            pants = MapleAvatarItemCategory.Pants,
            shoes = MapleAvatarItemCategory.Shoes,
            glove = MapleAvatarItemCategory.Glove,
            shield = MapleAvatarItemCategory.SubWeapon,
            earaccessory = MapleAvatarItemCategory.EarAccessory,
        }
        equipment = equipment or {}
        for slot, category in pairs(slotToCategory) do
            local inst = equipment[slot]
            local ruid = ""
            if inst ~= nil then
                local tpl = self._T.itemCatalog[inst.itemId]
                if tpl ~= nil then
                    ruid = tpl.ruid
                end
            end
            costume:SetEquip(category, ruid)
        end
    end

end
