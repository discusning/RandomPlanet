@Component
script SettingsUIController extends Component
    -- Minimal settings popup stub, opened from the bottom bar's "설정" button (see AGENTS.md's
    -- latest UI-split request). No actual settings exist yet in this project - this is just the
    -- window shell so the bottom bar's 4 buttons are all wired, ready to grow real options later.
    property Entity btnClose = "6104a159-3a26-4295-8669-a7d20e3701be"
    -- Title-bar drag strip (left of the close button) + the window panel it moves - lets the
    -- player reposition the window by mouse-down-dragging the title, matching classic MapleStory
    -- window behavior (see AGENTS.md's window-drag request).
    property Entity dragHandle = "1e8644e5-2095-455a-a040-956fcec66d4b"
    property UITransformComponent cardTransform = "8bf82fcd-7253-4829-ab55-99b486ebbd41"
    property Entity btnKeySetting = "61c0f86f-7ed6-47b2-ae3c-19cfe24d949f"
    -- 시스템 설정(음량) 창 열기 버튼 - UIBuilder bind로 UUID 주입.
    property Entity btnSystem = "3f2ebe3b-973f-4515-b9eb-d1c35715974b"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.handlers = {}
        local h = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        table.insert(self._T.handlers, { entity = self.btnClose, eventType = ButtonClickEvent, eventHandler = h })
        if isvalid(self.dragHandle) then
            local hDrag = self.dragHandle:ConnectEvent(UITouchDragEvent, self.OnDrag)
            table.insert(self._T.handlers, { entity = self.dragHandle, eventType = UITouchDragEvent, eventHandler = hDrag })
        end
        if isvalid(self.btnKeySetting) then
            local hKeySetting = self.btnKeySetting:ConnectEvent(ButtonClickEvent, self.OnKeySettingClicked)
            table.insert(self._T.handlers, { entity = self.btnKeySetting, eventType = ButtonClickEvent, eventHandler = hKeySetting })
        end
        if isvalid(self.btnSystem) then
            local hSystem = self.btnSystem:ConnectEvent(ButtonClickEvent, self.OnSystemClicked)
            table.insert(self._T.handlers, { entity = self.btnSystem, eventType = ButtonClickEvent, eventHandler = hSystem })
        end
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnDrag(UITouchDragEvent event)
        -- 2026-09-15 코드 최적화 - 위임, 본체는 UI/WindowHotkeyLogic.ApplyDragDelta.
        _WindowHotkeyLogic:ApplyDragDelta(self.cardTransform, event)
    end

    @ExecSpace("ClientOnly")
    method void Show()
        self.Entity.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        if self.Entity.Enable then
            self:Hide()
        else
            self:Show()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnSystemClicked()
        -- 시스템 설정(배경/플레이어 음량) 창을 연다. SystemUIController는 /ui/SystemGroup 루트에 붙어 있다.
        log("SettingsUI: OnSystemClicked")
        self:Hide()
        local systemGroup = _EntityService:GetEntityByPath("/ui/SystemGroup")
        if not isvalid(systemGroup) then
            log_warning("SettingsUI: SystemGroup not found")
            return
        end
        local popup = systemGroup:GetComponent("script.SystemUIController")
        if isvalid(popup) then
            popup:Show()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnKeySettingClicked()
        -- KeyBindingPopupController lives on /ui/KeySettingGroup's root (see
        -- RootDesk/MyDesk/KeySetting/KeyBindingPopupController.mlua) - previously only reachable
        -- via the undiscoverable P-key shortcut. This is the in-game entry point.
        -- 2026-09-20 QA("설정 키설정 x") - 스크립트/P키로는 열리는데 실제 클릭에서만 안 열린다는
        -- 제보라 클릭 이벤트 도달 여부를 로그로 남긴다(재현되면 이 로그가 없으면 클릭 자체가 이
        -- 버튼에 안 닿는 것, 있으면 아래 Open 경로 문제).
        log("SettingsUI: OnKeySettingClicked")
        self:Hide()
        local keySettingGroup = _EntityService:GetEntityByPath("/ui/KeySettingGroup")
        if not isvalid(keySettingGroup) then
            log_warning("SettingsUI: KeySettingGroup not found")
            return
        end
        local popup = keySettingGroup:GetComponent("script.KeyBindingPopupController")
        if isvalid(popup) then
            popup:Open()
        end
    end
end
