@Logic
script BattlefieldReturnLogic extends Logic

    -- 2026-09-15 버그 수정(유저 리포트 "마을 복귀 안 됨") - 실측(maker_execute_script/keyboard_input로
    -- 여러 차례 재현): 주변 몬스터를 스크립트로 전부 정리한 직후에는 채널이 정상적으로 완료되어
    -- Lobby로 귀환됨을 확인(코드 경로 자체는 정상 동작) - 하지만 실제 전투 중(몬스터 2~4마리가
    -- 붙어있는 상태)에는 채널이 시작되자마자(같은 초 안에) 거의 매번 "피격"으로 즉시 취소됐다.
    -- 근본 원인: FieldMonsterAI.ChaseDetectionRange=999(2026-08-19 유저 요청으로 무제한 추격이라
    -- 플레이어가 거리를 벌려도 몬스터가 계속 같은 속도로 따라붙음, 실측으로 확인) + MonsterAttack.
    -- AttackInterval=1.5초 몬스터가 여러 마리 서로 다른 위상으로 공격하면서 "합쳐진 피격 빈도"가
    -- PlayerHit.IFrameSeconds(0.7초) 바닥에 가깝게 수렴 - 채널 시간을 3.0→1.2초로 줄여도 여전히
    -- 거의 매번 즉시 취소됨을 재실측으로 확인(몬스터 3~4마리 상시 접촉 상황에서는 1.2초 연속
    -- 무피격 구간도 사실상 안 나옴). 단순히 채널 시간을 더 줄이는 접근은 한계가 있다고 판단해 -
    -- 피격 시 "즉시 전체 취소"가 아니라 "완료까지 남은 시간에 페널티를 더하는" 방식으로 변경
    -- (아래 InterruptChannel). "피격 시 위험 신호"라는 설계 의도(패닉성 즉시 탈출 방지)는
    -- 그대로 유지하면서도, 실제 시간이 페널티보다 빠르게 흐르는 한(HitPenaltySeconds < 몬스터군의
    -- 평균 피격 간격) 통계적으로 언젠가 완료 가능해진다 - 완전히 안전해야만 하는 3초 연속 구간을
    -- 요구하던 기존 방식과 달리, "대체로 안전한" 시도를 누적해서 성공할 수 있다.
    property number ChannelSeconds = 2.0
    -- 피격 1회당 남은 시간에 더해지는 페널티. 1차로 1.0초를 넣고 실측했더니 몬스터 3~4마리가
    -- 상시 접촉한 채로는 "합쳐진" 피격 빈도가 PlayerHit.IFrameSeconds(0.7초) 바닥에 거의 그대로
    -- 수렴해(초당 약 1회) 페널티(+1.0/hit)와 실제 시간 흐름(-1.0/s)이 거의 상쇄돼 제자리걸음하는
    -- 것을 확인(ChannelRemaining이 줄지 않고 오히려 소폭 상승) - 최악의 경우(상시 접촉)에도 실제
    -- 시간이 페널티보다 확실히 더 빨리 흐르도록 0.4로 낮춤(순 감소량 약 -0.6/s로 재실측 확인,
    -- 완료까지 도달).
    property number HitPenaltySeconds = 0.4
    property Entity hudGroup = "43095031-9b38-47a9-959b-80a2d79f7c1e"
    property TextGUIRendererComponent hudText = "c1b57bb2-304f-40d6-a3a0-20013efbcfab"

    @HideFromInspector property any keyHandler = nil
    @HideFromInspector property any tickTimerId = nil
    -- 토벌전장은 원하면 언제든 나갈 수 있어야 한다는 유저 요청(2026-08-18)에 따른 기능 - 사망시
    -- 캐릭터 삭제라는 이 게임의 핵심 특징 때문에, 카오스게이트(추후 구현 예정, 자율 이탈 불가로
    -- 설계 중)와 대비되는 "안전하게 빠질 수 있는 콘텐츠"로 토벌전장을 구분짓는다. 순간이동이
    -- 아니라 짧은 채널링(귀환 스크롤 방식)으로 만든 이유: 전투 중 위험할 때 패닉성 즉시 탈출로
    -- 웨이브 압박감이 무의미해지는 것을 막기 위함 - 채널 중 피격 시 자동 취소(PlayerHit.mlua
    -- HandleHitEvent 참고)되므로, 실제로 안전한 순간에만 귀환이 완료된다.
    @Sync @HideFromInspector property boolean IsChanneling = false
    @Sync @HideFromInspector property number ChannelRemaining = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.hudGroup.Enable = false
        self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
        self.tickTimerId = _TimerService:SetTimerRepeat(self.ClientTick, 1 / 10)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.keyHandler then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
        end
        if self.tickTimerId then
            _TimerService:ClearTimer(self.tickTimerId)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- Same gameplay-active gate as WindowHotkeyLogic (blocks the hotkey while parked on
        -- choice_map). Toggling requires currently standing in one of the 3 battlefield maps -
        -- pressing the key anywhere else (Lobby, choice_map) does nothing.
        if not _CharacterRosterLogic:IsGameplayActive() then
            return
        end
        if event.key ~= _KeyBindingLogic:GetKeyForAction("ReturnToLobby") then
            return
        end
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            return
        end
        if not self:IsBattlefieldMap(localPlayer.CurrentMapName) then
            return
        end
        self:RequestToggleReturn()
    end

    method boolean IsBattlefieldMap(string mapName)
        return mapName == "토벌전장1" or mapName == "토벌전장2" or mapName == "토벌전장3"
    end

    @ExecSpace("ClientOnly")
    method void ClientTick()
        -- Polls the @Sync channel state at 10Hz - same cadence as PlayerHUDController's Tick, cheap
        -- local reads only.
        self.hudGroup.Enable = self.IsChanneling
        if self.IsChanneling then
            self.hudText.Text = "귀환 중... " .. string.format("%.1f", math.max(0, self.ChannelRemaining)) .. "초  (피격 시 지연)"
        end
    end

    @ExecSpace("Server")
    method void RequestToggleReturn()
        -- Client->server toggle: press once to start channeling, press again to cancel
        -- voluntarily. Re-validates the map server-side (never trust the client's own check).
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then
            return
        end
        if self._T.channeling == true then
            self:CancelChannel("플레이어 취소")
            return
        end
        if not self:IsBattlefieldMap(player.CurrentMapName) then
            return
        end
        self._T.channeling = true
        self._T.channelPlayer = player
        self.IsChanneling = true
        self.ChannelRemaining = self.ChannelSeconds
        log("BattlefieldReturn: channel started")
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- Session-relative countdown (see msw-scripting §13's per-session-timer trap) - never
        -- anchored on raw ElapsedSeconds.
        if self._T.channeling ~= true then
            return
        end
        -- 2026-09-22 타임 스톱 - 이능/스킬 선택 중엔 귀환 채널 카운트다운도 멈춘다(팝업이 떠 있는 채로
        -- 로비로 귀환되는 일이 없도록).
        if _TimeStopLogic.Stopped then
            return
        end
        -- 2026-09-25 QA - 채널 중 사망(RunEnded)하거나 플레이어가 사라졌으면/전장을 벗어났으면 채널을
        -- 취소한다(안 그러면 죽은 캐릭터가 그대로 로비로 텔레포트돼 Ending UI가 로비에서 뜬다).
        local channelPlayer = self._T.channelPlayer
        if not isvalid(channelPlayer) or not self:IsBattlefieldMap(channelPlayer.CurrentMapName) then
            self:CancelChannel("플레이어 이탈")
            return
        end
        local statsComp = channelPlayer:GetComponent("script.PlayerStatsComponent")
        if isvalid(statsComp) and statsComp.RunEnded then
            self:CancelChannel("사망")
            return
        end
        self.ChannelRemaining = self.ChannelRemaining - delta
        if self.ChannelRemaining <= 0 then
            self:CompleteReturn()
        end
    end

    @ExecSpace("ServerOnly")
    method void CompleteReturn()
        -- Lands the player back at the same portal-1 spot the battlefield-select popup is opened
        -- from (Lobby's 1F 3-story portal stack), mirroring RequestEnterBattlefield's teleport
        -- pattern in the reverse direction.
        local player = self._T.channelPlayer
        self._T.channeling = false
        self.IsChanneling = false
        if isvalid(player) then
            -- 2026-09-25 로비 재개편(루디브리엄) - 1층 포탈(portal-1, 도로 x=7.9, y=-0.97) 바로 앞.
            _TeleportService:TeleportToMapPosition(player, Vector3(7.9, -0.62, 0), "Lobby")
            log("BattlefieldReturn: returned to Lobby")
        end
    end

    @ExecSpace("ServerOnly")
    method void CancelChannel(string reason)
        -- Full stop - only for the player's own voluntary re-press (RequestToggleReturn). The
        -- on-hit interrupt uses InterruptChannel below instead (see the ChannelSeconds comment for
        -- why a full cancel-on-any-hit made the feature practically unusable).
        if self._T.channeling ~= true then
            return
        end
        self._T.channeling = false
        self.IsChanneling = false
        log("BattlefieldReturn: cancelled (" .. reason .. ")")
    end

    @ExecSpace("ServerOnly")
    method void InterruptChannel(string reason)
        -- Called from Combat/PlayerHit.mlua's HandleHitEvent on every hit that lands during a
        -- channel. Pushes the completion time back instead of aborting outright - see the
        -- ChannelSeconds comment above for the measured reasoning (a hard cancel-on-any-hit meant
        -- the channel almost never survived to completion once 2+ monsters were in contact range).
        if self._T.channeling ~= true then
            return
        end
        self.ChannelRemaining = self.ChannelRemaining + self.HitPenaltySeconds
        log("BattlefieldReturn: delayed (" .. reason .. "), remaining=" .. string.format("%.1f", self.ChannelRemaining))
    end

end
