@Logic
script BattlefieldProgressHUDController extends Logic

    property Entity hudGroup = "e0dca177-a207-4c49-a46f-641160dc90a5"
    property TextGUIRendererComponent waveBadge = "3de6307c-3fbf-49aa-838b-eed52d920f84"
    property UITransformComponent fillTransform = "45374010-365f-45f6-90b9-383c6ac210f9"
    property TextGUIRendererComponent countText = "adef6757-d807-486e-8c7a-b48334a72d45"
    -- 2026-08-19 유저 요청 - "전체 진행도"(고정 5웨이브 중 몇 웨이브째)와 기존 "웨이브 진행도"(이번
    -- 웨이브 처치수/목표) 2종 게이지를 함께 표시. 바인딩 UUID는 UIBuilder write(bind=...)로 주입.
    property TextGUIRendererComponent overallBadge = "649489dc-32fc-4a81-8031-f8d8c859e202"
    property UITransformComponent overallFillTransform = "47881c69-9ba6-418e-b628-487820f76d31"
    property number fullWidth = 360
    property any timerId = nil

    -- 미니보스 HP바 (Phase 4, 2026-08-24) - 마지막 웨이브 클리어 후 FieldWaveSpawner.MiniBossActive가
    -- 켜지는 동안에만 노출. 웨이브 진행도 게이지와 동일한 폴링(Tick) 패턴 재사용.
    property Entity bossName = "3b07de42-7dad-4ff2-a8bc-86b4b2c2637a"
    property Entity bossTrack = "9501d974-8fe7-40c6-adfd-32735611017b"
    property UITransformComponent bossFillTransform = "b1cd0405-c923-40de-a3cd-3f5ba5b8d36d"
    property TextGUIRendererComponent bossHpText = "06195ba6-9ee0-4f63-9463-c54670b19536"
    property number bossFullWidth = 420
    -- RoR2 텔레포터 이벤트 참고(2026-08-24, 시장 비교 검토) - 미니보스 스폰 순간 카메라 셰이크 +
    -- 짧은 배너로 임팩트를 준다. Tick의 4Hz 폴링에서 FieldWaveSpawner.MiniBossSpawnSerial이 마지막
    -- 관측값과 달라진 순간을 "방금 스폰됨" 엣지로 감지(별도 이벤트/RPC 불필요).
    property Entity bossBanner = "f972453d-e182-4d54-a91e-40ff76215300"
    @HideFromInspector property integer lastBossSerial = -1

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Hidden by default; Tick shows it only while the local player is actually standing in one
        -- of the 3 battlefield maps (mirrors PlayerHUDController's polling pattern, but this Logic
        -- also owns its own visibility instead of being toggled externally, since "which map am I
        -- on" is the only real trigger and no other script needs to know about it).
        self.hudGroup.Enable = false
        self.timerId = _TimerService:SetTimerRepeat(self.Tick, 1 / 4)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.timerId then
            _TimerService:ClearTimer(self.timerId)
        end
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        -- 카오스 던전의 "작전 진행도" 게이지 참고 - 처치수/목표치 비율을 채워서 보여준다. 4Hz면
        -- 몬스터 처치 직후 반영까지 최대 0.25초 지연 - 체감상 즉시로 느껴지는 수준.
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            self.hudGroup.Enable = false
            return
        end
        local mapName = localPlayer.CurrentMapName
        if mapName ~= "토벌전장1" and mapName ~= "토벌전장2" and mapName ~= "토벌전장3" then
            self.hudGroup.Enable = false
            return
        end
        local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
        if not isvalid(mapEntity) then
            self.hudGroup.Enable = false
            return
        end
        local spawner = mapEntity:GetComponent("script.FieldWaveSpawner")
        if not isvalid(spawner) then
            self.hudGroup.Enable = false
            return
        end
        self.hudGroup.Enable = true
        self.waveBadge.Text = "웨이브 " .. tostring(spawner.WaveNumber)
        local ratio = 0
        if spawner.WaveKillTarget > 0 then
            ratio = math.max(0, math.min(1, spawner.WaveKillCount / spawner.WaveKillTarget))
        end
        local size = self.fillTransform.RectSize
        self.fillTransform.RectSize = Vector2(self.fullWidth * ratio, size.y)
        self.countText.Text = tostring(spawner.WaveKillCount) .. " / " .. tostring(spawner.WaveKillTarget)

        -- 전체 진행도(고정 5웨이브 중 완료한 웨이브 수) - 클리어 상태면 꽉 채우고 배지 문구를 바꾼다.
        local maxWave = spawner.MaxWaveNumber
        local completedWaves = spawner.WaveNumber - 1
        if spawner.FieldCleared then
            completedWaves = maxWave
        end
        local overallRatio = 0
        if maxWave > 0 then
            overallRatio = math.max(0, math.min(1, completedWaves / maxWave))
        end
        local overallSize = self.overallFillTransform.RectSize
        self.overallFillTransform.RectSize = Vector2(self.fullWidth * overallRatio, overallSize.y)
        if spawner.FieldCleared then
            self.overallBadge.Text = "토벌 완료!"
        else
            self.overallBadge.Text = "전체 진행도 " .. tostring(spawner.WaveNumber) .. " / " .. tostring(maxWave)
        end

        -- 미니보스 HP바 - MiniBossActive일 때만 노출(마지막 웨이브 클리어 후 등장, 처치하면 사라짐).
        local bossOn = spawner.MiniBossActive
        if isvalid(self.bossName) then self.bossName.Enable = bossOn end
        if isvalid(self.bossTrack) then self.bossTrack.Enable = bossOn end
        if bossOn then
            local bossRatio = 0
            local maxHp = spawner.MiniBossMaxHp
            if maxHp > 0 then
                bossRatio = math.max(0, math.min(1, spawner.MiniBossHp / maxHp))
            end
            local bossSize = self.bossFillTransform.RectSize
            self.bossFillTransform.RectSize = Vector2(self.bossFullWidth * bossRatio, bossSize.y)
            self.bossHpText.Text = tostring(math.floor(spawner.MiniBossHp)) .. " / " .. tostring(math.floor(maxHp))
        end

        -- 보스 등장 연출 - 시리얼이 마지막으로 본 값과 달라진 첫 틱에만 1회 발동(스폰 순간의
        -- 카메라 셰이크 + 배너, RoR2 텔레포터 이벤트 참고). lastBossSerial=-1(최초 진입)일 때는
        -- 발동시키지 않는다 - 이미 스폰돼 있던 보스와 함께 입장한 경우(재접속 등) 매번 셰이크가
        -- 뜨는 것을 방지.
        local serial = spawner.MiniBossSpawnSerial
        if self.lastBossSerial >= 0 and serial > self.lastBossSerial then
            self:PlayBossEntranceFx()
        end
        self.lastBossSerial = serial
    end

    @ExecSpace("ClientOnly")
    method void PlayBossEntranceFx()
        log("BattlefieldProgressHUD: PlayBossEntranceFx triggered (serial=" .. self.lastBossSerial .. ")")
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then
            cam:ShakeCamera(1.2, 0.5)
        end
        if isvalid(self.bossBanner) then
            self.bossBanner.Enable = true
            _TimerService:SetTimerOnce(function()
                if isvalid(self.bossBanner) then
                    self.bossBanner.Enable = false
                end
            end, 2.0)
        end
    end

end
