@Logic
script EndingUIController extends Logic

    property Entity endingGroup = "eb162279-3a65-4139-bc2d-cb96332cb0e1"
    property TextGUIRendererComponent levelText = "fb307c66-ea47-4b10-898e-8add534b27e5"
    property TextGUIRendererComponent killText = "575c07cd-f82c-4e5b-ab4d-5726688bec25"
    property TextGUIRendererComponent survivalText = "6fcb7650-1dd2-4a83-9621-cc9e37957686"
    property Entity restartButton = "8f06f937-452d-4e1b-b3c9-c81a6594a5e8"
    -- M2 Phase H(2026-09-08) - 명예의 전당 진입점(전체 기획서 §9). ENDING 화면에서만 열 수 있다.
    property Entity hallOfFameButton = "a6745fcd-7773-4e26-8547-1008744e640d"
    @HideFromInspector property any hallOfFameHandler = nil
    -- 시장 비교 검토(2026-08-25, Dead Cells/RoR2 런 종료 리포트 + Rogue Legacy/Vampire Survivors
    -- 개인 최고 기록 참고) - 도달 웨이브·클리어 여부 + 계정 내 최고 기록 표시. 바인딩은
    -- msw_ui_builder write(bind=...)로 주입.
    property TextGUIRendererComponent waveText = "5632ce2d-4988-4864-a874-29fbd202b53d"
    property TextGUIRendererComponent bestRecordText = "5095f09d-c013-4a78-bac3-d66cbd608f81"
    property Entity newRecordBadge = "17c537ba-394c-45ad-8c68-5fae8b0a6354"

    @HideFromInspector property any restartHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        if isvalid(self.endingGroup) then
            self.endingGroup.Enable = false
        end
        if isvalid(self.restartButton) then
            self.restartHandler = self.restartButton:ConnectEvent(ButtonClickEvent, self.OnRestartClicked)
        end
        if isvalid(self.hallOfFameButton) then
            self.hallOfFameHandler = self.hallOfFameButton:ConnectEvent(ButtonClickEvent, self.OnHallOfFameClicked)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.restartHandler and isvalid(self.restartButton) then
            self.restartButton:DisconnectEvent(ButtonClickEvent, self.restartHandler)
        end
        if self.hallOfFameHandler and isvalid(self.hallOfFameButton) then
            self.hallOfFameButton:DisconnectEvent(ButtonClickEvent, self.hallOfFameHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnHallOfFameClicked()
        -- 2026-09-10 QA - LeaderboardGroup의 GroupOrder(6)가 EndingGroup(13)보다 낮아 명예의 전당을
        -- 열어도 ENDING 팝업 뒤에 가려 보이지 않던 버그 발견. GroupOrder를 leaderboard 쪽에서 더
        -- 높게 올려도(18) 라이브 렌더링에는 반영되지 않아(활성화 시점 기준 동적 정렬로 추정, 정적
        -- GroupOrder 값만으론 불충분) 대신 명시적으로 ENDING을 잠시 숨기는 방식으로 확실히 해결 -
        -- LeaderboardUIController.OnCloseClicked에서 다시 보여준다.
        if isvalid(self.endingGroup) then
            self.endingGroup.Enable = false
        end
        _LeaderboardUIController:Show()
    end

    @ExecSpace("ClientOnly")
    method void ShowEnding(integer level, integer killCount, number survivalSeconds, integer waveReached, boolean fieldCleared)
        -- Called from PlayerStatsComponent.OnSyncProperty when the local player's RunEnded flips to
        -- true (Phase 4 permadeath). Freezes the on-screen stats - the underlying PlayerStatsComponent
        -- fields keep existing after this, so we snapshot into text here rather than re-reading live.
        if isvalid(self.levelText) then
            -- 2026-09-12 QA(전반적 텍스트 일관성 스캔) - 이 화면만 "Lv. " (점 뒤 공백)을 써서 나머지
            -- 3곳(CharacterCardController/CharacterInfoUIController/PlayerHUDController)이 전부 쓰는
            -- "Lv."(공백 없음)과 형식이 달랐다 - 순수 표기 통일, 로직 변경 없음.
            self.levelText.Text = "Lv." .. level
        end
        if isvalid(self.killText) then
            self.killText.Text = "처치 " .. killCount .. "마리"
        end
        if isvalid(self.survivalText) then
            local totalSeconds = math.floor(math.max(0, survivalSeconds))
            local minutes = math.floor(totalSeconds / 60)
            local seconds = totalSeconds % 60
            self.survivalText.Text = "생존 " .. string.format("%02d:%02d", minutes, seconds)
        end
        if isvalid(self.waveText) then
            if fieldCleared then
                self.waveText.Text = "토벌 완료! (전 웨이브 클리어)"
            elseif waveReached > 0 then
                self.waveText.Text = "도달 웨이브 " .. waveReached
            else
                self.waveText.Text = ""
            end
        end
        if isvalid(self.newRecordBadge) then
            self.newRecordBadge.Enable = false
        end
        if isvalid(self.bestRecordText) then
            self.bestRecordText.Text = "최고 기록 불러오는 중..."
        end
        if isvalid(self.endingGroup) then
            self.endingGroup.Enable = true
        end
        log("EndingUI: ShowEnding level=" .. level .. " kills=" .. killCount .. " survivalSeconds=" .. string.format("%.1f", survivalSeconds) .. " waveReached=" .. waveReached .. " fieldCleared=" .. tostring(fieldCleared))
    end

    @ExecSpace("ClientOnly")
    method void ShowBestRecord(boolean isNewLevel, boolean isNewKillCount, boolean isNewSurvival, integer bestLevel, integer bestKillCount, number bestSurvivalSeconds)
        -- BestRecordLogic.OnBestResult가 호출(서버 왕복 후 - ShowEnding보다 약간 늦게 도착하는 게
        -- 정상, 팝업이 이미 뜬 상태에서 이 줄만 채워 넣는다).
        if isvalid(self.bestRecordText) then
            local totalSeconds = math.floor(math.max(0, bestSurvivalSeconds))
            local minutes = math.floor(totalSeconds / 60)
            local seconds = totalSeconds % 60
            self.bestRecordText.Text = "최고 기록 - Lv." .. bestLevel .. " / 처치 " .. bestKillCount .. "마리 / 생존 " .. string.format("%02d:%02d", minutes, seconds)
        end
        if isvalid(self.newRecordBadge) then
            self.newRecordBadge.Enable = isNewLevel or isNewKillCount or isNewSurvival
        end
        log("EndingUI: ShowBestRecord newLevel=" .. tostring(isNewLevel) .. " newKillCount=" .. tostring(isNewKillCount) .. " newSurvival=" .. tostring(isNewSurvival) .. " bestLevel=" .. bestLevel .. " bestKillCount=" .. bestKillCount)
    end

    @ExecSpace("ClientOnly")
    method void OnRestartClicked()
        -- Permanent deletion happens here (not at the moment of death) - the character roster is
        -- entirely ClientOnly (CharacterRosterLogic), so this is the natural place to mutate it: a
        -- client-initiated click, no server->specific-client targeting needed. See
        -- Docs/RandomPlanet-M1-Phase4.md "핵심 설계 결정" for why.
        local idx = _CharacterRosterLogic:GetActiveIndex()
        if idx ~= nil then
            _CharacterRosterLogic:DeleteSlot(idx)
        end
        if isvalid(self.endingGroup) then
            self.endingGroup.Enable = false
        end
        _CharacterRosterLogic:HideLocalPlayer()
        _CharacterRosterLogic:RequestReturnToSelect()
        log("EndingUI: OnRestartClicked idx=" .. tostring(idx))
    end

end
