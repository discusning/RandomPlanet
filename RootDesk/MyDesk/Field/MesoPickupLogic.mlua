@Logic
script MesoPickupLogic extends Logic
    -- 메소 줍기 (2026-09-21 유저 요청 "줍기 키를 사용하면 먹어지게") - BattlefieldReturnLogic과
    -- 동일한 패턴(ClientOnly KeyDownEvent 리스너 -> Server RPC). 몬스터 처치로 필드에 떨어진
    -- MesoDropItem 중 플레이어 근처 것만 회수해 CharacterRosterLogic 골드에 적립한다.
    property number PickupRadius = 1.3

    @HideFromInspector property any keyHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.keyHandler then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- BattlefieldReturnLogic.OnKeyDown과 동일한 게이트 - choice_map(캐릭터 선택)처럼 실제
        -- 아바타가 숨겨진 화면에서는 아무 반응도 하지 않는다.
        if not _CharacterRosterLogic:IsGameplayActive() then
            return
        end
        if event.key ~= _KeyBindingLogic:GetKeyForAction("PickupMeso") then
            return
        end
        self:RequestPickup()
    end

    @ExecSpace("Server")
    method void RequestPickup()
        -- 2026-09-21 - 이 스캔은 "매 프레임 자동 충돌 판정"이 아니라 플레이어가 줍기 키를 누른
        -- 그 순간에만 1회 도는 명시적 상호작용이라(msw-combat-system §1-7이 경고하는 반복적
        -- per-frame 거리 계산 안티패턴과는 다름), 현재 맵의 엔티티 목록(보통 수십 개 이하)을
        -- 순회하는 것으로 충분하다 - FieldWaveSpawner/TryDropPotion 등 이 프로젝트의 기존
        -- map.Children 순회 패턴과 동일.
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        local playerPos = player.TransformComponent.WorldPosition
        local radiusSq = self.PickupRadius * self.PickupRadius
        local totalAmount = 0
        local collectedCount = 0
        for _, entity in pairs(map.Children) do
            local item = entity:GetComponent("script.MesoDropItem")
            if isvalid(item) then
                local pos = entity.TransformComponent.WorldPosition
                local dx = pos.x - playerPos.x
                local dy = pos.y - playerPos.y
                if (dx * dx + dy * dy) <= radiusSq then
                    totalAmount = totalAmount + item.Amount
                    collectedCount = collectedCount + 1
                    _EntityService:Destroy(entity)
                end
            end
        end
        if totalAmount > 0 then
            _CharacterRosterLogic:GrantGold(totalAmount, player.PlayerComponent.UserId)
            log("MesoPickup: collected " .. collectedCount .. " drop(s), gold+" .. totalAmount)
        end
    end

end
