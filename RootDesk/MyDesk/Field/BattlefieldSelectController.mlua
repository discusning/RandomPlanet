@Component
script BattlefieldSelectController extends Component
    property Entity btnClose = "8af166e4-08e8-4c31-be8e-c21de84faaaf"
    property Entity btnField1 = "a4bd9939-1ff7-48d9-ab61-66f68476763c"
    property Entity btnField2 = "6957d183-c4b4-4468-b3ee-3019ea3cc260"
    property Entity btnField3 = "a23c98d1-5990-4ff1-9e70-105015d5c551"
    property UITransformComponent gaugeFillTransform = "81b24646-f2fb-4ee9-acb9-6b96043dd102"
    property TextGUIRendererComponent gaugeText = "ec041098-e571-4032-8d0e-b9ecf56b0da2"
    property number gaugeFullWidth = 380
    property TextGUIRendererComponent myPowerText = "48a9e2ad-aab5-44e6-9dd2-432e52a586d5"
    property TextGUIRendererComponent recommend1 = "9a1a10fb-757a-4f5c-9781-e5196fa46ad7"
    property TextGUIRendererComponent recommend2 = "8c6beb07-e778-46bf-8239-dbc6f6eb92fa"
    property TextGUIRendererComponent recommend3 = "0037477b-c944-46ba-b5ac-d5ddc0a1dbd9"
    property number recommendedCp1 = 150
    property number recommendedCp2 = 400
    property number recommendedCp3 = 800
    -- M2 Phase E(2026-09-06) - 몬스터 게이트 입장. 전체 기획서 §5-2 "입장권 소모로 입장".
    property any tickTimerId = nil
    -- 2026-09-30 유저 요청 - "몬스터게이트 UI 형식도 토벌 던전과 비슷하게" - 난이도(하급~최상급)를
    -- 더 이상 "토글 4개 + 별도 입장 버튼" 2단계로 고르지 않고, 토벌전장 Field1~3과 완전히 같은
    -- 형식(뱃지+이름+권장전투력 행)의 행 4개로 바꿔 행을 누르면 그 난이도로 즉시 입장한다.
    -- 옛 tierBtn1~4/selectedTier/btnGate/gateTicketText(=Field4 재사용)는 전부 제거되고
    -- gateTier1~4Btn + gateRecommend1~4 + gateTicketLabel(전용 신규 엔티티)로 대체됨.
    property Entity gateTier1Btn = "c239ec9c-f2d4-4f57-a087-42c189c8e586"
    property Entity gateTier2Btn = "88ef5415-e0cf-4f38-8fd8-6b906c49ed1e"
    property Entity gateTier3Btn = "1ab94a7a-228d-4f81-8486-e7848691d9fe"
    property Entity gateTier4Btn = "5d8a93af-562d-4589-b5c9-1794c94c785a"
    property TextGUIRendererComponent gateRecommend1 = "2b65656b-abd6-498b-b8c1-79c29ea9d4c2"
    property TextGUIRendererComponent gateRecommend2 = "b27cde92-3d3a-449e-94eb-52adcffc696c"
    property TextGUIRendererComponent gateRecommend3 = "55450f99-d7fe-4919-b934-40012ba38234"
    property TextGUIRendererComponent gateRecommend4 = "b7827053-6c66-4c6b-9e41-438dfbcbd6c5"
    property TextGUIRendererComponent gateTicketLabel = "cefcd878-cbb4-4a8a-8572-da59b76a1bbb"
    -- 2026-09-24 유저 요청 - 게이트 난이도(하급~최상급)마다 토벌전장처럼 권장 전투력 표시. 게이트는
    -- 토벌전장3(권장 800)을 게이트 배율(FieldWaveSpawner: 3.0 x 1/1.5/2.25/3.4)로 강화한 것이라
    -- 권장치도 800 x 배율(2400/3600/5400/8160). 배율을 바꾸면 이 값도 같이 조정할 것.
    property number gateRecommendedCp1 = 2400
    property number gateRecommendedCp2 = 3600
    property number gateRecommendedCp3 = 5400
    property number gateRecommendedCp4 = 8160
    -- 2026-09-24 유저 요청 - 로비 우측 포탈 3개(1층 토벌전장/2층 카오스게이트/3층 보스포탈)가 실제로는
    -- 전부 1층 포탈에서만 열리는 이 팝업 하나에 뭉쳐 있었다(토벌전장1~3 + 게이트가 같은 카드 안,
    -- 게이트가 맨 아래쪽이라 헷갈린다는 QA 피드백과 동일 원인). LobbyStageController가 층별로
    -- Show(mode)를 다르게 호출해 같은 팝업을 세 가지 단일 목적 화면처럼 보이게 한다 - 배경/버튼
    -- 좌표는 그대로 재사용하고 관련 없는 구획만 숨긴다("battlefield"|"gate"|"boss").
    @HideFromInspector property string mode = "battlefield"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Hidden by default (same root-Enable toggle pattern as SquadFormationController/
        -- KeyBindingPopupController - this script sits on the popup's own group root, so
        -- self.Entity.Enable gates the whole card). All 3 battlefields now have real maps
        -- (토벌전장1~3), so all 3 rows are wired the same way.
        self._T.handlers = {}
        -- 유저 요청(2026-08-18): "내 전투력"/권장치 비교가 팝업을 열 때 한 번만이 아니라 계속
        -- 실시간으로 갱신되게 해달라 - 레벨업/장비 교체/특성 변경 등으로 전투력이 바뀌면 팝업이
        -- 열려있는 동안 바로 반영되어야 함. PlayerHUDController의 10Hz 폴링과 같은 패턴이지만,
        -- 이 팝업은 대부분 시간 닫혀있으므로 Tick 내부에서 Enable 체크로 닫혀있을 때는 즉시
        -- 리턴해 불필요한 연산을 건너뛴다(HUD처럼 상시 화면에 떠있는 것과는 다른 케이스).
        self.tickTimerId = _TimerService:SetTimerRepeat(self.Tick, 1 / 5)
        local hClose = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        table.insert(self._T.handlers, { entity = self.btnClose, eventHandler = hClose })
        local hField1 = self.btnField1:ConnectEvent(ButtonClickEvent, self.OnField1Clicked)
        table.insert(self._T.handlers, { entity = self.btnField1, eventHandler = hField1 })
        local hField2 = self.btnField2:ConnectEvent(ButtonClickEvent, self.OnField2Clicked)
        table.insert(self._T.handlers, { entity = self.btnField2, eventHandler = hField2 })
        local hField3 = self.btnField3:ConnectEvent(ButtonClickEvent, self.OnField3Clicked)
        table.insert(self._T.handlers, { entity = self.btnField3, eventHandler = hField3 })
        local hGateTier1 = self.gateTier1Btn:ConnectEvent(ButtonClickEvent, self.OnGateTier1Clicked)
        table.insert(self._T.handlers, { entity = self.gateTier1Btn, eventHandler = hGateTier1 })
        local hGateTier2 = self.gateTier2Btn:ConnectEvent(ButtonClickEvent, self.OnGateTier2Clicked)
        table.insert(self._T.handlers, { entity = self.gateTier2Btn, eventHandler = hGateTier2 })
        local hGateTier3 = self.gateTier3Btn:ConnectEvent(ButtonClickEvent, self.OnGateTier3Clicked)
        table.insert(self._T.handlers, { entity = self.gateTier3Btn, eventHandler = hGateTier3 })
        local hGateTier4 = self.gateTier4Btn:ConnectEvent(ButtonClickEvent, self.OnGateTier4Clicked)
        table.insert(self._T.handlers, { entity = self.gateTier4Btn, eventHandler = hGateTier4 })
        -- 2026-09-24 - 모드별로 켜고 끌 구획들(전장 전용/게이트 전용) - 별도 바인딩 프로퍼티 없이
        -- 이름으로 한 번만 찾아 캐시(정적 하이어라키라 재조회 불필요, ApplyMode가 반복 호출됨).
        self._T.title = self.Entity:GetChildByName("Title", true)
        self._T.gaugeLabel = self.Entity:GetChildByName("GaugeLabel", true)
        self._T.gaugeTrack = self.Entity:GetChildByName("GaugeTrack", true)
        self._T.gaugeNote = self.Entity:GetChildByName("GaugeNote", true)
        self._T.gaugeRule = self.Entity:GetChildByName("GaugeRule", true)
        self._T.gateNote = self.Entity:GetChildByName("GateNote", true)
        self._T.gateRule = self.Entity:GetChildByName("GateRule", true)
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Releases the button click handlers and the recommendation-refresh timer.
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
        end
        if self.tickTimerId then
            _TimerService:ClearTimer(self.tickTimerId)
        end
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        -- Runs at 5Hz for the whole popup lifetime, but skips all work while hidden - the popup
        -- is only open for a few seconds at a time, so there's no point recomputing CP 5x/sec
        -- while nobody can see it.
        if not self.Entity.Enable then
            return
        end
        if self.mode == "battlefield" then
            self:RefreshRecommendations()
        end
    end

    @ExecSpace("ClientOnly")
    method void Show(string mode)
        -- Opens the popup in one of 3 single-purpose modes, called by LobbyStageController based on
        -- which floor's portal (1F/2F/3F) the player pressed up-arrow at:
        --   "battlefield" (1F) - 토벌전장 1~3 선택 + 난이도 + 휴식 게이지
        --   "gate"        (2F) - 카오스(몬스터) 게이트 입장만
        --   "boss"        (3F) - 보스 포탈, 아직 미구현 - 안내 문구만 표시
        -- 2026-09-24 QA("게이트는 아래에서 가능해서 헷갈림") - 이전엔 이 셋이 전부 1F 포탈 하나에서
        -- 열리는 같은 화면에 뒤섞여 있었다. 좌표/버튼은 그대로 재사용하고 모드별로 관련 없는 구획만
        -- 숨겨 세 포탈이 각자 단일 목적 화면을 여는 것처럼 보이게 한다.
        self.mode = mode
        self.Entity.Enable = true
        self:RefreshGauge()
        self:RefreshRecommendations()
        self:RefreshGateTicketDisplay()
        self:ApplyMode()
    end

    @ExecSpace("ClientOnly")
    method void ApplyMode()
        -- 모드에 따라 관련 없는 구획을 Enable=false로 숨긴다(부모 Enable이 자식까지 그대로 가려서
        -- 각 행의 Badge/Name/Recommend 텍스트도 함께 숨겨짐 - 프로젝트 전역에서 쓰는 패턴).
        local isBattlefield = self.mode == "battlefield"
        local isGate = self.mode == "gate"
        local isBoss = self.mode == "boss"

        -- 보스 모드에서는 같은 3행을 보스 1~3단계로 쓴다(RefreshBossRows가 이름/상태를 채운다).
        self.btnField1.Enable = isBattlefield or isBoss
        self.btnField2.Enable = isBattlefield or isBoss
        self.btnField3.Enable = isBattlefield or isBoss
        self:ApplyRowNames(isBoss)
        if isvalid(self._T.gaugeTrack) then self._T.gaugeTrack.Enable = isBattlefield end
        if isvalid(self._T.gaugeNote) then self._T.gaugeNote.Enable = isBattlefield end
        if isvalid(self._T.gaugeRule) then self._T.gaugeRule.Enable = isBattlefield end
        self.myPowerText.Enable = not isBoss

        -- 2026-09-30 - 난이도 행 4개(하급~최상급)는 게이트 전용 - 토벌전장 모드에서는 완전히 숨긴다.
        -- 각 행 자체가 토벌전장 Field1~3과 같은 "뱃지+이름+권장전투력" 행이라 누르면 바로 입장된다.
        self.gateTier1Btn.Enable = isGate
        self.gateTier2Btn.Enable = isGate
        self.gateTier3Btn.Enable = isGate
        self.gateTier4Btn.Enable = isGate
        self.gateTicketLabel.Enable = isGate
        if isvalid(self._T.gateNote) then self._T.gateNote.Enable = isGate end
        if isvalid(self._T.gateRule) then self._T.gateRule.Enable = isGate end

        if isvalid(self._T.gaugeLabel) then
            if isBoss then
                self._T.gaugeLabel.Enable = true
                self._T.gaugeLabel.TextGUIRendererComponent.Text = "보스 1단계 개방 - 다음 단계는 이전 보스 처치 후 해금"
            else
                self._T.gaugeLabel.Enable = isBattlefield
                self._T.gaugeLabel.TextGUIRendererComponent.Text = "휴식 게이지"
            end
        end

        if isvalid(self._T.title) then
            local titleText = "토벌 전장 선택"
            if isGate then
                titleText = "몬스터 게이트"
            elseif isBoss then
                titleText = "보스 포탈"
            end
            self._T.title.TextGUIRendererComponent.Text = titleText
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshGateTicketDisplay()
        -- M2 Phase E - GateTicketLogic(계정 단위)이 로드/갱신될 때마다도 호출된다(OnLoaded/OnTicketGranted/
        -- OnEnterGateResult). 팝업이 닫혀있어도 텍스트 갱신 자체는 가볍기 때문에 Tick의 Enable 가드와
        -- 달리 무조건 갱신 - 다음에 열릴 때 바로 최신값이 보이게 함.
        local count = _GateTicketLogic:GetCount()
        self.gateTicketLabel.Text = "입장권 보유 " .. tostring(count)
    end

    @ExecSpace("ClientOnly")
    method void EnterGate(integer tier)
        -- 몬스터 게이트 입장 - 입장권 소모/검증은 서버(GateTicketLogic.RequestEnterGate)가 전담한다.
        -- 2026-09-30 - "난이도 선택 후 별도 입장 버튼" 2단계를 없애고, 4개 난이도 행 각각이 이 메서드를
        -- 자신의 tier로 직접 호출한다(토벌전장 Field1~3의 "행 클릭 = 즉시 입장" 형식과 동일).
        -- 2026-09-24 QA(스크린샷 재검토) - 입장권 0개일 때 눌러도 서버가 조용히 거부만 하고(로그만
        -- 남김) 클라는 무조건 곧장 팝업을 닫아버려서, 플레이어 입장에서는 "게이트를 눌렀는데
        -- 아무 일도 없이 창만 닫힘"으로 보였다(성공/실패 구분 불가). 클라에서 먼저 티켓 수를 확인해
        -- 0개면 서버 호출도, 창 닫기도 하지 않고 안내문(GateNote)에 경고를 잠깐 띄운다.
        local count = _GateTicketLogic:GetCount()
        if count <= 0 then
            log("BattlefieldSelect: 몬스터 게이트 입장 거부(입장권 없음)")
            self:ShowGateDenied()
            return
        end
        log("BattlefieldSelect: 몬스터 게이트 입장 시도 tier=" .. tostring(tier))
        _GateTicketLogic:RequestEnterGate(tier)
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnGateTier1Clicked()
        self:EnterGate(1)
    end

    @ExecSpace("ClientOnly")
    method void OnGateTier2Clicked()
        self:EnterGate(2)
    end

    @ExecSpace("ClientOnly")
    method void OnGateTier3Clicked()
        self:EnterGate(3)
    end

    @ExecSpace("ClientOnly")
    method void OnGateTier4Clicked()
        self:EnterGate(4)
    end

    @ExecSpace("ClientOnly")
    method void ShowGateDenied()
        -- GateNote 텍스트를 2초간 경고 문구로 바꿨다가 원래 안내문으로 되돌린다.
        if not isvalid(self._T.gateNote) then return end
        local textComp = self._T.gateNote.TextGUIRendererComponent
        local originalColor = textComp.FontColor
        textComp.Text = "입장권이 부족합니다. 전장 클리어 시 낮은 확률로 획득할 수 있습니다."
        textComp.FontColor = Color(0.72, 0.18, 0.14, 1)
        if self._T.gateDeniedTimerId then
            _TimerService:ClearTimer(self._T.gateDeniedTimerId)
        end
        self._T.gateDeniedTimerId = _TimerService:SetTimerOnce(function()
            if isvalid(self._T.gateNote) then
                local t = self._T.gateNote.TextGUIRendererComponent
                t.Text = "난이도가 높을수록 몬스터가 강해지고 더 많이 등장하며 보상도 늘어납니다."
                t.FontColor = originalColor
            end
        end, 2.0)
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        -- Closes the popup. Also the target of BottomBarController.CloseOtherWindows' mutual
        -- exclusion sweep and WindowHotkeyLogic's ESC handler, same as the other full-card popups.
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void RefreshGauge()
        -- Chaos Dungeon 휴식 게이지 참고 - RestGaugeLogic(계정 단위, 실시간 경과 축적)의 현재
        -- 값을 게이지 바(HP바와 동일한 Sliced 폭-리사이즈 패턴)와 텍스트에 반영한다.
        -- 2026-09-15 코드 최적화(보류 항목 판단) - 로드가 끝나기 전(팝업을 아주 빨리 다시 열었을
        -- 때 등) 0으로 잠깐 보이던 것을 AccountCurrencyLogic의 IsLoadComplete 가드와 동일한
        -- 패턴으로 "..."로 표시하도록 수정. RestGaugeLogic의 OnGaugeLoaded->NotifyUIIfOpen이
        -- 로드 완료 시 다시 이 메서드를 불러 실제 값으로 갱신한다.
        if not _RestGaugeLogic:IsLoadComplete() then
            local size0 = self.gaugeFillTransform.RectSize
            self.gaugeFillTransform.RectSize = Vector2(0, size0.y)
            self.gaugeText.Text = "휴식 게이지 ... / 100"
            return
        end
        local value = _RestGaugeLogic:GetGauge()
        local ratio = math.max(0, math.min(1, value / 100))
        local size = self.gaugeFillTransform.RectSize
        self.gaugeFillTransform.RectSize = Vector2(self.gaugeFullWidth * ratio, size.y)
        self.gaugeText.Text = "휴식 게이지 " .. math.floor(value) .. " / 100"
    end

    @ExecSpace("ClientOnly")
    method void RefreshRecommendations()
        -- 유저 요청(2026-08-18): 레벨/전투력 제한 없이 아무 캐릭터나 원하는 전장에 바로 보낼 수
        -- 있게 하되, 뉴비가 각 전장의 난이도 감을 잡을 수 있도록 "권장 전투력"만 표시(입장을 막지
        -- 않는 순수 안내). CP 산식은 CharacterInfoUIController의 전투력 배지와 완전히 동일 -
        -- 기획서에 없는 근사 DPS 지수를 이 프로젝트에서 이미 "전투력"이라는 이름으로 써왔으므로
        -- 그대로 재사용해 일관성을 맞췄다.
        if self.mode == "boss" then
            self:RefreshBossRows()
            return
        end
        local cp = self:GetLiveCp()
        self.myPowerText.Text = "내 전투력  " .. tostring(cp)
        self:ApplyRecommendColor(self.recommend1, self.recommendedCp1, cp)
        self:ApplyRecommendColor(self.recommend2, self.recommendedCp2, cp)
        self:ApplyRecommendColor(self.recommend3, self.recommendedCp3, cp)
        -- 게이트 난이도 행(하급~최상급) 권장치 - 토벌전장 행(recommend1~3)과 완전히 같은
        -- ApplyRecommendColor 규칙(텍스트 "권장 전투력 N" + 초록/주황 색)을 그대로 재사용.
        self:ApplyRecommendColor(self.gateRecommend1, self.gateRecommendedCp1, cp)
        self:ApplyRecommendColor(self.gateRecommend2, self.gateRecommendedCp2, cp)
        self:ApplyRecommendColor(self.gateRecommend3, self.gateRecommendedCp3, cp)
        self:ApplyRecommendColor(self.gateRecommend4, self.gateRecommendedCp4, cp)
    end

    method number GetLiveCp()
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            return 0
        end
        local attack = localPlayer:GetComponent("script.PlayerAttack")
        local statsComp = localPlayer:GetComponent("script.PlayerStatsComponent")
        if not isvalid(attack) then
            return 0
        end
        local expectedMult = 1 + attack.CriticalChance * (attack.CritDamageMultiplier - 1)
        local cooldown = math.max(0.1, attack.AttackCooldownSeconds)
        local survivalMult = 1 + (isvalid(statsComp) and statsComp.DamageReductionPercent or 0)
        return math.floor(attack.AttackDamage * expectedMult / cooldown * survivalMult * 10)
    end

    @ExecSpace("ClientOnly")
    method void ApplyRecommendColor(TextGUIRendererComponent label, number recommended, number currentCp)
        -- 입장을 막지는 않지만(유저 요청), 권장치 대비 부족하면 색으로 바로 티나게 - 초록=충족,
        -- 주황=미달. 텍스트 자체는 항상 "권장 전투력 N"으로 고정, 색만 바뀐다.
        label.Text = "권장 전투력  " .. tostring(math.floor(recommended))
        if currentCp >= recommended then
            label.FontColor = Color(0.16, 0.45, 0.16, 1)
        else
            label.FontColor = Color(0.72, 0.32, 0.1, 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        -- X button in the corner.
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void ApplyRowNames(boolean isBoss)
        -- 행 이름 텍스트(Field1~3/Name)는 토벌전장 이름과 보스 단계 이름을 오간다. 원래 문구는 처음 한 번
        -- 캐시해 두고, 토벌 모드로 돌아갈 때 그대로 복원한다(ui 원본 문구를 코드에 하드코딩하지 않기 위함).
        local rows = { self.btnField1, self.btnField2, self.btnField3 }
        if self._T.rowNames == nil then
            self._T.rowNames = {}
            for i, row in ipairs(rows) do
                local nameComp = row:GetChildByName("Name", false)
                if isvalid(nameComp) then
                    self._T.rowNames[i] = nameComp.TextGUIRendererComponent.Text
                end
            end
        end
        if not isBoss then
            for i, row in ipairs(rows) do
                local nameComp = row:GetChildByName("Name", false)
                if isvalid(nameComp) and self._T.rowNames[i] ~= nil then
                    nameComp.TextGUIRendererComponent.Text = self._T.rowNames[i]
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshBossRows()
        -- 보스 모드 - 행 1~3 = 보스 1~3단계. 이름은 보스 이름(또는 준비 중), 권장 줄은 입장 상태
        -- (입장 가능 / 처치 완료 / 잠김 / 준비 중)로 표시. 잠긴 행을 눌러도 입장되지 않는다(RequestBossTier).
        if self.mode ~= "boss" then return end
        local rows = { self.btnField1, self.btnField2, self.btnField3 }
        local labels = { self.recommend1, self.recommend2, self.recommend3 }
        local loaded = _BossRaidLogic:IsProgressLoaded()
        local cleared = _BossRaidLogic:GetClearedTier()
        for tier = 1, 3 do
            local stats = _BossRaidLogic:GetTierStats(tier)
            local nameComp = rows[tier]:GetChildByName("Name", false)
            if isvalid(nameComp) then
                nameComp.TextGUIRendererComponent.Text = stats ~= nil and stats.name or "준비 중"
            end
            local label = labels[tier]
            if stats == nil then
                label.Text = "준비 중"
                label.FontColor = Color(0.45, 0.45, 0.45, 1)
            elseif not loaded then
                label.Text = "진행도 확인 중..."
                label.FontColor = Color(0.45, 0.45, 0.45, 1)
            elseif cleared >= tier then
                label.Text = "처치 완료 - 재도전 가능"
                label.FontColor = Color(0.16, 0.45, 0.16, 1)
            elseif _BossRaidLogic:IsTierUnlocked(tier) then
                label.Text = "입장 가능"
                label.FontColor = Color(0.16, 0.45, 0.16, 1)
            else
                label.Text = "[잠김] 이전 보스 처치 필요"
                label.FontColor = Color(0.72, 0.32, 0.1, 1)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RequestBossTier(integer tier)
        -- 보스 단계 입장. 잠김/준비 중이면 입장하지 않고 권장 줄에 상태를 다시 보여준다.
        if not _BossRaidLogic:IsTierUnlocked(tier) then
            log("BattlefieldSelect: 보스 " .. tier .. "단계 잠김 - 입장 안 함")
            self:RefreshBossRows()
            return
        end
        log("BattlefieldSelect: 보스 " .. tier .. "단계 입장 요청")
        _BossRaidLogic:RequestEnterBossRaid(tier)
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnField1Clicked()
        -- Routed through CharacterRosterLogic (a world-session @Logic, reachable from any map)
        -- rather than a map-scoped component, matching RequestReturnToSelect's reasoning for the
        -- same class of cross-map server call. Rest-gauge consumption happens server-side inside
        -- RequestEnterBattlefield itself, not here. No CP/level gate - purely informational
        -- (see RefreshRecommendations).
        -- 2026-09-24 유저 결정 - 토벌전장은 전장1~3(맵) 자체가 난이도 구분이라 별도 tier 선택이
        -- 필요 없음 - "하급~최상급" 4단계 선택 UI는 게이트 전용으로 재배치했으므로 항상 1 고정.
        if self.mode == "boss" then
            self:RequestBossTier(1)
            return
        end
        log("BattlefieldSelect: 토벌전장 1 선택")
        _CharacterRosterLogic:RequestEnterBattlefield(1, 1)
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnField2Clicked()
        if self.mode == "boss" then
            self:RequestBossTier(2)
            return
        end
        log("BattlefieldSelect: 토벌전장 2 선택")
        _CharacterRosterLogic:RequestEnterBattlefield(2, 1)
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnField3Clicked()
        if self.mode == "boss" then
            self:RequestBossTier(3)
            return
        end
        -- 2026-09-24 버그 수정 - Field1/2Clicked만 tier=1 고정으로 바꾸고 이 메서드는 옛 로직
        -- (self.selectedTier)이 그대로 남아있었다 - 게이트 화면에서 마지막으로 고른 난이도가
        -- 실수로 토벌전장3 입장에 섞여 들어갈 수 있었던 잠재 버그.
        log("BattlefieldSelect: 토벌전장 3 선택")
        _CharacterRosterLogic:RequestEnterBattlefield(3, 1)
        self:Hide()
    end
end
