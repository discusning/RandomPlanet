            strafe = { id = "strafe", tier = 3, name = "스트레이프", job = "궁수", kind = "multi_hit", coef = 0.71, hits = 4, cooldown = 4.5, mpCost = 15, projectileVfxRuid = "ac868a4ac45c4489a3c2e60ad3dd9454", iconRuid = "56127b20dcd0425f9804f03a7a4c0f52", desc = "한 명의 적에게 화살 4발을 쏘아 각 타격마다 평타의 71% 피해를 입힙니다." },
            -- 2026-10-02 유저 엑셀 - 실제 수치는 크리티컬 확률 +5% + 피해 +20%(기존 크리+30% 단일
            -- 효과는 과장된 추정치였음). testableEffect(critchance)는 하나만 가질 수 있어, 두 번째
            -- 독립 채널(evasionBonus와 동일 패턴)로 atkBonusPercent2를 추가 - skilldmg 채널은 DoRanged의
            -- magic 전용이라 궁수 자신의 비마법 공격엔 적용되지 않는 죽은 수치가 되므로, 모든 kind가
            -- 공유하는 attack.AttackDamage 채널(atkbonus와 동일)을 재사용해 실제로 관측 가능하게 함.
            -- 2026-10-02 유저 엑셀 신규 - "모탈 블로우"(궁수 3차 공격). 즉사 확률을 실제로 구현 -
            -- 평타 110% 피해를 입힌 뒤, 피격 후 HP가 executeHpPercent 이하로 떨어진 대상에게
            -- executeInstakillChance 확률로 Monster:ExecuteKill(기존 "동전 던지기 사형집행인"
            -- 트레잇과 동일 처치 경로) 발동 - PlayerSkillExecutionLogic.DispatchSkillEffect에서
            -- melee_single 판정 뒤 추가 스캔.
            -- 2026-10-02 VFX 패스 - 실제 "모탈 블로우"(skill/1311.img/skill/13110009) 팩 - 이름
            -- 완전 일치했으나 애니메이션클립 없이 아이콘만 존재(에이전트 확인) - 아이콘만 교체.
            -- 2026-10-04 주석 정리: 이 스킬에는 hitVfxRuid/projectileVfxRuid 필드가 없다(예전 "기존 값
            -- 유지" 문구는 사실과 달라 삭제). 투사체는 Projectile.model 기본 스프라이트를 쓴다.
            mortalblow = { id = "mortalblow", tier = 3, name = "모탈 블로우", job = "궁수", kind = "passive_mortal", coef = 1.1, triggerChance = 0.32, executeHpPercent = 0.2, executeInstakillChance = 0.01, cooldown = 0, mpCost = 0, iconRuid = "1425ace675e2486ebb6c4bb595e7294e", desc = "(패시브) 공격할 때 32% 확률로 추가 타격을 입힙니다(평타의 110%). 적의 HP가 20% 이하일 때는 1% 확률로 즉사시킵니다." },
            -- 2026-10-02 유저 엑셀 전체 반영 - 샤프 아이즈는 엑셀상 궁수 4차 소속(기존엔 3차에 잘못
            -- 배치돼 있었음) - 아래 4차 섹션으로 이동.
            shadowpartner = { id = "shadowpartner", sfxRuid = "6c7c28167b9049419435cc53001cef0c", buffVfxRuid = "8ef08d990aeb452bad114479f6bc76fd",tier = 3, name = "쉐도우 파트너", job = "도적", kind = "buff", duration = 8.0, testableEffect = "atkspeed", cooldown = 20.0, mpCost = 15, auraType = "Buff", auraColor = Color(0.5, 0.3, 0.6, 0.9), iconRuid = "9916a2204e994e7d9283f2e54462f45c", desc = "분신이 함께 공격해 공격 속도가 크게 증가한 것처럼 동작합니다." },
            -- 2026-10-02 유저 엑셀 신규 - "어벤져"(도적 3차 공격). "표창 3개로 최대 4명 공격"을
            -- ranged_pierce + maxTargets(관통 캡)로 구현 - ProjectileComponent에 MaxPierceTargets를
            -- 추가해 기존 "무제한 관통" pierce=true와 구분되는 "N명까지만 관통" 모드를 신설.
