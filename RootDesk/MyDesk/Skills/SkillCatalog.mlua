@Logic
script SkillCatalog extends Logic
    -- 1차 스킬 풀 (Docs/랜덤 플래닛 전체 기획서.md §04 "각 전직마다 메이플스토리 5차 이전 직업 스킬 3개
    -- 제시 → 1개 선택. 풀은 차수별 분리, 풀 내에서는 전 직업 통합"). 직업별 액티브 1 + 버프 1, 5직업 x 2 = 10종.
    -- kind별 필드:
    --   melee_single  { coef }                      - 전방 근접 단일 히트, PlayerAttack.AttackDamage*coef
    --   ranged_single { coef, magic }                - 투사체 단일 히트. magic=true면 INT의 SkillDamageBonus 추가 적용
    --   ranged_pierce { coef, magic }                - 투사체 관통(최대 2체)
    --   multi_hit     { coef, hits }                 - 즉시 다단 히트(히트당 coef, hits회)
    --   dash          { force }                      - 데미지 없는 순간 돌진(AddForce)
    --   buff          { duration, testableEffect, inertNote } - 지속시간 버프. testableEffect만 실제 적용, 나머지는 로그만 남김(비활성)

    method table GetAllSkillIds()
        return {
            "powerstrike", "ironbody",
            "magicclaw", "magicguard",
            "arrowblow", "focus",
            "luckyseven", "nimblebody",
            "dash", "knucklebooster",
        }
    end

    method table GetSkillDef(string skillId)
        -- VFX fields (added so each skill reads visually distinct instead of sharing the generic
        -- "projectile" bullet sprite / no effect at all - see PlayerSkillComponent for how each is used):
        --   projectileVfxRuid (ranged_single/ranged_pierce) - overrides the projectile's default sprite
        --   hitVfxRuid        (melee_single/multi_hit)       - one-shot impact clip at the swing position
        --   dashVfxRuid       (dash)                          - one-shot clip at the caster on dash
        --   auraType/auraColor (buff)                         - looping BasicParticle attached while active
        -- RUIDs are the real MapleStory skill-pack clips for that exact skill (found via msw-search),
        -- so magic claw actually looks like a claw swipe and arrow blow like a flying arrow, not a shared dot.
        local defs = {
            powerstrike = { id = "powerstrike", name = "파워 스트라이크", job = "검사", kind = "melee_single", coef = 1.8, cooldown = 3.0, mpCost = 8, hitVfxRuid = "dad03b3a528348bf98295b01edd621a4" },
            ironbody = { id = "ironbody", name = "아이언 바디", job = "검사", kind = "buff", duration = 5.0, testableEffect = "none", inertNote = "방어력 상승 - 몬스터가 플레이어를 공격하는 파이프라인이 없어 비활성", cooldown = 15.0, mpCost = 15, auraType = "Aura", auraColor = Color(0.75, 0.75, 0.82, 0.9) },
            magicclaw = { id = "magicclaw", name = "매직 클로", job = "마법사", kind = "ranged_single", coef = 1.3, magic = true, cooldown = 2.5, mpCost = 10, projectileVfxRuid = "2a0d72e836fb4862aae83087035f3d2a" },
            magicguard = { id = "magicguard", name = "매직 가드", job = "마법사", kind = "buff", duration = 8.0, testableEffect = "none", inertNote = "받는 피해 일부를 MP로 전환 - 몬스터 공격 파이프라인 없어 비활성", cooldown = 20.0, mpCost = 20, auraType = "Enchant", auraColor = Color(0.4, 0.6, 1.0, 0.9) },
            arrowblow = { id = "arrowblow", name = "애로우 블로우", job = "궁수", kind = "ranged_pierce", coef = 1.2, magic = false, cooldown = 2.0, mpCost = 8, projectileVfxRuid = "64f775829e234918bd65e9d22214bb06" },
            focus = { id = "focus", name = "포커스", job = "궁수", kind = "buff", duration = 6.0, testableEffect = "accuracy", accuracyBonus = 30, inertNote = "회피 상승 부분은 비활성(몬스터 공격 파이프라인 없음)", cooldown = 12.0, mpCost = 12, auraType = "SpinField", auraColor = Color(1.0, 0.85, 0.3, 0.9) },
            luckyseven = { id = "luckyseven", name = "럭키 세븐", job = "도적", kind = "multi_hit", coef = 0.5, hits = 3, cooldown = 3.5, mpCost = 12, hitVfxRuid = "458e72f0720a4584a9a7fc3642b6e601" },
            nimblebody = { id = "nimblebody", name = "님블 바디", job = "도적", kind = "buff", duration = 6.0, testableEffect = "movespeed", moveSpeedBonus = 1.5, inertNote = "회피 상승 부분은 비활성(몬스터 공격 파이프라인 없음)", cooldown = 12.0, mpCost = 10, auraType = "Buff", auraColor = Color(0.3, 1.0, 0.85, 0.9) },
            dash = { id = "dash", name = "대시", job = "해적", kind = "dash", force = 6.0, cooldown = 4.0, mpCost = 6, dashVfxRuid = "b84c3c28e8284104b68d16b5cf0524b2" },
            knucklebooster = { id = "knucklebooster", name = "너클 부스터", job = "해적", kind = "buff", duration = 6.0, testableEffect = "atkspeed", cooldown = 15.0, mpCost = 15, auraType = "LightningOrbSoft", auraColor = Color(1.0, 0.55, 0.15, 0.9) },
        }
        return defs[skillId]
    end

    method table RollThreeSkills()
        -- Fisher-Yates shuffle over the id pool, take the first 3 (no duplicates within one roll).
        local ids = self:GetAllSkillIds()
        for i = #ids, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            local tmp = ids[i]
            ids[i] = ids[j]
            ids[j] = tmp
        end
        return { ids[1], ids[2], ids[3] }
    end

end
