            dash = { id = "dash", tier = 1, name = "대시", job = "해적", kind = "dash", force = 6.0, coef = 1.4, cooldown = 4.0, mpCost = 6, dashVfxRuid = "b84c3c28e8284104b68d16b5cf0524b2", hitVfxRuid = "dad03b3a528348bf98295b01edd621a4", desc = "바라보는 방향으로 짧게 돌진해 경로상의 적에게 평타의 140% 피해를 입힙니다." },
            -- 너클 부스터 (2026-08-17, 럭키 세븐과 동일 사유 - see 위 주석): 실제로는 해적 1차가
            -- 아니라 인파이터(2차) 스킬. 실제 해적 1차는 대시가 사실상 전부라 대체할 진짜 1차 버프가
            -- 없어 의도적 타협으로 유지(유저 확인 완료, 2026-08-17).
            knucklebooster = { id = "knucklebooster", tier = 1, name = "너클 부스터", job = "해적", kind = "buff", duration = 6.0, testableEffect = "atkspeed", cooldown = 15.0, mpCost = 15, auraType = "LightningOrbSoft", auraColor = Color(1.0, 0.55, 0.15, 0.9), buffVfxRuid = "a049e37d33f44125bd279ace994a3322", desc = "일정 시간 공격 속도가 크게 증가합니다." },

            -- 2026-09-06 (M2 Phase D) - 2/3/4차 스킬 30종(5직업 x 3티어 x 버프/공격). 이름은 메이플스토리
            -- 지식 기반 최선 추정(더블스윙/파워가드/썬더볼트/트리플스로우/아수라/인피니티/허리케인/
            -- 메테오스트라이크/배틀쉽 등은 실제 클래식 메이플 스킬임을 높은 확신으로 확인 - WebSearch로
            -- 일부 교차검증 시도했으나 구버전 위키 자료가 부족해 전부를 백과사전 수준으로 검증하지는
            -- 못함) - 정확한 전직 차수/직업 분기(예: 파이터/페이지/스피어맨)까지 완벽히 일치하는 것은
            -- 아니며, 기존 1차 스킬(럭키세븐/너클부스터)도 이미 같은 수준의 타협을 거친 전례가 있음.
            -- VFX는 시간 관계상 신규 msw-search 없이 각 직업의 기존 1차 스킬 RUID를 재사용(같은 직업
            -- 내에서는 시각적으로 자연스럽게 어울림, 다만 스킬마다 완전히 고유한 이펙트는 아님 - 향후
            -- 폴리싱 패스에서 개별 검색으로 교체 권장). 버프는 기존 5종 auraType(Aura/Enchant/
            -- SpinField/Buff/LightningOrbSoft)을 색상만 다르게 재사용.
            -- 신규 testableEffect 3종(dmgreduction/skilldmg/atkbonus)은 PlayerSkillComponent.DoBuff/
            -- RevertBuff에 ironbody(maxhp)와 동일한 "델타 저장 후 복원" 패턴으로 구현.

