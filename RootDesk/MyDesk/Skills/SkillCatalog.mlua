@Logic
script SkillCatalog extends Logic
    -- 1차 스킬 풀 (Docs/랜덤 플래닛 전체 기획서.md §04 "각 전직마다 메이플스토리 5차 이전 직업 스킬 3개
    -- 제시 → 1개 선택. 풀은 차수별 분리, 풀 내에서는 전 직업 통합"). 직업별 액티브 1 + 버프 1, 5직업 x 2 = 10종.
    -- kind별 필드:
    --   melee_single  { coef }                      - 전방 근접 단일 히트, PlayerAttack.AttackDamage*coef
    --   ranged_single { coef, magic }                - 투사체 단일 히트. magic=true면 INT의 SkillDamageBonus 추가 적용
    --   ranged_pierce { coef, magic }                - 투사체 관통(최대 2체)
    --   multi_hit     { coef, hits }                 - 즉시 다단 히트(히트당 coef, hits회)
    --   dash          { force }                      - 데미지 없는 순간 돌진(AddForce)
    --   buff          { duration, testableEffect, inertNote } - 지속시간 버프. testableEffect만 실제 적용, 나머지는 로그만 남김(비활성)

    method table GetAllSkillIds()
        return {
            "powerstrike", "ironbody",
            "magicclaw", "magicguard",
            "arrowblow", "focus",
            "luckyseven", "nimblebody",
            "dash", "knucklebooster",
        }
    end

    method table GetSkillDef(string skillId)
        -- VFX fields (added so each skill reads visually distinct instead of sharing the generic
        -- "projectile" bullet sprite / no effect at all - see PlayerSkillComponent for how each is used):
        --   projectileVfxRuid (ranged_single/ranged_pierce) - overrides the projectile's default sprite
        --   hitVfxRuid        (melee_single/multi_hit)       - one-shot impact clip at the swing position
        --   dashVfxRuid       (dash)                          - one-shot clip at the caster on dash
        --   buffVfxRuid       (buff)                          - one-shot cast clip at the caster, played once on activation
        --   auraType/auraColor (buff)                         - looping BasicParticle attached while active (fallback/complement)
        -- RUIDs are the real MapleStory skill-pack clips for that exact skill, verified one-by-one via
        -- msw-search's searchResources(resourceTypeFilter=["resource_pack"], categoryFilter=["skill"])
        -- against the skill's own Korean name and cross-checked against the pack's element rel_path
        -- (e.g. "hit/0", "ball", "effect") so magic claw actually looks like a claw swipe and arrow
        -- blow like a flying arrow, not a shared dot or an unrelated generic particle.
        -- 2026-08-13 audit (pass 1): re-verified all 10 against their canonical resource_pack.
        -- powerstrike/magicclaw/arrowblow/luckyseven/dash were already correct (each RUID matched an
        -- element of the skill's own pack). magicguard/knucklebooster were wrong - they only had a
        -- generic BasicParticleType aura (auraType) and no real skill clip, even though a real
        -- "effect" animationclip exists in their canonical packs (skill/1200.img/skill/12001001 and
        -- skill/15510.img/skill/155101005) - added as buffVfxRuid.
        --
        -- 2026-08-13 audit (pass 2, after user reported buffs still "looked like generic particle
        -- blobs" even for the pass-1-fixed skills): root cause was that DoBuff played the real
        -- buffVfxRuid as a single one-shot flash via PlayEffect, then immediately layered the flat-
        -- colored generic BasicParticle aura on top for the whole buff duration - so the correct clip
        -- was on screen for a fraction of a second and the generic shape is what the player actually
        -- watched for the next 5-8s. Fixed in PlayerSkillComponent.DoBuff: buffVfxRuid (when present)
        -- is now looped + attached to the caster for the full buff duration via
        -- _EffectService:PlayEffectAttached(..., isLoop=true) and completely REPLACES the generic
        -- aura (auraType/auraColor kept only as the last-resort fallback for skills with no clip at
        -- all). Also closed 2 of the 3 remaining gaps with same-function substitute clips from the
        -- SAME official MSW/MapleStory resource index (there is no tool access to browse another
        -- creator's specific published World, e.g. a "메이플랜드"-style world, nor any path to import
        -- assets from unrelated third-party commercial games - only this shared official resource
        -- library is available, and it IS sourced from real MapleStory art):
        --   focus      -> "포커스 온"(skill/322.img/skill/3220021)'s "repeat" clip - same class
        --                 lineage (Bowman), same function (accuracy buff), real "포커스" has zero
        --                 indexed resource_pack under any phrasing tried.
        --   nimblebody -> "헤이스트"/Haste(skill/000.img/skill/0008000)'s "affected" clip - not
        --                 thief-specific, but mechanically identical (movement speed buff) and one of
        --                 the most recognizable classic Maple buff visuals; real "님블 바디" has zero
        --                 indexed resource_pack under any phrasing tried.
        --
        -- 2026-08-13 audit (pass 3, user asked for a substitute for ironbody too): found "파워 가드"/
        -- Power Guard (skill/800033.img/skill/80003317) - a warrior/knight physical-toughness self-buff,
        -- same class lineage and same "harden the body" flavor as Iron Body - its "affected" clip
        -- (the sustained while-buffed overlay, not the one-shot "effect" cast clip) is now ironbody's
        -- buffVfxRuid. Real "아이언 바디" itself still has zero indexed resource_pack beyond icon
        -- sprites under any phrasing tried across all 3 passes.
        -- 2026-08-13 audit (pass 4, 2026-08-16): user re-flagged "name vs effect mismatch" + "unfinished
        -- effects" project-wide. Re-verified all 10 RUIDs' actual pack membership (not just the `names`
        -- field, which is null/unreliable on individual animationclips - confirmed via
        -- `findPacksContaining` that luckyseven/magicguard/knucklebooster's clips genuinely belong to
        -- their own named skill's pack despite a misleading AI-generated `names` tag on luckyseven's).
        -- Found a strictly better substitute for ironbody: "아이언 월"(skill/800032.img/skill/80003293) -
        -- shares the literal "아이언"(Iron) root with "아이언 바디" (unlike "파워 가드", no name overlap
        -- at all) and has both `affected`/`effect` clips. Swapped. Re-searched focus/nimblebody's real
        -- packs ("명중치/회피치 확률 증가", "님블 핑거") once more with fresh query angles - both still
        -- have zero animationclip elements (icon sprites only), confirming pass-2's substitutes
        -- (포커스 온 / 헤이스트) remain the best available option. **Also completed ironbody/magicguard's
        -- previously fully-inert (`testableEffect="none"`) mechanics** - see PlayerSkillComponent.DoBuff:
        -- ironbody now grants a real temporary MaxHp boost (`testableEffect="maxhp"`), magicguard now
        -- makes skills MP-free for its duration (`testableEffect="mpfree"`) - both deliberately
        -- reinterpreted (not literal defense/damage-to-MP conversion) since that would still require the
        -- not-yet-built monster-attacks-player pipeline to be observable at all; these substitutes are
        -- fully observable today with existing systems (HP bar, MP bar).
        -- desc: 스킬창 툴팁에 그대로 노출되는 플레이어용 효과 설명. 실제로 수치가 적용되는 부분은
        -- 구체적 수치를 명시하고(예: "명중률 +30"), inertNote로 비활성 처리된 부분은 설명에서 뺐다 -
        -- 발동 안 하는 효과를 설명에 적어두면 플레이어에게 거짓 정보가 된다.
        local defs = {
            powerstrike = { id = "powerstrike", name = "파워 스트라이크", job = "검사", kind = "melee_single", coef = 1.8, cooldown = 3.0, mpCost = 8, hitVfxRuid = "dad03b3a528348bf98295b01edd621a4", desc = "전방의 적을 강하게 내리쳐 평타의 180% 피해를 입힙니다." },
            ironbody = { id = "ironbody", name = "아이언 바디", job = "검사", kind = "buff", duration = 5.0, testableEffect = "maxhp", maxHpBonusPercent = 0.3, cooldown = 15.0, mpCost = 15, auraType = "Aura", auraColor = Color(0.75, 0.75, 0.82, 0.9), buffVfxRuid = "e9c90ecd65224980b56903dba89ef856", desc = "일정 시간 최대 체력이 30% 증가합니다." },
            magicclaw = { id = "magicclaw", name = "매직 클로", job = "마법사", kind = "ranged_single", coef = 1.3, magic = true, cooldown = 2.5, mpCost = 10, projectileVfxRuid = "2a0d72e836fb4862aae83087035f3d2a", desc = "전방으로 마법 발톱을 날려 평타의 130% 마법 피해를 입힙니다." },
            magicguard = { id = "magicguard", name = "매직 가드", job = "마법사", kind = "buff", duration = 8.0, testableEffect = "mpfree", cooldown = 20.0, mpCost = 20, auraType = "Enchant", auraColor = Color(0.4, 0.6, 1.0, 0.9), buffVfxRuid = "3878fb0f62bf43a48cd9f43332490315", desc = "일정 시간 스킬 MP 소모가 없어집니다." },
            arrowblow = { id = "arrowblow", name = "애로우 블로우", job = "궁수", kind = "ranged_pierce", coef = 1.2, magic = false, cooldown = 2.0, mpCost = 8, projectileVfxRuid = "64f775829e234918bd65e9d22214bb06", desc = "화살을 쏘아 최대 2명의 적을 관통, 각각 평타의 120% 피해를 입힙니다." },
            focus = { id = "focus", name = "포커스", job = "궁수", kind = "buff", duration = 6.0, testableEffect = "accuracy", accuracyBonus = 30, inertNote = "회피 상승 부분은 비활성(몬스터 공격 파이프라인 없음)", cooldown = 12.0, mpCost = 12, auraType = "SpinField", auraColor = Color(1.0, 0.85, 0.3, 0.9), buffVfxRuid = "0d68db29ec2046f4bb2a64e6f03b745b", desc = "일정 시간 명중률이 30 증가합니다." },
            luckyseven = { id = "luckyseven", name = "럭키 세븐", job = "도적", kind = "multi_hit", coef = 0.5, hits = 3, cooldown = 3.5, mpCost = 12, hitVfxRuid = "458e72f0720a4584a9a7fc3642b6e601", desc = "단검을 3연속으로 던져 각 타격마다 평타의 50% 피해를 입힙니다." },
            nimblebody = { id = "nimblebody", name = "님블 바디", job = "도적", kind = "buff", duration = 6.0, testableEffect = "movespeed", moveSpeedBonus = 1.5, inertNote = "회피 상승 부분은 비활성(몬스터 공격 파이프라인 없음)", cooldown = 12.0, mpCost = 10, auraType = "Buff", auraColor = Color(0.3, 1.0, 0.85, 0.9), buffVfxRuid = "372fdc6781974004bfb08edd5b5f9914", desc = "일정 시간 이동 속도가 증가합니다." },
            dash = { id = "dash", name = "대시", job = "해적", kind = "dash", force = 6.0, cooldown = 4.0, mpCost = 6, dashVfxRuid = "b84c3c28e8284104b68d16b5cf0524b2", desc = "바라보는 방향으로 짧게 돌진합니다." },
            knucklebooster = { id = "knucklebooster", name = "너클 부스터", job = "해적", kind = "buff", duration = 6.0, testableEffect = "atkspeed", cooldown = 15.0, mpCost = 15, auraType = "LightningOrbSoft", auraColor = Color(1.0, 0.55, 0.15, 0.9), buffVfxRuid = "a049e37d33f44125bd279ace994a3322", desc = "일정 시간 공격 속도가 크게 증가합니다." },
        }
        return defs[skillId]
    end

    method table RollThreeSkills()
        -- Fisher-Yates shuffle over the id pool, take the first 3 (no duplicates within one roll).
        local ids = self:GetAllSkillIds()
        for i = #ids, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            local tmp = ids[i]
            ids[i] = ids[j]
            ids[j] = tmp
        end
        return { ids[1], ids[2], ids[3] }
    end

    method boolean IsBuffSkill(string skillId)
        -- Category split used by PlayerSkillComponent's tier-slot grants (Docs/랜덤 플래닛 전체 기획서.md
        -- §04 "버프풀 3택1 + 공격풀 3택1 동시 진행"). Every non-"buff" kind counts as the attack category.
        local def = self:GetSkillDef(skillId)
        return def ~= nil and def.kind == "buff"
    end

    method table GetSkillsByCategory(string category)
        -- category = "buff" | "attack". Returns ids in catalog order (stable, not shuffled).
        local ids = self:GetAllSkillIds()
        local result = {}
        for _, id in ipairs(ids) do
            local isBuff = self:IsBuffSkill(id)
            if (category == "buff" and isBuff) or (category == "attack" and not isBuff) then
                table.insert(result, id)
            end
        end
        return result
    end

    method table RollSkillChoices(string category, table excludeIds)
        -- Up to 3 unowned ids of the given category, shuffled. Returns fewer than 3 once the
        -- category pool (5 ids today) is mostly exhausted by earlier tier grants - callers must
        -- handle a short list (see PlayerSkillComponent.GrantTierSkills).
        local pool = self:GetSkillsByCategory(category)
        local excludeLookup = {}
        for _, id in ipairs(excludeIds) do
            excludeLookup[id] = true
        end
        local candidates = {}
        for _, id in ipairs(pool) do
            if not excludeLookup[id] then
                table.insert(candidates, id)
            end
        end
        for i = #candidates, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            local tmp = candidates[i]
            candidates[i] = candidates[j]
            candidates[j] = tmp
        end
        local result = {}
        for i = 1, math.min(3, #candidates) do
            table.insert(result, candidates[i])
        end
        return result
    end

end
