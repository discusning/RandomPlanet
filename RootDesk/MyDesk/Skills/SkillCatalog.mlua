@Logic
script SkillCatalog extends Logic
    -- 1차 스킬 풀 (Docs/랜덤 플래닛 전체 기획서.md §04 "각 전직마다 메이플스토리 5차 이전 직업 스킬 3개
    -- 제시 → 1개 선택. 풀은 차수별 분리, 풀 내에서는 전 직업 통합"). 직업별 액티브 1 + 버프 1, 5직업 x 2 = 10종.
    -- kind별 필드:
    --   melee_single  { coef }                      - 전방 근접 단일 히트, PlayerAttack.AttackDamage*coef
    --   ranged_single { coef, magic }                - 투사체 단일 히트. magic=true면 INT의 SkillDamageBonus 추가 적용
    --   ranged_pierce { coef, magic }                - 투사체 관통(최대 2체)
    --   multi_hit     { coef, hits }                 - 짧은 사거리를 실제로 날아가는 투사체를 hits회 연속 투척(히트당 coef) - PlayerSkillComponent.DoMultiHit
    --   dash          { force, coef }                - 돌진(AddForce) + 돌진 경로상의 적에게 평타*coef 피해
    --                                                   (2026-08-25 밸런스 - 원래 데미지 없이 이동만 했던 탓에
    --                                                   해적 1차 공격풀에 실제 데미지 스킬이 하나도 없었음,
    --                                                   아래 밸런스 조정 로그 참고)
    --   debuff        { evasionReduction, duration }  - 전방 근처 몬스터 1체의 Evasion을 일시 감소(Monster.ApplyDisorder) - 데미지 없음
    --   buff          { duration, testableEffect, inertNote } - 지속시간 버프. testableEffect만 실제 적용, 나머지는 로그만 남김(비활성)

    method table GetAllSkillIds()
        return {
            -- 1차 (tier=1)
            "powerstrike", "slashblast", "ironbody",
            "magicclaw", "magicguard",
            "arrowblow", "focus",
            "luckyseven", "disable", "darksight", "nimblebody",
            "dash", "knucklebooster",
            -- 2차 (tier=2, M2 Phase D 2026-09-06)
            "doubleswing", "powerguard",
            "thunderbolt", "meditation",
            "doubleshot", "soularrow",
            "doublestab", "haste",
            "flamethrower", "reload",
            -- 3차 (tier=3)
            "risingslash", "ironwill",
            "blizzard", "magicbooster",
            "arrowrain", "sharpeyes",
            "venom", "shadowpartner",
            "battery", "speedenhancer",
            -- 4차 (tier=4)
            "blast", "rage",
            "meteorstrike", "infinity",
            "hurricane", "eagleeye",
            "asura", "markofassassin",
            "rapidfire", "battleship",
        }
    end

    method table GetSkillDef(string skillId)
        -- VFX fields (added so each skill reads visually distinct instead of sharing the generic
        -- "projectile" bullet sprite / no effect at all - see PlayerSkillComponent for how each is used):
        --   projectileVfxRuid (ranged_single/ranged_pierce) - overrides the projectile's default sprite
        --   hitVfxRuid        (melee_single/multi_hit)       - one-shot impact clip at the swing position
        --   dashVfxRuid       (dash)                          - one-shot clip at the caster on dash
        --   buffVfxRuid       (buff)                          - one-shot cast clip at the caster, played once on activation
        --   auraType/auraColor (buff)                         - looping BasicParticle attached while active (fallback/complement)
        -- RUIDs are the real MapleStory skill-pack clips for that exact skill, verified one-by-one via
        -- msw-search's searchResources(resourceTypeFilter=["resource_pack"], categoryFilter=["skill"])
        -- against the skill's own Korean name and cross-checked against the pack's element rel_path
        -- (e.g. "hit/0", "ball", "effect") so magic claw actually looks like a claw swipe and arrow
        -- blow like a flying arrow, not a shared dot or an unrelated generic particle.
        -- 2026-08-13 audit (pass 1): re-verified all 10 against their canonical resource_pack.
        -- powerstrike/magicclaw/arrowblow/luckyseven/dash were already correct (each RUID matched an
        -- element of the skill's own pack). magicguard/knucklebooster were wrong - they only had a
        -- generic BasicParticleType aura (auraType) and no real skill clip, even though a real
        -- "effect" animationclip exists in their canonical packs (skill/1200.img/skill/12001001 and
        -- skill/15510.img/skill/155101005) - added as buffVfxRuid.
        --
        -- 2026-08-13 audit (pass 2, after user reported buffs still "looked like generic particle
        -- blobs" even for the pass-1-fixed skills): root cause was that DoBuff played the real
        -- buffVfxRuid as a single one-shot flash via PlayEffect, then immediately layered the flat-
        -- colored generic BasicParticle aura on top for the whole buff duration - so the correct clip
        -- was on screen for a fraction of a second and the generic shape is what the player actually
        -- watched for the next 5-8s. Fixed in PlayerSkillComponent.DoBuff: buffVfxRuid (when present)
        -- is now looped + attached to the caster for the full buff duration via
        -- _EffectService:PlayEffectAttached(..., isLoop=true) and completely REPLACES the generic
        -- aura (auraType/auraColor kept only as the last-resort fallback for skills with no clip at
        -- all). Also closed 2 of the 3 remaining gaps with same-function substitute clips from the
        -- SAME official MSW/MapleStory resource index (there is no tool access to browse another
        -- creator's specific published World, e.g. a "메이플랜드"-style world, nor any path to import
        -- assets from unrelated third-party commercial games - only this shared official resource
        -- library is available, and it IS sourced from real MapleStory art):
        --   focus      -> "포커스 온"(skill/322.img/skill/3220021)'s "repeat" clip - same class
        --                 lineage (Bowman), same function (accuracy buff), real "포커스" has zero
        --                 indexed resource_pack under any phrasing tried.
        --   nimblebody -> "헤이스트"/Haste(skill/000.img/skill/0008000)'s "affected" clip - not
        --                 thief-specific, but mechanically identical (movement speed buff) and one of
        --                 the most recognizable classic Maple buff visuals; real "님블 바디" has zero
        --                 indexed resource_pack under any phrasing tried.
        --
        -- 2026-08-13 audit (pass 3, user asked for a substitute for ironbody too): found "파워 가드"/
        -- Power Guard (skill/800033.img/skill/80003317) - a warrior/knight physical-toughness self-buff,
        -- same class lineage and same "harden the body" flavor as Iron Body - its "affected" clip
        -- (the sustained while-buffed overlay, not the one-shot "effect" cast clip) is now ironbody's
        -- buffVfxRuid. Real "아이언 바디" itself still has zero indexed resource_pack beyond icon
        -- sprites under any phrasing tried across all 3 passes.
        -- 2026-08-13 audit (pass 4, 2026-08-16): user re-flagged "name vs effect mismatch" + "unfinished
        -- effects" project-wide. Re-verified all 10 RUIDs' actual pack membership (not just the `names`
        -- field, which is null/unreliable on individual animationclips - confirmed via
        -- `findPacksContaining` that luckyseven/magicguard/knucklebooster's clips genuinely belong to
        -- their own named skill's pack despite a misleading AI-generated `names` tag on luckyseven's).
        -- Found a strictly better substitute for ironbody: "아이언 월"(skill/800032.img/skill/80003293) -
        -- shares the literal "아이언"(Iron) root with "아이언 바디" (unlike "파워 가드", no name overlap
        -- at all) and has both `affected`/`effect` clips. Swapped. Re-searched focus/nimblebody's real
        -- packs ("명중치/회피치 확률 증가", "님블 핑거") once more with fresh query angles - both still
        -- have zero animationclip elements (icon sprites only), confirming pass-2's substitutes
        -- (포커스 온 / 헤이스트) remain the best available option. **Also completed ironbody/magicguard's
        -- previously fully-inert (`testableEffect="none"`) mechanics** - see PlayerSkillComponent.DoBuff:
        -- ironbody now grants a real temporary MaxHp boost (`testableEffect="maxhp"`), magicguard now
        -- makes skills MP-free for its duration (`testableEffect="mpfree"`) - both deliberately
        -- reinterpreted (not literal defense/damage-to-MP conversion) since that would still require the
        -- not-yet-built monster-attacks-player pipeline to be observable at all; these substitutes are
        -- fully observable today with existing systems (HP bar, MP bar).
        -- 2026-08-16 (same session): user asked to check for missing 1차 액티브 스킬 (Adventurer tier-1
        -- active skills) against the real classic MapleStory kit. Verified per job via msw-search +
        -- pack-membership checks: 마법사(Magic Claw)/궁수(Arrow Blow)/해적(Dash) genuinely have only 1
        -- offensive/active 1차 skill each in real MapleStory (2nd job is where they branch out) - nothing
        -- missing there. 검사(Warrior) was missing its real 2nd 1차 active, **슬래시 블러스트**(Slash
        -- Blast, `skill/100.img/skill/1001005` - same genuine 1차 Warrior family as ironbody's real
        -- "아이언 바디" pack) - added as `wide=true` melee_single (see PlayerSkillComponent.DoMeleeSingle
        -- - reuses the same AttackFast-over-a-shape pipeline with a much wider box, since AttackFast
        -- already resolves against every overlapping entity, not just one - no new `kind` needed for a
        -- frontal AoE). 도적(Thief)'s other 1차 actives (Disorder/Dark Sight) are non-damage utility
        -- (enemy debuff / self-stealth) with no current consumer (no monster-attacks-player pipeline, no
        -- enemy stat fields to debuff) - left out for now rather than adding another day-one-inert skill;
        -- revisit once that pipeline exists.
        -- desc: 스킬창 툴팁에 그대로 노출되는 플레이어용 효과 설명. 실제로 수치가 적용되는 부분은
        -- 구체적 수치를 명시하고(예: "명중률 +30"), inertNote로 비활성 처리된 부분은 설명에서 뺐다 -
        -- 발동 안 하는 효과를 설명에 적어두면 플레이어에게 거짓 정보가 된다.
        --
        -- 2026-08-25 밸런스 조정 (유저 리포트 "특정 스킬들이 다른 스킬들보다 굉장히 약하다" +
        -- "약한 직업도 던전을 깰 수 있게 밸런싱해달라"): 공격 스킬 DPS 계수(coef/cooldown)를 비교한
        -- 결과 dash(해적 1차 공격 슬롯)가 유일하게 coef=0(데미지 없음, 순수 이동)이었다 - 해적을
        -- 뽑으면 액티브 스킬로는 평타밖에 못 넣는 구조적 결함. dash에 실제 돌진 판정 데미지(coef=1.4,
        -- 근접 skill 중 가장 높은 계수 - "몸으로 부딪히는" 대시 특성상 사거리가 짧고 재사용도
        -- 4초라 근접 최고계수를 줘도 DPS 계수(1.4/4.0=0.35)는 여전히 powerstrike(0.6)보다 낮음)를
        -- 추가(PlayerSkillComponent.DoDash). luckyseven도 DPS 계수가 가장 낮았던 편(0.429)이라
        -- coef 0.5->0.6으로 소폭 상향(다단히트 특성상 체감 딜레이가 있어 완전히 맞추진 않음).
        local defs = {
            -- impactDelay (2026-09-06, M2 Phase A) - VFX 타이밍 딜레이. 키 입력 즉시 스윙 모션은
            -- 시작되지만(PlayerSkillComponent.PlaySkillMotion) 실제 판정은 이 값만큼 늦춰서 스윙의
            -- 타격 프레임과 데미지 적용 시점을 맞춘다(PlayerSkillComponent.UseSkillSlot 참고). 값은
            -- 각 스킬 모션의 체감 스윙 속도에 맞춘 추정치 - 실제 애니메이션 프레임 데이터를 정밀
            -- 측정한 것은 아니며, 실플레이 피드백에 따라 조정 예정.
            powerstrike = { id = "powerstrike", tier = 1, name = "파워 스트라이크", job = "검사", kind = "melee_single", coef = 1.8, cooldown = 3.0, mpCost = 8, impactDelay = 0.15, hitVfxRuid = "dad03b3a528348bf98295b01edd621a4", desc = "전방의 적을 강하게 내리쳐 평타의 180% 피해를 입힙니다." },
            slashblast = { id = "slashblast", tier = 1, name = "슬래시 블러스트", job = "검사", kind = "melee_single", coef = 1.0, wide = true, cooldown = 4.0, mpCost = 10, impactDelay = 0.2, hitVfxRuid = "3ebd5d6967394c2589408f69c2bc5c54", desc = "전방의 넓은 범위를 베어 그 안의 모든 적에게 평타의 100% 피해를 입힙니다." },
            -- 아이언 바디 (2026-08-19 전 스킬 이펙트 일괄 재검증 - 이번엔 GIF를 프레임 단위로 직접
            -- 열어서 확인): 이전 buffVfxRuid("1838b57c...", "파워 가드" affected 클립)는 실제로는
            -- 12프레임 중 겨우 3프레임에만 내용이 있고 그마저도 거의 흰색에 가까운 연한 살구색이라
            -- 사실상 화면에 아무것도 안 보였다(직전 세션이 "주황/금색 방패 문양"이라고 재검증
            -- 결론냈던 게 실제로는 오판 - 이름/팩만 보고 판단, 프레임을 직접 열어보지 않았던 것으로
            -- 추정). "바디 오브 스틸"(Body of Steel, skill/40001.img/skill/400011066)의 effect
            -- 클립으로 교체 - 실제로 열어보니 선명한 하늘색 스타버스트로 "몸이 단단해진다"는 버프
            -- 컨셉에 합리적으로 맞고 눈에도 잘 띈다. 실제 "아이언 바디" 팩(skill/100.img/
            -- skill/1000003)은 여전히 아이콘만 있고 애니메이션클립 없음(재확인).
            ironbody = { id = "ironbody", tier = 1, name = "아이언 바디", job = "검사", kind = "buff", duration = 5.0, testableEffect = "maxhp", maxHpBonusPercent = 0.3, cooldown = 15.0, mpCost = 15, auraType = "Aura", auraColor = Color(0.75, 0.75, 0.82, 0.9), buffVfxRuid = "af55fcb744604ac5aa3b8f9955b30c72", desc = "일정 시간 최대 체력이 30% 증가합니다." },
            -- 매직 클로 (2026-08-17 유저 재지적 후 수정): 기존 projectileVfxRuid("2a0d72e8...")는
            -- "매직 클로"라는 이름의 리소스 팩(skill/800032.img/skill/80003294)에서 가져왔지만,
            -- 유저가 실제 플레이 경험상 "이펙트 자체가 원래 매직 클로와 다르다"고 지적 - 실제로
            -- 그 팩의 effect 클립은 파란 초승달 모양이라 실제 매직 클로(초록/노랑 계열, 발톱으로
            -- 할퀸 3갈래 자국)와 색·형태 둘 다 불일치했다(같은 "매직 클로"라는 한글명을 쓰는 리소스가
            -- 이 라이브러리에 최소 2개 존재 - 800032/800016 두 팩 다 검증했으나 둘 다 아이콘·이펙트가
            -- 실제 스킬과 어긋남, 원본 매직클로 리소스가 인덱스에 없는 것으로 판단). 유저와 함께
            -- 형태가 일치하는 대체 리소스를 탐색 - "魔力爪"(skill/1200.img/skill/12001003, 한글명
            -- 미태깅)의 hit/0 요소가 실제 발톱으로 할퀸 3갈래 자국 형태와 정확히 일치(유저 확인),
            -- 다만 원본 색이 주황 계열이라 유저 요청대로 SpriteRendererComponent.Color 틴트로
            -- 초록/노랑 계열로 보정(PlayerSkillComponent.DoRanged가 projectileTintColor를 적용).
            magicclaw = { id = "magicclaw", tier = 1, name = "매직 클로", job = "마법사", kind = "ranged_single", coef = 1.3, magic = true, cooldown = 2.5, mpCost = 10, projectileVfxRuid = "64096440f11f4c9b9c96df38e0e3852e", projectileTintColor = Color(0.55, 1.0, 0.25, 1.0), desc = "전방으로 마법 발톱을 날려 평타의 130% 마법 피해를 입힙니다." },
            -- 매직 가드 (2026-08-17 이미지 재검증 후 수정): "매직 가드" 팩(skill/1200.img/
            -- skill/12001001)의 effect 클립을 실제로 열어보니 방패/보호막이 아니라 지팡이를 든
            -- 작은 요정 캐릭터 그림이었다(팩 이름은 정확히 일치했지만 내용물이 무관함 - 아이언
            -- 바디와 같은 부류의 오판). "마법 보호막" 계열로 재검색해 실제 눈으로 확인한 "워터
            -- 실드"(Water Shield, skill/2311.img/skill/23111005)의 repeat 클립으로 교체 - 연한
            -- 파란 반투명 보호막 구체로 매직 가드의 실제 컨셉(마법 방어막)에 훨씬 부합.
            magicguard = { id = "magicguard", tier = 1, name = "매직 가드", job = "마법사", kind = "buff", duration = 8.0, testableEffect = "mpfree", cooldown = 20.0, mpCost = 20, auraType = "Enchant", auraColor = Color(0.4, 0.6, 1.0, 0.9), buffVfxRuid = "53e7aaf6b3f1401ba1909ebeebd337ab", desc = "일정 시간 스킬 MP 소모가 없어집니다." },
            -- 애로우 블로우 (2026-08-16 사용위치 검증 후 수정): 실제 클래식 메이플스토리의 애로우
            -- 블로우는 궁수 계열 중 유일하게 활로 직접 근접 타격하는 스킬 - 원거리 발사도, 관통도
            -- 아니다. 기존 ranged_pierce(투사체 관통)는 실제 스킬 성격과 반대였음 - melee_single로
            -- 교체(다른 근접 단일히트 스킬과 동일 파이프라인, PlayerSkillComponent.DoMeleeSingle).
            -- hitVfxRuid는 실제 "애로우 블로우" 팩(skill/300.img/skill/3001004, findPacksContaining로
            -- 재확인)의 hit/0 요소 - 기존 "ball"(투사체용 화살 그래픽)은 더 이상 맞지 않아 교체.
            arrowblow = { id = "arrowblow", tier = 1, name = "애로우 블로우", job = "궁수", kind = "melee_single", coef = 1.2, cooldown = 2.0, mpCost = 8, impactDelay = 0.12, hitVfxRuid = "84a473e004a34fdea67aa74a87dc75c6", desc = "활로 전방의 적을 강하게 가격해 평타의 120% 피해를 입힙니다." },
            focus = { id = "focus", tier = 1, name = "포커스", job = "궁수", kind = "buff", duration = 6.0, testableEffect = "accuracy", accuracyBonus = 30, inertNote = "회피 상승 부분은 비활성(몬스터 공격 파이프라인 없음)", cooldown = 12.0, mpCost = 12, auraType = "SpinField", auraColor = Color(1.0, 0.85, 0.3, 0.9), buffVfxRuid = "0d68db29ec2046f4bb2a64e6f03b745b", desc = "일정 시간 명중률이 30 증가합니다." },
            -- 럭키 세븐 (2026-08-17 메이플랜드/클래식 메이플스토리 자료 조사 후 확인 - 의도적 타협):
            -- 실제로는 도적 1차가 아니라 어쌔신(2차) 스킬 - 실제 도적 1차 스킬은 님블 바디/디스오더
            -- (아래 disable)/다크사이트 3종뿐이고 데미지 액티브 자체가 없다(WebSearch로 다수 문서
            -- 교차 확인, 너클 부스터도 동일 사유로 2차/인파이터 스킬). 이 프로젝트 설계(전직마다
            -- 액티브1+버프1)가 도적/해적의 실제 1차 킷과 안 맞아서 생긴 구조적 문제 - 유저에게 보고
            -- 후 "대체할 진짜 1차 액티브가 없으니 의도적 타협으로 유지" 결정(2026-08-17). 향후 2차
            -- 스킬 풀이 생기면 그쪽으로 옮기는 것이 정석. "디스에이블"(disable, 아래)이라는 이름도
            -- 실제 명칭 "디스오더"의 오기로 보이나 효과 자체(회피/명중 감소)는 일치해 그대로 둠.
            -- 럭키 세븐 (2026-08-16 사용위치 검증 후 수정): 실제 클래식 메이플스토리의 럭키 세븐은
            -- 단검을 짧게 투척하는 스킬 - 기존 구현은 검사류 근접 스윙과 동일한 즉발 박스 판정이라
            -- "던지는" 느낌이 전혀 없었음. PlayerSkillComponent.DoMultiHit을 짧은 사거리를 실제로
            -- 날아가는 투사체 3발 연속 투척으로 교체(간격 0.09초).
            -- 2026-08-19 재수정 1차: 이전 projectileVfxRuid("0ae88fa4...")는 pack 소속상으로는 럭키
            -- 세븐의 effect 요소가 맞았지만, 실제로는 캐스팅 이펙트용 animationclip이고 첫 프레임이
            -- 4x4px(사실상 안 보임) - 럭키 세븐 팩 자체의 icon 요소(십자로 겹친 표창 아이콘)로 1차
            -- 교체했으나, 유저가 "스킬 UI 아이콘이 그대로 날아가면 안 되지, 메이플스토리에 실존하는
            -- 표창으로 바꿔달라"고 재차 지적(정당한 지적 - 스킬창 아이콘을 필드에 그대로 띄우는 건
            -- 어색함).
            -- 2026-08-19 재수정 2차: 실제 "표창 던지기"라는 이름의 스킬 팩
            -- (skill/800016.img/skill/80001657)의 ball 요소로 최종 교체 - 다른 근거리 스킬들의 ball
            -- 요소(애로우 블로우의 화살 등)와 동일하게 "날아가는 투사체 전용" 스프라이트로 태깅된
            -- 항목이라 용도가 정확히 맞고, 실제 다운로드해 확인 - 4갈래 회색 표창이 잔상을 남기며
            -- 회전하는 모습(39x24px, 프레임 크기 문제 없음).
            luckyseven = { id = "luckyseven", tier = 1, name = "럭키 세븐", job = "도적", kind = "multi_hit", coef = 0.6, hits = 3, cooldown = 3.5, mpCost = 12, projectileVfxRuid = "0af95ff09be14c389c1854f03c575e2e", desc = "단검을 3연속으로 투척해 각 타격마다 평타의 60% 피해를 입힙니다." },
            disable = { id = "disable", tier = 1, name = "디스에이블", job = "도적", kind = "debuff", evasionReduction = 40, duration = 8.0, cooldown = 10.0, mpCost = 10, hitVfxRuid = "06df52ffae254cf98de250a0071c86c5", desc = "전방의 적 하나를 약화시켜 일정 시간 회피가 크게 감소합니다." },
            darksight = { id = "darksight", tier = 1, name = "다크 사이트", job = "도적", kind = "buff", duration = 5.0, testableEffect = "critchance", critChanceBonus = 0.25, cooldown = 12.0, mpCost = 10, buffVfxRuid = "abdf05be0b3e4146a6271c4ee1f3b1b1", desc = "일정 시간 그림자에 숨어 치명타 확률이 25% 증가합니다." },
