            -- 2026-10-02 유저 엑셀 신규 - "메이플 용사"(job="전체", 5직업 공통 11번째 4차 버프).
            -- "모든 스탯 +5%"는 이 게임의 파생 스탯 구조상 하나의 단일 수치로 직결되는 채널이 없어,
            -- 기존 atkbonus 채널(같은 패턴의 atkbonus 스킬들과 동일)로 근사 구현 - 실제 올스탯
            -- 시스템은 추후 폴리싱 패스 대상.
            -- 2026-10-02 VFX 패스 - 실제 "메이플 용사"(skill/112.img/skill/1121000) 팩의
            -- affected 루프 오라 - 이름 완전 일치, 클래식 메이플의 상징적 스킬답게 검증 완료.
            maplewarrior = { id = "maplewarrior", sfxRuid = "a270e3388573455cbd6ae5bfb67a44a0", tier = 4, name = "메이플 용사", job = "전체", kind = "buff", duration = 10.0, testableEffect = "atkbonus", atkBonusPercent = 0.05, cooldown = 25.0, mpCost = 20, buffVfxRuid = "e4d47514c92a435eb9aa12068c14d127", auraType = "Aura", auraColor = Color(1.0, 0.85, 0.3, 0.95), iconRuid = "4ee998dcaff742ffad5bda5688be5e11", desc = "일정 시간 모든 스탯이 5% 증가합니다. (현재는 공격력 증가로 근사 구현)" },
        }
        return defs[skillId]
    end


    method boolean IsBuffSkill(string skillId)
        -- Category split used by PlayerSkillComponent's tier-slot grants (Docs/랜덤 플래닛 전체 기획서.md
        -- §04 "버프풀 3택1 + 공격풀 3택1 동시 진행"). Every non-"buff" kind counts as the attack category.
        -- 2026-10-02 유저 엑셀 지시 - "소환수 계열 스킬은 버프 스킬 칸에 해당하게 할거야": kind="summon"
        -- (옥토퍼스/서포트 옥토퍼스)도 버프 카테고리로 취급한다.
        local def = self:GetSkillDef(skillId)
        return def ~= nil and (def.kind == "buff" or def.kind == "summon")
    end

    method table GetSkillsByCategory(string category, integer tier)
        -- category = "buff" | "attack". tier = 1|2|3|4 (M2 Phase D, 2026-09-06 - each tier now has
        -- its own 5-per-category pool; without this filter a tier-2+ roll would draw from every
        -- tier's ids at once, letting a 5-level character get handed a tier-4 flagship skill).
        -- Returns ids in catalog order (stable, not shuffled).
        local ids = self:GetAllSkillIds()
        local result = {}
        for _, id in ipairs(ids) do
            local def = self:GetSkillDef(id)
            local isBuff = self:IsBuffSkill(id)
            if def.tier == tier and ((category == "buff" and isBuff) or (category == "attack" and not isBuff)) then
                table.insert(result, id)
            end
        end
        return result
    end

    method table RollSkillChoices(string category, integer tier, table excludeIds)
        -- Up to 3 unowned ids of the given category+tier, shuffled. Returns fewer than 3 once the
        -- tier's category pool (5 ids per tier) is mostly exhausted by earlier grants - callers must
        -- handle a short list (see PlayerSkillComponent.GrantTierSkills).
        local pool = self:GetSkillsByCategory(category, tier)
        local excludeLookup = {}
        for _, id in ipairs(excludeIds) do
            excludeLookup[id] = true
        end
        local candidates = {}
        for _, id in ipairs(pool) do
            if not excludeLookup[id] then
                table.insert(candidates, id)
            end
        end
        for i = #candidates, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            local tmp = candidates[i]
            candidates[i] = candidates[j]
            candidates[j] = tmp
        end
        local result = {}
        for i = 1, math.min(3, #candidates) do
            table.insert(result, candidates[i])
        end
        return result
    end

end
