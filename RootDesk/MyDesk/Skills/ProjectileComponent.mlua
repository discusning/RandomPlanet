@Component
script ProjectileComponent extends Component
    -- Body-less straight projectile, shared by any ranged 1차 스킬 (매직 클로/애로우 블로우 등).
    -- Follows msw-combat-system/references/projectile.md's "straight projectile, no homing"
    -- variant, generalized to scan every script.Monster on the map (not one fixed EnemyModelId)
    -- since this project doesn't restrict enemies to a single model.

    property number Speed = 10
    property number Damage = 10
    property number MaxLifetime = 2
    property number HitRadius = 0.4
    property boolean Pierce = false
    -- 2026-10-02 유저 엑셀("어벤져" - 관통 최대 4명) - 기존 Pierce(무제한 관통)와 별개로 "N명까지만
    -- 관통"을 표현하는 캡. 0이면 기존 동작과 완전히 동일(무제한) - Pierce=true일 때만 의미가 있다.
    property integer MaxPierceTargets = 0
    -- 2026-10-02 유저 엑셀("피어싱" - 궁수 4차, "뚫고 지날수록 더 강해지는 화살") - 관통할 때마다
    -- 데미지가 누적 증가. 0이면 기존 동작과 동일(스케일링 없음). BaseDamage는 Fire 시점의 원본
    -- 데미지를 보존(ProjectileAttackComponent.Damage는 매 히트마다 덮어써지므로 별도 보관 필요).
    property number DamageScalingPerHit = 0
    -- 2026-10-02 유저 엑셀 수치 대조(피어싱 "140→200→260→320%") - BaseDamage에 coef가 이미 곱해진
    -- 채로 들어오면 아래 스케일링 공식이 coef 위에 다시 곱해져 복리처럼 불어난다(실측 140/224/308/392%
    -- - 320% 불일치). coef를 별도 보관해 "원본 평타 * (coef + scalingPerHit*(hit-1))" 형태로 고친다.
    @HideFromInspector property number DamageCoef = 1
    @HideFromInspector property number BaseDamage = 0
    @HideFromInspector property number DirX = 0
    @HideFromInspector property number DirY = 0

    method void OnBeginPlay()
        self._T.fired = false
        self._T.lifetime = 0
        self._T.hitList = {}
        self._T.hitCount = 0
        self._T.monsters = {}
        self._T.monsterScanTimer = 0
    end

    @ExecSpace("ServerOnly")
    method void Fire(number dirX, number dirY)
        self.DirX = dirX
        self.DirY = dirY
        self._T.fired = true
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self._T.fired then return end
        -- 2026-09-22 타임 스톱 - 이능/스킬 선택 중엔 비행/수명 카운트가 멈춘다(그 자리에 정지).
        if _TimeStopLogic.Stopped then return end

        self._T.lifetime = self._T.lifetime + delta
        if self._T.lifetime >= self.MaxLifetime then
            self.Entity:Destroy()
            return
        end

        self.Entity.TransformComponent:Translate(self.DirX * self.Speed * delta, self.DirY * self.Speed * delta)

        -- Rescans the map's monster list at most ~7x/sec instead of every frame -
        -- GetChildComponentsByTypeName(recursive=true) walks the whole map entity tree, and doing
        -- that 60x/sec per in-flight projectile was the single most expensive loop in the project
        -- (cost multiplies with concurrent projectiles - e.g. luckyseven's 3 hits or rapid arrowblow
        -- taps). A projectile lives at most MaxLifetime seconds (2s default) and monsters aren't
        -- currently spawned mid-flight, so a briefly-stale list is a non-issue in practice.
        self._T.monsterScanTimer = self._T.monsterScanTimer - delta
        if self._T.monsterScanTimer <= 0 then
            self._T.monsterScanTimer = 0.15
            local map = self.Entity.CurrentMap
            if isvalid(map) then
                self._T.monsters = map:GetChildComponentsByTypeName("script.Monster", true) or {}
            end
        end

        local myPos = self.Entity.TransformComponent.WorldPosition
        for _, monsterComp in ipairs(self._T.monsters) do
            local monsterEntity = monsterComp.Entity
            if isvalid(monsterEntity) and (not self._T.hitList[monsterEntity.Name]) then
                local mPos = monsterEntity.TransformComponent.WorldPosition
                local dx = mPos.x - myPos.x
                local dy = mPos.y - myPos.y
                if math.sqrt(dx * dx + dy * dy) <= self.HitRadius then
                    -- Mark this monster hit BEFORE calling OnHit - without this, a Pierce
                    -- projectile (e.g. arrowblow) re-hits the same still-overlapping monster on
                    -- every subsequent OnUpdate tick until it moves out of HitRadius, instead of
                    -- the intended "one hit per pierced target" (confirmed via direct repro: a
                    -- slow-moving target took 2 hits worth of damage from a single cast before
                    -- this fix). A non-Pierce shot never reached this bug since it destroys itself
                    -- (and returns) on its first hit.
                    self._T.hitList[monsterEntity.Name] = true
                    self._T.hitCount = self._T.hitCount + 1
                    if self.DamageScalingPerHit > 0 then
                        local projAttack = self.Entity:GetComponent("script.ProjectileAttackComponent")
                        if isvalid(projAttack) then
                            projAttack.Damage = math.floor(self.BaseDamage * (self.DamageCoef + self.DamageScalingPerHit * (self._T.hitCount - 1)))
                        end
                    end
                    self:OnHit()
                    if not self.Pierce then return end
                    -- 관통 캡 도달 - 더 뚫지 않고 여기서 소멸(OnHit이 Pierce=true일 땐 Destroy를
                    -- 호출하지 않으므로 캡 체크는 여기서 별도로 수행).
                    if self.MaxPierceTargets > 0 and self._T.hitCount >= self.MaxPierceTargets then
                        self.Entity:Destroy()
                        return
                    end
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnHit()
        -- Do not subtract HP directly - AttackFrom keeps the real HitEvent pipeline (damage skin,
        -- hit effect, IsHitTarget) working. See msw-combat-system/SKILL.md §2-3.
        local pos = self.Entity.TransformComponent.WorldPosition
        local ac = self.Entity.AttackComponent
        if isvalid(ac) then
            ac:AttackFrom(Vector2(self.HitRadius * 2, self.HitRadius * 2), Vector2(pos.x, pos.y), "skill.projectile", CollisionGroups.Monster)
        end
        if not self.Pierce then
            self.Entity:Destroy()
        end
    end

end
