@Component
script SkillUIController extends Component
    -- Skill window ("스킬창") - classic MapleStory-style 1~4차 탭 브라우저. Each tab shows the
    -- player's buff/attack slot for that job-promotion tier (Docs/랜덤 플래닛 전체 기획서.md §04) -
    -- owned skills render as clickable icons, an un-promoted tier shows a locked placeholder.
    -- 2026-09-16 유저 요청("메이플처럼 보유 스킬 전부를 원하는 키에 자유 배치") - 보유 스킬은 이제
    -- PlayerSkillComponent.RefillEquipSlots()가 자동으로 8개 슬롯에 전부 배치하므로 "장착" 개념이
    -- 사라졌다.
    -- 2026-09-17 유저 요청("1~4차 중 공격 스킬은 1~2개만 쓰고 싶은데 끼고 빼는 기능이 없다") -
    -- 키 세팅 창과 스킬창을 동시에 띄울 수 없어 드래그로 장착/해제를 못 하던 문제를, 스킬창 자체에
    -- "사용/해제" 토글 버튼(btnEquipEntity 재사용)을 넣어 해결. 보유는 하되 해제한 스킬은 8슬롯에
    -- 채워지지 않고 물리 키도 소모하지 않는다(PlayerSkillComponent.RequestSetSkillEquipped). Data
    -- source: GetOwnedSkillIds() + GetEquippedFlag(tier, category).
    property Entity btnClose = "62504d0c-23e7-439a-ad42-96b9f58f202c"
    property Entity dragHandle = "f4765af0-287e-4d2b-b094-f816fce08c62"
    property UITransformComponent cardTransform = "a576b606-5c3b-4ffa-bcd8-7c202695b3b0"
    property Entity btnOpenKeySetting = "685991ef-4874-411e-a50b-ec0b2832fa61"

    property Entity tab1Entity = "d96fa85b-d206-48f1-9f19-ed7acb1c1655"
    property SpriteGUIRendererComponent tab1Sprite = "d96fa85b-d206-48f1-9f19-ed7acb1c1655"
    property Entity tab2Entity = "0ecf6b4e-bd97-4aa5-82f0-5f35404a3b96"
    property SpriteGUIRendererComponent tab2Sprite = "0ecf6b4e-bd97-4aa5-82f0-5f35404a3b96"
    property Entity tab3Entity = "c3ceebc6-83ee-4f1a-a179-44cdb8564349"
    property SpriteGUIRendererComponent tab3Sprite = "c3ceebc6-83ee-4f1a-a179-44cdb8564349"
    property Entity tab4Entity = "a15fed7f-c529-4f15-9073-911d3d3ed562"
    property SpriteGUIRendererComponent tab4Sprite = "a15fed7f-c529-4f15-9073-911d3d3ed562"

    property Entity buffSlotEntity = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property SpriteGUIRendererComponent buffSlotSprite = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property TextGUIRendererComponent buffSlotText = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property Entity atkSlotEntity = "645a1913-7a41-4039-90f6-8579993eed77"
    property SpriteGUIRendererComponent atkSlotSprite = "645a1913-7a41-4039-90f6-8579993eed77"
    property TextGUIRendererComponent atkSlotText = "645a1913-7a41-4039-90f6-8579993eed77"
    property Entity lockedTextEntity = "b7db6eda-9ff2-43e0-a58a-6f083e755a35"

    property TextGUIRendererComponent detailName = "07091083-bb39-4e65-a64e-fd7823ac1f3c"
    property TextGUIRendererComponent detailInfo = "90769341-fb8c-4c26-aa10-b792bd92d1cf"
    property TextGUIRendererComponent detailDesc = "90db5fcc-3968-42a1-a74b-b4d5d70ede4f"
    property Entity btnEquipEntity = "9b709512-46db-4ef4-a093-aece0af5c4de"
    property Entity equippedBadgeEntity = "42859164-04c7-4658-b61e-2724b16871b1"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.handlers = {}
        self._T.selectedTier = 1
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""

        local hClose = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        table.insert(self._T.handlers, { entity = self.btnClose, eventType = ButtonClickEvent, eventHandler = hClose })
        if isvalid(self.dragHandle) then
            local hDrag = self.dragHandle:ConnectEvent(UITouchDragEvent, self.OnWindowDrag)
            table.insert(self._T.handlers, { entity = self.dragHandle, eventType = UITouchDragEvent, eventHandler = hDrag })
        end
        if isvalid(self.btnOpenKeySetting) then
            local hKS = self.btnOpenKeySetting:ConnectEvent(ButtonClickEvent, self.OnOpenKeySettingClicked)
            table.insert(self._T.handlers, { entity = self.btnOpenKeySetting, eventType = ButtonClickEvent, eventHandler = hKS })
        end

        local tabEntities = { self.tab1Entity, self.tab2Entity, self.tab3Entity, self.tab4Entity }
        for i, tabEntity in ipairs(tabEntities) do
            local tierIndex = i
            local h = tabEntity:ConnectEvent(ButtonClickEvent, function() self:OnTabClicked(tierIndex) end)
            table.insert(self._T.handlers, { entity = tabEntity, eventType = ButtonClickEvent, eventHandler = h })
        end

        local hBuff = self.buffSlotEntity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked("buff") end)
        table.insert(self._T.handlers, { entity = self.buffSlotEntity, eventType = ButtonClickEvent, eventHandler = hBuff })
        local hAtk = self.atkSlotEntity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked("attack") end)
        table.insert(self._T.handlers, { entity = self.atkSlotEntity, eventType = ButtonClickEvent, eventHandler = hAtk })
        -- 2026-09-17 - btnEquipEntity를 "장착" 단발성 버튼에서 "사용/해제" 토글 버튼으로 재사용.
        if isvalid(self.btnEquipEntity) then
            local hEquip = self.btnEquipEntity:ConnectEvent(ButtonClickEvent, self.OnToggleEquipClicked)
            table.insert(self._T.handlers, { entity = self.btnEquipEntity, eventType = ButtonClickEvent, eventHandler = hEquip })
        end

        -- Hover preview (메이플식 툴팁) - separate from the click-to-select/equip flow below. Only
        -- overwrites the 3 text fields, never btnEquipEntity/equippedBadgeEntity, so it can never
        -- race with a click's Refresh() and leave the equip button pointing at the wrong skill.
        local hBuffHover = self.buffSlotEntity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnSlotHoverStateChanged("buff", event) end)
        table.insert(self._T.handlers, { entity = self.buffSlotEntity, eventType = ButtonStateChangeEvent, eventHandler = hBuffHover })
        local hAtkHover = self.atkSlotEntity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnSlotHoverStateChanged("attack", event) end)
        table.insert(self._T.handlers, { entity = self.atkSlotEntity, eventType = ButtonStateChangeEvent, eventHandler = hAtkHover })

        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnWindowDrag(UITouchDragEvent event)
        if not isvalid(self.cardTransform) then return end
        local pos = self.cardTransform.anchoredPosition
        self.cardTransform.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnOpenKeySettingClicked()
        self:Hide()
        local keySettingGroup = _EntityService:GetEntityByPath("/ui/KeySettingGroup")
        if not isvalid(keySettingGroup) then
            return
        end
        local popup = keySettingGroup:GetComponent("script.KeyBindingPopupController")
        if isvalid(popup) then
            popup:Open()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnTabClicked(integer tier)
        self._T.selectedTier = tier
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnSlotClicked(string category)
        local owned = self:GetOwnedForCurrentTier()
        local skillId = owned[category]
        if skillId == nil or skillId == "" then return end
        self._T.selectedSkillId = skillId
        self._T.selectedCategory = category
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnSlotHoverStateChanged(string category, ButtonStateChangeEvent event)
        -- 메이플식 마우스오버 툴팁 - 클릭해서 선택하지 않아도 스킬 위에 마우스를 올리면 바로 상세
        -- 설명이 보인다. PreviewSkill은 텍스트 3줄만 갈아치우고 장착 버튼/뱃지는 절대 건드리지
        -- 않으므로, 클릭 직후 버튼 상태가 다시 Hover로 튀어도 장착 흐름과 절대 충돌하지 않는다.
        if event.state == ButtonState.Hover then
            local owned = self:GetOwnedForCurrentTier()
            local skillId = owned[category]
            if skillId ~= nil and skillId ~= "" then
                self:PreviewSkill(skillId)
            end
        elseif event.state == ButtonState.Normal then
            self:RefreshDetailText()
        end
    end

    @ExecSpace("ClientOnly")
    method void PreviewSkill(string skillId)
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then return end
        self.detailName.Text = def.name .. " (" .. def.job .. ")"
        self.detailInfo.Text = self:KindLabel(def.kind) .. "  ·  재사용 " .. tostring(def.cooldown) .. "초  ·  MP " .. tostring(def.mpCost)
        self.detailDesc.Text = def.desc or ""
    end

    @ExecSpace("ClientOnly")
    method void Show()
        self.Entity.Enable = true
        self._T.selectedTier = 1
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        if self.Entity.Enable then
            self:Hide()
        else
            self:Show()
        end
    end

    method table GetOwnedForCurrentTier()
        -- { buff = id|nil, attack = id|nil } for self._T.selectedTier, read fresh from the local
        -- player's PlayerSkillComponent every call (cheap - 8 string compares).
        local result = { buff = nil, attack = nil }
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return result end
        local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
        if not isvalid(skillComp) then return result end
        local owned = skillComp:GetOwnedSkillIds()
        for _, entry in ipairs(owned) do
            if entry.tier == self._T.selectedTier then
                result[entry.category] = entry.id
            end
        end
        return result
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        local tabEntities = { self.tab1Entity, self.tab2Entity, self.tab3Entity, self.tab4Entity }
        local tabSprites = { self.tab1Sprite, self.tab2Sprite, self.tab3Sprite, self.tab4Sprite }
        for i, sprite in ipairs(tabSprites) do
            if i == self._T.selectedTier then
                sprite.Color = Color(0.85, 0.65, 0.18, 0.95)
            else
                sprite.Color = Color(0.29, 0.18, 0.09, 0.9)
            end
        end

        local owned = self:GetOwnedForCurrentTier()
        local tierUnlocked = (owned.buff ~= nil) or (owned.attack ~= nil)
        self.lockedTextEntity.Enable = not tierUnlocked
        self.buffSlotEntity.Enable = tierUnlocked
        self.atkSlotEntity.Enable = tierUnlocked

        if tierUnlocked then
            local localPlayer = _UserService.LocalPlayer
            local buffEquipped = true
            local atkEquipped = true
            if isvalid(localPlayer) then
                local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
                if isvalid(skillComp) then
                    buffEquipped = skillComp:GetEquippedFlag(self._T.selectedTier, "buff")
                    atkEquipped = skillComp:GetEquippedFlag(self._T.selectedTier, "attack")
                end
            end
            self:RefreshSlot(self.buffSlotSprite, self.buffSlotText, owned.buff, buffEquipped)
            self:RefreshSlot(self.atkSlotSprite, self.atkSlotText, owned.attack, atkEquipped)
        end

        self:RefreshDetailText()
    end

    @ExecSpace("ClientOnly")
    method void RefreshDetailText()
        -- Renders the click-selected skill (self._T.selectedSkillId) into the detail panel.
        -- Separate from PreviewSkill (hover) so a hover-exit can restore this exact state without
        -- re-deriving tab/slot data. equippedBadgeEntity stays hidden - btnEquipEntity now doubles as
        -- both the "사용/해제" toggle AND the key-placement readout (same rect, one widget instead of
        -- two overlapping ones), since a skill can only show one of "해제하기 (배치: X)" / "사용하기"
        -- at a time anyway.
        self.equippedBadgeEntity.Enable = false

        if self._T.selectedSkillId == "" then
            self.detailName.Text = "스킬을 선택하세요"
            self.detailInfo.Text = ""
            self.detailDesc.Text = ""
            self.btnEquipEntity.Enable = false
            return
        end

        local def = _SkillCatalog:GetSkillDef(self._T.selectedSkillId)
        if def == nil then
            self.detailName.Text = "알 수 없는 스킬"
            self.detailInfo.Text = ""
            self.detailDesc.Text = ""
            self.btnEquipEntity.Enable = false
            return
        end

        self.detailName.Text = def.name .. " (" .. def.job .. ")"
        self.detailInfo.Text = self:KindLabel(def.kind) .. "  ·  재사용 " .. tostring(def.cooldown) .. "초  ·  MP " .. tostring(def.mpCost)
        self.detailDesc.Text = def.desc or ""

        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then
            self.btnEquipEntity.Enable = false
            return
        end
        local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
        if not isvalid(skillComp) then
            self.btnEquipEntity.Enable = false
            return
        end
        local isEquipped = skillComp:GetEquippedFlag(self._T.selectedTier, self._T.selectedCategory)
        self.btnEquipEntity.Enable = true
        self:ApplyEquipButtonLabel(isEquipped)
    end

    method void ApplyEquipButtonLabel(boolean isEquipped)
        -- btnEquipEntity의 라벨을 그리는 공용 헬퍼 - RefreshDetailText(서버 진실값 기준)와
        -- OnToggleEquipClicked(낙관적 즉시 반영, 아래 참고) 둘 다 이 헬퍼 하나로 라벨을 맞춘다.
        local btnText = self.btnEquipEntity.TextGUIRendererComponent
        if not isvalid(btnText) then return end
        if isEquipped then
            local slot = self:SlotForTierCategory(self._T.selectedTier, self._T.selectedCategory)
            local symbol = "-"
            if slot ~= nil then
                local actionName = (slot == 1) and "Skill" or ("Skill" .. tostring(slot))
                symbol = _KeyBindingLogic:GetSymbol(_KeyBindingLogic:GetKeyForAction(actionName))
            end
            btnText.Text = "해제 (" .. symbol .. ")"
        else
            btnText.Text = "사용하기"
        end
    end

    @ExecSpace("ClientOnly")
    method void OnToggleEquipClicked()
        -- 2026-09-17 유저 요청 - 보유 스킬 중 원하는 것만 골라 8슬롯에 채우고 나머지는 빼둘 수 있게
        -- 하는 "사용/해제" 토글. 서버에 요청을 보냄과 동시에 버튼 라벨/슬롯 아이콘 밝기를 요청한
        -- 새 상태로 바로 반영한다(낙관적 갱신) - self:Refresh()를 호출하면 아직 서버 @Sync가 도착하기
        -- 전이라 옛 값을 다시 읽어와 방금 바꾼 라벨을 그대로 덮어써버리므로, 여기서는 Refresh() 대신
        -- 이미 아는 새 상태값으로 필요한 위젯만 직접 갱신한다.
        if self._T.selectedSkillId == "" then return end
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end
        local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
        if not isvalid(skillComp) then return end
        local newState = not skillComp:GetEquippedFlag(self._T.selectedTier, self._T.selectedCategory)
        skillComp:RequestSetSkillEquipped(self._T.selectedCategory, self._T.selectedTier, newState)

        self:ApplyEquipButtonLabel(newState)
        local def = _SkillCatalog:GetSkillDef(self._T.selectedSkillId)
        if def ~= nil then
            local sprite = (self._T.selectedCategory == "buff") and self.buffSlotSprite or self.atkSlotSprite
            local kindColor = self:ColorForKind(def.kind)
            if newState then
                sprite.Color = kindColor
            else
                sprite.Color = Color(kindColor.r * 0.45, kindColor.g * 0.45, kindColor.b * 0.45, 0.55)
            end
        end
        log("SkillUI: OnToggleEquipClicked tier=" .. self._T.selectedTier .. " category=" .. self._T.selectedCategory .. " ->" .. tostring(newState))
    end

    method any SlotForTierCategory(integer tier, string category)
        -- RefillEquipSlots()가 채우는 순서(Atk1,Buff1,Atk2,Buff2,...,Atk4,Buff4 -> 슬롯1~8)와
        -- 동일한 매핑을 클라이언트에서 재계산 - 서버 왕복 없이 "배치: [키]" 표시에 쓴다.
        if category == "attack" then
            return (tier - 1) * 2 + 1
        elseif category == "buff" then
            return (tier - 1) * 2 + 2
        end
        return nil
    end

    method void RefreshSlot(SpriteGUIRendererComponent sprite, TextGUIRendererComponent text, string skillId, boolean isEquipped)
        if skillId == nil or skillId == "" then
            text.Text = "-"
            sprite.Color = Color(0.3, 0.26, 0.2, 0.4)
            return
        end
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then
            text.Text = "?"
            sprite.Color = Color(0.3, 0.26, 0.2, 0.4)
            return
        end
        -- 2026-09-10 QA(유저 피드백 "어색한 UI 찾아서 고쳐줘") - 예전엔 이름을 2글자로 잘라
        -- "매직"/"디스"처럼 불완전한 단어로 보이게 표시했음(원래 각각 "매직 가드"/"디스에이블") -
        -- 슬롯이 120x120으로 충분히 크고 텍스트가 폭에 맞춰 자동 줄바꿈되므로 전체 이름을 그대로 표시.
        text.Text = def.name
        local kindColor = self:ColorForKind(def.kind)
        if isEquipped then
            sprite.Color = kindColor
        else
            -- 2026-09-17 - 보유는 하지만 "해제" 상태인 스킬은 색을 반쯤 죽여 한눈에 구분되게 한다.
            sprite.Color = Color(kindColor.r * 0.45, kindColor.g * 0.45, kindColor.b * 0.45, 0.55)
        end
    end

    method Color ColorForKind(string kind)
        if kind == "melee_single" or kind == "multi_hit" then
            return Color(0.75, 0.16, 0.14, 0.85)
        elseif kind == "ranged_single" or kind == "ranged_pierce" then
            return Color(0.14, 0.34, 0.75, 0.85)
        elseif kind == "buff" then
            return Color(0.2, 0.62, 0.32, 0.85)
        elseif kind == "dash" then
            return Color(0.85, 0.52, 0.14, 0.85)
        end
        return Color(0.5, 0.5, 0.5, 0.85)
    end

    method string KindLabel(string kind)
        if kind == "melee_single" then return "근접"
        elseif kind == "ranged_single" then return "원거리"
        elseif kind == "ranged_pierce" then return "관통"
        elseif kind == "multi_hit" then return "다단히트"
        elseif kind == "dash" then return "대시"
        elseif kind == "buff" then return "버프"
        end
        return kind
    end
end
