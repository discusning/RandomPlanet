@Component
script SkillUIController extends Component
    -- Skill window ("스킬창") - classic MapleStory-style 1~4차 탭 브라우저. Each tab shows the
    -- player's buff/attack slot for that job-promotion tier (Docs/랜덤 플래닛 전체 기획서.md §04) -
    -- owned skills render as clickable icons, an un-promoted tier shows a locked placeholder.
    -- 2026-09-22 유저 요청("스킬 8개를 강제로 키에 박아두지 말고 필요한 스킬만 키 설정에 넣고 뺄 수
    -- 있게" - Docs/RandomPlanet-KeyRework-Plan.md) - 예전의 자동 8슬롯 배치와 "사용/해제" 토글은
    -- 폐지됐다. 스킬은 보유만 하고 미배정으로 시작하며, 이 창의 스킬 슬롯을 키 설정 창의 키로 끌어다
    -- 놓아 배정한다(키 설정 창은 이 창과 동시에 열린다). 여기서는 각 스킬이 어느 키에 배정됐는지
    -- (KeyBindingLogic.GetKeyForSkill)만 보여준다. Data source: GetOwnedSkillIds().
    property Entity btnClose = "62504d0c-23e7-439a-ad42-96b9f58f202c"
    property Entity dragHandle = "f4765af0-287e-4d2b-b094-f816fce08c62"
    property UITransformComponent cardTransform = "a576b606-5c3b-4ffa-bcd8-7c202695b3b0"
    property Entity btnOpenKeySetting = "685991ef-4874-411e-a50b-ec0b2832fa61"

    property Entity tab1Entity = "d96fa85b-d206-48f1-9f19-ed7acb1c1655"
    property SpriteGUIRendererComponent tab1Sprite = "d96fa85b-d206-48f1-9f19-ed7acb1c1655"
    property Entity tab2Entity = "0ecf6b4e-bd97-4aa5-82f0-5f35404a3b96"
    property SpriteGUIRendererComponent tab2Sprite = "0ecf6b4e-bd97-4aa5-82f0-5f35404a3b96"
    property Entity tab3Entity = "c3ceebc6-83ee-4f1a-a179-44cdb8564349"
    property SpriteGUIRendererComponent tab3Sprite = "c3ceebc6-83ee-4f1a-a179-44cdb8564349"
    property Entity tab4Entity = "a15fed7f-c529-4f15-9073-911d3d3ed562"
    property SpriteGUIRendererComponent tab4Sprite = "a15fed7f-c529-4f15-9073-911d3d3ed562"

    property Entity buffSlotEntity = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property SpriteGUIRendererComponent buffSlotSprite = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property TextGUIRendererComponent buffSlotText = "3b36d0b0-1b02-46a5-920f-02ba186c46fd"
    property Entity atkSlotEntity = "645a1913-7a41-4039-90f6-8579993eed77"
    property SpriteGUIRendererComponent atkSlotSprite = "645a1913-7a41-4039-90f6-8579993eed77"
    property TextGUIRendererComponent atkSlotText = "645a1913-7a41-4039-90f6-8579993eed77"
    property Entity lockedTextEntity = "b7db6eda-9ff2-43e0-a58a-6f083e755a35"

    property TextGUIRendererComponent detailName = "07091083-bb39-4e65-a64e-fd7823ac1f3c"
    property TextGUIRendererComponent detailInfo = "90769341-fb8c-4c26-aa10-b792bd92d1cf"
    property TextGUIRendererComponent detailDesc = "90db5fcc-3968-42a1-a74b-b4d5d70ede4f"
    property Entity btnEquipEntity = "9b709512-46db-4ef4-a093-aece0af5c4de"
    property Entity equippedBadgeEntity = "42859164-04c7-4658-b61e-2724b16871b1"

    -- 2026-10-03 마스터 캐릭터 전용 다중 스킬 리스트 - GetOwnedForCurrentTier()는 카테고리당 1개만
    -- 보여주는 구조적 한계가 있어(동일 틱어/카테고리에 여러 스킬을 "보유"하는 마스터 캐릭터는 마지막
    -- 항목만 보임) 마스터일 때만 buffSlotEntity/atkSlotEntity 자리에 스크롤 리스트를 보여준다. 리스트는
    -- InventoryUIController 방식(고정 슬롯 풀 + Enable 토글)을 따른다 - 틱어당 카테고리 최대 보유 수
    -- (현재 최대 8개, 1틱어 공격)보다 넉넉한 10개 슬롯.
    property Entity masterBuffListEntity = "f9469661-f6ac-4cd8-a588-47f6eca78500"
    property Entity masterBuffItem1 = "c1c57fb4-661c-4930-867a-659e868b25a7"
    property Entity masterBuffItem2 = "5d62e919-c8a4-4ce9-a60d-8a46cf94252a"
    property Entity masterBuffItem3 = "13102c82-38ad-4610-906a-3829fe6b8351"
    property Entity masterBuffItem4 = "59a518d3-6fd0-4c40-b7e2-ac85e8ec1e82"
    property Entity masterBuffItem5 = "77cdd593-766a-4eab-86b2-14cec1bd8a5a"
    property Entity masterBuffItem6 = "416c2a1f-5811-414f-85e0-1c3e09c67f73"
    property Entity masterBuffItem7 = "b373694a-81b3-4b54-95c6-ea9363653b34"
    property Entity masterBuffItem8 = "215681a7-4afa-4bef-a429-0c95de93ce8e"
    property Entity masterBuffItem9 = "7aa253d9-b0e5-466b-af31-50f516016b00"
    property Entity masterBuffItem10 = "88350f66-e789-455c-98dc-43066fe9d77b"
    property Entity masterBuffPrevEntity = "1de2a6ec-8f0f-4ee7-9607-91b632e3504a"
    property Entity masterBuffNextEntity = "11219119-0c59-43bc-8547-7914a8cc1ad6"
    property Entity masterAtkPrevEntity = "a21bef32-7538-4285-814d-e82949b52b22"
    property Entity masterAtkNextEntity = "f7ce479e-24f5-4105-86f8-e78b5a32f2e0"
    property Entity masterAtkListEntity = "1bbeda53-eda5-49d5-88d4-6ad09483828e"
    property Entity masterAtkItem1 = "a96d9b60-a79f-4eeb-b1d0-94e00837a32c"
    property Entity masterAtkItem2 = "666563bd-8cf9-462a-a474-fc97864db83b"
    property Entity masterAtkItem3 = "0ea5bd51-4162-4ba2-b7e4-83c80785ce40"
    property Entity masterAtkItem4 = "905c7498-465e-4f63-bac7-eb9235a83a2e"
    property Entity masterAtkItem5 = "0b51346e-6c11-4373-b763-38fe462d82b2"
    property Entity masterAtkItem6 = "114e0f60-bf9e-4625-b13d-7d267da61985"
    property Entity masterAtkItem7 = "e5bd79ef-7ad1-4686-b82c-b07035a464dc"
    property Entity masterAtkItem8 = "0cfecdba-cdd8-476e-ad5e-0d9fa9cc04a9"
    property Entity masterAtkItem9 = "09fcf54b-ad17-423e-a46f-b8dbcf0e9341"
    property Entity masterAtkItem10 = "61cae0bd-2aa9-48a0-b82c-cb1e46e29ab2"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.handlers = {}
        self._T.selectedTier = 1
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""

        local hClose = self.btnClose:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        table.insert(self._T.handlers, { entity = self.btnClose, eventType = ButtonClickEvent, eventHandler = hClose })
        if isvalid(self.dragHandle) then
            local hDrag = self.dragHandle:ConnectEvent(UITouchDragEvent, self.OnWindowDrag)
            table.insert(self._T.handlers, { entity = self.dragHandle, eventType = UITouchDragEvent, eventHandler = hDrag })
        end
        if isvalid(self.btnOpenKeySetting) then
            local hKS = self.btnOpenKeySetting:ConnectEvent(ButtonClickEvent, self.OnOpenKeySettingClicked)
            table.insert(self._T.handlers, { entity = self.btnOpenKeySetting, eventType = ButtonClickEvent, eventHandler = hKS })
        end

        local tabEntities = { self.tab1Entity, self.tab2Entity, self.tab3Entity, self.tab4Entity }
        for i, tabEntity in ipairs(tabEntities) do
            local tierIndex = i
            local h = tabEntity:ConnectEvent(ButtonClickEvent, function() self:OnTabClicked(tierIndex) end)
            table.insert(self._T.handlers, { entity = tabEntity, eventType = ButtonClickEvent, eventHandler = h })
        end

        local hBuff = self.buffSlotEntity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked("buff") end)
        table.insert(self._T.handlers, { entity = self.buffSlotEntity, eventType = ButtonClickEvent, eventHandler = hBuff })
        local hAtk = self.atkSlotEntity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked("attack") end)
        table.insert(self._T.handlers, { entity = self.atkSlotEntity, eventType = ButtonClickEvent, eventHandler = hAtk })
        -- 2026-09-22 - btnEquipEntity는 "사용/해제" 토글이 아니라 "배정된 키" 표시 + 키 설정 창 열기
        -- 버튼으로 재사용(스킬은 이 창의 슬롯을 키 설정 창의 키로 끌어다 놓아 배정한다).
        if isvalid(self.btnEquipEntity) then
            local hEquip = self.btnEquipEntity:ConnectEvent(ButtonClickEvent, self.OnKeyInfoClicked)
            table.insert(self._T.handlers, { entity = self.btnEquipEntity, eventType = ButtonClickEvent, eventHandler = hEquip })
        end

        -- Hover preview (메이플식 툴팁) - separate from the click-to-select/equip flow below. Only
        -- overwrites the 3 text fields, never btnEquipEntity/equippedBadgeEntity, so it can never
        -- race with a click's Refresh() and leave the equip button pointing at the wrong skill.
        local hBuffHover = self.buffSlotEntity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnSlotHoverStateChanged("buff", event) end)
        table.insert(self._T.handlers, { entity = self.buffSlotEntity, eventType = ButtonStateChangeEvent, eventHandler = hBuffHover })
        local hAtkHover = self.atkSlotEntity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnSlotHoverStateChanged("attack", event) end)
        table.insert(self._T.handlers, { entity = self.atkSlotEntity, eventType = ButtonStateChangeEvent, eventHandler = hAtkHover })

        -- 2026-09-22 키 설정 개편 - 이 창의 스킬 슬롯을 키 설정 창의 키로 끌어다 놓아 배정한다
        -- (HotkeyDragLogic이 고스트/드롭 판정을 담당). 슬롯 엔티티에는 UITouchReceiveComponent가 있어야
        -- 드래그 이벤트가 온다(ui/SkillGroup.ui의 BuffSlot/AtkSlot에 추가됨).
        local dragSlots = { { category = "buff", entity = self.buffSlotEntity }, { category = "attack", entity = self.atkSlotEntity } }
        for _, ds in ipairs(dragSlots) do
            local capturedCategory = ds.category
            local hBegin = ds.entity:ConnectEvent(UITouchBeginDragEvent, function(event) self:OnSlotBeginDrag(capturedCategory, event) end)
            table.insert(self._T.handlers, { entity = ds.entity, eventType = UITouchBeginDragEvent, eventHandler = hBegin })
            local hMove = ds.entity:ConnectEvent(UITouchDragEvent, self.OnSlotDrag)
            table.insert(self._T.handlers, { entity = ds.entity, eventType = UITouchDragEvent, eventHandler = hMove })
            local hEnd = ds.entity:ConnectEvent(UITouchEndDragEvent, self.OnSlotEndDrag)
            table.insert(self._T.handlers, { entity = ds.entity, eventType = UITouchEndDragEvent, eventHandler = hEnd })
        end

        -- 2026-10-03 마스터 캐릭터 다중 스킬 리스트 - 고정 10슬롯 풀을 한 번만 와이어링(클릭/호버/드래그는
        -- buffSlotEntity/atkSlotEntity와 완전히 같은 핸들러(OnSlotDrag/OnSlotEndDrag)를 재사용하고,
        -- 클릭/호버만 인덱스 기반 전용 핸들러를 쓴다 - RefreshMasterList가 매번 새로 만들지 않고
        -- Enable/아이콘/텍스트만 갈아치우므로 OnEndPlay에서 self._T.handlers 하나로 전부 해제된다.
        self._T.masterBuffItems = {
            self.masterBuffItem1, self.masterBuffItem2, self.masterBuffItem3, self.masterBuffItem4, self.masterBuffItem5,
            self.masterBuffItem6, self.masterBuffItem7, self.masterBuffItem8, self.masterBuffItem9, self.masterBuffItem10,
        }
        self._T.masterAtkItems = {
            self.masterAtkItem1, self.masterAtkItem2, self.masterAtkItem3, self.masterAtkItem4, self.masterAtkItem5,
            self.masterAtkItem6, self.masterAtkItem7, self.masterAtkItem8, self.masterAtkItem9, self.masterAtkItem10,
        }
        self._T.masterBuffIcons = {}
        self._T.masterAtkIcons = {}
        for i, item in ipairs(self._T.masterBuffItems) do
            self._T.masterBuffIcons[i] = item:GetChildByName("Icon")
        end
        for i, item in ipairs(self._T.masterAtkItems) do
            self._T.masterAtkIcons[i] = item:GetChildByName("Icon")
        end
        self._T.masterBuffIds = {}
        self._T.masterAtkIds = {}
        self:WireMasterListItems(self._T.masterBuffItems, "buff")
        self:WireMasterListItems(self._T.masterAtkItems, "attack")
        self._T.masterBuffPage = 1
        self._T.masterAtkPage = 1
        local pagingButtons = {
            { entity = self.masterBuffPrevEntity, fn = function() self:OnMasterPage("buff", -1) end },
            { entity = self.masterBuffNextEntity, fn = function() self:OnMasterPage("buff", 1) end },
            { entity = self.masterAtkPrevEntity, fn = function() self:OnMasterPage("attack", -1) end },
            { entity = self.masterAtkNextEntity, fn = function() self:OnMasterPage("attack", 1) end },
        }
        for _, pb in ipairs(pagingButtons) do
            if isvalid(pb.entity) then
                local h = pb.entity:ConnectEvent(ButtonClickEvent, pb.fn)
                table.insert(self._T.handlers, { entity = pb.entity, eventType = ButtonClickEvent, eventHandler = h })
            end
        end

        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void WireMasterListItems(table items, string category)
        -- 고정 슬롯 풀 전체에 클릭/호버/드래그를 한 번만 연결한다(InventoryUIController의 고정 슬롯
        -- 패턴과 동일) - 슬롯이 어떤 스킬을 보여줄지는 RefreshMasterList가 매 Refresh마다 갈아치운다.
        for i, item in ipairs(items) do
            local capturedIndex = i
            local hClick = item:ConnectEvent(ButtonClickEvent, function() self:OnMasterItemClicked(category, capturedIndex) end)
            table.insert(self._T.handlers, { entity = item, eventType = ButtonClickEvent, eventHandler = hClick })
            local hHover = item:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnMasterItemHoverStateChanged(category, capturedIndex, event) end)
            table.insert(self._T.handlers, { entity = item, eventType = ButtonStateChangeEvent, eventHandler = hHover })
            local hBegin = item:ConnectEvent(UITouchBeginDragEvent, function(event) self:OnMasterItemBeginDrag(category, capturedIndex, event) end)
            table.insert(self._T.handlers, { entity = item, eventType = UITouchBeginDragEvent, eventHandler = hBegin })
            local hMove = item:ConnectEvent(UITouchDragEvent, self.OnSlotDrag)
            table.insert(self._T.handlers, { entity = item, eventType = UITouchDragEvent, eventHandler = hMove })
            local hEnd = item:ConnectEvent(UITouchEndDragEvent, self.OnSlotEndDrag)
            table.insert(self._T.handlers, { entity = item, eventType = UITouchEndDragEvent, eventHandler = hEnd })
        end
    end

    @ExecSpace("ClientOnly")
    method void OnMasterItemClicked(string category, integer index)
        local ids = (category == "buff") and self._T.masterBuffIds or self._T.masterAtkIds
        local skillId = ids[index]
        if skillId == nil or skillId == "" then return end
        self._T.selectedSkillId = skillId
        self._T.selectedCategory = category
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnMasterItemHoverStateChanged(string category, integer index, ButtonStateChangeEvent event)
        local ids = (category == "buff") and self._T.masterBuffIds or self._T.masterAtkIds
        local skillId = ids[index]
        if skillId == nil or skillId == "" then return end
        if event.state == ButtonState.Hover then
            self:PreviewSkill(skillId)
        elseif event.state == ButtonState.Normal then
            self:RefreshDetailText()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnMasterItemBeginDrag(string category, integer index, UITouchBeginDragEvent event)
        -- buffSlotEntity/atkSlotEntity의 OnSlotBeginDrag와 완전히 같은 드래그 시작 로직 - 카테고리당
        -- 1개만 찾던 GetOwnedForCurrentTier() 대신 리스트의 인덱스별 스킬 id를 직접 쓴다는 점만 다르다.
        local ids = (category == "buff") and self._T.masterBuffIds or self._T.masterAtkIds
        local skillId = ids[index]
        if skillId == nil or skillId == "" then return end
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then return end
        _HotkeyDragLogic:BeginDrag({ kind = "skill", id = skillId }, def.name, self:ColorForKind(def.kind), event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    method void OnSlotBeginDrag(string category, UITouchBeginDragEvent event)
        -- 보유 스킬 슬롯을 끌기 시작 - 미보유(빈) 슬롯이면 무시. 고스트에 스킬 이름/종류색을 보여준다.
        local skillId = self:GetOwnedForCurrentTier()[category]
        if skillId == nil or skillId == "" then return end
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then return end
        _HotkeyDragLogic:BeginDrag({ kind = "skill", id = skillId }, def.name, self:ColorForKind(def.kind), event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    method void OnSlotDrag(UITouchDragEvent event)
        _HotkeyDragLogic:MoveDrag(event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    method void OnSlotEndDrag(UITouchEndDragEvent event)
        -- 키 위에 놓아 배정에 성공하면 이 창의 "배정된 키" 표시(슬롯 색/[키]/버튼 라벨)를 갱신한다.
        local assigned = _HotkeyDragLogic:EndDrag(event.TouchPoint)
        if assigned then
            self:Refresh()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnWindowDrag(UITouchDragEvent event)
        if not isvalid(self.cardTransform) then return end
        local pos = self.cardTransform.anchoredPosition
        self.cardTransform.anchoredPosition = Vector2(pos.x + event.TouchDelta.x, pos.y + event.TouchDelta.y)
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        self:Hide()
    end

    @ExecSpace("ClientOnly")
    method void OnOpenKeySettingClicked()
        -- 2026-09-22 - 키 설정 창은 이 창과 동시에 열려야(스킬을 이 창에서 키 설정 창으로 끌어다
        -- 놓는다) 하므로 더 이상 이 창을 닫지 않는다.
        local keySettingGroup = _EntityService:GetEntityByPath("/ui/KeySettingGroup")
        if not isvalid(keySettingGroup) then
            return
        end
        local popup = keySettingGroup:GetComponent("script.KeyBindingPopupController")
        if isvalid(popup) then
            popup:Open()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnKeyInfoClicked()
        -- 선택한 스킬의 "키 배정하기/해제" 토글(클릭 한 번으로 하는 보조 경로 - 정밀한 위치 지정이 필요하면
        -- 슬롯을 키 설정 창의 키로 끌어다 놓는다). 미배정이면 비어 있는 핫바 키(Q W E R A S D F ...)
        -- 중 첫 키에 배정하고, 이미 배정돼 있으면 해제한다. 스킬을 고르지 않았으면 키 설정 창을 연다.
        local skillId = self._T.selectedSkillId
        if skillId == nil or skillId == "" then
            self:OnOpenKeySettingClicked()
            return
        end
        local slot = _KeyBindingLogic:GetSlotOfSkill(skillId)
        if slot ~= nil then
            _KeyBindingLogic:RemoveSkillFromSlot(slot)
        else
            local key = _KeyBindingLogic:FindFreeHotkey()
            if key == nil then
                log("SkillUI: OnKeyInfoClicked no free hotkey")
                return
            end
            _KeyBindingLogic:AssignSkillToKey(skillId, key)
        end
        self:Refresh()
        -- 키 설정 창이 열려 있으면 아이콘도 바로 갱신.
        local keyGroup = _EntityService:GetEntityByPath("/ui/KeySettingGroup")
        if isvalid(keyGroup) then
            local popup = keyGroup:GetComponent("script.KeyBindingPopupController")
            if isvalid(popup) and popup.isOpen then
                popup:RefreshIcons()
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnTabClicked(integer tier)
        self._T.selectedTier = tier
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""
        self._T.masterBuffPage = 1
        self._T.masterAtkPage = 1
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnSlotClicked(string category)
        local owned = self:GetOwnedForCurrentTier()
        local skillId = owned[category]
        if skillId == nil or skillId == "" then return end
        self._T.selectedSkillId = skillId
        self._T.selectedCategory = category
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void OnSlotHoverStateChanged(string category, ButtonStateChangeEvent event)
        -- 메이플식 마우스오버 툴팁 - 클릭해서 선택하지 않아도 스킬 위에 마우스를 올리면 바로 상세
        -- 설명이 보인다. PreviewSkill은 텍스트 3줄만 갈아치우고 장착 버튼/뱃지는 절대 건드리지
        -- 않으므로, 클릭 직후 버튼 상태가 다시 Hover로 튀어도 장착 흐름과 절대 충돌하지 않는다.
        if event.state == ButtonState.Hover then
            local owned = self:GetOwnedForCurrentTier()
            local skillId = owned[category]
            if skillId ~= nil and skillId ~= "" then
                self:PreviewSkill(skillId)
            end
        elseif event.state == ButtonState.Normal then
            self:RefreshDetailText()
        end
    end

    @ExecSpace("ClientOnly")
    method void PreviewSkill(string skillId)
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then return end
        self.detailName.Text = def.name .. " (" .. def.job .. ")"
        self.detailInfo.Text = self:KindLabel(def.kind) .. "  ·  재사용 " .. tostring(def.cooldown) .. "초  ·  MP " .. tostring(def.mpCost)
        self.detailDesc.Text = def.desc or ""
    end

    @ExecSpace("ClientOnly")
    method void Show()
        self.Entity.Enable = true
        self._T.selectedTier = 1
        self._T.selectedSkillId = ""
        self._T.selectedCategory = ""
        self:Refresh()
        -- 키 설정 창이 열려 있으면 그 옆(오른쪽 끝)으로 붙는다.
        _WindowHotkeyLogic:DockCardBesideKeyWindow("/ui/SkillGroup/Card", 480)
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        self.Entity.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        if self.Entity.Enable then
            self:Hide()
        else
            self:Show()
        end
    end

    method table GetOwnedForCurrentTier()
        -- { buff = id|nil, attack = id|nil } for self._T.selectedTier, read fresh from the local
        -- player's PlayerSkillComponent every call (cheap - 8 string compares).
        local result = { buff = nil, attack = nil }
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return result end
        local skillComp = localPlayer:GetComponent("script.PlayerSkillComponent")
        if not isvalid(skillComp) then return result end
        local owned = skillComp:GetOwnedSkillIds()
        for _, entry in ipairs(owned) do
            if entry.tier == self._T.selectedTier then
                result[entry.category] = entry.id
            end
        end
        return result
    end

    method boolean IsLocalPlayerMaster()
        -- 2026-10-03 - 마스터 캐릭터(PlayerStatsComponent.IsMasterCharacter) 여부. 로컬 플레이어가
        -- 없거나 컴포넌트가 없으면 false(일반 플레이어와 동일하게 단일 슬롯 UI를 그린다).
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return false end
        local stats = localPlayer:GetComponent("script.PlayerStatsComponent")
        return isvalid(stats) and stats.IsMasterCharacter
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        local tabEntities = { self.tab1Entity, self.tab2Entity, self.tab3Entity, self.tab4Entity }
        local tabSprites = { self.tab1Sprite, self.tab2Sprite, self.tab3Sprite, self.tab4Sprite }
        for i, sprite in ipairs(tabSprites) do
            if i == self._T.selectedTier then
                sprite.Color = Color(0.85, 0.65, 0.18, 0.95)
            else
                sprite.Color = Color(0.29, 0.18, 0.09, 0.9)
            end
        end

        -- 2026-10-03 마스터 캐릭터 분기 - GetOwnedForCurrentTier()가 카테고리당 1개만 돌려주는 구조적
        -- 한계(SkillUIController 상단 주석 참고)를 마스터 모드에서는 스크롤 리스트로 우회한다. 일반
        -- 플레이어 경로(else)는 기존 단일 슬롯 로직 그대로, 한 글자도 바꾸지 않았다.
        if self:IsLocalPlayerMaster() then
            self.lockedTextEntity.Enable = false
            self.buffSlotEntity.Enable = false
            self.atkSlotEntity.Enable = false
            self:RefreshMasterList("buff", self.masterBuffListEntity, self._T.masterBuffItems, self._T.masterBuffIcons, self._T.masterBuffIds)
            self:RefreshMasterList("attack", self.masterAtkListEntity, self._T.masterAtkItems, self._T.masterAtkIcons, self._T.masterAtkIds)
        else
            self.masterBuffListEntity.Enable = false
            self.masterAtkListEntity.Enable = false

            local owned = self:GetOwnedForCurrentTier()
            local tierUnlocked = (owned.buff ~= nil) or (owned.attack ~= nil)
            self.lockedTextEntity.Enable = not tierUnlocked
            self.buffSlotEntity.Enable = tierUnlocked
            self.atkSlotEntity.Enable = tierUnlocked

            if tierUnlocked then
                self:RefreshSlot(self.buffSlotSprite, self.buffSlotText, owned.buff)
                self:RefreshSlot(self.atkSlotSprite, self.atkSlotText, owned.attack)
            end
        end

        self:RefreshDetailText()
    end

    @ExecSpace("ClientOnly")
    method table GetMasterPool(string category, integer tier)
        -- 클라이언트에서 _SkillCatalog:GetSkillsByCategory를 직접 부르면 조용히 빈 결과가 나와서
        -- (실측: 로그 없이 실패) GetAllSkillIds/GetSkillDef/IsBuffSkill(클라이언트 실측 정상)만으로
        -- 같은 필터를 로컬에서 계산한다.
        local out = {}
        for _, id in ipairs(_SkillCatalog:GetAllSkillIds()) do
            local def = _SkillCatalog:GetSkillDef(id)
            if def ~= nil and def.tier == tier then
                local isBuff = _SkillCatalog:IsBuffSkill(id)
                if (category == "buff" and isBuff) or (category == "attack" and not isBuff) then
                    table.insert(out, id)
                end
            end
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method void OnMasterPage(string category, integer delta)
        -- 마스터 리스트는 한 번에 4개씩(MasterBuffList/MasterAtkList 마스크 높이 156px에 맞춤)만 보여
        -- 주고, 화살표 버튼으로 페이지를 넘긴다. 실제 범위 클램프는 RefreshMasterList가 한다.
        local pageKey = (category == "buff") and "masterBuffPage" or "masterAtkPage"
        self._T[pageKey] = self._T[pageKey] + delta
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void RefreshMasterList(string category, Entity listEntity, table items, table icons, table idsOut)
        -- 고정 10슬롯 풀을 현재 틱어의 카테고리 전체 스킬(_SkillCatalog:GetSkillsByCategory)로 채운다 -
        -- 마스터는 해당 카테고리/틱어의 카탈로그 스킬을 전부 "보유"하므로(PlayerSkillComponent.
        -- GetOwnedSkillIds) 이 쿼리 결과가 곧 마스터의 보유 목록과 같다. 남는 슬롯은 Enable=false.
        for i = #idsOut, 1, -1 do
            table.remove(idsOut, i)
        end

        local all = self:GetMasterPool(category, self._T.selectedTier)
        local pageKey = (category == "buff") and "masterBuffPage" or "masterAtkPage"
        local pageSize = 4
        local pageCount = math.max(1, math.ceil(#all / pageSize))
        if self._T[pageKey] > pageCount then self._T[pageKey] = pageCount end
        if self._T[pageKey] < 1 then self._T[pageKey] = 1 end
        local offset = (self._T[pageKey] - 1) * pageSize
        local ids = {}
        for i = 1, pageSize do
            ids[i] = all[offset + i]
        end
        for i, item in ipairs(items) do
            local skillId = ids[i]
            if i > pageSize or skillId == nil then
                item.Enable = false
            else
                idsOut[i] = skillId
                item.Enable = true
                local def = _SkillCatalog:GetSkillDef(skillId)
                local key = _KeyBindingLogic:GetKeyForSkill(skillId)
                local label = item.TextGUIRendererComponent
                if isvalid(label) and def ~= nil then
                    if key ~= nil then
                        label.Text = def.name .. " [" .. _KeyBindingLogic:GetSymbol(key) .. "]"
                    else
                        label.Text = def.name
                    end
                end

                local icon = icons[i]
                if isvalid(icon) then
                    local iconSprite = icon.SpriteGUIRendererComponent
                    if isvalid(iconSprite) then
                        if def ~= nil and def.iconRuid ~= nil then
                            iconSprite.ImageRUID = DataRef(def.iconRuid)
                        end
                        if key ~= nil then
                            iconSprite.Color = Color(1, 1, 1, 1)
                        else
                            iconSprite.Color = Color(0.55, 0.55, 0.55, 0.6)
                        end
                    end
                end

                local bg = item.SpriteGUIRendererComponent
                if isvalid(bg) then
                    if skillId == self._T.selectedSkillId then
                        bg.Color = Color(0.85, 0.65, 0.18, 0.55)
                    else
                        bg.Color = Color(0.3, 0.26, 0.2, 0.35)
                    end
                end
            end
        end

        listEntity.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void RefreshDetailText()
        -- Renders the click-selected skill (self._T.selectedSkillId) into the detail panel.
        -- Separate from PreviewSkill (hover) so a hover-exit can restore this exact state without
        -- re-deriving tab/slot data. equippedBadgeEntity stays hidden - btnEquipEntity now doubles as
        -- both the "사용/해제" toggle AND the key-placement readout (same rect, one widget instead of
        -- two overlapping ones), since a skill can only show one of "해제하기 (배치: X)" / "사용하기"
        -- at a time anyway.
        self.equippedBadgeEntity.Enable = false

        if self._T.selectedSkillId == "" then
            self.detailName.Text = "스킬을 선택하세요"
            self.detailInfo.Text = ""
            self.detailDesc.Text = ""
            self.btnEquipEntity.Enable = false
            return
        end

        local def = _SkillCatalog:GetSkillDef(self._T.selectedSkillId)
        if def == nil then
            self.detailName.Text = "알 수 없는 스킬"
            self.detailInfo.Text = ""
            self.detailDesc.Text = ""
            self.btnEquipEntity.Enable = false
            return
        end

        self.detailName.Text = def.name .. " (" .. def.job .. ")"
        self.detailInfo.Text = self:KindLabel(def.kind) .. "  ·  재사용 " .. tostring(def.cooldown) .. "초  ·  MP " .. tostring(def.mpCost)
        self.detailDesc.Text = def.desc or ""

        self.btnEquipEntity.Enable = true
        self:ApplyKeyInfoLabel(self._T.selectedSkillId)
    end

    method void ApplyKeyInfoLabel(string skillId)
        -- btnEquipEntity의 라벨 - 이 스킬이 어느 키에 배정돼 있는지(KeyBindingLogic이 진실 소스).
        -- 미배정이면 배정 방법을 안내한다.
        local btnText = self.btnEquipEntity.TextGUIRendererComponent
        if not isvalid(btnText) then return end
        local key = _KeyBindingLogic:GetKeyForSkill(skillId)
        if key == nil then
            btnText.Text = "키 배정하기"
        else
            btnText.Text = "해제 [" .. _KeyBindingLogic:GetSymbol(key) .. "]"
        end
    end

    method void RefreshSlot(SpriteGUIRendererComponent sprite, TextGUIRendererComponent text, string skillId)
        if skillId == nil or skillId == "" then
            text.Text = "-"
            sprite.Color = Color(0.3, 0.26, 0.2, 0.4)
            return
        end
        local def = _SkillCatalog:GetSkillDef(skillId)
        if def == nil then
            text.Text = "?"
            sprite.Color = Color(0.3, 0.26, 0.2, 0.4)
            return
        end
        -- 2026-09-29 QA 수정("스킬 이모티콘이 있어서 가독성이 없음") - 예전엔 실제 아이콘 스프라이트
        -- 없이 종류별 4색 배경(ColorForKind) 위에 스킬 이름 텍스트만 얹어 보여줬다(이모티콘처럼
        -- 보였던 진짜 원인, SkillCatalog.iconRuid 신규 추가 주석 참고). 이제 sprite.ImageRUID에 실제
        -- 스킬 아이콘을 채우고, 종류별 색 구분은 더 이상 필요 없어(아이콘 자체가 스킬을 구분) 흰색
        -- 유지 - 텍스트는 배정된 키만 작게 표시(이름은 아이콘이 대신 전달, 클릭 시 detailName에
        -- 전체 이름이 뜸).
        local key = _KeyBindingLogic:GetKeyForSkill(skillId)
        if def.iconRuid ~= nil then
            sprite.ImageRUID = DataRef(def.iconRuid)
        end
        if key ~= nil then
            text.Text = "[" .. _KeyBindingLogic:GetSymbol(key) .. "]"
            sprite.Color = Color(1, 1, 1, 1)
        else
            text.Text = ""
            sprite.Color = Color(0.55, 0.55, 0.55, 0.6)
        end
    end

    method Color ColorForKind(string kind)
        if kind == "melee_single" or kind == "multi_hit" then
            return Color(0.75, 0.16, 0.14, 0.85)
        elseif kind == "ranged_single" or kind == "ranged_pierce" then
            return Color(0.14, 0.34, 0.75, 0.85)
        elseif kind == "buff" then
            return Color(0.2, 0.62, 0.32, 0.85)
        elseif kind == "dash" then
            return Color(0.85, 0.52, 0.14, 0.85)
        end
        return Color(0.5, 0.5, 0.5, 0.85)
    end

    method string KindLabel(string kind)
        if kind == "melee_single" then return "근접"
        elseif kind == "ranged_single" then return "원거리"
        elseif kind == "ranged_pierce" then return "관통"
        elseif kind == "multi_hit" then return "다단히트"
        elseif kind == "dash" then return "대시"
        elseif kind == "buff" then return "버프"
        end
        return kind
    end
end
