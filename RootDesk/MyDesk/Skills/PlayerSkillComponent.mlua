@Component
script PlayerSkillComponent extends Component
    -- 전직별 스킬 보유·장착 실행기 (Docs/랜덤 플래닛 전체 기획서.md §04 "버프풀 3택1 + 공격풀 3택1
    -- 동시 진행"). 스킬 정의는 SkillCatalog(@Logic)에서 조회, 실제 수치는 PlayerAttack/
    -- PlayerStatsComponent/MovementComponent를 그때그때 읽고 쓴다(각 스탯 공식은 그쪽이 유일한 소유자).
    -- 8개 고정 슬롯(1~4차 x 버프/공격)에 보유 스킬을 저장하고, 그중 하나만 EquippedSkillId로 "Skill"
    -- (Q)키에 실제 장착한다. 캐릭터 생성 시점(1차)은 유저가 카드에서 공격/버프 각각 전체 풀 안에서
    -- 직접 고른 두 스킬을 그대로 받는다(GrantInitialSkill, 2026-08-19 재설계 - 예전엔 하나만 직접
    -- 고르고 반대 카테고리는 안 보이게 자동 배정됐음).
    -- 2026-09-06 (M2 Phase A) - 2/3/4차 전직 티어는 이전엔 GrantTierSkills가 각 카테고리 첫 후보를
    -- 자동 지급했으나(3택1 UI 부재), 실제 3택1 선택 팝업(SkillChoiceUIController/ui/SkillChoiceGroup.ui,
    -- AbilityChoiceUIController와 동일 아키텍처)으로 교체 - 버프 3택1을 먼저 띄우고 확정되면 이어서
    -- 공격 3택1을 띄운다(TierQueued2~4가 여러 티어가 동시에 몰렸을 때의 대기열). 티어 진급마다 유저가
    -- 실제로 버프 1개+공격 1개를 직접 고른다(전체 기획서 §04).

    @Sync property string BuffSkill1 = ""
    @Sync property string BuffSkill2 = ""
    @Sync property string BuffSkill3 = ""
    @Sync property string BuffSkill4 = ""
    @Sync property string AtkSkill1 = ""
    @Sync property string AtkSkill2 = ""
    @Sync property string AtkSkill3 = ""
    @Sync property string AtkSkill4 = ""
    @Sync property string EquippedSkillId = ""
    @Sync @HideFromInspector property number LastUseTime = -999
    -- 2번 스킬 슬롯 (2026-08-25, 유저 요청 - "스킬 관련 세팅이 더 진화된 모습으로... 자유도를
    -- 올리고" - 기존엔 슬롯이 1개(Q)뿐이라 버프와 공격 스킬을 동시에 쓸 수 없었다. Q(EquippedSkillId)는
    -- 항상 공격 카테고리, W(EquippedSkillId2)는 항상 버프 카테고리로 고정해 "공격 키 + 버프 키를
    -- 동시에 장착"하는 실제 메이플스토리식 다중 스킬 키 구조에 가깝게 만든다 - 스킬창에서 장착 버튼을
    -- 누르면 그 스킬의 카테고리에 따라 자동으로 맞는 슬롯에 들어간다(RequestSetEquippedSkill).
    @Sync property string EquippedSkillId2 = ""
    @Sync @HideFromInspector property number LastUseTime2 = -999
    -- 2026-09-06 (M2 Phase A) - 티어 3택1 선택 팝업 상태. SkillChoicePending은 클라이언트가
    -- OnSyncProperty로 감시하는 진입점(true가 되면 SkillChoiceUIController.ShowChoice 호출) -
    -- AbilityChoicePending과 동일 패턴. PendingSkillChoice1~3은 이번 팝업의 후보 3개(카테고리 내
    -- 풀이 3개 미만이면 빈 문자열로 채워짐 - UI가 빈 슬롯을 숨겨야 함).
    @Sync @HideFromInspector property boolean SkillChoicePending = false
    @Sync @HideFromInspector property string PendingSkillCategory = ""
    @Sync @HideFromInspector property integer PendingSkillTier = 0
    @Sync @HideFromInspector property string PendingSkillChoice1 = ""
    @Sync @HideFromInspector property string PendingSkillChoice2 = ""
    @Sync @HideFromInspector property string PendingSkillChoice3 = ""
    -- 여러 레벨이 한 틱에 몰려 티어가 동시에 여러 개 진급할 때의 대기열(이능 팝업의
    -- PendingAbilityChoices 카운터와 달리, 스킬 티어는 각각 서로 다른 후보 풀을 굴려야 해서 단순
    -- 카운터로는 표현 불가 - 티어 번호별 불리언 플래그 3개로 대신한다. 최대 3개뿐이라 충분).
    @HideFromInspector property boolean TierQueued2 = false
    @HideFromInspector property boolean TierQueued3 = false
    @HideFromInspector property boolean TierQueued4 = false
    -- 2026-08-19 유저 요청 - "버프 유지 시간이 전혀 안 보인다". 원인은 이 3개가 @Sync가 아니라서
    -- 클라이언트가 애초에 값을 읽을 수 없었던 것 - PlayerHUDController가 이 값들로 남은 시간을
    -- 표시한다(BuffExpireTime - _UtilLogic.ServerElapsedSeconds, 스킬 쿨다운 표시와 동일 패턴).
    @Sync @HideFromInspector property boolean BuffActive = false
    @Sync @HideFromInspector property number BuffExpireTime = 0
    @Sync @HideFromInspector property string BuffType = ""
    @HideFromInspector property number BuffOriginalValue = 0
    -- 2026-09-08 QA 발견 - 포커스/님블바디의 inertNote("회피 상승 부분은 비활성(몬스터 공격
    -- 파이프라인 없음)")가 이번 세션 초반에 그 파이프라인(PlayerHit.HandleHitEvent의 EvasionPercent
    -- 소비)을 구현하면서 이미 stale해졌다 - testableEffect 슬롯(BuffType/BuffOriginalValue)은
    -- PlayerAttack/MovementComponent 값 하나만 담당하므로, EvasionPercent는 별도 채널로 병행 적용.
    @HideFromInspector property number BuffEvasionBonus = 0
    @HideFromInspector property integer BuffParticleSerial = 0
    @HideFromInspector property boolean BuffUsingSkillVfx = false
    @HideFromInspector property integer ProjectileCount = 0

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self.BuffActive then return end
        if _UtilLogic.ElapsedSeconds < self.BuffExpireTime then return end
        self:RevertBuff()
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Opens the skill-tier 3택1 popup for the local player only (RestrictedPlayerEntitySync
        -- keeps other players' PlayerSkillComponent invisible to this client anyway, but the guard
        -- is kept explicit to match this project's other per-player UI controllers).
        if name ~= "SkillChoicePending" or value ~= true then return end
        if not isvalid(_UserService.LocalPlayer) or self.Entity ~= _UserService.LocalPlayer then return end
        _SkillChoiceUIController:ShowChoice(self.PendingSkillCategory, self.PendingSkillTier, self.PendingSkillChoice1, self.PendingSkillChoice2, self.PendingSkillChoice3)
    end

    @ExecSpace("ServerOnly")
    method void GrantInitialSkill(string atkSkillId, string buffSkillId)
        -- Called once from RequestEnterGame/SwapActiveCharacter with the roster's rolled tier-1
        -- attack/buff skill ids (CharacterSelectStageController.CreateCharacter picks one random id
        -- per category - no manual card picker anymore, see CharacterCardController).
        --
        -- 유저 리포트(2026-08-19) "인게임 스킬창에서도 1차 스킬이 모두 사라져있다" - 원인은 이전 세션에
        -- 만들어진 캐릭터(구 데이터 형식 skillCandidates/skillId만 있고 atkSkillId/buffSkillId가 없는
        -- roster 항목)로 PLAY하면 이 두 파라미터가 둘 다 nil로 넘어오는데, 그 경우 아무것도 배정하지
        -- 않고 그냥 넘어가서 AtkSkill1/BuffSkill1이 빈 채로 남았던 것 - 신규/구 캐릭터 모두 항상 1차에
        -- 공격 1개+버프 1개를 보유하도록, 비어 있으면 해당 카테고리 전체 풀에서 즉석 롤백.
        if atkSkillId ~= nil and atkSkillId ~= "" then
            self.AtkSkill1 = atkSkillId
        elseif self.AtkSkill1 == "" then
            local pool = _SkillCatalog:GetSkillsByCategory("attack", 1)
            if #pool > 0 then self.AtkSkill1 = pool[_UtilLogic:RandomIntegerRange(1, #pool)] end
        end
        if buffSkillId ~= nil and buffSkillId ~= "" then
            self.BuffSkill1 = buffSkillId
        elseif self.BuffSkill1 == "" then
            local pool = _SkillCatalog:GetSkillsByCategory("buff", 1)
            if #pool > 0 then self.BuffSkill1 = pool[_UtilLogic:RandomIntegerRange(1, #pool)] end
        end
        -- 기본 장착은 공격 스킬(Q키가 곧바로 딜을 넣도록) - 공격 쪽이 비어 있으면 버프로 대체.
        if self.AtkSkill1 ~= "" then
            self.EquippedSkillId = self.AtkSkill1
        elseif self.BuffSkill1 ~= "" then
            self.EquippedSkillId = self.BuffSkill1
        end
        -- W(2번 슬롯)에는 버프 스킬을 처음부터 장착 - 공격(Q)과 버프(W)를 동시에 쓸 수 있게(위
        -- EquippedSkillId2 선언부 주석 참고). 매번 스킬창에서 수동으로 바꿔 낄 필요가 없어져서
        -- "약한 직업도 던전을 깰 수 있어야 한다"는 요청에도 실질적으로 기여한다 - 예전엔 버프를
        -- 쓰려면 공격 스킬을 내려야 했다.
        if self.BuffSkill1 ~= "" then
            self.EquippedSkillId2 = self.BuffSkill1
        end
        log("PlayerSkill: GrantInitialSkill atk1=" .. self.AtkSkill1 .. " buff1=" .. self.BuffSkill1)
    end

    @ExecSpace("ServerOnly")
    method void GrantTierSkills(integer tier)
        -- Called from PlayerStatsComponent.GrantSkillTierIfMilestone at levels 5/13/18 (tier 2/3/4).
        -- Queues the tier instead of granting immediately - ProcessSkillTierQueue starts the actual
        -- buff-then-attack 3택1 popup flow once no other choice is currently open.
        if tier < 2 or tier > 4 then return end
        if tier == 2 then self.TierQueued2 = true
        elseif tier == 3 then self.TierQueued3 = true
        else self.TierQueued4 = true
        end
        log("PlayerSkill: GrantTierSkills queued tier=" .. tier)
        self:ProcessSkillTierQueue()
    end

    @ExecSpace("ServerOnly")
    method void ProcessSkillTierQueue()
        -- Starts the next queued tier's buff choice once no choice popup is currently open. Tiers
        -- are processed in ascending order (2 -> 3 -> 4) - a huge XP grant (a real overkill burst,
        -- or a test script) that crosses multiple milestones in one GrantXp call queues all of them,
        -- resolved one at a time.
        --
        -- Guard on PendingSkillTier (~= 0), NOT SkillChoicePending. SkillChoicePending's flip to true
        -- is deliberately deferred by 0.1s in StartTierChoice (same-tick @Sync visibility pattern -
        -- see that method) - within that 0.1s window it's still false even though a choice IS already
        -- in flight. A second GrantTierSkills call landing inside that window (e.g. two milestones hit
        -- in the same synchronous GrantXp loop) would otherwise see SkillChoicePending=false and start
        -- a second StartTierChoice immediately, overwriting the first tier's Pending* fields before its
        -- own deferred flip ever fires - silently discarding that tier's choice entirely (reproduced in
        -- testing: a level 1->13 jump in one GrantXp call skipped tier 2's buff choice this way).
        -- PendingSkillTier is set synchronously at the very top of StartTierChoice (no timer), so it is
        -- a reliable "a choice is in flight" flag even during that window.
        if self.PendingSkillTier ~= 0 then return end
        local nextTier = 0
        if self.TierQueued2 then nextTier = 2
        elseif self.TierQueued3 then nextTier = 3
        elseif self.TierQueued4 then nextTier = 4
        end
        if nextTier == 0 then return end
        if nextTier == 2 then self.TierQueued2 = false
        elseif nextTier == 3 then self.TierQueued3 = false
        else self.TierQueued4 = false
        end
        self:StartTierChoice(nextTier, "buff")
    end

    @ExecSpace("ServerOnly")
    method void StartTierChoice(integer tier, string category)
        -- Rolls up to 3 unowned candidates for the given tier/category and opens the popup. If the
        -- category's pool is already exhausted (0 candidates - possible once M2's full trait/skill
        -- pools shrink via prior grants), skips straight to the next step instead of showing an
        -- empty popup.
        local owned = self:GetOwnedSkillIds()
        local ownedIds = {}
        for _, entry in ipairs(owned) do
            table.insert(ownedIds, entry.id)
        end
        local choices = _SkillCatalog:RollSkillChoices(category, tier, ownedIds)
        if #choices == 0 then
            log("PlayerSkill: StartTierChoice tier=" .. tier .. " category=" .. category .. " pool exhausted, skipping")
            self:AdvanceTierChoice(tier, category)
            return
        end

        self.PendingSkillTier = tier
        self.PendingSkillCategory = category
        self.PendingSkillChoice1 = choices[1] or ""
        self.PendingSkillChoice2 = choices[2] or ""
        self.PendingSkillChoice3 = choices[3] or ""

        -- Deferred flip (같은 틱 @Sync 지연-가시성 패턴 - PlayerStatsComponent.MaybeOpenNextAbilityChoice
        -- 와 동일한 이유) - SkillChoicePending이 true로 도착할 때 형제 필드(PendingSkillChoice1~3 등)가
        -- 이미 이전 sync 틱에 도착해 있도록 한 틱 늦춰서 별도로 보낸다.
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) then return end
            self.SkillChoicePending = true
            log("PlayerSkill: StartTierChoice tier=" .. tier .. " category=" .. category .. " choices=" .. choices[1] .. "/" .. tostring(choices[2]) .. "/" .. tostring(choices[3]))
        end, 0.1)
    end

    @ExecSpace("ServerOnly")
    method void AdvanceTierChoice(integer tier, string category)
        -- Called when a category's pool was empty (StartTierChoice) or after a choice resolves
        -- (RequestResolveSkillChoice). Buff -> attack within the same tier; attack -> tier complete.
        if category == "buff" then
            self:StartTierChoice(tier, "attack")
        else
            self.PendingSkillTier = 0
            self:ProcessSkillTierQueue()
        end
    end

    @ExecSpace("Server")
    method void RequestResolveSkillChoice(string chosenId)
        -- Client-invoked (skill choice popup card click). senderUserId guards against resolving
        -- another player's pending choice. Rejects an id that isn't one of the 3 rolled candidates
        -- (spoofed / stale click) silently, mirroring RequestSetEquippedSkill's rejection pattern.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if not self.SkillChoicePending then return end
        if chosenId ~= self.PendingSkillChoice1 and chosenId ~= self.PendingSkillChoice2 and chosenId ~= self.PendingSkillChoice3 then
            log_warning("PlayerSkill: RequestResolveSkillChoice rejected, not a rolled candidate: " .. tostring(chosenId))
            return
        end
        local tier = self.PendingSkillTier
        local category = self.PendingSkillCategory
        self:SetTierSlot(category, tier, chosenId)
        self.SkillChoicePending = false
        self.PendingSkillCategory = ""
        self.PendingSkillChoice1 = ""
        self.PendingSkillChoice2 = ""
        self.PendingSkillChoice3 = ""
        log("PlayerSkill: RequestResolveSkillChoice tier=" .. tier .. " category=" .. category .. " chosen=" .. chosenId)
        self:AdvanceTierChoice(tier, category)
    end

    @ExecSpace("Server")
    method void RequestRerollSkillChoice()
        -- 큐브마스터 특성 훅(전체 기획서 §2-3 "스킬 선택 시 제시 옵션 1회 재추첨 가능") - 이 특성이
        -- M2 Phase B에서 전체 115종 특성 풀 도입 이후 정상 동작(당시 M1 축소 풀 기준 메모는
        -- 삭제 - 아래 큐브마스터 판정 자체는 그때도 지금도 이 메서드만으로 곧바로 동작).
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if not self.SkillChoicePending then return end
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if not isvalid(statsComp) or (statsComp.Trait ~= "큐브마스터" and statsComp.Trait2 ~= "큐브마스터") then
            log("PlayerSkill: RequestRerollSkillChoice rejected, no 큐브마스터 trait")
            return
        end
        local owned = self:GetOwnedSkillIds()
        local ownedIds = {}
        for _, entry in ipairs(owned) do
            table.insert(ownedIds, entry.id)
        end
        local choices = _SkillCatalog:RollSkillChoices(self.PendingSkillCategory, self.PendingSkillTier, ownedIds)
        if #choices == 0 then return end
        self.PendingSkillChoice1 = choices[1] or ""
        self.PendingSkillChoice2 = choices[2] or ""
        self.PendingSkillChoice3 = choices[3] or ""
        log("PlayerSkill: 큐브마스터 reroll -> " .. choices[1])
    end

    @ExecSpace("ServerOnly")
    method void SetTierSlot(string category, integer tier, string skillId)
        if category == "buff" then
            if tier == 1 then self.BuffSkill1 = skillId
            elseif tier == 2 then self.BuffSkill2 = skillId
            elseif tier == 3 then self.BuffSkill3 = skillId
            elseif tier == 4 then self.BuffSkill4 = skillId
            end
        else
            if tier == 1 then self.AtkSkill1 = skillId
            elseif tier == 2 then self.AtkSkill2 = skillId
            elseif tier == 3 then self.AtkSkill3 = skillId
            elseif tier == 4 then self.AtkSkill4 = skillId
            end
        end
    end

    method table GetOwnedSkillIds()
        -- Returns { {id, tier, category}, ... } for every filled slot - the skill window's data
        -- source (see SkillUIController.Refresh).
        local result = {}
        local buffSlots = { self.BuffSkill1, self.BuffSkill2, self.BuffSkill3, self.BuffSkill4 }
        local atkSlots = { self.AtkSkill1, self.AtkSkill2, self.AtkSkill3, self.AtkSkill4 }
        for i, id in ipairs(buffSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "buff" })
            end
        end
        for i, id in ipairs(atkSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "attack" })
            end
        end
        return result
    end

    @ExecSpace("Server")
    method void RequestSetEquippedSkill(string skillId)
        -- Client-invoked (skill window "장착" button). Only allows equipping an actually-owned
        -- skill - rejects a spoofed/unknown id silently (no error, just a no-op + log).
        -- 2026-08-25: 카테고리로 슬롯 자동 분기 - 버프 스킬은 항상 2번 슬롯(W), 공격/대시 스킬은
        -- 항상 1번 슬롯(Q)에 들어간다(EquippedSkillId2 선언부 주석 참고). 스킬창 UI는 버튼 하나
        -- 그대로 두고 이 서버 로직만으로 "공격+버프 동시 장착"을 구현 - 클라이언트 쪽 변경 불필요.
        local owned = self:GetOwnedSkillIds()
        for _, entry in ipairs(owned) do
            if entry.id == skillId then
                if entry.category == "buff" then
                    self.EquippedSkillId2 = skillId
                else
                    self.EquippedSkillId = skillId
                end
                log("PlayerSkill: equipped " .. skillId .. " slot=" .. (entry.category == "buff" and "2(W)" or "1(Q)"))
                return
            end
        end
        log("PlayerSkill: RequestSetEquippedSkill rejected, not owned: " .. tostring(skillId))
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- Resolves the player's skill keys into UseSkillSlot(). Mirrors PlayerAttack's own
        -- ActionName-filtered handler pattern for the "Attack" key. "Skill"(Q)=slot 1(공격),
        -- "Skill2"(W)=slot 2(버프) - see EquippedSkillId2 선언부 주석 + KeyBindingLogic.BuildRegistry.
        if event.ActionName == "Skill" then
            self:UseSkillSlot(1)
        elseif event.ActionName == "Skill2" then
            self:UseSkillSlot(2)
        end
    end

    @ExecSpace("ServerOnly")
    method void UseSkillSlot(integer slot)
        -- 2026-09-06 (M2 Phase A) - UseSkill()을 슬롯 파라미터화해서 Q(1)/W(2) 양쪽이 쿨다운·MP
        -- 차감·절약가/mpfree 처리 등 동일 로직을 공유하도록 통합(기존엔 슬롯 2가 아예 발동 경로가
        -- 없었음 - As-built 25차 "W키 백엔드 로직 완료"는 장착 라우팅만 완료된 상태였고 실제 키
        -- 입력을 UseSkill로 연결하는 배선이 빠져있었다).
        local equippedId = slot == 2 and self.EquippedSkillId2 or self.EquippedSkillId
        if equippedId == "" then return end
        local def = _SkillCatalog:GetSkillDef(equippedId)
        if def == nil then return end
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        -- 2026-09-10 QA - SkillCooldownReduction(INT 파생 2차 스탯)이 지금까지 계산만 되고 소비처가
        -- 전혀 없던 "죽은 스탯"이었음을 발견(이 세션의 LUK/EvasionPercent, STR/KnockbackResistance에
        -- 이은 세 번째 - RecalculateDerived 주석에 "inert until Phase 3 (no skill system yet)"라고
        -- 명시돼 있었는데, 이미 오래전에 실제 스킬 시스템(Q/W, 쿨다운 포함)이 구축된 뒤에도 계속
        -- 연결되지 않은 채 남아있었다). effectiveCooldown에 반영.
        local cooldownReduction = isvalid(statsComp) and statsComp.SkillCooldownReduction or 0
        local effectiveCooldown = def.cooldown * (1 - cooldownReduction)
        local lastUseTime = slot == 2 and self.LastUseTime2 or self.LastUseTime
        if _UtilLogic.ElapsedSeconds - lastUseTime < effectiveCooldown then
            return
        end
        -- 침묵의 맹세(hb) - basicDesc가 명시한 "MP 소모 스킬 사용 불가"가 지금까지 실제로는
        -- 강제되지 않았다(atk=1.0 보너스만 적용되고 페널티는 "선행 필요"로 미구현 상태였음 -
        -- 2026-09-08 밸런스 점검에서 발견한 무비용 특성). 이 특성은 스킬 자체를 아예 못 쓰게 막는다
        -- (평타 3배로 이미 보상받으므로).
        if isvalid(statsComp) and (statsComp.Trait == "침묵의 맹세" or statsComp.Trait2 == "침묵의 맹세") then
            log("PlayerSkill: 침묵의 맹세 - 스킬 사용 불가")
            return
        end
        -- 절약가(1차 특성) - 스킬 MP 소모 30% 감소(상시, magicguard의 시전형 mpfree와 별개). 순수
        -- 유틸 스탯이라 CP에는 반영하지 않지만(PlayerStatsComponent 참고) 실제로 MP 차감에 반영된다.
        local mpCost = def.mpCost
        if isvalid(statsComp) and (statsComp.Trait == "절약가" or statsComp.Trait2 == "절약가") then
            mpCost = math.floor(mpCost * 0.7)
        elseif isvalid(statsComp) and statsComp.MpCostMultiplier ~= 0 then
            -- M2 Phase B(2026-09-06) - 신규 특성(수련생/낭비벽/깨진 그릇 등)의 범용 MP소모% 효과.
            mpCost = math.max(0, math.floor(mpCost * (1 + statsComp.MpCostMultiplier)))
        end
        -- magicguard (testableEffect="mpfree") makes skill MP cost free for its own duration - see
        -- DoBuff/RevertBuff. Check/deduction below is skipped entirely while it's active.
        local mpFreeActive = self.BuffActive and self.BuffType == "mpfree"
        if not mpFreeActive then
            if not isvalid(statsComp) or statsComp.CurrentMp < mpCost then
                log("PlayerSkill: not enough MP for " .. def.name)
                return
            end
        end

        if slot == 2 then
            self.LastUseTime2 = _UtilLogic.ElapsedSeconds
        else
            self.LastUseTime = _UtilLogic.ElapsedSeconds
        end
        if not mpFreeActive then
            statsComp.CurrentMp = statsComp.CurrentMp - mpCost
        end
        log("PlayerSkill: use " .. def.name .. " slot=" .. slot .. " (kind=" .. def.kind .. " mp=" .. mpCost .. (mpFreeActive and " [mpfree]" or "") .. ")")

        -- M2 Phase B 2단계(2026-09-06) - 회전룰렛(onSkillCooldownRoulette): 스킬 사용마다 10% 확률로
        -- 그 슬롯 쿨다운 즉시 초기화, 별도 10%로 쿨다운 2배(다음 사용 가능 시점을 뒤로 미룸).
        local rouletteChance = isvalid(statsComp) and _TraitEffectEngine:GetOnSkillCooldownRoulette(statsComp.Trait) or 0
        if rouletteChance == 0 and isvalid(statsComp) and statsComp.Trait2 ~= "" then
            rouletteChance = _TraitEffectEngine:GetOnSkillCooldownRoulette(statsComp.Trait2)
        end
        -- 2026-09-08 QA - 회전룰렛 링크("돌아가는 운명") 신규 연결.
        if isvalid(statsComp) then
            rouletteChance = rouletteChance + statsComp.LinkSkillCooldownRouletteChance
        end
        if rouletteChance > 0 then
            local roll = _UtilLogic:RandomDouble()
            if roll < rouletteChance then
                if slot == 2 then self.LastUseTime2 = -999 else self.LastUseTime = -999 end
                log("PlayerSkill: 회전룰렛 - 쿨다운 즉시 초기화")
            elseif roll < rouletteChance * 2 then
                if slot == 2 then self.LastUseTime2 = self.LastUseTime2 + def.cooldown else self.LastUseTime = self.LastUseTime + def.cooldown end
                log("PlayerSkill: 회전룰렛 - 쿨다운 2배")
            end
        end

        -- Skill use and the basic attack (PlayerAttack.DoAttack) are driven by two independent,
        -- unlinked cooldown timers - PlayerControllerComponent fires a fresh PlayerActionEvent
        -- for the Attack key on every tick it's held (that's why DoAttack needs its own cooldown
        -- gate at all), so a player holding Attack while tapping a skill would have their
        -- already-elapsed AttackCooldownSeconds fire a basic attack immediately after (or during)
        -- the skill's own near-instant resolution - reported as "some skills chain into a basic
        -- attack afterward," really just an unsynced-timer coincidence, not a per-skill defect.
        -- Refreshing the shared attack timer here (classic MapleStory behavior: using a skill also
        -- resets your attack timer) closes that window.
        local attackComp = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(attackComp) then
            attackComp.LastAttackTime = _UtilLogic.ElapsedSeconds
        end

        -- 2026-09-15 버그 수정(유저 리포트 "스킬 사용 직후 후딜레이가 심해서 피격을 피할 수 없다") -
        -- 스킬 사용 순간에도 일반 피격 무적시간(PlayerHit.IFrameSeconds)과 동일한 창을 부여한다.
        -- 자세한 근거는 PlayerHit.GrantIFrame의 주석 참고 - 실측으로 이동 자체를 막는 코드는 없음을
        -- 확인했지만, 이 프로젝트 몬스터가 무제한 추격 범위로 항상 접촉 거리를 유지하다 보니 스킬
        -- 사용 순간이 하필 몬스터 공격과 겹쳐 "피할 수 없다"고 체감되는 문제를 액션 게임의 표준
        -- 해법(스킬 사용 시 짧은 무적)으로 해결.
        local hitComp = self.Entity:GetComponent("script.PlayerHit")
        if isvalid(hitComp) then
            hitComp:GrantIFrame()
        end

        -- dash already reads as a motion via its own AddForce impulse - every other kind gets a
        -- body pose here since the "Skill"(Q) action isn't part of PlayerControllerComponent's
        -- auto-state set (only "Attack"/LeftControl is - see msw-avatar SKILL.md), so without this
        -- the character would stand idle while only the VFX/damage happen.
        if def.kind ~= "dash" then
            self:PlaySkillMotion(def.kind == "buff" and "Heal" or "Attack")
        end

        self:DispatchSkillEffect(def)

        -- 2026-09-08 QA - 느림보(bad)의 basicDesc "낮은 확률로 스킬 2연발"이 basicEffect에 없어
        -- 페널티(as=-0.10)만 적용되고 보상이 전혀 없던 무비용 페널티 버그(도굴꾼류와 반대 방향 -
        -- 이쪽은 "손해만 보는" 불공정). 산만함 링크("재시전 지원")도 동일 메커니즘의 링크 버전이라
        -- 함께 연결 - MP/쿨다운 재차감 없이 디스패치만 한 번 더(위에서 이미 차감 완료).
        local doubleCastChance = isvalid(statsComp) and _TraitEffectEngine:GetDoubleCastChance(statsComp.Trait) or 0
        if doubleCastChance == 0 and isvalid(statsComp) and statsComp.Trait2 ~= "" then
            doubleCastChance = _TraitEffectEngine:GetDoubleCastChance(statsComp.Trait2)
        end
        local linkDoubleCastChance = isvalid(statsComp) and _TraitEffectEngine:GetLinkDoubleCastChance(statsComp.LinkTrait1) or 0
        if linkDoubleCastChance == 0 and isvalid(statsComp) and statsComp.LinkTrait2 ~= "" then
            linkDoubleCastChance = _TraitEffectEngine:GetLinkDoubleCastChance(statsComp.LinkTrait2)
        end
        if (doubleCastChance + linkDoubleCastChance) > 0 and _UtilLogic:RandomDouble() < (doubleCastChance + linkDoubleCastChance) then
            log("PlayerSkill: 느림보/산만함 링크 - 스킬 2연발 발동")
            _TimerService:SetTimerOnce(function()
                if isvalid(self.Entity) then self:DispatchSkillEffect(def) end
            end, 0.15)
        end
    end

    method void DispatchSkillEffect(table def)
        -- 2026-09-15 코드 구조화 4/9 - 위임 래퍼, 본체는 Skills/PlayerSkillExecutionLogic.mlua.
        _PlayerSkillExecutionLogic:DispatchSkillEffect(self, def)
    end

    @ExecSpace("Client")
    method void PlaySkillMotion(string poseName)
        -- 2026-09-15 코드 구조화 4/9 - 위임 래퍼, 본체는 Skills/PlayerSkillExecutionLogic.mlua.
        _PlayerSkillExecutionLogic:PlaySkillMotion(self, poseName)
    end

