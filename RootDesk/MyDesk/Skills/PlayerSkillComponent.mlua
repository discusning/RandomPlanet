@Component
script PlayerSkillComponent extends Component
    -- 전직별 스킬 보유·장착 실행기 (Docs/랜덤 플래닛 전체 기획서.md §04 "버프풀 3택1 + 공격풀 3택1
    -- 동시 진행"). 스킬 정의는 SkillCatalog(@Logic)에서 조회, 실제 수치는 PlayerAttack/
    -- PlayerStatsComponent/MovementComponent를 그때그때 읽고 쓴다(각 스탯 공식은 그쪽이 유일한 소유자).
    -- 8개 고정 슬롯(1~4차 x 버프/공격)에 보유 스킬을 저장하고, 그중 하나만 EquippedSkillId로 "Skill"
    -- (Q)키에 실제 장착한다. 캐릭터 생성 시점(1차)은 유저가 카드에서 공격/버프 각각 전체 풀 안에서
    -- 직접 고른 두 스킬을 그대로 받는다(GrantInitialSkill, 2026-08-19 재설계 - 예전엔 하나만 직접
    -- 고르고 반대 카테고리는 안 보이게 자동 배정됐음).
    -- 2026-09-06 (M2 Phase A) - 2/3/4차 전직 티어는 이전엔 GrantTierSkills가 각 카테고리 첫 후보를
    -- 자동 지급했으나(3택1 UI 부재), 실제 3택1 선택 팝업(SkillChoiceUIController/ui/SkillChoiceGroup.ui,
    -- AbilityChoiceUIController와 동일 아키텍처)으로 교체 - 버프 3택1을 먼저 띄우고 확정되면 이어서
    -- 공격 3택1을 띄운다(TierQueued2~4가 여러 티어가 동시에 몰렸을 때의 대기열). 티어 진급마다 유저가
    -- 실제로 버프 1개+공격 1개를 직접 고른다(전체 기획서 §04).

    @Sync property string BuffSkill1 = ""
    @Sync property string BuffSkill2 = ""
    @Sync property string BuffSkill3 = ""
    @Sync property string BuffSkill4 = ""
    @Sync property string AtkSkill1 = ""
    @Sync property string AtkSkill2 = ""
    @Sync property string AtkSkill3 = ""
    @Sync property string AtkSkill4 = ""
    @Sync property string EquippedSkillId = ""
    @Sync @HideFromInspector property number LastUseTime = -999
    -- 2번 스킬 슬롯 (2026-08-25, 유저 요청 - "스킬 관련 세팅이 더 진화된 모습으로... 자유도를
    -- 올리고" - 기존엔 슬롯이 1개(Q)뿐이라 버프와 공격 스킬을 동시에 쓸 수 없었다. Q(EquippedSkillId)는
    -- 항상 공격 카테고리, W(EquippedSkillId2)는 항상 버프 카테고리로 고정해 "공격 키 + 버프 키를
    -- 동시에 장착"하는 실제 메이플스토리식 다중 스킬 키 구조에 가깝게 만든다 - 스킬창에서 장착 버튼을
    -- 누르면 그 스킬의 카테고리에 따라 자동으로 맞는 슬롯에 들어간다(RequestSetEquippedSkill).
    @Sync property string EquippedSkillId2 = ""
    @Sync @HideFromInspector property number LastUseTime2 = -999
    -- 2026-09-06 (M2 Phase A) - 티어 3택1 선택 팝업 상태. SkillChoicePending은 클라이언트가
    -- OnSyncProperty로 감시하는 진입점(true가 되면 SkillChoiceUIController.ShowChoice 호출) -
    -- AbilityChoicePending과 동일 패턴. PendingSkillChoice1~3은 이번 팝업의 후보 3개(카테고리 내
    -- 풀이 3개 미만이면 빈 문자열로 채워짐 - UI가 빈 슬롯을 숨겨야 함).
    @Sync @HideFromInspector property boolean SkillChoicePending = false
    @Sync @HideFromInspector property string PendingSkillCategory = ""
    @Sync @HideFromInspector property integer PendingSkillTier = 0
    @Sync @HideFromInspector property string PendingSkillChoice1 = ""
    @Sync @HideFromInspector property string PendingSkillChoice2 = ""
    @Sync @HideFromInspector property string PendingSkillChoice3 = ""
    -- 여러 레벨이 한 틱에 몰려 티어가 동시에 여러 개 진급할 때의 대기열(이능 팝업의
    -- PendingAbilityChoices 카운터와 달리, 스킬 티어는 각각 서로 다른 후보 풀을 굴려야 해서 단순
    -- 카운터로는 표현 불가 - 티어 번호별 불리언 플래그 3개로 대신한다. 최대 3개뿐이라 충분).
    @HideFromInspector property boolean TierQueued2 = false
    @HideFromInspector property boolean TierQueued3 = false
    @HideFromInspector property boolean TierQueued4 = false
    -- 2026-08-19 유저 요청 - "버프 유지 시간이 전혀 안 보인다". 원인은 이 3개가 @Sync가 아니라서
    -- 클라이언트가 애초에 값을 읽을 수 없었던 것 - PlayerHUDController가 이 값들로 남은 시간을
    -- 표시한다(BuffExpireTime - _UtilLogic.ServerElapsedSeconds, 스킬 쿨다운 표시와 동일 패턴).
    @Sync @HideFromInspector property boolean BuffActive = false
    @Sync @HideFromInspector property number BuffExpireTime = 0
    @Sync @HideFromInspector property string BuffType = ""
    @HideFromInspector property number BuffOriginalValue = 0
    -- 2026-09-08 QA 발견 - 포커스/님블바디의 inertNote("회피 상승 부분은 비활성(몬스터 공격
    -- 파이프라인 없음)")가 이번 세션 초반에 그 파이프라인(PlayerHit.HandleHitEvent의 EvasionPercent
    -- 소비)을 구현하면서 이미 stale해졌다 - testableEffect 슬롯(BuffType/BuffOriginalValue)은
    -- PlayerAttack/MovementComponent 값 하나만 담당하므로, EvasionPercent는 별도 채널로 병행 적용.
    @HideFromInspector property number BuffEvasionBonus = 0
    @HideFromInspector property integer BuffParticleSerial = 0
    @HideFromInspector property boolean BuffUsingSkillVfx = false
    @HideFromInspector property integer ProjectileCount = 0

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self.BuffActive then return end
        if _UtilLogic.ElapsedSeconds < self.BuffExpireTime then return end
        self:RevertBuff()
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Opens the skill-tier 3택1 popup for the local player only (RestrictedPlayerEntitySync
        -- keeps other players' PlayerSkillComponent invisible to this client anyway, but the guard
        -- is kept explicit to match this project's other per-player UI controllers).
        if name ~= "SkillChoicePending" or value ~= true then return end
        if not isvalid(_UserService.LocalPlayer) or self.Entity ~= _UserService.LocalPlayer then return end
        _SkillChoiceUIController:ShowChoice(self.PendingSkillCategory, self.PendingSkillTier, self.PendingSkillChoice1, self.PendingSkillChoice2, self.PendingSkillChoice3)
    end

    @ExecSpace("ServerOnly")
    method void GrantInitialSkill(string atkSkillId, string buffSkillId)
        -- Called once from RequestEnterGame/SwapActiveCharacter with the roster's rolled tier-1
        -- attack/buff skill ids (CharacterSelectStageController.CreateCharacter picks one random id
        -- per category - no manual card picker anymore, see CharacterCardController).
        --
        -- 유저 리포트(2026-08-19) "인게임 스킬창에서도 1차 스킬이 모두 사라져있다" - 원인은 이전 세션에
        -- 만들어진 캐릭터(구 데이터 형식 skillCandidates/skillId만 있고 atkSkillId/buffSkillId가 없는
        -- roster 항목)로 PLAY하면 이 두 파라미터가 둘 다 nil로 넘어오는데, 그 경우 아무것도 배정하지
        -- 않고 그냥 넘어가서 AtkSkill1/BuffSkill1이 빈 채로 남았던 것 - 신규/구 캐릭터 모두 항상 1차에
        -- 공격 1개+버프 1개를 보유하도록, 비어 있으면 해당 카테고리 전체 풀에서 즉석 롤백.
        if atkSkillId ~= nil and atkSkillId ~= "" then
            self.AtkSkill1 = atkSkillId
        elseif self.AtkSkill1 == "" then
            local pool = _SkillCatalog:GetSkillsByCategory("attack", 1)
            if #pool > 0 then self.AtkSkill1 = pool[_UtilLogic:RandomIntegerRange(1, #pool)] end
        end
        if buffSkillId ~= nil and buffSkillId ~= "" then
            self.BuffSkill1 = buffSkillId
        elseif self.BuffSkill1 == "" then
            local pool = _SkillCatalog:GetSkillsByCategory("buff", 1)
            if #pool > 0 then self.BuffSkill1 = pool[_UtilLogic:RandomIntegerRange(1, #pool)] end
        end
        -- 기본 장착은 공격 스킬(Q키가 곧바로 딜을 넣도록) - 공격 쪽이 비어 있으면 버프로 대체.
        if self.AtkSkill1 ~= "" then
            self.EquippedSkillId = self.AtkSkill1
        elseif self.BuffSkill1 ~= "" then
            self.EquippedSkillId = self.BuffSkill1
        end
        -- W(2번 슬롯)에는 버프 스킬을 처음부터 장착 - 공격(Q)과 버프(W)를 동시에 쓸 수 있게(위
        -- EquippedSkillId2 선언부 주석 참고). 매번 스킬창에서 수동으로 바꿔 낄 필요가 없어져서
        -- "약한 직업도 던전을 깰 수 있어야 한다"는 요청에도 실질적으로 기여한다 - 예전엔 버프를
        -- 쓰려면 공격 스킬을 내려야 했다.
        if self.BuffSkill1 ~= "" then
            self.EquippedSkillId2 = self.BuffSkill1
        end
        log("PlayerSkill: GrantInitialSkill atk1=" .. self.AtkSkill1 .. " buff1=" .. self.BuffSkill1)
    end

    @ExecSpace("ServerOnly")
    method void GrantTierSkills(integer tier)
        -- Called from PlayerStatsComponent.GrantSkillTierIfMilestone at levels 5/13/18 (tier 2/3/4).
        -- Queues the tier instead of granting immediately - ProcessSkillTierQueue starts the actual
        -- buff-then-attack 3택1 popup flow once no other choice is currently open.
        if tier < 2 or tier > 4 then return end
        if tier == 2 then self.TierQueued2 = true
        elseif tier == 3 then self.TierQueued3 = true
        else self.TierQueued4 = true
        end
        log("PlayerSkill: GrantTierSkills queued tier=" .. tier)
        self:ProcessSkillTierQueue()
    end

    @ExecSpace("ServerOnly")
    method void ProcessSkillTierQueue()
        -- Starts the next queued tier's buff choice once no choice popup is currently open. Tiers
        -- are processed in ascending order (2 -> 3 -> 4) - a huge XP grant (a real overkill burst,
        -- or a test script) that crosses multiple milestones in one GrantXp call queues all of them,
        -- resolved one at a time.
        --
        -- Guard on PendingSkillTier (~= 0), NOT SkillChoicePending. SkillChoicePending's flip to true
        -- is deliberately deferred by 0.1s in StartTierChoice (same-tick @Sync visibility pattern -
        -- see that method) - within that 0.1s window it's still false even though a choice IS already
        -- in flight. A second GrantTierSkills call landing inside that window (e.g. two milestones hit
        -- in the same synchronous GrantXp loop) would otherwise see SkillChoicePending=false and start
        -- a second StartTierChoice immediately, overwriting the first tier's Pending* fields before its
        -- own deferred flip ever fires - silently discarding that tier's choice entirely (reproduced in
        -- testing: a level 1->13 jump in one GrantXp call skipped tier 2's buff choice this way).
        -- PendingSkillTier is set synchronously at the very top of StartTierChoice (no timer), so it is
        -- a reliable "a choice is in flight" flag even during that window.
        if self.PendingSkillTier ~= 0 then return end
        local nextTier = 0
        if self.TierQueued2 then nextTier = 2
        elseif self.TierQueued3 then nextTier = 3
        elseif self.TierQueued4 then nextTier = 4
        end
        if nextTier == 0 then return end
        if nextTier == 2 then self.TierQueued2 = false
        elseif nextTier == 3 then self.TierQueued3 = false
        else self.TierQueued4 = false
        end
        self:StartTierChoice(nextTier, "buff")
    end

    @ExecSpace("ServerOnly")
    method void StartTierChoice(integer tier, string category)
        -- Rolls up to 3 unowned candidates for the given tier/category and opens the popup. If the
        -- category's pool is already exhausted (0 candidates - possible once M2's full trait/skill
        -- pools shrink via prior grants), skips straight to the next step instead of showing an
        -- empty popup.
        local owned = self:GetOwnedSkillIds()
        local ownedIds = {}
        for _, entry in ipairs(owned) do
            table.insert(ownedIds, entry.id)
        end
        local choices = _SkillCatalog:RollSkillChoices(category, tier, ownedIds)
        if #choices == 0 then
            log("PlayerSkill: StartTierChoice tier=" .. tier .. " category=" .. category .. " pool exhausted, skipping")
            self:AdvanceTierChoice(tier, category)
            return
        end

        self.PendingSkillTier = tier
        self.PendingSkillCategory = category
        self.PendingSkillChoice1 = choices[1] or ""
        self.PendingSkillChoice2 = choices[2] or ""
        self.PendingSkillChoice3 = choices[3] or ""

        -- Deferred flip (같은 틱 @Sync 지연-가시성 패턴 - PlayerStatsComponent.MaybeOpenNextAbilityChoice
        -- 와 동일한 이유) - SkillChoicePending이 true로 도착할 때 형제 필드(PendingSkillChoice1~3 등)가
        -- 이미 이전 sync 틱에 도착해 있도록 한 틱 늦춰서 별도로 보낸다.
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) then return end
            self.SkillChoicePending = true
            log("PlayerSkill: StartTierChoice tier=" .. tier .. " category=" .. category .. " choices=" .. choices[1] .. "/" .. tostring(choices[2]) .. "/" .. tostring(choices[3]))
        end, 0.1)
    end

    @ExecSpace("ServerOnly")
    method void AdvanceTierChoice(integer tier, string category)
        -- Called when a category's pool was empty (StartTierChoice) or after a choice resolves
        -- (RequestResolveSkillChoice). Buff -> attack within the same tier; attack -> tier complete.
        if category == "buff" then
            self:StartTierChoice(tier, "attack")
        else
            self.PendingSkillTier = 0
            self:ProcessSkillTierQueue()
        end
    end

    @ExecSpace("Server")
    method void RequestResolveSkillChoice(string chosenId)
        -- Client-invoked (skill choice popup card click). senderUserId guards against resolving
        -- another player's pending choice. Rejects an id that isn't one of the 3 rolled candidates
        -- (spoofed / stale click) silently, mirroring RequestSetEquippedSkill's rejection pattern.
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if not self.SkillChoicePending then return end
        if chosenId ~= self.PendingSkillChoice1 and chosenId ~= self.PendingSkillChoice2 and chosenId ~= self.PendingSkillChoice3 then
            log_warning("PlayerSkill: RequestResolveSkillChoice rejected, not a rolled candidate: " .. tostring(chosenId))
            return
        end
        local tier = self.PendingSkillTier
        local category = self.PendingSkillCategory
        self:SetTierSlot(category, tier, chosenId)
        self.SkillChoicePending = false
        self.PendingSkillCategory = ""
        self.PendingSkillChoice1 = ""
        self.PendingSkillChoice2 = ""
        self.PendingSkillChoice3 = ""
        log("PlayerSkill: RequestResolveSkillChoice tier=" .. tier .. " category=" .. category .. " chosen=" .. chosenId)
        self:AdvanceTierChoice(tier, category)
    end

    @ExecSpace("Server")
    method void RequestRerollSkillChoice()
        -- 큐브마스터 특성 훅(전체 기획서 §2-3 "스킬 선택 시 제시 옵션 1회 재추첨 가능") - 이 특성이
        -- 아직 축소 특성 풀(M1)에 없어 오늘은 사실상 항상 거부되지만, M2 Phase B에서 전체 114종
        -- 특성 풀이 들어오면 이 메서드만으로 곧바로 동작한다(별도 배선 불필요).
        if not isvalid(self.Entity.PlayerComponent) or senderUserId ~= self.Entity.PlayerComponent.UserId then
            return
        end
        if not self.SkillChoicePending then return end
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if not isvalid(statsComp) or (statsComp.Trait ~= "큐브마스터" and statsComp.Trait2 ~= "큐브마스터") then
            log("PlayerSkill: RequestRerollSkillChoice rejected, no 큐브마스터 trait")
            return
        end
        local owned = self:GetOwnedSkillIds()
        local ownedIds = {}
        for _, entry in ipairs(owned) do
            table.insert(ownedIds, entry.id)
        end
        local choices = _SkillCatalog:RollSkillChoices(self.PendingSkillCategory, self.PendingSkillTier, ownedIds)
        if #choices == 0 then return end
        self.PendingSkillChoice1 = choices[1] or ""
        self.PendingSkillChoice2 = choices[2] or ""
        self.PendingSkillChoice3 = choices[3] or ""
        log("PlayerSkill: 큐브마스터 reroll -> " .. choices[1])
    end

    @ExecSpace("ServerOnly")
    method void SetTierSlot(string category, integer tier, string skillId)
        if category == "buff" then
            if tier == 1 then self.BuffSkill1 = skillId
            elseif tier == 2 then self.BuffSkill2 = skillId
            elseif tier == 3 then self.BuffSkill3 = skillId
            elseif tier == 4 then self.BuffSkill4 = skillId
            end
        else
            if tier == 1 then self.AtkSkill1 = skillId
            elseif tier == 2 then self.AtkSkill2 = skillId
            elseif tier == 3 then self.AtkSkill3 = skillId
            elseif tier == 4 then self.AtkSkill4 = skillId
            end
        end
    end

    method table GetOwnedSkillIds()
        -- Returns { {id, tier, category}, ... } for every filled slot - the skill window's data
        -- source (see SkillUIController.Refresh).
        local result = {}
        local buffSlots = { self.BuffSkill1, self.BuffSkill2, self.BuffSkill3, self.BuffSkill4 }
        local atkSlots = { self.AtkSkill1, self.AtkSkill2, self.AtkSkill3, self.AtkSkill4 }
        for i, id in ipairs(buffSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "buff" })
            end
        end
        for i, id in ipairs(atkSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "attack" })
            end
        end
        return result
    end

    @ExecSpace("Server")
    method void RequestSetEquippedSkill(string skillId)
        -- Client-invoked (skill window "장착" button). Only allows equipping an actually-owned
        -- skill - rejects a spoofed/unknown id silently (no error, just a no-op + log).
        -- 2026-08-25: 카테고리로 슬롯 자동 분기 - 버프 스킬은 항상 2번 슬롯(W), 공격/대시 스킬은
        -- 항상 1번 슬롯(Q)에 들어간다(EquippedSkillId2 선언부 주석 참고). 스킬창 UI는 버튼 하나
        -- 그대로 두고 이 서버 로직만으로 "공격+버프 동시 장착"을 구현 - 클라이언트 쪽 변경 불필요.
        local owned = self:GetOwnedSkillIds()
        for _, entry in ipairs(owned) do
            if entry.id == skillId then
                if entry.category == "buff" then
                    self.EquippedSkillId2 = skillId
                else
                    self.EquippedSkillId = skillId
                end
                log("PlayerSkill: equipped " .. skillId .. " slot=" .. (entry.category == "buff" and "2(W)" or "1(Q)"))
                return
            end
        end
        log("PlayerSkill: RequestSetEquippedSkill rejected, not owned: " .. tostring(skillId))
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- Resolves the player's skill keys into UseSkillSlot(). Mirrors PlayerAttack's own
        -- ActionName-filtered handler pattern for the "Attack" key. "Skill"(Q)=slot 1(공격),
        -- "Skill2"(W)=slot 2(버프) - see EquippedSkillId2 선언부 주석 + KeyBindingLogic.BuildRegistry.
        if event.ActionName == "Skill" then
            self:UseSkillSlot(1)
        elseif event.ActionName == "Skill2" then
            self:UseSkillSlot(2)
        end
    end

    @ExecSpace("ServerOnly")
    method void UseSkillSlot(integer slot)
        -- 2026-09-06 (M2 Phase A) - UseSkill()을 슬롯 파라미터화해서 Q(1)/W(2) 양쪽이 쿨다운·MP
        -- 차감·절약가/mpfree 처리 등 동일 로직을 공유하도록 통합(기존엔 슬롯 2가 아예 발동 경로가
        -- 없었음 - As-built 25차 "W키 백엔드 로직 완료"는 장착 라우팅만 완료된 상태였고 실제 키
        -- 입력을 UseSkill로 연결하는 배선이 빠져있었다).
        local equippedId = slot == 2 and self.EquippedSkillId2 or self.EquippedSkillId
        if equippedId == "" then return end
        local def = _SkillCatalog:GetSkillDef(equippedId)
        if def == nil then return end
        local lastUseTime = slot == 2 and self.LastUseTime2 or self.LastUseTime
        if _UtilLogic.ElapsedSeconds - lastUseTime < def.cooldown then
            return
        end
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        -- 침묵의 맹세(hb) - basicDesc가 명시한 "MP 소모 스킬 사용 불가"가 지금까지 실제로는
        -- 강제되지 않았다(atk=1.0 보너스만 적용되고 페널티는 "선행 필요"로 미구현 상태였음 -
        -- 2026-09-08 밸런스 점검에서 발견한 무비용 특성). 이 특성은 스킬 자체를 아예 못 쓰게 막는다
        -- (평타 3배로 이미 보상받으므로).
        if isvalid(statsComp) and (statsComp.Trait == "침묵의 맹세" or statsComp.Trait2 == "침묵의 맹세") then
            log("PlayerSkill: 침묵의 맹세 - 스킬 사용 불가")
            return
        end
        -- 절약가(1차 특성) - 스킬 MP 소모 30% 감소(상시, magicguard의 시전형 mpfree와 별개). 순수
        -- 유틸 스탯이라 CP에는 반영하지 않지만(PlayerStatsComponent 참고) 실제로 MP 차감에 반영된다.
        local mpCost = def.mpCost
        if isvalid(statsComp) and (statsComp.Trait == "절약가" or statsComp.Trait2 == "절약가") then
            mpCost = math.floor(mpCost * 0.7)
        elseif isvalid(statsComp) and statsComp.MpCostMultiplier ~= 0 then
            -- M2 Phase B(2026-09-06) - 신규 특성(수련생/낭비벽/깨진 그릇 등)의 범용 MP소모% 효과.
            mpCost = math.max(0, math.floor(mpCost * (1 + statsComp.MpCostMultiplier)))
        end
        -- magicguard (testableEffect="mpfree") makes skill MP cost free for its own duration - see
        -- DoBuff/RevertBuff. Check/deduction below is skipped entirely while it's active.
        local mpFreeActive = self.BuffActive and self.BuffType == "mpfree"
        if not mpFreeActive then
            if not isvalid(statsComp) or statsComp.CurrentMp < mpCost then
                log("PlayerSkill: not enough MP for " .. def.name)
                return
            end
        end

        if slot == 2 then
            self.LastUseTime2 = _UtilLogic.ElapsedSeconds
        else
            self.LastUseTime = _UtilLogic.ElapsedSeconds
        end
        if not mpFreeActive then
            statsComp.CurrentMp = statsComp.CurrentMp - mpCost
        end
        log("PlayerSkill: use " .. def.name .. " slot=" .. slot .. " (kind=" .. def.kind .. " mp=" .. mpCost .. (mpFreeActive and " [mpfree]" or "") .. ")")

        -- M2 Phase B 2단계(2026-09-06) - 회전룰렛(onSkillCooldownRoulette): 스킬 사용마다 10% 확률로
        -- 그 슬롯 쿨다운 즉시 초기화, 별도 10%로 쿨다운 2배(다음 사용 가능 시점을 뒤로 미룸).
        local rouletteChance = isvalid(statsComp) and _TraitEffectEngine:GetOnSkillCooldownRoulette(statsComp.Trait) or 0
        if rouletteChance == 0 and isvalid(statsComp) and statsComp.Trait2 ~= "" then
            rouletteChance = _TraitEffectEngine:GetOnSkillCooldownRoulette(statsComp.Trait2)
        end
        -- 2026-09-08 QA - 회전룰렛 링크("돌아가는 운명") 신규 연결.
        if isvalid(statsComp) then
            rouletteChance = rouletteChance + statsComp.LinkSkillCooldownRouletteChance
        end
        if rouletteChance > 0 then
            local roll = _UtilLogic:RandomDouble()
            if roll < rouletteChance then
                if slot == 2 then self.LastUseTime2 = -999 else self.LastUseTime = -999 end
                log("PlayerSkill: 회전룰렛 - 쿨다운 즉시 초기화")
            elseif roll < rouletteChance * 2 then
                if slot == 2 then self.LastUseTime2 = self.LastUseTime2 + def.cooldown else self.LastUseTime = self.LastUseTime + def.cooldown end
                log("PlayerSkill: 회전룰렛 - 쿨다운 2배")
            end
        end

        -- Skill use and the basic attack (PlayerAttack.DoAttack) are driven by two independent,
        -- unlinked cooldown timers - PlayerControllerComponent fires a fresh PlayerActionEvent
        -- for the Attack key on every tick it's held (that's why DoAttack needs its own cooldown
        -- gate at all), so a player holding Attack while tapping a skill would have their
        -- already-elapsed AttackCooldownSeconds fire a basic attack immediately after (or during)
        -- the skill's own near-instant resolution - reported as "some skills chain into a basic
        -- attack afterward," really just an unsynced-timer coincidence, not a per-skill defect.
        -- Refreshing the shared attack timer here (classic MapleStory behavior: using a skill also
        -- resets your attack timer) closes that window.
        local attackComp = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(attackComp) then
            attackComp.LastAttackTime = _UtilLogic.ElapsedSeconds
        end

        -- dash already reads as a motion via its own AddForce impulse - every other kind gets a
        -- body pose here since the "Skill"(Q) action isn't part of PlayerControllerComponent's
        -- auto-state set (only "Attack"/LeftControl is - see msw-avatar SKILL.md), so without this
        -- the character would stand idle while only the VFX/damage happen.
        if def.kind ~= "dash" then
            self:PlaySkillMotion(def.kind == "buff" and "Heal" or "Attack")
        end

        self:DispatchSkillEffect(def)

        -- 2026-09-08 QA - 느림보(bad)의 basicDesc "낮은 확률로 스킬 2연발"이 basicEffect에 없어
        -- 페널티(as=-0.10)만 적용되고 보상이 전혀 없던 무비용 페널티 버그(도굴꾼류와 반대 방향 -
        -- 이쪽은 "손해만 보는" 불공정). 산만함 링크("재시전 지원")도 동일 메커니즘의 링크 버전이라
        -- 함께 연결 - MP/쿨다운 재차감 없이 디스패치만 한 번 더(위에서 이미 차감 완료).
        local doubleCastChance = isvalid(statsComp) and _TraitEffectEngine:GetDoubleCastChance(statsComp.Trait) or 0
        if doubleCastChance == 0 and isvalid(statsComp) and statsComp.Trait2 ~= "" then
            doubleCastChance = _TraitEffectEngine:GetDoubleCastChance(statsComp.Trait2)
        end
        local linkDoubleCastChance = isvalid(statsComp) and _TraitEffectEngine:GetLinkDoubleCastChance(statsComp.LinkTrait1) or 0
        if linkDoubleCastChance == 0 and isvalid(statsComp) and statsComp.LinkTrait2 ~= "" then
            linkDoubleCastChance = _TraitEffectEngine:GetLinkDoubleCastChance(statsComp.LinkTrait2)
        end
        if (doubleCastChance + linkDoubleCastChance) > 0 and _UtilLogic:RandomDouble() < (doubleCastChance + linkDoubleCastChance) then
            log("PlayerSkill: 느림보/산만함 링크 - 스킬 2연발 발동")
            _TimerService:SetTimerOnce(function()
                if isvalid(self.Entity) then self:DispatchSkillEffect(def) end
            end, 0.15)
        end
    end

    method void DispatchSkillEffect(table def)
        -- def.kind에 따라 실제 판정 로직(Do*)으로 분기. UseSkillSlot 본 사용 + 느림보/산만함
        -- 링크의 2연발 재사용 양쪽에서 호출되는 공용 진입점(MP/쿨다운 차감과는 독립).
        if def.kind == "melee_single" then
            -- 2026-09-06 (M2 Phase A) - VFX 타이밍 딜레이 적용(As-built 25차 "설계만 완료, 코드
            -- 미적용" 항목 - DoDash 주석에 있던 "DispatchSkill의 impactDelay" 개념을 실제로 구현).
            -- 지금까지 melee_single은 키 입력과 같은 프레임에 즉시 판정이 나가서, 스윙 모션의 초반
            -- 프레임에 이미 데미지가 적용되는 것처럼 보였다(모션은 PlaySkillMotion으로 방금 시작했는데
            -- 타격은 그 즉시 발생). def.impactDelay(SkillCatalog, 기본 0)만큼 실제 판정을 늦춰서
            -- 스윙 애니메이션의 타격 프레임과 데미지 적용 시점을 맞춘다. dash는 의도적으로 제외(위
            -- DoDash 주석 참고 - 돌진 자체가 스윙이라 즉시 판정이 맞음), multi_hit(럭키 세븐)은 이미
            -- 투사체 비행시간으로 자연스러운 지연이 있어 별도 적용 불필요.
            local impactDelay = def.impactDelay or 0
            if impactDelay > 0 then
                _TimerService:SetTimerOnce(function()
                    if isvalid(self.Entity) then self:DoMeleeSingle(def) end
                end, impactDelay)
            else
                self:DoMeleeSingle(def)
            end
        elseif def.kind == "ranged_single" or def.kind == "ranged_pierce" then
            self:DoRanged(def, def.kind == "ranged_pierce")
        elseif def.kind == "multi_hit" then
            self:DoMultiHit(def)
        elseif def.kind == "dash" then
            self:DoDash(def)
        elseif def.kind == "debuff" then
            self:DoDisorder(def)
        elseif def.kind == "buff" then
            self:DoBuff(def)
        end

        -- 2026-09-10 QA - 명상가 링크("지혜의 등불": 스킬 사용 시 소형 범위 확산) 신규 연결. 순수
        -- 버프(magicguard 등)는 대상이 없어 제외 - 실제 공격/디버프 종류 스킬에서만 발동.
        if def.kind ~= "buff" then
            local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
            if isvalid(statsComp) then
                local spreadSpec = _TraitEffectEngine:GetLinkWisdomSpread(statsComp.LinkTrait1)
                if spreadSpec == nil and statsComp.LinkTrait2 ~= "" then spreadSpec = _TraitEffectEngine:GetLinkWisdomSpread(statsComp.LinkTrait2) end
                if spreadSpec ~= nil then
                    local attack = self.Entity:GetComponent("script.PlayerAttack")
                    local transform = self.Entity.TransformComponent
                    if isvalid(attack) and isvalid(transform) then
                        local pos = transform.WorldPosition
                        local shape = BoxShape(Vector2(pos.x, pos.y + 0.5), Vector2(2.0, 1.6), 0)
                        local originalDamage = attack.AttackDamage
                        attack.AttackDamage = math.floor(originalDamage * (spreadSpec.pct or 0.2))
                        attack:AttackFast(shape, "skill.linkWisdomSpread", CollisionGroups.Monster)
                        attack.AttackDamage = originalDamage
                        log("PlayerSkill: 명상가 링크 - 지혜의 등불 소형 범위 확산 발동")
                    end
                end
            end
        end
    end

    @ExecSpace("Client")
    method void PlaySkillMotion(string poseName)
        -- Replays a built-in avatar body pose (Attack swing / Heal self-cast) via a fresh
        -- BodyActionStateChangeEvent instead of StateComponent:ChangeState("ATTACK") - the latter
        -- gets silently stomped because PlayerControllerComponent re-evaluates real held keys every
        -- tick and would immediately transition back to IDLE/MOVE since Q isn't in its own action
        -- set (see msw-avatar SKILL.md "14 states vs custom actions" + its ChangeState pitfall).
        -- Called with no target from ServerOnly code, so it's a broadcast RPC every nearby client sees.
        local actionState = MapleAvatarBodyActionState.Attack
        if poseName == "Heal" then
            actionState = MapleAvatarBodyActionState.Heal
        end
        local event = BodyActionStateChangeEvent()
        event.ActionState = actionState
        event.needResetAction = true
        self.Entity:SendEvent(event)
    end

    @ExecSpace("ServerOnly")
    method void DoMeleeSingle(table def)
        -- Reuses PlayerAttack's existing hitbox/crit pipeline - temporarily scales AttackDamage by
        -- the skill coefficient, fires, then restores the base value in the same call.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        -- def.wide (slashblast) uses a much wider frontal box than the default single-target zone -
        -- AttackFast already resolves against every entity overlapping the shape (not just one), so
        -- a plain wider BoxShape is enough to turn this into a real frontal AoE - no new "kind" needed.
        local boxSize = def.wide and Vector2(2.6, 1.6) or Vector2(1.5, 1.4)
        local shape = BoxShape(Vector2(pos.x + 0.7 * dir, pos.y + 0.5), boxSize, 0)

        local originalDamage = attack.AttackDamage
        attack.AttackDamage = math.floor(originalDamage * def.coef)
        attack:AttackFast(shape, "skill." .. def.id, CollisionGroups.Monster)
        attack.AttackDamage = originalDamage

        if def.hitVfxRuid ~= nil then
            -- FlipX must be set explicitly per cast - PlayEffect never inherits the caster's
            -- current facing on its own (2026-08-17 user report: "매직 클로가 이상하게 날아다닌다"
            -- traced to this exact gap on the ranged projectile below; melee hit clips have the same
            -- gap even though it's less visible for a roughly-symmetric burst shape). Source art
            -- faces left by default (msw-search convention), so dir>0 (facing right) needs FlipX=true.
            local serial = _EffectService:PlayEffect(def.hitVfxRuid, self.Entity, Vector3(pos.x + 0.7 * dir, pos.y + 0.5, pos.z), 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " hit VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoMultiHit(table def)
        -- Lucky Seven (currently the only multi_hit skill) - real classic MapleStory throws daggers a
        -- short distance rather than swinging like a melee weapon (2026-08-16 usage-location audit:
        -- the previous instant frontal-box version read identically to a sword swing). Spawns def.hits
        -- real short-range projectiles staggered ~0.09s apart (a visible "rapid throw" instead of one
        -- simultaneous flash) via FireThrownDagger, reusing DoRanged's spawn/override pattern but with
        -- a short MaxLifetime so each dagger only travels a few units before disappearing.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        local damage = math.floor(attack.AttackDamage * def.coef)
        local critChance = attack.CriticalChance
        local critMult = attack.CritDamageMultiplier

        for i = 1, def.hits do
            local delay = (i - 1) * 0.09
            _TimerService:SetTimerOnce(function()
                self:FireThrownDagger(def, dir, pos, map, damage, critChance, critMult)
            end, delay)
        end
    end

    @ExecSpace("ServerOnly")
    method void FireThrownDagger(table def, integer dir, Vector3 pos, Entity map, integer damage, number critChance, number critMult)
        -- One thrown dagger for Lucky Seven's DoMultiHit above - short travel distance (Speed*MaxLifetime
        -- ~= 3 units) so it visibly leaves the caster's hand and lands nearby instead of an instant hit.
        self.ProjectileCount = self.ProjectileCount + 1
        local name = "skillproj_" .. tostring(self.ProjectileCount)
        -- 2026-08-19 유저 리포트("표창 나가는 위치가 애매하다") - 실제 Play 세션에서 스크린샷으로
        -- 확인해보니 DoRanged와 똑같이 pos.y(캐릭터 발밑 높이)에서 스폰되어 표창이 손이 아니라
        -- 바닥에서 튀어나오는 것처럼 보였다. HitRadius를 0.4->0.55로 함께 키워서 몬스터와의 세로
        -- 판정 여유를 확보한 채로 +0.35 만큼 위로(허리~손 높이) 올렸다 - DoRanged(매직 클로/애로우
        -- 블로우)는 이 세션에서 별도로 지적받은 적이 없어 그쪽 스폰 높이는 그대로 둔다.
        local proj = _SpawnService:SpawnByModelId("projectile", name, Vector3(pos.x + 0.4 * dir, pos.y + 0.35, pos.z), map)
        if not isvalid(proj) then return end

        if def.projectileVfxRuid ~= nil and isvalid(proj.SpriteRendererComponent) then
            proj.SpriteRendererComponent.SpriteRUID = def.projectileVfxRuid
            -- Source art faces left by default - a projectile fired while facing right (dir>0)
            -- renders backwards without this (2026-08-17 user report, same root cause as DoRanged).
            proj.SpriteRendererComponent.FlipX = dir > 0
        end

        local projComp = proj:GetComponent("script.ProjectileComponent")
        local projAttack = proj:GetComponent("script.ProjectileAttackComponent")
        if isvalid(projAttack) then
            projAttack.Damage = damage
            projAttack.CriticalChance = critChance
            projAttack.CritDamageMultiplier = critMult
        end
        if isvalid(projComp) then
            projComp.Speed = 10
            projComp.MaxLifetime = 0.3
            projComp.HitRadius = 0.55
            projComp.Pierce = false
            projComp:Fire(dir, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void DoRanged(table def, boolean pierce)
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end

        local damage = attack.AttackDamage * def.coef
        if def.magic and isvalid(statsComp) then
            damage = damage * (1 + statsComp.SkillDamageBonus)
        end
        damage = math.floor(damage)

        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition

        self.ProjectileCount = self.ProjectileCount + 1
        local name = "skillproj_" .. tostring(self.ProjectileCount)
        -- Spawn at the caster's own Y (not offset up) - monsters are hit-checked against their own
        -- WorldPosition (foot-anchor), and ProjectileComponent's HitRadius=0.4 circular check has no
        -- vertical tolerance beyond that radius, so a +0.5 spawn offset flew every projectile clean
        -- over the head of any monster at the same ground level as the caster (confirmed via a real
        -- Play-session test: magicclaw/arrowblow both dealt 0 damage on a same-level dummy).
        local proj = _SpawnService:SpawnByModelId("projectile", name, Vector3(pos.x + 0.5 * dir, pos.y, pos.z), map)
        if not isvalid(proj) then return end

        -- Overrides the projectile model's default sprite so each ranged skill actually looks like
        -- itself (magic claw swipe / flying arrow) instead of every ranged_single/ranged_pierce
        -- sharing the same generic placeholder bullet baked into Models/Skills/Projectile.model.
        if def.projectileVfxRuid ~= nil and isvalid(proj.SpriteRendererComponent) then
            proj.SpriteRendererComponent.SpriteRUID = def.projectileVfxRuid
            -- Source art faces left by default (msw-search convention) - without this the
            -- projectile always renders in its left-facing default regardless of travel
            -- direction, so a right-facing cast (dir>0, the common case) looks backwards -
            -- reported 2026-08-17 as "매직 클로가 병신같이 날아다닌다."
            proj.SpriteRendererComponent.FlipX = dir > 0
            log("PlayerSkill: " .. def.name .. " projectile sprite -> " .. def.projectileVfxRuid)
            -- Color-multiply tint for a clip whose source art doesn't match this skill's real color
            -- (e.g. magicclaw's closest-shape-match substitute is orange, real Magic Claw is
            -- green/yellow - see SkillCatalog comment). Only applied when the def sets one.
            if def.projectileTintColor ~= nil then
                proj.SpriteRendererComponent.Color = def.projectileTintColor
            end
        end

        local projComp = proj:GetComponent("script.ProjectileComponent")
        local projAttack = proj:GetComponent("script.ProjectileAttackComponent")
        if isvalid(projAttack) then
            projAttack.Damage = damage
            projAttack.CriticalChance = attack.CriticalChance
            projAttack.CritDamageMultiplier = attack.CritDamageMultiplier
        end
        if isvalid(projComp) then
            projComp.Speed = 12
            projComp.MaxLifetime = 2
            projComp.HitRadius = 0.4
            projComp.Pierce = pierce
            projComp:Fire(dir, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void DoDash(table def)
        local body = self.Entity.RigidbodyComponent
        local controller = self.Entity.PlayerControllerComponent
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local transform = self.Entity.TransformComponent
        if not isvalid(body) or not isvalid(controller) or not isvalid(attack) or not isvalid(transform) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        body:AddForce(Vector2(dir * def.force, 0))

        -- 2026-09-10 QA - 환영 교체 링크("잔상 지원": 대시 시 짧은 무적시간) 신규 연결. 본인 특성의
        -- 분신 소환(선행 서브시스템 필요, 미착수)과 달리 링크는 무적시간 부여만 필요해 구현 가능.
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        if isvalid(statsComp) then
            local dashInvulnDuration = _TraitEffectEngine:GetLinkDashInvuln(statsComp.LinkTrait1)
            if dashInvulnDuration == 0 and statsComp.LinkTrait2 ~= "" then dashInvulnDuration = _TraitEffectEngine:GetLinkDashInvuln(statsComp.LinkTrait2) end
            if dashInvulnDuration > 0 then
                statsComp.LinkDashInvulnUntilElapsed = _UtilLogic.ElapsedSeconds + dashInvulnDuration
                log("PlayerSkill: 환영 교체 링크 - 잔상 지원 무적 발동")
            end
        end

        -- 2026-08-25 밸런스 - 대시에 실제 돌진 판정 데미지 추가(SkillCatalog 주석 참고, 해적 1차
        -- 공격 슬롯에 데미지 스킬이 하나도 없었던 문제 수정). AddForce와 같은 프레임에 즉시 판정 -
        -- 다른 근접 스킬처럼 타격 지연(DispatchSkill의 impactDelay)을 주면 이미 몸으로 부딪혀
        -- 지나간 뒤에 뒤늦게 맞는 것처럼 보여 "이펙트와 모션이 안 맞는다"는 지적을 그대로 재현하게
        -- 된다 - 대시는 이동 자체가 곧 스윙이므로 즉시 판정이 맞다. 돌진 거리 전체를 덮도록 다른
        -- 근접 스킬(1.5x1.4)보다 넓은 박스(2.4x1.4)를 사용.
        local pos = transform.WorldPosition
        local shape = BoxShape(Vector2(pos.x + 1.0 * dir, pos.y + 0.5), Vector2(2.4, 1.4), 0)
        local originalDamage = attack.AttackDamage
        attack.AttackDamage = math.floor(originalDamage * def.coef)
        attack:AttackFast(shape, "skill." .. def.id, CollisionGroups.Monster)
        attack.AttackDamage = originalDamage

        if def.hitVfxRuid ~= nil then
            local serial = _EffectService:PlayEffect(def.hitVfxRuid, self.Entity, Vector3(pos.x + 1.0 * dir, pos.y + 0.5, pos.z), 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " hit VFX serial=" .. tostring(serial))
        end

        if def.dashVfxRuid ~= nil then
            -- Attached (not a fixed-position PlayEffect) so the clip travels with the caster during
            -- the dash impulse instead of being left behind at the cast position - a fixed-position
            -- one-shot visibly failed to keep up the moment AddForce fired (2026-08-16, user report).
            local serial = _EffectService:PlayEffectAttached(def.dashVfxRuid, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " dash VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoDisorder(table def)
        -- 도적 1차 액티브 "디스에이블" - 데미지 없이 전방 가장 가까운 몬스터 1체의 Evasion을 일시
        -- 감소시킨다. AttackComponent 파이프라인을 타지 않고 직접 Monster 스크립트를 찾아 호출하는
        -- 이유: Attack/AttackFast는 항상 HitEvent(데미지 0이라도)를 발생시켜 데미지 스킨에 "0"이
        -- 뜨는 등 순수 디버프 스킬의 연출과 안 맞음 - ProjectileComponent 등에서 이미 쓰는
        -- GetChildComponentsByTypeName 기반 근접 탐색 패턴을 재사용.
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        local range = 3.0

        local monsters = map:GetChildComponentsByTypeName("script.Monster", true)
        local nearest = nil
        local nearestDist = range + 1
        for _, m in ipairs(monsters) do
            if isvalid(m) and isvalid(m.Entity) and not m.IsDead then
                local mpos = m.Entity.TransformComponent.WorldPosition
                local dx = mpos.x - pos.x
                if dx * dir >= 0 and math.abs(dx) <= range and math.abs(dx) < nearestDist then
                    nearestDist = math.abs(dx)
                    nearest = m
                end
            end
        end

        if nearest == nil then
            log("PlayerSkill: " .. def.name .. " no target in range")
            return
        end

        nearest:ApplyDisorder(def.evasionReduction, def.duration)
        log("PlayerSkill: " .. def.name .. " applied to " .. nearest.Entity.Name)
        if def.hitVfxRuid ~= nil then
            local mpos = nearest.Entity.TransformComponent.WorldPosition
            local serial = _EffectService:PlayEffect(def.hitVfxRuid, self.Entity, mpos, 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoBuff(table def)
        -- Only the testableEffect actually changes a real value (see SkillCatalog comments) - the
        -- rest of each buff's design is logged so the intent is visible without a fake mechanic.

        -- Casting a second buff while an earlier one is still active used to leak the earlier one:
        -- BuffParticleSerial/BuffType/BuffOriginalValue below were overwritten unconditionally, so
        -- the first buff's attached VFX was never removed (self:RevertBuff() was only ever called
        -- from OnUpdate's own-expiry check) and its stat change was never restored - reported as
        -- "effects that should disappear after use are staying on screen." Revert whatever is
        -- currently active first so every new cast starts from a clean state.
        if self.BuffActive then
            self:RevertBuff()
        end

        if def.inertNote ~= nil then
            log("PlayerSkill: " .. def.name .. " partial effect inert - " .. def.inertNote)
        end

        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local move = self.Entity.MovementComponent
        local player = self.Entity.PlayerComponent
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")

        -- 2026-09-08 QA - 포커스/님블바디의 evasionBonus(회피율 증가) 전용. testableEffect 슬롯과
        -- 별개로 항상 병행 적용 - EvasionPercent는 PlayerHit.HandleHitEvent가 이미 소비하고 있다.
        if def.evasionBonus ~= nil and isvalid(statsComp) then
            statsComp.EvasionPercent = math.min(0.9, statsComp.EvasionPercent + def.evasionBonus)
            self.BuffEvasionBonus = def.evasionBonus
        end

        if def.testableEffect == "accuracy" and isvalid(attack) then
            self.BuffOriginalValue = attack.Accuracy
            attack.Accuracy = attack.Accuracy + def.accuracyBonus
        elseif def.testableEffect == "movespeed" and isvalid(move) then
            self.BuffOriginalValue = move.InputSpeed
            move.InputSpeed = move.InputSpeed + def.moveSpeedBonus
        elseif def.testableEffect == "atkspeed" and isvalid(attack) then
            self.BuffOriginalValue = attack.AttackCooldownSeconds
            attack.AttackCooldownSeconds = attack.AttackCooldownSeconds * 0.4
        elseif def.testableEffect == "critchance" and isvalid(attack) then
            -- darksight (2026-08-16) - real Dark Sight is a stealth/evasion skill with no consumer
            -- yet (no monster-attacks-player pipeline), reinterpreted as "strike from the shadows"
            -- bonus crit chance instead - immediately observable via CalcCritical's real roll.
            self.BuffOriginalValue = attack.CriticalChance
            attack.CriticalChance = math.min(1.0, attack.CriticalChance + def.critChanceBonus)
        elseif def.testableEffect == "maxhp" and isvalid(player) then
            -- ironbody (2026-08-16 completion) - real Iron Body's defense boost has no observable
            -- effect yet (no monster-attacks-player pipeline), so this grants a temporary MaxHp
            -- increase instead - "몸이 단단해진다" stays true to the theme and is immediately visible
            -- on the HP bar. Store the bonus (not the pre-buff MaxHp) so a mid-buff level-up's MaxHp
            -- change isn't clobbered by RevertBuff.
            local bonus = math.floor(player.MaxHp * def.maxHpBonusPercent)
            self.BuffOriginalValue = bonus
            player.MaxHp = player.MaxHp + bonus
            player.Hp = player.Hp + bonus
        elseif def.testableEffect == "mpfree" then
            -- magicguard (2026-08-16 completion) - real Magic Guard converts incoming HP damage to MP
            -- loss, same missing-pipeline blocker as ironbody. Reinterpreted as free skill MP cost for
            -- the buff's duration ("마나가 보호막처럼 스킬 비용을 대신 막아준다") - see UseSkill's
            -- mpFreeActive check. Nothing to store; RevertBuff just clears BuffType/BuffActive.
            self.BuffOriginalValue = 0
        elseif def.testableEffect == "dmgreduction" and isvalid(statsComp) then
            -- 2026-09-06 (M2 Phase D, 2/3차 신규) - powerguard/ironwill. Now that a monster->player hit
            -- pipeline exists (Phase 3.5) and PlayerStatsComponent.DamageReductionPercent is a real,
            -- observable channel (PlayerHit reads it), a temporary defense buff is fully testable -
            -- unlike ironbody/magicguard's 2026-08-16 reinterpretation, no substitute effect needed.
            -- Same "store the delta, add now, subtract on revert" pattern as maxhp below - a
            -- RecalculateDerived mid-buff (level-up) will still reset the base value from scratch and
            -- silently drop this addition, matching ironbody's known, accepted limitation.
            self.BuffOriginalValue = def.dmgReductionBonus
            statsComp.DamageReductionPercent = statsComp.DamageReductionPercent + def.dmgReductionBonus
        elseif def.testableEffect == "skilldmg" and isvalid(statsComp) then
            -- meditation/magicbooster/infinity - adds directly onto PlayerStatsComponent.SkillDamageBonus
            -- (the same field DoRanged's `magic` branch already reads), so a magic ranged_single/
            -- ranged_pierce ability gets a real, observable temporary boost.
            self.BuffOriginalValue = def.skillDmgBonus
            statsComp.SkillDamageBonus = statsComp.SkillDamageBonus + def.skillDmgBonus
        elseif def.testableEffect == "atkbonus" and isvalid(attack) then
            -- rage/markofassassin/battleship - flat delta on PlayerAttack.AttackDamage, same pattern as
            -- ironbody's maxhp (store the bonus itself, not the pre-buff base, so a mid-buff stat
            -- recompute doesn't get double-subtracted on revert).
            local bonus = math.floor(attack.AttackDamage * def.atkBonusPercent)
            self.BuffOriginalValue = bonus
            attack.AttackDamage = attack.AttackDamage + bonus
        else
            self.BuffOriginalValue = 0
        end

        self.BuffType = def.testableEffect
        self.BuffActive = true
        self.BuffExpireTime = _UtilLogic.ElapsedSeconds + def.duration

        -- Real MapleStory skill clip (buffVfxRuid) takes priority and is looped+attached to the
        -- caster for the whole buff duration via PlayEffectAttached(isLoop=true) - this is the
        -- authentic per-skill visual (magic guard's shield swirl, haste's speed-lines, etc.), not a
        -- generic shape. Only falls back to the native BasicParticleType aura (auraType/auraColor)
        -- when no matching skill clip exists in the resource index at all (ironbody only, as of the
        -- 2026-08-13 audit - see SkillCatalog comments). Using BOTH at once was the previous bug:
        -- the flat-colored generic aura loop visually drowned out the one-shot real clip that used
        -- to play under it, so every buff still read as "a random particle blob" even after the
        -- correct RUID was wired in.
        if def.buffVfxRuid ~= nil then
            self.BuffUsingSkillVfx = true
            -- SyncFlip (not a manual dir snapshot) so the looped clip keeps following the caster's
            -- facing for the whole buff duration, not just whichever way they faced at cast time -
            -- same "player-attached effect must follow facing" rule as msw-combat-system SKILL.md §4.
            self.BuffParticleSerial = _EffectService:PlayEffectAttached(def.buffVfxRuid, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true, { SyncFlip = true })
            log("PlayerSkill: " .. def.name .. " skill VFX (looped) serial=" .. tostring(self.BuffParticleSerial))
        elseif def.auraType ~= nil then
            self.BuffUsingSkillVfx = false
            local particleType = self:ResolveBasicParticleType(def.auraType)
            if particleType ~= nil then
                self.BuffParticleSerial = _ParticleService:PlayBasicParticleAttached(particleType, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true, { Color = def.auraColor })
                log("PlayerSkill: " .. def.name .. " generic aura fallback serial=" .. tostring(self.BuffParticleSerial))
            end
        end
    end

    @ExecSpace("ServerOnly")
    method any ResolveBasicParticleType(string key)
        -- Converts the SkillCatalog string key back into the engine's BasicParticleType enum -
        -- enums can't cross data tables/RPC boundaries directly (see msw-scripting §6), so each
        -- buff's def just carries the enum's field name and this maps it back locally.
        if key == "Aura" then return BasicParticleType.Aura
        elseif key == "Enchant" then return BasicParticleType.Enchant
        elseif key == "SpinField" then return BasicParticleType.SpinField
        elseif key == "Buff" then return BasicParticleType.Buff
        elseif key == "LightningOrbSoft" then return BasicParticleType.LightningOrbSoft
        end
        return nil
    end

    @ExecSpace("ServerOnly")
    method void RevertBuff()
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local move = self.Entity.MovementComponent
        local player = self.Entity.PlayerComponent
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")

        if self.BuffType == "accuracy" and isvalid(attack) then
            attack.Accuracy = self.BuffOriginalValue
        elseif self.BuffType == "movespeed" and isvalid(move) then
            move.InputSpeed = self.BuffOriginalValue
        elseif self.BuffType == "atkspeed" and isvalid(attack) then
            attack.AttackCooldownSeconds = self.BuffOriginalValue
        elseif self.BuffType == "critchance" and isvalid(attack) then
            attack.CriticalChance = self.BuffOriginalValue
        elseif self.BuffType == "maxhp" and isvalid(player) then
            player.MaxHp = math.max(1, player.MaxHp - self.BuffOriginalValue)
            player.Hp = math.min(player.Hp, player.MaxHp)
        elseif self.BuffType == "dmgreduction" and isvalid(statsComp) then
            statsComp.DamageReductionPercent = math.max(0, statsComp.DamageReductionPercent - self.BuffOriginalValue)
        elseif self.BuffType == "skilldmg" and isvalid(statsComp) then
            statsComp.SkillDamageBonus = math.max(0, statsComp.SkillDamageBonus - self.BuffOriginalValue)
        elseif self.BuffType == "atkbonus" and isvalid(attack) then
            attack.AttackDamage = math.max(1, attack.AttackDamage - self.BuffOriginalValue)
        end
        -- "mpfree" (magicguard) has no stat to restore - UseSkill's mpFreeActive check already
        -- stops reading it the instant BuffActive/BuffType are cleared below.

        -- 2026-09-08 QA - evasionBonus(포커스/님블바디) 복원. BuffType 슬롯과 독립적으로 병행
        -- 적용됐으므로 여기서도 독립적으로 되돌린다.
        if self.BuffEvasionBonus > 0 and isvalid(statsComp) then
            statsComp.EvasionPercent = math.max(0, statsComp.EvasionPercent - self.BuffEvasionBonus)
            self.BuffEvasionBonus = 0
        end

        if self.BuffParticleSerial ~= 0 then
            if self.BuffUsingSkillVfx then
                _EffectService:RemoveEffect(self.BuffParticleSerial)
            else
                _ParticleService:RemoveParticle(self.BuffParticleSerial)
            end
            self.BuffParticleSerial = 0
            self.BuffUsingSkillVfx = false
        end

        log("PlayerSkill: buff expired, reverted " .. self.BuffType)
        self.BuffActive = false
        self.BuffType = ""
    end

end
