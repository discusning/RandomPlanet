@Component
script PlayerSkillComponent extends Component
    -- 전직별 스킬 보유·장착 실행기 (Docs/랜덤 플래닛 전체 기획서.md §04 "버프풀 3택1 + 공격풀 3택1
    -- 동시 진행"). 스킬 정의는 SkillCatalog(@Logic)에서 조회, 실제 수치는 PlayerAttack/
    -- PlayerStatsComponent/MovementComponent를 그때그때 읽고 쓴다(각 스탯 공식은 그쪽이 유일한 소유자).
    -- 8개 고정 슬롯(1~4차 x 버프/공격)에 보유 스킬을 저장하고, 그중 하나만 EquippedSkillId로 "Skill"
    -- (Q)키에 실제 장착한다 - 전직/레벨업 3택1 선택 UI는 아직 없어(Phase 3+ 몫) 매 티어 첫 미보유
    -- 후보를 자동 지급한다(GrantTierSkills). 캐릭터 생성 시점(1차)만 유저가 카드에서 직접 고른
    -- skillId 하나를 받고, 나머지 1차 반대 카테고리 슬롯은 자동으로 채운다(GrantInitialSkill).

    @Sync property string BuffSkill1 = ""
    @Sync property string BuffSkill2 = ""
    @Sync property string BuffSkill3 = ""
    @Sync property string BuffSkill4 = ""
    @Sync property string AtkSkill1 = ""
    @Sync property string AtkSkill2 = ""
    @Sync property string AtkSkill3 = ""
    @Sync property string AtkSkill4 = ""
    @Sync property string EquippedSkillId = ""
    @Sync @HideFromInspector property number LastUseTime = -999
    @HideFromInspector property boolean BuffActive = false
    @HideFromInspector property number BuffExpireTime = 0
    @HideFromInspector property string BuffType = ""
    @HideFromInspector property number BuffOriginalValue = 0
    @HideFromInspector property integer BuffParticleSerial = 0
    @HideFromInspector property boolean BuffUsingSkillVfx = false
    @HideFromInspector property integer ProjectileCount = 0

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self.BuffActive then return end
        if _UtilLogic.ElapsedSeconds < self.BuffExpireTime then return end
        self:RevertBuff()
    end

    @ExecSpace("ServerOnly")
    method void GrantInitialSkill(string skillId)
        -- Called once from RequestEnterGame/SwapActiveCharacter with the single skill the player
        -- picked on the character card (cycle-through-3 picker, still a flat mixed pool - see
        -- SkillCatalog.RollThreeSkills). Puts it in its own category's tier-1 slot, then auto-fills
        -- the OTHER tier-1 category slot with the first available id (no picker yet for that half -
        -- guarantees every character starts with exactly 1 buff + 1 attack per §04's "1+1=2개").
        if skillId == nil or skillId == "" then return end
        local isBuff = _SkillCatalog:IsBuffSkill(skillId)
        if isBuff then
            self.BuffSkill1 = skillId
            local atkChoices = _SkillCatalog:RollSkillChoices("attack", {})
            if #atkChoices > 0 then self.AtkSkill1 = atkChoices[1] end
        else
            self.AtkSkill1 = skillId
            local buffChoices = _SkillCatalog:RollSkillChoices("buff", {})
            if #buffChoices > 0 then self.BuffSkill1 = buffChoices[1] end
        end
        self.EquippedSkillId = skillId
        log("PlayerSkill: GrantInitialSkill skillId=" .. skillId .. " buff1=" .. self.BuffSkill1 .. " atk1=" .. self.AtkSkill1)
    end

    @ExecSpace("ServerOnly")
    method void GrantTierSkills(integer tier)
        -- Auto-grants one unowned buff + one unowned attack skill into the given tier's slots (2/3/4
        -- only - tier 1 is handled by GrantInitialSkill). No 3택1 choice UI exists yet (Phase 3+), so
        -- this always takes the first rolled candidate - see header comment.
        if tier < 2 or tier > 4 then return end
        local owned = self:GetOwnedSkillIds()
        local ownedIds = {}
        for _, entry in ipairs(owned) do
            table.insert(ownedIds, entry.id)
        end

        local buffChoices = _SkillCatalog:RollSkillChoices("buff", ownedIds)
        if #buffChoices > 0 then
            self:SetTierSlot("buff", tier, buffChoices[1])
        end
        local atkChoices = _SkillCatalog:RollSkillChoices("attack", ownedIds)
        if #atkChoices > 0 then
            self:SetTierSlot("attack", tier, atkChoices[1])
        end
        log("PlayerSkill: GrantTierSkills tier=" .. tier .. " buff=" .. tostring(buffChoices[1]) .. " atk=" .. tostring(atkChoices[1]))
    end

    @ExecSpace("ServerOnly")
    method void SetTierSlot(string category, integer tier, string skillId)
        if category == "buff" then
            if tier == 1 then self.BuffSkill1 = skillId
            elseif tier == 2 then self.BuffSkill2 = skillId
            elseif tier == 3 then self.BuffSkill3 = skillId
            elseif tier == 4 then self.BuffSkill4 = skillId
            end
        else
            if tier == 1 then self.AtkSkill1 = skillId
            elseif tier == 2 then self.AtkSkill2 = skillId
            elseif tier == 3 then self.AtkSkill3 = skillId
            elseif tier == 4 then self.AtkSkill4 = skillId
            end
        end
    end

    method table GetOwnedSkillIds()
        -- Returns { {id, tier, category}, ... } for every filled slot - the skill window's data
        -- source (see SkillUIController.Refresh).
        local result = {}
        local buffSlots = { self.BuffSkill1, self.BuffSkill2, self.BuffSkill3, self.BuffSkill4 }
        local atkSlots = { self.AtkSkill1, self.AtkSkill2, self.AtkSkill3, self.AtkSkill4 }
        for i, id in ipairs(buffSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "buff" })
            end
        end
        for i, id in ipairs(atkSlots) do
            if id ~= "" then
                table.insert(result, { id = id, tier = i, category = "attack" })
            end
        end
        return result
    end

    @ExecSpace("Server")
    method void RequestSetEquippedSkill(string skillId)
        -- Client-invoked (skill window "장착" button). Only allows equipping an actually-owned
        -- skill - rejects a spoofed/unknown id silently (no error, just a no-op + log).
        local owned = self:GetOwnedSkillIds()
        for _, entry in ipairs(owned) do
            if entry.id == skillId then
                self.EquippedSkillId = skillId
                log("PlayerSkill: equipped " .. skillId)
                return
            end
        end
        log("PlayerSkill: RequestSetEquippedSkill rejected, not owned: " .. tostring(skillId))
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- Resolves the player's skill key (Q) into UseSkill(). Mirrors PlayerAttack's own
        -- ActionName-filtered handler pattern for the "Attack" key.
        if event.ActionName ~= "Skill" then return end
        self:UseSkill()
    end

    @ExecSpace("ServerOnly")
    method void UseSkill()
        if self.EquippedSkillId == "" then return end
        local def = _SkillCatalog:GetSkillDef(self.EquippedSkillId)
        if def == nil then return end
        if _UtilLogic.ElapsedSeconds - self.LastUseTime < def.cooldown then
            return
        end
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        -- 절약가(1차 특성) - 스킬 MP 소모 30% 감소(상시, magicguard의 시전형 mpfree와 별개). 순수
        -- 유틸 스탯이라 CP에는 반영하지 않지만(PlayerStatsComponent 참고) 실제로 MP 차감에 반영된다.
        local mpCost = def.mpCost
        if isvalid(statsComp) and statsComp.Trait == "절약가" then
            mpCost = math.floor(mpCost * 0.7)
        end
        -- magicguard (testableEffect="mpfree") makes skill MP cost free for its own duration - see
        -- DoBuff/RevertBuff. Check/deduction below is skipped entirely while it's active.
        local mpFreeActive = self.BuffActive and self.BuffType == "mpfree"
        if not mpFreeActive then
            if not isvalid(statsComp) or statsComp.CurrentMp < mpCost then
                log("PlayerSkill: not enough MP for " .. def.name)
                return
            end
        end

        self.LastUseTime = _UtilLogic.ElapsedSeconds
        if not mpFreeActive then
            statsComp.CurrentMp = statsComp.CurrentMp - mpCost
        end
        log("PlayerSkill: use " .. def.name .. " (kind=" .. def.kind .. " mp=" .. mpCost .. (mpFreeActive and " [mpfree]" or "") .. ")")

        -- Skill use and the basic attack (PlayerAttack.DoAttack) are driven by two independent,
        -- unlinked cooldown timers - PlayerControllerComponent fires a fresh PlayerActionEvent
        -- for the Attack key on every tick it's held (that's why DoAttack needs its own cooldown
        -- gate at all), so a player holding Attack while tapping a skill would have their
        -- already-elapsed AttackCooldownSeconds fire a basic attack immediately after (or during)
        -- the skill's own near-instant resolution - reported as "some skills chain into a basic
        -- attack afterward," really just an unsynced-timer coincidence, not a per-skill defect.
        -- Refreshing the shared attack timer here (classic MapleStory behavior: using a skill also
        -- resets your attack timer) closes that window.
        local attackComp = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(attackComp) then
            attackComp.LastAttackTime = _UtilLogic.ElapsedSeconds
        end

        -- dash already reads as a motion via its own AddForce impulse - every other kind gets a
        -- body pose here since the "Skill"(Q) action isn't part of PlayerControllerComponent's
        -- auto-state set (only "Attack"/LeftControl is - see msw-avatar SKILL.md), so without this
        -- the character would stand idle while only the VFX/damage happen.
        if def.kind ~= "dash" then
            self:PlaySkillMotion(def.kind == "buff" and "Heal" or "Attack")
        end

        if def.kind == "melee_single" then
            self:DoMeleeSingle(def)
        elseif def.kind == "ranged_single" or def.kind == "ranged_pierce" then
            self:DoRanged(def, def.kind == "ranged_pierce")
        elseif def.kind == "multi_hit" then
            self:DoMultiHit(def)
        elseif def.kind == "dash" then
            self:DoDash(def)
        elseif def.kind == "debuff" then
            self:DoDisorder(def)
        elseif def.kind == "buff" then
            self:DoBuff(def)
        end
    end

    @ExecSpace("Client")
    method void PlaySkillMotion(string poseName)
        -- Replays a built-in avatar body pose (Attack swing / Heal self-cast) via a fresh
        -- BodyActionStateChangeEvent instead of StateComponent:ChangeState("ATTACK") - the latter
        -- gets silently stomped because PlayerControllerComponent re-evaluates real held keys every
        -- tick and would immediately transition back to IDLE/MOVE since Q isn't in its own action
        -- set (see msw-avatar SKILL.md "14 states vs custom actions" + its ChangeState pitfall).
        -- Called with no target from ServerOnly code, so it's a broadcast RPC every nearby client sees.
        local actionState = MapleAvatarBodyActionState.Attack
        if poseName == "Heal" then
            actionState = MapleAvatarBodyActionState.Heal
        end
        local event = BodyActionStateChangeEvent()
        event.ActionState = actionState
        event.needResetAction = true
        self.Entity:SendEvent(event)
    end

    @ExecSpace("ServerOnly")
    method void DoMeleeSingle(table def)
        -- Reuses PlayerAttack's existing hitbox/crit pipeline - temporarily scales AttackDamage by
        -- the skill coefficient, fires, then restores the base value in the same call.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        -- def.wide (slashblast) uses a much wider frontal box than the default single-target zone -
        -- AttackFast already resolves against every entity overlapping the shape (not just one), so
        -- a plain wider BoxShape is enough to turn this into a real frontal AoE - no new "kind" needed.
        local boxSize = def.wide and Vector2(2.6, 1.6) or Vector2(1.5, 1.4)
        local shape = BoxShape(Vector2(pos.x + 0.7 * dir, pos.y + 0.5), boxSize, 0)

        local originalDamage = attack.AttackDamage
        attack.AttackDamage = math.floor(originalDamage * def.coef)
        attack:AttackFast(shape, "skill." .. def.id, CollisionGroups.Monster)
        attack.AttackDamage = originalDamage

        if def.hitVfxRuid ~= nil then
            -- FlipX must be set explicitly per cast - PlayEffect never inherits the caster's
            -- current facing on its own (2026-08-17 user report: "매직 클로가 이상하게 날아다닌다"
            -- traced to this exact gap on the ranged projectile below; melee hit clips have the same
            -- gap even though it's less visible for a roughly-symmetric burst shape). Source art
            -- faces left by default (msw-search convention), so dir>0 (facing right) needs FlipX=true.
            local serial = _EffectService:PlayEffect(def.hitVfxRuid, self.Entity, Vector3(pos.x + 0.7 * dir, pos.y + 0.5, pos.z), 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " hit VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoMultiHit(table def)
        -- Lucky Seven (currently the only multi_hit skill) - real classic MapleStory throws daggers a
        -- short distance rather than swinging like a melee weapon (2026-08-16 usage-location audit:
        -- the previous instant frontal-box version read identically to a sword swing). Spawns def.hits
        -- real short-range projectiles staggered ~0.09s apart (a visible "rapid throw" instead of one
        -- simultaneous flash) via FireThrownDagger, reusing DoRanged's spawn/override pattern but with
        -- a short MaxLifetime so each dagger only travels a few units before disappearing.
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        local damage = math.floor(attack.AttackDamage * def.coef)
        local critChance = attack.CriticalChance
        local critMult = attack.CritDamageMultiplier

        for i = 1, def.hits do
            local delay = (i - 1) * 0.09
            _TimerService:SetTimerOnce(function()
                self:FireThrownDagger(def, dir, pos, map, damage, critChance, critMult)
            end, delay)
        end
    end

    @ExecSpace("ServerOnly")
    method void FireThrownDagger(table def, integer dir, Vector3 pos, Entity map, integer damage, number critChance, number critMult)
        -- One thrown dagger for Lucky Seven's DoMultiHit above - short travel distance (Speed*MaxLifetime
        -- ~= 3 units) so it visibly leaves the caster's hand and lands nearby instead of an instant hit.
        self.ProjectileCount = self.ProjectileCount + 1
        local name = "skillproj_" .. tostring(self.ProjectileCount)
        -- Same-Y spawn as DoRanged (not +0.5) - ProjectileComponent's HitRadius circular check has no
        -- vertical tolerance beyond its radius; a raised spawn flies clean over a same-level monster.
        local proj = _SpawnService:SpawnByModelId("projectile", name, Vector3(pos.x + 0.4 * dir, pos.y, pos.z), map)
        if not isvalid(proj) then return end

        if def.projectileVfxRuid ~= nil and isvalid(proj.SpriteRendererComponent) then
            proj.SpriteRendererComponent.SpriteRUID = def.projectileVfxRuid
            -- Source art faces left by default - a projectile fired while facing right (dir>0)
            -- renders backwards without this (2026-08-17 user report, same root cause as DoRanged).
            proj.SpriteRendererComponent.FlipX = dir > 0
        end

        local projComp = proj:GetComponent("script.ProjectileComponent")
        local projAttack = proj:GetComponent("script.ProjectileAttackComponent")
        if isvalid(projAttack) then
            projAttack.Damage = damage
            projAttack.CriticalChance = critChance
            projAttack.CritDamageMultiplier = critMult
        end
        if isvalid(projComp) then
            projComp.Speed = 10
            projComp.MaxLifetime = 0.3
            projComp.HitRadius = 0.4
            projComp.Pierce = false
            projComp:Fire(dir, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void DoRanged(table def, boolean pierce)
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local statsComp = self.Entity:GetComponent("script.PlayerStatsComponent")
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(attack) or not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end

        local damage = attack.AttackDamage * def.coef
        if def.magic and isvalid(statsComp) then
            damage = damage * (1 + statsComp.SkillDamageBonus)
        end
        damage = math.floor(damage)

        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition

        self.ProjectileCount = self.ProjectileCount + 1
        local name = "skillproj_" .. tostring(self.ProjectileCount)
        -- Spawn at the caster's own Y (not offset up) - monsters are hit-checked against their own
        -- WorldPosition (foot-anchor), and ProjectileComponent's HitRadius=0.4 circular check has no
        -- vertical tolerance beyond that radius, so a +0.5 spawn offset flew every projectile clean
        -- over the head of any monster at the same ground level as the caster (confirmed via a real
        -- Play-session test: magicclaw/arrowblow both dealt 0 damage on a same-level dummy).
        local proj = _SpawnService:SpawnByModelId("projectile", name, Vector3(pos.x + 0.5 * dir, pos.y, pos.z), map)
        if not isvalid(proj) then return end

        -- Overrides the projectile model's default sprite so each ranged skill actually looks like
        -- itself (magic claw swipe / flying arrow) instead of every ranged_single/ranged_pierce
        -- sharing the same generic placeholder bullet baked into Models/Skills/Projectile.model.
        if def.projectileVfxRuid ~= nil and isvalid(proj.SpriteRendererComponent) then
            proj.SpriteRendererComponent.SpriteRUID = def.projectileVfxRuid
            -- Source art faces left by default (msw-search convention) - without this the
            -- projectile always renders in its left-facing default regardless of travel
            -- direction, so a right-facing cast (dir>0, the common case) looks backwards -
            -- reported 2026-08-17 as "매직 클로가 병신같이 날아다닌다."
            proj.SpriteRendererComponent.FlipX = dir > 0
            log("PlayerSkill: " .. def.name .. " projectile sprite -> " .. def.projectileVfxRuid)
            -- Color-multiply tint for a clip whose source art doesn't match this skill's real color
            -- (e.g. magicclaw's closest-shape-match substitute is orange, real Magic Claw is
            -- green/yellow - see SkillCatalog comment). Only applied when the def sets one.
            if def.projectileTintColor ~= nil then
                proj.SpriteRendererComponent.Color = def.projectileTintColor
            end
        end

        local projComp = proj:GetComponent("script.ProjectileComponent")
        local projAttack = proj:GetComponent("script.ProjectileAttackComponent")
        if isvalid(projAttack) then
            projAttack.Damage = damage
            projAttack.CriticalChance = attack.CriticalChance
            projAttack.CritDamageMultiplier = attack.CritDamageMultiplier
        end
        if isvalid(projComp) then
            projComp.Speed = 12
            projComp.MaxLifetime = 2
            projComp.HitRadius = 0.4
            projComp.Pierce = pierce
            projComp:Fire(dir, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void DoDash(table def)
        local body = self.Entity.RigidbodyComponent
        local controller = self.Entity.PlayerControllerComponent
        if not isvalid(body) or not isvalid(controller) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        body:AddForce(Vector2(dir * def.force, 0))

        if def.dashVfxRuid ~= nil then
            -- Attached (not a fixed-position PlayEffect) so the clip travels with the caster during
            -- the dash impulse instead of being left behind at the cast position - a fixed-position
            -- one-shot visibly failed to keep up the moment AddForce fired (2026-08-16, user report).
            local serial = _EffectService:PlayEffectAttached(def.dashVfxRuid, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " dash VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoDisorder(table def)
        -- 도적 1차 액티브 "디스에이블" - 데미지 없이 전방 가장 가까운 몬스터 1체의 Evasion을 일시
        -- 감소시킨다. AttackComponent 파이프라인을 타지 않고 직접 Monster 스크립트를 찾아 호출하는
        -- 이유: Attack/AttackFast는 항상 HitEvent(데미지 0이라도)를 발생시켜 데미지 스킨에 "0"이
        -- 뜨는 등 순수 디버프 스킬의 연출과 안 맞음 - ProjectileComponent 등에서 이미 쓰는
        -- GetChildComponentsByTypeName 기반 근접 탐색 패턴을 재사용.
        local transform = self.Entity.TransformComponent
        local controller = self.Entity.PlayerControllerComponent
        local map = self.Entity.CurrentMap
        if not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end
        local dir = controller.LookDirectionX
        if dir == 0 then dir = 1 end
        local pos = transform.WorldPosition
        local range = 3.0

        local monsters = map:GetChildComponentsByTypeName("script.Monster", true)
        local nearest = nil
        local nearestDist = range + 1
        for _, m in ipairs(monsters) do
            if isvalid(m) and isvalid(m.Entity) and not m.IsDead then
                local mpos = m.Entity.TransformComponent.WorldPosition
                local dx = mpos.x - pos.x
                if dx * dir >= 0 and math.abs(dx) <= range and math.abs(dx) < nearestDist then
                    nearestDist = math.abs(dx)
                    nearest = m
                end
            end
        end

        if nearest == nil then
            log("PlayerSkill: " .. def.name .. " no target in range")
            return
        end

        nearest:ApplyDisorder(def.evasionReduction, def.duration)
        log("PlayerSkill: " .. def.name .. " applied to " .. nearest.Entity.Name)
        if def.hitVfxRuid ~= nil then
            local mpos = nearest.Entity.TransformComponent.WorldPosition
            local serial = _EffectService:PlayEffect(def.hitVfxRuid, self.Entity, mpos, 0, Vector3(1, 1, 1), false, { FlipX = dir > 0 })
            log("PlayerSkill: " .. def.name .. " VFX serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ServerOnly")
    method void DoBuff(table def)
        -- Only the testableEffect actually changes a real value (see SkillCatalog comments) - the
        -- rest of each buff's design is logged so the intent is visible without a fake mechanic.

        -- Casting a second buff while an earlier one is still active used to leak the earlier one:
        -- BuffParticleSerial/BuffType/BuffOriginalValue below were overwritten unconditionally, so
        -- the first buff's attached VFX was never removed (self:RevertBuff() was only ever called
        -- from OnUpdate's own-expiry check) and its stat change was never restored - reported as
        -- "effects that should disappear after use are staying on screen." Revert whatever is
        -- currently active first so every new cast starts from a clean state.
        if self.BuffActive then
            self:RevertBuff()
        end

        if def.inertNote ~= nil then
            log("PlayerSkill: " .. def.name .. " partial effect inert - " .. def.inertNote)
        end

        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local move = self.Entity.MovementComponent
        local player = self.Entity.PlayerComponent

        if def.testableEffect == "accuracy" and isvalid(attack) then
            self.BuffOriginalValue = attack.Accuracy
            attack.Accuracy = attack.Accuracy + def.accuracyBonus
        elseif def.testableEffect == "movespeed" and isvalid(move) then
            self.BuffOriginalValue = move.InputSpeed
            move.InputSpeed = move.InputSpeed + def.moveSpeedBonus
        elseif def.testableEffect == "atkspeed" and isvalid(attack) then
            self.BuffOriginalValue = attack.AttackCooldownSeconds
            attack.AttackCooldownSeconds = attack.AttackCooldownSeconds * 0.4
        elseif def.testableEffect == "critchance" and isvalid(attack) then
            -- darksight (2026-08-16) - real Dark Sight is a stealth/evasion skill with no consumer
            -- yet (no monster-attacks-player pipeline), reinterpreted as "strike from the shadows"
            -- bonus crit chance instead - immediately observable via CalcCritical's real roll.
            self.BuffOriginalValue = attack.CriticalChance
            attack.CriticalChance = math.min(1.0, attack.CriticalChance + def.critChanceBonus)
        elseif def.testableEffect == "maxhp" and isvalid(player) then
            -- ironbody (2026-08-16 completion) - real Iron Body's defense boost has no observable
            -- effect yet (no monster-attacks-player pipeline), so this grants a temporary MaxHp
            -- increase instead - "몸이 단단해진다" stays true to the theme and is immediately visible
            -- on the HP bar. Store the bonus (not the pre-buff MaxHp) so a mid-buff level-up's MaxHp
            -- change isn't clobbered by RevertBuff.
            local bonus = math.floor(player.MaxHp * def.maxHpBonusPercent)
            self.BuffOriginalValue = bonus
            player.MaxHp = player.MaxHp + bonus
            player.Hp = player.Hp + bonus
        elseif def.testableEffect == "mpfree" then
            -- magicguard (2026-08-16 completion) - real Magic Guard converts incoming HP damage to MP
            -- loss, same missing-pipeline blocker as ironbody. Reinterpreted as free skill MP cost for
            -- the buff's duration ("마나가 보호막처럼 스킬 비용을 대신 막아준다") - see UseSkill's
            -- mpFreeActive check. Nothing to store; RevertBuff just clears BuffType/BuffActive.
            self.BuffOriginalValue = 0
        else
            self.BuffOriginalValue = 0
        end

        self.BuffType = def.testableEffect
        self.BuffActive = true
        self.BuffExpireTime = _UtilLogic.ElapsedSeconds + def.duration

        -- Real MapleStory skill clip (buffVfxRuid) takes priority and is looped+attached to the
        -- caster for the whole buff duration via PlayEffectAttached(isLoop=true) - this is the
        -- authentic per-skill visual (magic guard's shield swirl, haste's speed-lines, etc.), not a
        -- generic shape. Only falls back to the native BasicParticleType aura (auraType/auraColor)
        -- when no matching skill clip exists in the resource index at all (ironbody only, as of the
        -- 2026-08-13 audit - see SkillCatalog comments). Using BOTH at once was the previous bug:
        -- the flat-colored generic aura loop visually drowned out the one-shot real clip that used
        -- to play under it, so every buff still read as "a random particle blob" even after the
        -- correct RUID was wired in.
        if def.buffVfxRuid ~= nil then
            self.BuffUsingSkillVfx = true
            -- SyncFlip (not a manual dir snapshot) so the looped clip keeps following the caster's
            -- facing for the whole buff duration, not just whichever way they faced at cast time -
            -- same "player-attached effect must follow facing" rule as msw-combat-system SKILL.md §4.
            self.BuffParticleSerial = _EffectService:PlayEffectAttached(def.buffVfxRuid, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true, { SyncFlip = true })
            log("PlayerSkill: " .. def.name .. " skill VFX (looped) serial=" .. tostring(self.BuffParticleSerial))
        elseif def.auraType ~= nil then
            self.BuffUsingSkillVfx = false
            local particleType = self:ResolveBasicParticleType(def.auraType)
            if particleType ~= nil then
                self.BuffParticleSerial = _ParticleService:PlayBasicParticleAttached(particleType, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true, { Color = def.auraColor })
                log("PlayerSkill: " .. def.name .. " generic aura fallback serial=" .. tostring(self.BuffParticleSerial))
            end
        end
    end

    @ExecSpace("ServerOnly")
    method any ResolveBasicParticleType(string key)
        -- Converts the SkillCatalog string key back into the engine's BasicParticleType enum -
        -- enums can't cross data tables/RPC boundaries directly (see msw-scripting §6), so each
        -- buff's def just carries the enum's field name and this maps it back locally.
        if key == "Aura" then return BasicParticleType.Aura
        elseif key == "Enchant" then return BasicParticleType.Enchant
        elseif key == "SpinField" then return BasicParticleType.SpinField
        elseif key == "Buff" then return BasicParticleType.Buff
        elseif key == "LightningOrbSoft" then return BasicParticleType.LightningOrbSoft
        end
        return nil
    end

    @ExecSpace("ServerOnly")
    method void RevertBuff()
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        local move = self.Entity.MovementComponent
        local player = self.Entity.PlayerComponent

        if self.BuffType == "accuracy" and isvalid(attack) then
            attack.Accuracy = self.BuffOriginalValue
        elseif self.BuffType == "movespeed" and isvalid(move) then
            move.InputSpeed = self.BuffOriginalValue
        elseif self.BuffType == "atkspeed" and isvalid(attack) then
            attack.AttackCooldownSeconds = self.BuffOriginalValue
        elseif self.BuffType == "critchance" and isvalid(attack) then
            attack.CriticalChance = self.BuffOriginalValue
        elseif self.BuffType == "maxhp" and isvalid(player) then
            player.MaxHp = math.max(1, player.MaxHp - self.BuffOriginalValue)
            player.Hp = math.min(player.Hp, player.MaxHp)
        end
        -- "mpfree" (magicguard) has no stat to restore - UseSkill's mpFreeActive check already
        -- stops reading it the instant BuffActive/BuffType are cleared below.

        if self.BuffParticleSerial ~= 0 then
            if self.BuffUsingSkillVfx then
                _EffectService:RemoveEffect(self.BuffParticleSerial)
            else
                _ParticleService:RemoveParticle(self.BuffParticleSerial)
            end
            self.BuffParticleSerial = 0
            self.BuffUsingSkillVfx = false
        end

        log("PlayerSkill: buff expired, reverted " .. self.BuffType)
        self.BuffActive = false
        self.BuffType = ""
    end

end
