@Logic
script PotionShopUIController extends Logic
    -- 물약 상점 (2026-09-20 QA "물약 상점 없음") - 로비 물약 상인 NPC(LobbyStageController.
    -- OnShopNpcTouched)를 누르면 열리는 팝업. 캐릭터가 몬스터를 잡아 번 인게임 재화 "골드"
    -- (CharacterRosterLogic.GetGold/SpendGold)로 빨간/파란 포션을 산다. 계정 영구 재화 "정수"
    -- (AccountCurrencyLogic - 좋은 특성 저격용 메타 강화)와는 완전히 별개이며 여기서 쓰지 않는다.
    -- 골드/물약 인벤토리 모두 캐릭터 데이터(roster, 클라이언트 소유)라 구매는 클라이언트에서
    -- 끝난다. AccountUpgradeUIController와 동일한 구조(엔티티를 직접 property로 주입한 독립
    -- @Logic) - ui/PotionShopGroup.ui의 엔티티 UUID는 UIBuilder write(bind)가 주입한다.
    property Entity shopGroup = "4f87dd1d-1877-461b-8965-3267713ae4f1"
    property TextGUIRendererComponent currencyText = "7cd7f029-4405-4cf2-89ad-46a319a1ed57"
    property TextGUIRendererComponent statusText = "d06cd47e-b7bc-45e4-afea-6776b3e09d96"
    property TextGUIRendererComponent hpInfoText = "b765a43a-bda9-496c-b32f-a3759ef15cb5"
    property TextGUIRendererComponent mpInfoText = "6145706b-96f2-4c1b-b9ef-3e912d97ef50"
    property Entity btnHpBuy1 = "1fc895be-3a13-4624-a244-b9d9e3846e11"
    property Entity btnHpBuy10 = "9c3d76b4-8ca3-46c4-8461-67f79e3e45b2"
    property Entity btnMpBuy1 = "27d4c85f-eada-499c-a844-335574e55707"
    property Entity btnMpBuy10 = "8edbbe54-63c8-428f-97a5-83f1f9e450a7"
    property Entity btnClose = "7ab6284f-1448-4fe6-b970-c2c912e98f3c"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.handlers = {}
        if isvalid(self.shopGroup) then
            self.shopGroup.Enable = false
        end
        self:Bind(self.btnHpBuy1, function() self:OnBuyClicked("hppotion", 1) end)
        self:Bind(self.btnHpBuy10, function() self:OnBuyClicked("hppotion", 10) end)
        self:Bind(self.btnMpBuy1, function() self:OnBuyClicked("mppotion", 1) end)
        self:Bind(self.btnMpBuy10, function() self:OnBuyClicked("mppotion", 10) end)
        self:Bind(self.btnClose, function() self:Hide() end)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, rec in ipairs(self._T.handlers) do
            if isvalid(rec.entity) then
                rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity button, any callback)
        -- 버튼 클릭 핸들러 연결 + OnEndPlay 해제용 기록.
        if not isvalid(button) then return end
        local h = button:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self._T.handlers, { entity = button, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void Show()
        if isvalid(self.shopGroup) then
            self.shopGroup.Enable = true
        end
        self:SetStatus("")
        self:RefreshDisplay()
        log("PotionShop: opened gold=" .. _CharacterRosterLogic:GetGold())
    end

    @ExecSpace("ClientOnly")
    method void Hide()
        if isvalid(self.shopGroup) then
            self.shopGroup.Enable = false
        end
    end

    @ExecSpace("ClientOnly")
    method void SetStatus(string message)
        if isvalid(self.statusText) then
            self.statusText.Text = message
        end
    end

    @ExecSpace("ClientOnly")
    method integer CountOwned(string potionId)
        -- 활성 캐릭터 인벤토리에서 해당 물약의 보유 수량(1인스턴스=count 필드로 스택).
        local data = _CharacterRosterLogic:GetActiveCharacterData()
        if data == nil or data.inventory == nil then return 0 end
        for _, inst in ipairs(data.inventory) do
            if inst.potionId == potionId then
                return inst.count or 1
            end
        end
        return 0
    end

    @ExecSpace("ClientOnly")
    method string BuildInfoLine(string potionId)
        local tpl = _EquipmentLogic:GetPotionTemplate(potionId)
        if tpl == nil then return "" end
        return "개당 " .. tpl.price .. " 골드  ·  보유 " .. self:CountOwned(potionId) .. "개"
    end

    @ExecSpace("ClientOnly")
    method void RefreshDisplay()
        -- 열릴 때 / 구매 결과마다 텍스트만 갱신.
        if isvalid(self.currencyText) then
            self.currencyText.Text = "보유 골드: " .. _CharacterRosterLogic:GetGold()
        end
        if isvalid(self.hpInfoText) then
            self.hpInfoText.Text = self:BuildInfoLine("hppotion")
        end
        if isvalid(self.mpInfoText) then
            self.mpInfoText.Text = self:BuildInfoLine("mppotion")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnBuyClicked(string potionId, integer amount)
        if _CharacterRosterLogic:GetActiveCharacterData() == nil then
            self:SetStatus("활성 캐릭터가 없어 구매할 수 없습니다.")
            return
        end
        local tpl = _EquipmentLogic:GetPotionTemplate(potionId)
        if tpl == nil then return end
        local cost = tpl.price * amount
        local gold = _CharacterRosterLogic:GetGold()
        if not _CharacterRosterLogic:SpendGold(cost) then
            self:SetStatus("골드가 부족합니다. (필요 " .. cost .. " / 보유 " .. gold .. ")")
            log("PotionShop: purchase denied " .. potionId .. " x" .. amount .. " cost=" .. cost .. " gold=" .. gold)
            return
        end
        -- GrantPotionDrop이 인벤토리 반영 + SaveRoster(차감된 골드도 함께 저장)까지 처리한다.
        _CharacterRosterLogic:GrantPotionDrop(potionId, amount)
        self:SetStatus(tpl.name .. " " .. amount .. "개를 구매했습니다.")
        self:RefreshDisplay()
        log("PotionShop: purchased " .. potionId .. " x" .. amount .. " cost=" .. cost .. " goldLeft=" .. _CharacterRosterLogic:GetGold())
    end

end
